PLI_FN(pli_record_read_char, VOID, (I64, PTR, I64))
PLI_FN(pli_record_read_bit, I8, (I64))

/* Multitasking (rules (79),(82),(83), QR2.8): EVENT completion flags are i32
 * words (0 incomplete, 1 complete) owned by PL/I variables; the runtime
 * serialises them behind one mutex+cond. TASK handles are opaque ids. */
PLI_FN(pli_event_reset, VOID, (PTR))        /* CALL: mark the event incomplete */
PLI_FN(pli_event_complete, VOID, (PTR))     /* task end: mark complete + wake */
PLI_FN(pli_event_wait, VOID, (PTR))         /* WAIT(ev): until complete */
PLI_FN(pli_wait_n, VOID, (PTR, I64, I64))   /* WAIT(evs)(k): array of addrs */
PLI_FN(pli_event_status, I8, (PTR))         /* EVENT(ev) poll: 0/1 */
PLI_FN(pli_delay, VOID, (I64))              /* DELAY(n): sleep n milliseconds */
PLI_FN(pli_task_spawn, VOID, (PTR, PTR))    /* spawn wrapper(ctx), detached */
PLI_FN(pli_task_spawn_p, VOID, (PTR, PTR, I64, I32)) /* spawn w/ priority */
PLI_FN(pli_sched_main, VOID, (PTR))         /* run MAIN as a task (ADR-234) */
PLI_FN(pli_task_note, VOID, (PTR))          /* CALL TASK: assign a handle id */
PLI_FN(pli_task_priority_of, I32, (I64))    /* PRIORITY(t): read relative priority */
PLI_FN(pli_task_set_priority_of, VOID, (I64, I32)) /* PRIORITY(t)=n: set priority */
