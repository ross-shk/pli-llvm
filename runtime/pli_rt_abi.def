/* pli_rt_abi.def — the single source of truth for the pli_* runtime ABI.
 *
 * Each PLI_FN line names one runtime entry point and its signature as type
 * tokens. Two consumers expand it differently:
 *   - runtime/pli_rt.h expands the tokens to C prototypes (for pli_rt.c).
 *   - src/irgen.cpp expands them to LLVM type tokens (for codegen).
 * Changing a signature here updates both sides at once, so the C ABI and the
 * emitted IR cannot drift (cf. docs/ARCHITECTURE.md "Runtime interface").
 *
 * Tokens: VOID I64 I32 I8 DOUBLE PTR (char*) CPTR (const char*).
 * A function with no parameters is written with a single VOID argument.
 *
 * Wide (>18 digit) FIXED DECIMAL values cross this ABI as an explicit
 * (lo, hi) pair of I64 halves (little-endian two's-complement bits), never
 * as a 128-bit integer by value: clang lowers a by-value __int128/PliI128
 * parameter indirectly (by pointer) on x86_64-pc-windows-msvc but passes it
 * in registers on SysV/ARM64, so a by-value i128 declaration in generated IR
 * cannot agree with the runtime body on every target.
 */
PLI_FN(pli_rt_init, VOID, (VOID))                     /* program prologue */
PLI_FN(pli_rt_fini, VOID, (VOID))                     /* program epilogue */
PLI_FN(pli_stop, VOID, (VOID))                        /* STOP, rule (85) */

/* Stream serialisation (ADR-233): the compiler brackets one output or input
 * statement with these calls when the program has a task, so the whole record
 * is written or read under the matching lock. All four are no-ops without a
 * task. */
PLI_FN(pli_out_begin, VOID, (VOID))
PLI_FN(pli_out_end, VOID, (VOID))
PLI_FN(pli_in_begin, VOID, (VOID))
PLI_FN(pli_in_end, VOID, (VOID))

PLI_FN(pli_put_skip, VOID, (I64))                     /* list-directed (104-109) */
PLI_FN(pli_put_page, VOID, (VOID))
PLI_FN(pli_put_list_char, VOID, (CPTR, I64))
PLI_FN(pli_put_list_fixed, VOID, (I64))
PLI_FN(pli_put_list_fixed_scaled, VOID, (I64, I64))   /* scaled FIXED (ADR-006) */
PLI_FN(pli_put_list_decfixed, VOID, (I64, I64))   /* decimal point (QR1.2) */
PLI_FN(pli_display_decfixed, VOID, (I64, I64))    /* decimal point (QR1.2) */
PLI_FN(pli_put_list_decfixed128, VOID, (I64, I64, I64))   /* >18 digit DECIMAL (ADR-191): (lo, hi, scale) */
PLI_FN(pli_display_decfixed128, VOID, (I64, I64, I64))    /* >18 digit DECIMAL (ADR-191): (lo, hi, scale) */
PLI_FN(pli_get_list_decfixed, I64, (I64))         /* decimal input (QR1.2) */
PLI_FN(pli_get_list_decfixed_wide, VOID, (I64, PTR)) /* wide decimal input (B1): (scale, out) */
PLI_FN(pli_get_list_fixed_scaled, I64, (I64))     /* scaled binary input (ADR-284) */
PLI_FN(pli_put_list_float, VOID, (DOUBLE))
PLI_FN(pli_put_list_bit, VOID, (I8))
PLI_FN(pli_put_list_complex, VOID, (DOUBLE, DOUBLE)) /* CM5 (ADR-085) */
PLI_FN(pli_put_data_name, VOID, (CPTR, I64))         /* DATA-directed (106, QR1.5) */
PLI_FN(pli_put_data_end, VOID, (VOID))
/* DISPLAY one scalar value (rule 114, ADR-081) */
PLI_FN(pli_display_char, VOID, (CPTR, I64))
PLI_FN(pli_display_fixed, VOID, (I64))
PLI_FN(pli_display_fixed_scaled, VOID, (I64, I64)) /* scaled binary (ADR-284) */
PLI_FN(pli_display_float, VOID, (DOUBLE))
PLI_FN(pli_display_bit, VOID, (I8))
PLI_FN(pli_display_complex, VOID, (DOUBLE, DOUBLE)) /* CM5 (ADR-085) */

/* Edit-directed output (rules (108),(44)-(54)): F(w,d), A(w), and the control
 * X/SKIP/PAGE/LINE items. The fixed form takes the stored value, its decimal
 * scale (value*10^scale), the field width, and the fractional-digit count. */
PLI_FN(pli_put_edit_char, VOID, (CPTR, I64, I64))
PLI_FN(pli_put_edit_bit, VOID, (CPTR, I64, I64))
PLI_FN(pli_put_edit_fixed, VOID, (I64, I64, I64, I64))
PLI_FN(pli_put_edit_float, VOID, (DOUBLE, I64, I64))
PLI_FN(pli_put_edit_float_e, VOID, (DOUBLE, I64, I64))
PLI_FN(pli_put_edit_x, VOID, (I64))
PLI_FN(pli_put_edit_column, VOID, (I64))
PLI_FN(pli_put_edit_skip, VOID, (I64))
PLI_FN(pli_put_edit_page, VOID, (VOID))
PLI_FN(pli_put_edit_line, VOID, (I64))
PLI_FN(pli_copy, VOID, (VOID))                        /* COPY (105): echo input remainder */
PLI_FN(pli_put_edit_pic, VOID, (I64, I64, I32, CPTR, I64))
PLI_FN(pli_put_edit_pic_wide, VOID, (I64, I64, I64, I32, CPTR, I64)) /* wide P output (B1) */
PLI_FN(pli_put_edit_pic_sterling, VOID, (I64, I32, CPTR, I64)) /* sterling P output (B1) */
PLI_FN(pli_pic_format, I64, (I64, I64, I32, CPTR, I64, PTR, I64)) /* PICTURE variable (ADR-290) */
PLI_FN(pli_pic_format_wide, I64, (I64, I64, I64, I32, CPTR, I64, PTR, I64)) /* wide PICTURE variable (B1) */
PLI_FN(pli_pic_format_sterling, I64, (I64, I32, CPTR, I64, PTR, I64)) /* sterling PICTURE variable (B1) */

