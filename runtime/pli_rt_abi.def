PLI_FN(pli_record_rewrite_float, VOID, (I64, DOUBLE))
PLI_FN(pli_record_rewrite_char, VOID, (I64, PTR, I64))
PLI_FN(pli_record_rewrite_bit, VOID, (I64, I8))
