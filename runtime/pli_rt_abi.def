/* pli_rt_abi.def — the single source of truth for the pli_* runtime ABI.
 *
 * Each PLI_FN line names one runtime entry point and its signature as type
 * tokens. Two consumers expand it differently:
 *   - runtime/pli_rt.h expands the tokens to C prototypes (for pli_rt.c).
 *   - src/irgen.cpp expands them to LLVM type tokens (for codegen).
 * Changing a signature here updates both sides at once, so the C ABI and the
 * emitted IR cannot drift (cf. docs/ARCHITECTURE.md "Runtime interface").
 *
 * Tokens: VOID I64 I32 I8 DOUBLE PTR (char*) CPTR (const char*).
 * A function with no parameters is written with a single VOID argument.
 */
PLI_FN(pli_rt_init, VOID, (VOID))                     /* program prologue */
PLI_FN(pli_rt_fini, VOID, (VOID))                     /* program epilogue */
PLI_FN(pli_stop, VOID, (VOID))                        /* STOP, rule (85) */

PLI_FN(pli_put_skip, VOID, (I64))                     /* list-directed (104-109) */
PLI_FN(pli_put_page, VOID, (VOID))
PLI_FN(pli_put_list_char, VOID, (CPTR, I64))
PLI_FN(pli_put_list_fixed, VOID, (I64))
PLI_FN(pli_put_list_fixed_scaled, VOID, (I64, I64))   /* scaled FIXED (ADR-006) */
PLI_FN(pli_put_list_float, VOID, (DOUBLE))
PLI_FN(pli_put_list_bit, VOID, (I8))
PLI_FN(pli_put_list_complex, VOID, (DOUBLE, DOUBLE)) /* CM5 (ADR-085) */
/* DISPLAY one scalar value (rule 114, ADR-081) */
PLI_FN(pli_display_char, VOID, (CPTR, I64))
PLI_FN(pli_display_fixed, VOID, (I64))
PLI_FN(pli_display_float, VOID, (DOUBLE))
PLI_FN(pli_display_bit, VOID, (I8))
PLI_FN(pli_display_complex, VOID, (DOUBLE, DOUBLE)) /* CM5 (ADR-085) */

/* Edit-directed output (rules (108),(44)-(54)): F(w,d), A(w), and the control
 * X/SKIP/PAGE/LINE items. The fixed form takes the stored value, its decimal
 * scale (value*10^scale), the field width, and the fractional-digit count. */
PLI_FN(pli_put_edit_char, VOID, (CPTR, I64, I64))
PLI_FN(pli_put_edit_fixed, VOID, (I64, I64, I64, I64))
PLI_FN(pli_put_edit_float, VOID, (DOUBLE, I64, I64))
PLI_FN(pli_put_edit_float_e, VOID, (DOUBLE, I64, I64))
PLI_FN(pli_put_edit_x, VOID, (I64))
PLI_FN(pli_put_edit_skip, VOID, (I64))
PLI_FN(pli_put_edit_page, VOID, (VOID))
PLI_FN(pli_put_edit_line, VOID, (I64))

PLI_FN(pli_assign_char, VOID, (PTR, I64, CPTR, I64))  /* string semantics */
PLI_FN(pli_assign_varying, I64, (PTR, I64, CPTR, I64))
PLI_FN(pli_concat, VOID, (PTR, CPTR, I64, CPTR, I64))
PLI_FN(pli_substr, VOID, (PTR, I64, CPTR, I64, I64, I64))    /* SUBSTR */
PLI_FN(pli_substr_assign, VOID, (PTR, I64, I64, I64, CPTR, I64)) /* SUBSTR pseudo-var */
PLI_FN(pli_index, I64, (CPTR, I64, CPTR, I64))        /* INDEX */
PLI_FN(pli_mod_ll, I64, (I64, I64))                   /* MOD */
PLI_FN(pli_mod_dd, DOUBLE, (DOUBLE, DOUBLE))
PLI_FN(pli_round, DOUBLE, (DOUBLE, I64))              /* ROUND */
PLI_FN(pli_floor, DOUBLE, (DOUBLE))                   /* scalar math (QR2.7) */
PLI_FN(pli_ceil, DOUBLE, (DOUBLE))
PLI_FN(pli_sqrt, DOUBLE, (DOUBLE))
PLI_FN(pli_exp, DOUBLE, (DOUBLE))
PLI_FN(pli_log, DOUBLE, (DOUBLE))
PLI_FN(pli_sin, DOUBLE, (DOUBLE))
PLI_FN(pli_cos, DOUBLE, (DOUBLE))
PLI_FN(pli_tan, DOUBLE, (DOUBLE))
PLI_FN(pli_log2, DOUBLE, (DOUBLE))
PLI_FN(pli_log10, DOUBLE, (DOUBLE))
PLI_FN(pli_atan, DOUBLE, (DOUBLE))
PLI_FN(pli_asin, DOUBLE, (DOUBLE))   /* ASIN (CM5) */
PLI_FN(pli_acos, DOUBLE, (DOUBLE))   /* ACOS (CM5) */
PLI_FN(pli_atan2, DOUBLE, (DOUBLE, DOUBLE)) /* ATAN2(y, x) (CM5) */
PLI_FN(pli_cbrt, DOUBLE, (DOUBLE))   /* CBRT (CM5) */
PLI_FN(pli_sinh, DOUBLE, (DOUBLE))
PLI_FN(pli_cosh, DOUBLE, (DOUBLE))
PLI_FN(pli_tanh, DOUBLE, (DOUBLE))
PLI_FN(pli_atanh, DOUBLE, (DOUBLE))
PLI_FN(pli_erf, DOUBLE, (DOUBLE))
PLI_FN(pli_erfc, DOUBLE, (DOUBLE))
PLI_FN(pli_sind, DOUBLE, (DOUBLE))
PLI_FN(pli_cosd, DOUBLE, (DOUBLE))
PLI_FN(pli_tand, DOUBLE, (DOUBLE))
PLI_FN(pli_atand, DOUBLE, (DOUBLE))
PLI_FN(pli_repeat, VOID, (PTR, I64, CPTR, I64, I64))  /* REPEAT */
PLI_FN(pli_verify, I64, (CPTR, I64, CPTR, I64))       /* VERIFY */
PLI_FN(pli_translate, VOID, (PTR, I64, CPTR, I64, CPTR, I64, CPTR, I64)) /* TRANSLATE */
PLI_FN(pli_high, VOID, (PTR, I64))                    /* HIGH(n) */
PLI_FN(pli_low, VOID, (PTR, I64))                     /* LOW(n) */
PLI_FN(pli_date, VOID, (PTR, I64))                    /* DATE() */
PLI_FN(pli_time, VOID, (PTR, I64))                    /* TIME() */
PLI_FN(pli_cmp_char, I32, (CPTR, I64, CPTR, I64))     /* string compare */

PLI_FN(pli_signal_error, VOID, (CPTR))                /* conditions (M5) */
PLI_FN(pli_subscript_oob, VOID, (VOID))               /* SUBSCRIPTRANGE interim (M2) */

PLI_FN(pli_on_push_error, VOID, (I64))  /* ON ERROR: establish handler id (0 = SYSTEM) */
PLI_FN(pli_on_pop_error, VOID, (VOID))  /* REVERT ERROR */
PLI_FN(pli_on_top_error, I64, (VOID))   /* SIGNAL dispatch: top id, 0 = none/SYSTEM */
PLI_FN(pli_on_depth_error, I64, (VOID)) /* block-entry save */
PLI_FN(pli_on_reset_error, VOID, (I64)) /* block/procedure-exit restore */
PLI_FN(pli_oncode, I32, (VOID))         /* ONCODE() */
PLI_FN(pli_set_oncode, VOID, (I32))
/* Programmer-named conditions (rules (94),(99)): same stack, tagged entries.
 * Key 0 is ERROR; the ERROR functions above address key 0 only. */
PLI_FN(pli_on_push_cond, VOID, (I64, I64)) /* ON CONDITION: key, handler id */
PLI_FN(pli_on_pop_cond, VOID, (I64))       /* REVERT CONDITION: drop topmost key */
PLI_FN(pli_on_top_cond, I64, (I64))        /* SIGNAL dispatch: topmost key id */

PLI_FN(pli_alloc, PTR, (I64))                         /* ALLOCATE (87) */
PLI_FN(pli_free, VOID, (PTR))                         /* FREE (90) */

PLI_FN(pli_get_list_fixed, I64, (VOID))               /* list-directed input (109) */
PLI_FN(pli_get_list_float, DOUBLE, (VOID))
PLI_FN(pli_get_list_char, VOID, (PTR, I64))
PLI_FN(pli_get_list_complex, VOID, (PTR, PTR)) /* CM5 (ADR-086) */
PLI_FN(pli_get_list_bit, I8, (VOID))

/* Edit-directed input (rules (108),(44)-(54)): F(w,d) is parsed to a double
 * (the caller converts to the target's type), A(w) reads a character field,
 * and X/SKIP advance the input position. */
PLI_FN(pli_get_edit_num, DOUBLE, (I64))
PLI_FN(pli_get_edit_char, VOID, (PTR, I64, I64))
PLI_FN(pli_get_edit_x, VOID, (I64))
PLI_FN(pli_get_edit_skip, VOID, (I64))

PLI_FN(pli_string_put_open, VOID, (PTR, I64))         /* STRING output (105) */
PLI_FN(pli_string_put_close, VOID, (PTR, I64))
PLI_FN(pli_string_get_open, VOID, (PTR, I64))         /* STRING input (105) */
PLI_FN(pli_string_get_close, VOID, (VOID))

PLI_FN(pli_file_open, VOID, (I64, CPTR, I64, I64))    /* OPEN (100-103): slot, name, mode */
PLI_FN(pli_file_close, VOID, (I64))
PLI_FN(pli_put_select, VOID, (I64))                   /* FILE output routing (105) */
PLI_FN(pli_put_unselect, VOID, (VOID))
PLI_FN(pli_get_select, VOID, (I64))                   /* FILE input routing (105) */
PLI_FN(pli_get_unselect, VOID, (VOID))
