   /* rule (94): ERROR, SIZE, SUBSCRIPTRANGE and
     ZERODIVIDE are served; other conditions are
     diagnosed, never silently accepted. */
  badoncond: procedure options(main);
     on overflow put skip list('x');
  end badoncond;
