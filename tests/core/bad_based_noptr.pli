 /* A bare BASED variable is unconnected (rule (25)): a reference
    without an explicit locator qualifier is diagnosed (rule (124)),
    never silently addressed through a null locator. */
 bad_based_noptr: procedure options(main);
   dcl 1 rec based,
       2 a fixed bin(31);
   rec.a = 1;
 end bad_based_noptr;
