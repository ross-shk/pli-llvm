 /* BIT(n>1) string operations (rules (18),(116),(117); QR2.2):
    packed big-endian bytes; literals pack fully; assignment pads
    and truncates on the right; logic is byte-wise; conversion to
    a number takes the binary value. */
 bitn: procedure options(main);
    declare b8 bit(8);
    declare c8 bit(8);
    declare f16 bit(16);
    declare e12 bit(12);
    declare i8 bit(8) init('11001100'b);
    declare 1 s, 2 v bit(8);
    declare x fixed bin(31);

    /* literals pack all bits, MSB first */
    b8 = '10101010'b;
    x = b8;
    if x ^= 170 then do;
       put skip list('FAIL bitn: expected 170, got', x);
       stop;
    end;
    /* same-length copy */
    c8 = b8;
    x = c8;
    if x ^= 170 then do;
       put skip list('FAIL bitn: expected 170, got', x);
       stop;
    end;
    /* short literals pad on the right */
    b8 = '101'b;
    x = b8;
    if x ^= 160 then do;
       put skip list('FAIL bitn: expected 160, got', x);
       stop;
    end;
    /* long literals truncate on the right */
    b8 = '111111111'b;
    x = b8;
    if x ^= 255 then do;
       put skip list('FAIL bitn: expected 255, got', x);
       stop;
    end;
    /* integers convert by value, low bits kept */
    b8 = 5;
    x = b8;
    if x ^= 5 then do;
       put skip list('FAIL bitn: expected 5, got', x);
       stop;
    end;
    /* equality and inequality */
    b8 = '10101010'b;
    c8 = '10101011'b;
    if b8 = c8 then do;
       put skip list('FAIL bitn: check at line 41 failed');
       stop;
    end;
    if ^(b8 ^= c8) then do;
       put skip list('FAIL bitn: check at line 42 failed');
       stop;
    end;
    c8 = b8;
    if ^(b8 = c8) then do;
       put skip list('FAIL bitn: check at line 44 failed');
       stop;
    end;
    /* byte-wise logic */
    c8 = b8 & '10101011'b;
    x = c8;
    if x ^= 170 then do;
       put skip list('FAIL bitn: expected 170, got', x);
       stop;
    end;
    c8 = b8 | '10101011'b;
    x = c8;
    if x ^= 171 then do;
       put skip list('FAIL bitn: expected 171, got', x);
       stop;
    end;
    c8 = ^b8;
    x = c8;
    if x ^= 85 then do;
       put skip list('FAIL bitn: expected 85, got', x);
       stop;
    end;
    /* multi-byte values pack big-endian */
    f16 = '1111111111111111'b;
    x = f16;
    if x ^= 65535 then do;
       put skip list('FAIL bitn: expected 65535, got', x);
       stop;
    end;
    b8 = f16;
    x = b8;
    if x ^= 255 then do;
       put skip list('FAIL bitn: expected 255, got', x);
       stop;
    end;
    /* NOT masks the unused low bits of the last byte */
    e12 = '111111111111'b;
    e12 = ^e12;
    x = e12;
    if x ^= 0 then do;
       put skip list('FAIL bitn: expected 0, got', x);
       stop;
    end;
    /* nonzero bit strings are true conditions */
    b8 = '00000001'b;
    if b8 then x = 1;
    else x = 0;
    if x ^= 1 then do;
       put skip list('FAIL bitn: expected 1, got', x);
       stop;
    end;
    b8 = '00000000'b;
    if b8 then x = 1;
    else x = 0;
    if x ^= 0 then do;
       put skip list('FAIL bitn: expected 0, got', x);
       stop;
    end;
    /* INITIAL packs the literal, members address normally */
    x = i8;
    if x ^= 204 then do;
       put skip list('FAIL bitn: expected 204, got', x);
       stop;
    end;
    s.v = '10101010'b;
    x = s.v;
    if x ^= 170 then do;
       put skip list('FAIL bitn: expected 170, got', x);
       stop;
    end;
    /* by-reference parameters pass the packed address through */
    b8 = '11110000'b;
    x = idb(b8);
    if x ^= 240 then do;
       put skip list('FAIL bitn: expected 240, got', x);
       stop;
    end;

   put skip list('PASS bitn');
 end bitn;
 idb: procedure(v) returns(fixed bin(31));
    declare v bit(8);
    declare y fixed bin(31);
    y = v;
    return(y);
 end idb;
