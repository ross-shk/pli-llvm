 /* A bare BASED variable has no own locator, so ALLOCATE must name
    one with SET ( rule (88) ); the bare form is diagnosed. */
 bad_based_alloc_noset: procedure options(main);
   dcl 1 rec based,
       2 a fixed bin(31);
   allocate rec;
 end bad_based_alloc_noset;
