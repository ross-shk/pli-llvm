 /* rules (123): TRANSLATE with constant out/in strings lowers to a
    256-entry translation table (ADR-273). The table path must agree
    exactly with the byte-at-a-time scan the variable form uses,
    including the rule that a match past the end of `out` is a blank,
    and that the first occurrence in `in` decides. */
 translate_const: procedure options(main);
    declare s char(6) init('abcxyz');
    declare out3 char(3) init('XYQ');
    declare in3 char(3) init('abc');
    declare out2 char(2) init('XY');
    declare out1 char(1) init('H');
    declare in1 char(1) init('h');
    declare in2 char(2) init('aa');
    declare a char(6);
    declare b char(6);
    declare fails fixed bin(31);
    fails = 0;

    /* the constant table and the variable scan agree */
    a = translate(s, 'XYQ', 'abc');
    b = translate(s, out3, in3);
    if a ^= b then do;
       fails = fails + 1;
       put skip list('FAIL table', a, b);
    end;
    if a ^= 'XYQxyz' then do;
       fails = fails + 1;
       put skip list('FAIL exact', a);
    end;

    /* `out` shorter than `in`: a match past the end of `out` is a
       blank, the PL/I rule that pads `out` to the length of `in` */
    a = translate(s, 'XY', 'abc');
    b = translate(s, out2, in3);
    if a ^= b then do;
       fails = fails + 1;
       put skip list('FAIL blank', a, b);
    end;
    if a ^= 'XY xyz' then do;
       fails = fails + 1;
       put skip list('FAIL blank exact', a);
    end;

    /* one character mapped, everything else passes through */
    a = translate('hello', 'H', 'h');
    b = translate('hello', out1, in1);
    if a ^= b then do;
       fails = fails + 1;
       put skip list('FAIL single', a, b);
    end;

    /* the first occurrence in `in` decides, as the scan does */
    a = translate('ab', 'PQ', 'aa');
    b = translate('ab', 'PQ', in2);
    if a ^= b then do;
       fails = fails + 1;
       put skip list('FAIL first', a, b);
    end;
    if a ^= 'Pb' then do;
       fails = fails + 1;
       put skip list('FAIL first exact', a);
    end;

    /* a VARYING source is translated the same way */
    declare v char(10) varying;
    v = 'abc';
    a = translate(v, 'XY', 'abc');
    if a ^= 'XY ' then do;
       fails = fails + 1;
       put skip list('FAIL varying', a);
    end;

    /* a zero-length source is a zero-length result */
    a = translate('', 'XY', 'abc');
    if a ^= '' then do;
       fails = fails + 1;
       put skip list('FAIL empty', a);
    end;

    if fails = 0 then put skip list('PASS translate_const');
    else put skip list('FAIL translate_const: fails =', fails);
 end translate_const;
