  /* BY NAME assignment (rule 86): S = T BY NAME copies the members of S from
     the members of T that share the same name, regardless of structure layout.
     Members present in only one structure are skipped. Matching is recursive
     through minor (nested) structures and applies to array members too. */
  struct_by_name_test: procedure options(main);
     declare 1 s,
            2 a fixed bin(31),
            2 v(2) fixed bin(31),
            2 x,
              3 y fixed bin(31),
              3 z fixed bin(31),
            2 p fixed bin(31);
     declare 1 t,
            2 a fixed bin(31),
            2 v(2) fixed bin(31),
            2 x,
              3 y fixed bin(31),
              3 w fixed bin(31),
            2 q fixed bin(31);
     declare fails fixed bin(31);

     fails = 0;
     t.a = 11;
     t.v(1) = 1;
     t.v(2) = 2;
     t.x.y = 33;
     t.x.w = 44;
     t.q = 99;

     /* matching members are copied by name; s.p is absent from t and left
        unchanged, t.q is absent from s and ignored */
     s.p = 7;
     s = t, by name;

     if s.a ^= 11 then fails = fails + 1;
     if s.v(1) ^= 1 or s.v(2) ^= 2 then fails = fails + 1;
     if s.x.y ^= 33 then fails = fails + 1;
     /* s.x.z has no same-named t member, so it keeps its prior value */
     s.x.z = 55;
     s = t, by name;
     if s.x.z ^= 55 then fails = fails + 1;
     /* s.p is untouched because t has no member p */
     if s.p ^= 7 then fails = fails + 1;

     if fails = 0 then put skip list('PASS struct_by_name');
     else put skip list('FAIL struct_by_name: fails =', fails);
  end struct_by_name_test;
