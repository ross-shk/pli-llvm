 /* Dynamic (runtime-extent) array restrictions (rule (13)): this stage serves
    a single-axis AUTOMATIC array with a constant lower bound (INITIAL on a
    dynamic array is now served). A multi-axis dynamic array is rejected. */
 bad_dynamic_array: procedure options(main);
    declare n fixed bin(31);
    declare m fixed bin(31);

    declare d(n, m) fixed bin(31);         /* dynamic arrays must be single-axis */
 end bad_dynamic_array;
