 /* Rules (25),(126): dimensioned BASED arrays. A fixed 1-D BASED
    array overlays caller storage through its POINTER; a runtime
    (n) overlay in a callee takes its bound from the length
    parameter. POINTER elements serve the handle-pool idiom. */
 based_array: procedure options(main);
   dcl p pointer;
   dcl q pointer;
   dcl n fixed bin(31);
   dcl i fixed bin(31);
   dcl fails fixed bin(31) init(0);
   dcl buf(4) fixed bin(31);
   dcl slots(4) pointer;
   dcl grid(2, 2) fixed bin(31);
   dcl e_array(4) fixed bin(31) based(p);
   dcl h_array(4) pointer based(q);
   dcl g_array(2, 2) fixed bin(31) based(p);
   buf(1) = 0; buf(2) = 0; buf(3) = 0; buf(4) = 0;
   /* fixed FIXED overlay: writes show through both names */
   p = addr(buf);
   e_array(1) = 11;
   e_array(4) = 44;
   if buf(1) ^= 11 then fails = fails + 1;
   if buf(4) ^= 44 then fails = fails + 1;
   if e_array(1) ^= 11 then fails = fails + 1;
   if hbound(e_array) ^= 4 then fails = fails + 1;
   if dim(e_array) ^= 4 then fails = fails + 1;
   if lbound(e_array) ^= 1 then fails = fails + 1;
   /* POINTER elements: the handle-pool view */
   q = addr(slots);
   h_array(1) = addr(buf);
   h_array(4) = addr(buf);
   if h_array(1) ^= addr(buf) then fails = fails + 1;
   if h_array(4) ^= addr(buf) then fails = fails + 1;
   /* runtime-(n) overlay in a callee over the same buffer */
   n = 4;
   p = addr(buf);
   call fill_view(p, n, 7);
   do i = 1 to n;
     if buf(i) ^= 7 then fails = fails + 1;
   end;
   if sum_view(p, n) ^= 28 then fails = fails + 1;
   /* multi-axis fixed overlay rides the same pointer base */
   p = addr(grid);
   g_array(1, 1) = 1;
   g_array(2, 2) = 4;
   if grid(1, 1) ^= 1 then fails = fails + 1;
   if grid(2, 2) ^= 4 then fails = fails + 1;
   /* heap block behind a fixed BASED array: independent cells */
   dcl cells(2) fixed bin(31) based(q);
   allocate cells set(q);
   cells(1) = 21;
   cells(2) = 22;
   if cells(2) ^= 22 then fails = fails + 1;
   free cells;
   if fails = 0 then put skip list('PASS based_array');
   else put skip list('FAIL based_array: fails =', fails);
 end based_array;
 /* Runtime-bound overlay (rules (13),(25)): bound (n) names the
    length parameter read at entry; no storage of its own. */
 fill_view: procedure(p, n, val);
   dcl p pointer;
   dcl n fixed bin(31);
   dcl val fixed bin(31);
   dcl v(n) fixed bin(31) based(p);
   dcl i fixed bin(31);
   do i = 1 to n;
     v(i) = val;
   end;
 end fill_view;
 sum_view: procedure(p, n) returns(fixed bin(31));
   dcl p pointer;
   dcl n fixed bin(31);
   dcl v(n) fixed bin(31) based(p);
   dcl i fixed bin(31);
   dcl s fixed bin(31) init(0);
   do i = 1 to n;
     s = s + v(i);
   end;
   return(s);
 end sum_view;
