 /* Rules (25),(126): dimensioned BASED arrays. A fixed 1-D BASED
    array overlays caller storage through its POINTER; a runtime
    (n) overlay in a callee takes its bound from the length
    parameter. POINTER elements serve the handle-pool idiom. */
 based_array: procedure options(main);
   dcl p pointer;
   dcl q pointer;
   dcl n fixed bin(31);
   dcl i fixed bin(31);
   dcl buf(4) fixed bin(31);
   dcl slots(4) pointer;
   dcl grid(2, 2) fixed bin(31);
   dcl e_array(4) fixed bin(31) based(p);
   dcl h_array(4) pointer based(q);
   dcl g_array(2, 2) fixed bin(31) based(p);
   buf(1) = 0; buf(2) = 0; buf(3) = 0; buf(4) = 0;
   /* fixed FIXED overlay: writes show through both names */
   p = addr(buf);
   e_array(1) = 11;
   e_array(4) = 44;
   if buf(1) ^= 11 then do;
      put skip list('FAIL based_array: expected 11, got', buf(1));
      stop;
   end;
   if buf(4) ^= 44 then do;
      put skip list('FAIL based_array: expected 44, got', buf(4));
      stop;
   end;
   if e_array(1) ^= 11 then do;
      put skip list('FAIL based_array: expected 11, got', e_array(1));
      stop;
   end;
   if hbound(e_array) ^= 4 then do;
      put skip list('FAIL based_array: expected 4, got',
         hbound(e_array));
      stop;
   end;
   if dim(e_array) ^= 4 then do;
      put skip list('FAIL based_array: expected 4, got', dim(e_array));
      stop;
   end;
   if lbound(e_array) ^= 1 then do;
      put skip list('FAIL based_array: expected 1, got',
         lbound(e_array));
      stop;
   end;
   /* POINTER elements: the handle-pool view */
   q = addr(slots);
   h_array(1) = addr(buf);
   h_array(4) = addr(buf);
   if h_array(1) ^= addr(buf) then do;
      put skip list('FAIL based_array: check at line 34 failed');
      stop;
   end;
   if h_array(4) ^= addr(buf) then do;
      put skip list('FAIL based_array: check at line 35 failed');
      stop;
   end;
   /* runtime-(n) overlay in a callee over the same buffer */
   n = 4;
   p = addr(buf);
   call fill_view(p, n, 7);
   do i = 1 to n;
     if buf(i) ^= 7 then do;
        put skip list('FAIL based_array: expected 7, got', buf(i));
        stop;
     end;
   end;
   if sum_view(p, n) ^= 28 then do;
      put skip list('FAIL based_array: expected 28, got',
         sum_view(p, n));
      stop;
   end;
   /* multi-axis fixed overlay rides the same pointer base */
   p = addr(grid);
   g_array(1, 1) = 1;
   g_array(2, 2) = 4;
   if grid(1, 1) ^= 1 then do;
      put skip list('FAIL based_array: expected 1, got', grid(1, 1));
      stop;
   end;
   if grid(2, 2) ^= 4 then do;
      put skip list('FAIL based_array: expected 4, got', grid(2, 2));
      stop;
   end;
   /* heap block behind a fixed BASED array: independent cells */
   dcl cells(2) fixed bin(31) based(q);
   allocate cells set(q);
   cells(1) = 21;
   cells(2) = 22;
   if cells(2) ^= 22 then do;
      put skip list('FAIL based_array: expected 22, got', cells(2));
      stop;
   end;
   free cells;
   put skip list('PASS based_array');
 end based_array;
 /* Runtime-bound overlay (rules (13),(25)): bound (n) names the
    length parameter read at entry; no storage of its own. */
 fill_view: procedure(p, n, val);
   dcl p pointer;
   dcl n fixed bin(31);
   dcl val fixed bin(31);
   dcl v(n) fixed bin(31) based(p);
   dcl i fixed bin(31);
   do i = 1 to n;
     v(i) = val;
   end;
 end fill_view;
 sum_view: procedure(p, n) returns(fixed bin(31));
   dcl p pointer;
   dcl n fixed bin(31);
   dcl v(n) fixed bin(31) based(p);
   dcl i fixed bin(31);
   dcl s fixed bin(31) init(0);
   do i = 1 to n;
     s = s + v(i);
   end;
   return(s);
 end sum_view;
