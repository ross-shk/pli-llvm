 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* rules (26),(121),(135): a constant expression folds to its value
    at compile time (ADR-240). The folded value must agree exactly with
    the runtime computation of the same expression, scale included, and
    a division by zero must still raise ZERODIVIDE — folding never
    removes an observable condition. The runtime side is computed from
    variable operands, so it really is the unfolded path. */
 decimal_const: procedure options(main);
    declare a fixed dec(9,2) init(99.99 + 0.01);
    declare b fixed dec(9,2) init(1.5 * 2.25);
    declare c fixed dec(9,2) value(10.0 + 2.5);
    declare d fixed dec(9,2);
    declare e fixed dec(9,2);
    declare f fixed dec(9,2);
    declare g fixed dec(9,2);
    declare z fixed dec(9,2) init(2.0);
    declare q fixed dec(9,2);
    declare x1 fixed dec(9,2) init(99.99);
    declare x2 fixed dec(9,2) init(0.01);
    declare y1 fixed dec(9,2) init(1.5);
    declare y2 fixed dec(9,2) init(2.25);
    declare w1 fixed dec(9,2) init(10.0);
    declare w2 fixed dec(9,2) init(2.5);
    declare caught fixed bin(31);

    /* the folded INITIAL agrees with the runtime computation of the
       same expression, computed here from variable operands */
    d = x1 + x2;
    if a ^= d then do;
       put skip list('FAIL a', a, d);
       stop;
    end;
    e = y1 * y2;
    if b ^= e then do;
       put skip list('FAIL b', b, e);
       stop;
    end;
    f = w1 + w2;
    if c ^= f then do;
       put skip list('FAIL c', c, f);
       stop;
    end;

    /* the scale of the target type is the scale of the stored value */
    if a ^= 100.00 then do;
       put skip list('FAIL scale a', a);
       stop;
    end;
    if b ^= 3.38 then do;
       put skip list('FAIL scale b', b);
       stop;
    end;
    if c ^= 12.50 then do;
       put skip list('FAIL scale c', c);
       stop;
    end;

    /* an integer literal is rescaled to the declared scale */
    declare h fixed dec(9,2) init(5);
    if h ^= 5.00 then do;
       put skip list('FAIL init int', h);
       stop;
    end;

    /* subtraction and a mixed-scale sum fold to the wider scale */
    declare s1 fixed dec(9,2) init(3.5 - 1.25);
    declare s2 fixed dec(9,2) init(4.5 + 1);
    g = 3.5 - 1.25;
    if s1 ^= 2.25 then do;
       put skip list('FAIL sub', s1);
       stop;
    end;
    if s2 ^= 5.50 then do;
       put skip list('FAIL mixed sum', s2);
       stop;
    end;

    /* a division is never folded: the divisor may be zero */
    caught = 0;
    on zerodivide caught = 1;
    q = 1.0 / 0.0;
    revert zerodivide;
    if caught = 0 then do;
       put skip list('FAIL no zerodivide');
       stop;
    end;

    /* a multiplication of variables still computes */
    g = z * 3.0;
    if g ^= 6.00 then do;
       put skip list('FAIL g', g);
       stop;
    end;

   put skip list('PASS decimal_const');
 end decimal_const;
