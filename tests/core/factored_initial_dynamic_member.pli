 /* Factored structures with dynamic array member — each gets own buffer
    initialized per the itemlist (rules 11, 13, 26, 30). */
 FACTORED_DYN_MEM: PROCEDURE OPTIONS(MAIN);
   DECLARE N FIXED BIN(31) INITIAL(5);
   DECLARE I FIXED BIN(31);

   /* Factored structures with dynamic array member — each gets own buffer */
   DECLARE 1 (D1, D2),
             2 LEN FIXED BIN(31),
             2 ARR(N) FIXED BIN(31);

   D1.LEN = N;
   D2.LEN = N;
   DO I = 1 TO N;
     D1.ARR(I) = I * 10;
     D2.ARR(I) = I * 20;
   END;

   PUT LIST('D1:');
   DO I = 1 TO N;
     PUT SKIP LIST(D1.ARR(I));
   END;

   PUT LIST('D2:');
   DO I = 1 TO N;
     PUT SKIP LIST(D2.ARR(I));
   END;

 END FACTORED_DYN_MEM;