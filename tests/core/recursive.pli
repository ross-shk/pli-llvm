 /* rules (5) RECURSIVE, (78) CALL, (81) RETURN,
    (123) function reference: direct, mutual and
    CALL recursion each need RECURSIVE; each
    activation keeps its own AUTOMATIC copy. */
 recursive: procedure options(main);
    declare fails fixed bin(31);
    declare r fixed bin(31);
    declare ticks fixed bin(31) init(0);
    fails = 0;
    r = fact(5);
    if r ^= 120 then do;
       fails = fails + 1;
       put skip list('FAIL fact(5) =', r);
    end;
    r = facta(5);
    if r ^= 120 then do;
       fails = fails + 1;
       put skip list('FAIL alias facta(5) =', r);
    end;
    if even(4) ^= 1 then do;
       fails = fails + 1;
       put skip list('FAIL even(4)');
    end;
    if odd(4) ^= 0 then do;
       fails = fails + 1;
       put skip list('FAIL odd(4)');
    end;
    if odd(7) ^= 1 then do;
       fails = fails + 1;
       put skip list('FAIL odd(7)');
    end;
    call countdn(3);
    if ticks ^= 3 then do;
       fails = fails + 1;
       put skip list('FAIL ticks =', ticks);
    end;
    r = tri(3);
    if r ^= 6 then do;
       fails = fails + 1;
       put skip list('FAIL tri(3) =', r);
    end;
    if fails = 0 then put skip list('PASS');
    fact: procedure(n) recursive returns(fixed bin(31));
       declare n fixed bin(31);
       if n <= 1 then return(1);
       return(n * fact(n - 1));
    end fact;
    facta: procedure(n) recursive returns(fixed bin(31));
       declare n fixed bin(31);
       if n <= 1 then return(1);
       return(n * facta(n - 1));
    end facta;
    even: procedure(n) recursive returns(fixed bin(31));
       declare n fixed bin(31);
       if n = 0 then return(1);
       return(odd(n - 1));
    end even;
    odd: procedure(n) recursive returns(fixed bin(31));
       declare n fixed bin(31);
       if n = 0 then return(0);
       return(even(n - 1));
    end odd;
    countdn: procedure(k) recursive;
       declare k fixed bin(31);
       if k <= 0 then return;
       ticks = ticks + 1;
       call countdn(k - 1);
    end countdn;
    tri: procedure(n) recursive returns(fixed bin(31));
       declare n fixed bin(31);
       declare m fixed bin(31);
       m = n;
       if n <= 0 then return(0);
       return(m + tri(n - 1));
    end tri;
 end recursive;
