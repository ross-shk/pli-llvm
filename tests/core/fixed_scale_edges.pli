/* FIXED scale edges (rules (16),(17),(135)): negative scale and scale >
   precision for DECIMAL and BINARY (Y33-6003-0 §4.5). */

fixed_scale_edges: procedure options(main);
    /* Negative scale: stored = logical / base^|q|, value = raw * base^|q|. */
    declare n2 fixed bin(15, -2);
    declare n4 fixed dec(5, -3);
    /* Scale > precision: a fraction with the point left of the digits. */
    declare f2 fixed bin(3, 5);
    declare f4 fixed dec(2, 4);
    /* A fractional INITIAL at scale > precision (Y33-6003-0 §4.5). */
    declare d1 fixed dec(2, 4) init(0.005);
    declare d3 fixed dec(3, 5);
    declare caught fixed bin(31) init(0);
    declare buf char(20);

    n2 = 5;
    if n2 ^= 4 then do;
       put skip list('FAIL n2', n2);
       stop;
    end;
    n4 = 2500;
    if n4 ^= 2000 then do;
       put skip list('FAIL n4', n4);
       stop;
    end;

    f2 = 0.125;
    if f2 ^= 0.125 then do;
       put skip list('FAIL f2', f2);
       stop;
    end;
    f4 = 0.005;
    if f4 ^= 0.005 then do;
       put skip list('FAIL f4', f4);
       stop;
    end;

    put string(buf) edit(d1) (f(10, 5));
    if substr(buf, 1, 10) ^= '   0.00500' then do;
       put skip list('FAIL d1', buf);
       stop;
    end;

    /* Overflow into the declared digits raises SIZE. */
    on size caught = 1;
    d3 = 1234.56;
    revert size;
    if caught ^= 1 then do;
       put skip list('FAIL size', caught);
       stop;
    end;

    /* Negative scale arithmetic */
    n2 = 5;
    if n2 ^= 4 then do;
       put skip list('FAIL n2', n2);
       stop;
    end;
    n4 = 2500;
    if n4 ^= 2000 then do;
       put skip list('FAIL n4', n4);
       stop;
    end;

    /* Scale > precision arithmetic */
    f2 = 0.125;
    if f2 ^= 0.125 then do;
       put skip list('FAIL f2', f2);
       stop;
    end;
    f4 = 0.005;
    if f4 ^= 0.005 then do;
       put skip list('FAIL f4', f4);
       stop;
    end;

    /* SIZE trap for negative scale: stored integer exceeds precision */
    on size caught = 1;
    n2 = 40000;
    if caught ^= 1 then do;
       put skip list('FAIL size neg scale', caught);
       stop;
    end;
    revert size;

    /* SIZE trap for scale > precision */
    on size caught = 1;
    f4 = 123.456;
    if caught ^= 1 then do;
       put skip list('FAIL size scale>prec', caught);
       stop;
    end;
    revert size;

    /* List-directed output */
    put skip list('n2=', n2);
    put skip list('n4=', n4);
    put skip list('f2=', f2);
    put skip list('f4=', f4);

    put skip list('PASS fixed_scale_edges');
 end fixed_scale_edges;
