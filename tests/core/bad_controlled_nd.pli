  /* N-D CONTROLLED ALLOCATE limits (rules (13),(89)): arity must
     match the DECLARE rank, a (*) axis needs an explicit bound,
     lb:ub pairs in ALLOCATE stay diagnosed, and a scalar takes
     a single extent. */
 bad_controlled_nd: procedure options(main);
   dcl a(3,4) fixed bin(31) controlled;
   dcl x(*,*) fixed bin(31) controlled;
   dcl s fixed bin(31) controlled;
   allocate a (2);
   allocate x;
   allocate a (1:2, 1:3);
   allocate s (2,3);
 end bad_controlled_nd;
