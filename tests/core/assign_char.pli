/* CHAR(n) assignment semantics (rule (85)): copy min(src,dst) bytes
   via memmove, blank-fill the tail. Boundary cases: empty source,
   short source, long source (clipping), self-overlap. Tests both
   the runtime pli_assign_char and the --experimental-lowering=auto
   dispatch that selects it in P0. */
ac: PROCEDURE OPTIONS(MAIN);
  DECLARE s CHAR(8);
  DECLARE v CHAR(8) VARYING;
  DECLARE t CHAR(10);

  /* Empty source → dst fully blank-padded */
  v = '';
  s = v;
  if s ^= '        ' then do;
     put skip list('FAIL assign_char: expected         , got', s);
     stop;
  end;

  /* Source shorter than dest → blank-fill tail */
  v = 'AB';
  s = v;
  if s ^= 'AB      ' then do;
     put skip list('FAIL assign_char: expected AB      , got', s);
     stop;
  end;

  /* Source longer than dest → clipped */
  v = 'ABCDEFGHIJ';
  s = v;
  if s ^= 'ABCDEFGH' then do;
     put skip list('FAIL assign_char: expected ABCDEFGH, got', s);
     stop;
  end;

  /* Exact-length source → no padding, no clipping */
  v = '12345678';
  s = v;
  if s ^= '12345678' then do;
     put skip list('FAIL assign_char: expected 12345678, got', s);
     stop;
  end;

  /* Self-overlap: substr of same buffer writes back. memmove is
     overlap-safe so the source bytes survive the copy. */
  t = 'ABCDEFGH  ';
  t = substr(t, 2, 7);
  if t ^= 'BCDEFGH   ' then do;
     put skip list('FAIL assign_char: expected BCDEFGH   , got', t);
     stop;
  end;

   put skip list('PASS assign_char');
END ac;
