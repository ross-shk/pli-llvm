  /* QR1.6 (TR §3.1): every abbreviation of
     a served keyword is accepted. */
  abbrev: proc options(main);
     dcl a fixed bin(31) init(1) auto int;
     dcl b fixed dec(4, 2) init(2.5);
     dcl s char(5) var init('hi');
     dcl p ptr;
     dcl x fixed bin(31);
     dcl y fixed bin(31) def x;
     dcl z cplx;
     dcl em_ext entry(fixed bin(31)) ext('em_ext');
     x = 41;
     y = y + 1;
     if y ^= 42 then do;
        put skip list('FAIL def');
        stop;
     end;
     z = complex(1.0, 2.0);
     if real(z) ^= 1.0 then do;
        put skip list('FAIL cplx');
        stop;
     end;
     p = null();
     if p ^= null() then do;
        put skip list('FAIL ptr');
        stop;
     end;
     if a + b ^= 3.5 then do;
        put skip list('FAIL init');
        stop;
     end;
   put skip list('PASS abbrev');
  end abbrev;
