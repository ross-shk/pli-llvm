 /* P2 litmus: DEFINED overlay pair. Overlays alias by definition
    (TR 25.084 (40)): memory at one location is visible through two
    names. This must NOT be marked noalias — output identical before/after P2. */
 alias_defined: PROCEDURE OPTIONS(MAIN);
    DECLARE (i, n, sum) FIXED BINARY(31);
    DECLARE base(1000) FIXED BINARY(31);
    DECLARE overlay(1000) FIXED BINARY(31) DEFINED base;

    n = 1000;
    DO i = 1 TO n;
      base(i) = i;
      overlay(i) = overlay(i) + 1;
    END;

    sum = 0;
    DO i = 1 TO n;
      sum = sum + base(i);
    END;

    PUT SKIP LIST(sum);
 END alias_defined;
