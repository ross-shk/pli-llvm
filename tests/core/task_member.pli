 /* rules (79),(82): CALL EVENT and WAIT accept an EVENT member ref;
    CALL TASK accepts a TASK member; EVENT(m) polls one. */
 task_member: procedure options(main);
    declare 1 st, 2 ev event, 2 tk task;
    declare counter fixed binary(31);
    counter = 0;
    call worker task(st.tk) event(st.ev);
    wait(st.ev);
    if counter = 1 then
       if event(st.ev) then
          put skip list('PASS');
       else
          put skip list('FAIL event poll');
    else
       put skip list('FAIL counter', counter);
    worker: procedure;
       counter = counter + 1;
    end worker;
 end task_member;
