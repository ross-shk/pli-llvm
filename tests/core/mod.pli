 /* MOD built-in function: mod(a, b) = a - b * floor(a/b); the result takes the
    sign of the divisor b. M2 arithmetic built-in (Y33-6003 MOD). */
 mod_test: procedure options(main);
    declare x fixed bin(31);
    declare y float dec(6);


    x = mod(7, 3);
    if x ^= 1 then do;
       put skip list('FAIL mod(7,3) =', x);
       stop;
    end;

    x = mod(-7, 3);   /* sign of the divisor b */
    if x ^= 2 then do;
       put skip list('FAIL mod(-7,3) =', x);
       stop;
    end;

    x = mod(10, 4);
    if x ^= 2 then do;
       put skip list('FAIL mod(10,4) =', x);
       stop;
    end;

    y = mod(7.5, 2.0);
    if y ^= 1.5 then do;
       put skip list('FAIL mod(7.5,2.0) =', y);
       stop;
    end;

   put skip list('PASS mod');
 end mod_test;
