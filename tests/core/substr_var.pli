 /* Variable-length SUBSTR (rules (86),(123)): substr(buf,1,n)
    with a runtime n slices exactly n bytes (clamped at zero);
    the live length rides a VARYING receiver, fixed receivers
    blank-pad; the pseudo-variable form writes through. */
 subvar: procedure options(main);
    declare buf char(64);
    declare v char(10) varying;
    declare n fixed bin(31);
    declare s char(64);
    declare vs char(64) varying;
    declare fails fixed bin(31);
    fails = 0;
    buf = 'hello';
    n = 5;
    vs = substr(buf, 1, n);
    if length(vs) ^= 5 then fails = fails + 1;
    if trim(vs) ^= 'hello' then fails = fails + 1;
    n = 0;
    vs = substr(buf, 1, n);
    if length(vs) ^= 0 then fails = fails + 1;
    n = 100;
    vs = substr(buf, 1, n);
    if length(vs) ^= 64 then fails = fails + 1;
    s = substr(buf, 1, 5);
    if trim(s) ^= 'hello' then fails = fails + 1;
    n = 5;
    s = substr(buf, 1, n);
    if trim(s) ^= 'hello' then fails = fails + 1;
    v = 'hi';
    n = 2;
    vs = substr(v, 1, n);
    if trim(vs) ^= 'hi' then fails = fails + 1;
    n = 2;
    substr(buf, 1, n) = 'XY';
    if substr(buf, 1, 2) ^= 'XY' then fails = fails + 1;
    if fails = 0 then put skip list('PASS subvar');
    else put skip list('FAIL subvar: fails =', fails);
 end subvar;
