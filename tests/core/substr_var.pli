 /* Variable-length SUBSTR (rules (86),(123)): substr(buf,1,n)
    with a runtime n slices exactly n bytes (clamped at zero);
    the live length rides a VARYING receiver, fixed receivers
    blank-pad; the pseudo-variable form writes through. */
 subvar: procedure options(main);
    declare buf char(64);
    declare v char(10) varying;
    declare n fixed bin(31);
    declare s char(64);
    declare vs char(64) varying;
    buf = 'hello';
    n = 5;
    vs = substr(buf, 1, n);
    if length(vs) ^= 5 then do;
       put skip list('FAIL substr_var: expected 5, got', length(vs));
       stop;
    end;
    if trim(vs) ^= 'hello' then do;
       put skip list('FAIL substr_var: expected hello, got', trim(vs));
       stop;
    end;
    n = 0;
    vs = substr(buf, 1, n);
    if length(vs) ^= 0 then do;
       put skip list('FAIL substr_var: expected 0, got', length(vs));
       stop;
    end;
    n = 100;
    vs = substr(buf, 1, n);
    if length(vs) ^= 64 then do;
       put skip list('FAIL substr_var: expected 64, got', length(vs));
       stop;
    end;
    s = substr(buf, 1, 5);
    if trim(s) ^= 'hello' then do;
       put skip list('FAIL substr_var: expected hello, got', trim(s));
       stop;
    end;
    n = 5;
    s = substr(buf, 1, n);
    if trim(s) ^= 'hello' then do;
       put skip list('FAIL substr_var: expected hello, got', trim(s));
       stop;
    end;
    v = 'hi';
    n = 2;
    vs = substr(v, 1, n);
    if trim(vs) ^= 'hi' then do;
       put skip list('FAIL substr_var: expected hi, got', trim(vs));
       stop;
    end;
    n = 2;
    substr(buf, 1, n) = 'XY';
    if substr(buf, 1, 2) ^= 'XY' then do;
       put skip list('FAIL substr_var: expected XY, got',
          substr(buf, 1, 2));
       stop;
    end;
    v = '';
    substr(v, 1, 5) = 'hello';
    if length(v) ^= 5 then do;
       put skip list('FAIL substr_var: expected 5, got', length(v));
       stop;
    end;
    if v ^= 'hello' then do;
       put skip list('FAIL substr_var: expected hello, got', v);
       stop;
    end;
    v = 'ab';
    substr(v, 4, 2) = 'cd';
    if length(v) ^= 5 then do;
       put skip list('FAIL substr_var: expected 5, got', length(v));
       stop;
    end;
    if v ^= 'ab cd' then do;
       put skip list('FAIL substr_var: expected ab cd, got', v);
       stop;
    end;
    v = 'abcdef';
    substr(v, 2, 2) = 'XY';
    if length(v) ^= 6 then do;
       put skip list('FAIL substr_var: expected 6, got', length(v));
       stop;
    end;
    if v ^= 'aXYdef' then do;
       put skip list('FAIL substr_var: expected aXYdef, got', v);
       stop;
    end;
    substr(v, 9, 2) = 'ZZ';
    if length(v) ^= 10 then do;
       put skip list('FAIL substr_var: expected 10, got', length(v));
       stop;
    end;
    if substr(v, 7, 2) ^= '  ' then do;
       put skip list('FAIL substr_var: expected   , got',
          substr(v, 7, 2));
       stop;
    end;
    if substr(v, 9, 2) ^= 'ZZ' then do;
       put skip list('FAIL substr_var: expected ZZ, got',
          substr(v, 9, 2));
       stop;
    end;
   put skip list('PASS subvar');
 end subvar;
