  /* Multi-axis '*' parameters (rules (12),
     (13),(34)): a parameter `x(*, 3)`
     takes its first-axis extent from the
     caller while later axes stay fixed;
     one hidden extent rides each call. */
  star_param_multi: procedure options(main);
     declare a(2, 3) fixed bin(31);
     declare b(4, 3) fixed bin(31);
     declare i fixed bin(31);
     declare j fixed bin(31);
     do i = 1 to 2;
        do j = 1 to 3;
           a(i, j) = i * 10 + j;
        end;
     end;
     do i = 1 to 4;
        do j = 1 to 3;
           b(i, j) = i * 10 + j;
        end;
     end;
     /* fixed actuals, different first
        axes: bounds follow the actual */
     call check2(a, 2);
     call check2(b, 4);
     /* write-through reaches caller */
     call bump2(a);
      if a(1, 1) ^= 12 then do;
         put skip list('FAIL star_param_multi: expected 12, got',
            a(1, 1));
         stop;
      end;
     if a(2, 3) ^= 24 then do;
        put skip list('FAIL star_param_multi: expected 24, got',
           a(2, 3));
        stop;
     end;
     /* dynamic actual carries its live
        first-axis extent */
     call dyn_wrap(4);
     /* forwarding keeps the live extent */
     if fwd2(b) ^= 4 then do;
        put skip list('FAIL star_param_multi: expected 4, got',
           fwd2(b));
        stop;
     end;
   put skip list('PASS star-param-multi');
  check2: procedure(x, k);
     declare x(*, 3) fixed bin(31);
     declare k fixed bin(31);
     declare i fixed bin(31);
     declare j fixed bin(31);
     if lbound(x, 1) ^= 1 then do;
        put skip list('FAIL star_param_multi: expected 1, got',
           lbound(x, 1));
        stop;
     end;
     if hbound(x, 1) ^= k then do;
        put skip list('FAIL star_param_multi: check at line 47 failed');
        stop;
     end;
     if lbound(x, 2) ^= 1 then do;
        put skip list('FAIL star_param_multi: expected 1, got',
           lbound(x, 2));
        stop;
     end;
     if hbound(x, 2) ^= 3 then do;
        put skip list('FAIL star_param_multi: expected 3, got',
           hbound(x, 2));
        stop;
     end;
     if dim(x) ^= k * 3 then do;
        put skip list('FAIL star_param_multi: check at line 50 failed');
        stop;
     end;
  end check2;
  dyn_wrap: procedure(k);
     declare k fixed bin(31);
     declare e(k, 3) fixed bin(31);
     declare i fixed bin(31);
     declare j fixed bin(31);
     do i = 1 to k;
        do j = 1 to 3;
           e(i, j) = i + j;
        end;
     end;
     call check2(e, k);
     if e(k, 3) ^= k + 3 then do;
        put skip list('FAIL star_param_multi: check at line 63 failed');
        stop;
     end;
  end dyn_wrap;
  bump2: procedure(x);
     declare x(*, 3) fixed bin(31);
     declare i fixed bin(31);
     declare j fixed bin(31);
     do i = 1 to hbound(x, 1);
        do j = 1 to 3;
           x(i, j) = x(i, j) + 1;
        end;
     end;
  end bump2;
  fwd2: procedure(xs) returns(fixed bin(31));
     declare xs(*, 3) fixed bin(31);
     return(hbound(xs, 1));
  end fwd2;
  end star_param_multi;
