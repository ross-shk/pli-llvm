  /* LIKE attribute (rule 43): a declaration item takes the structure shape of
     an already-declared structure variable, so its members are qualified like
     the template's. Covers a top-level copy and a nested (member) copy. */
  like_test: procedure options(main);
     declare 1 s,
            2 a fixed bin(31),
            2 b fixed bin(31);
     declare 1 t like s;

     s.a = 11;
     s.b = 22;

     /* t is a copy of s's structure: its members are set independently */
     t.a = 33;
     t.b = 44;
     if t.a ^= 33 or t.b ^= 44 then do;
        put skip list('FAIL like: check at line 20 failed');
        stop;
     end;
     if s.a ^= 11 or s.b ^= 22 then do;
        put skip list('FAIL like: check at line 21 failed');
        stop;
     end;

     /* identical shape, so whole-structure assignment works between them */
     t = s;
     if t.a ^= 11 or t.b ^= 22 then do;
        put skip list('FAIL like: check at line 25 failed');
        stop;
     end;

     /* LIKE as a nested (member) structure: 2 m like s inside 1 p */
     declare 1 p,
            2 m like s;
     p.m.a = 55;
     p.m.b = 66;
     if p.m.a ^= 55 or p.m.b ^= 66 then do;
        put skip list('FAIL like: check at line 32 failed');
        stop;
     end;

   put skip list('PASS like');
  end like_test;
