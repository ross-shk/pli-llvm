 /* Level-numbered structures (rules (11),(124),(125)): DECLARE 1 S, 2 A ..., 2 B ...
    declares a structure; S.A / S.B are qualified references to its scalar
    members, usable on both sides of an assignment. Minor (nested) structures
    like S.X.Y are served too. */
 struct_test: procedure options(main);
    declare 1 s,
           2 a fixed bin(31),
           2 b fixed bin(31),
           2 x,
             3 y fixed bin(31),
             3 z fixed bin(31);


    /* write via qualified references */
    s.a = 11;
    s.b = 22;
    s.x.y = 33;
    s.x.z = 44;

    /* read back */
    if s.a ^= 11 then do;
       put skip list('FAIL struct: expected 11, got', s.a);
       stop;
    end;
    if s.b ^= 22 then do;
       put skip list('FAIL struct: expected 22, got', s.b);
       stop;
    end;
    if s.x.y ^= 33 then do;
       put skip list('FAIL struct: expected 33, got', s.x.y);
       stop;
    end;
    if s.x.z ^= 44 then do;
       put skip list('FAIL struct: expected 44, got', s.x.z);
       stop;
    end;

    /* members in an arithmetic expression */
    s.b = s.a + s.x.y + 1;
    if s.b ^= 45 then do;
       put skip list('FAIL s.b =', s.b);
       stop;
    end;

   put skip list('PASS struct');
 end struct_test;
