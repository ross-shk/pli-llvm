  /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
  /* Rules (13),(23),(87)-(90),(123),(126): ALLOCATE bounds override
     the DECLARE bounds of a fixed 1-D CONTROLLED array (IBM
     Enterprise PL/I). Bare ALLOCATE uses the descriptor; ALLOCATE
     (n) pushes an n-element generation with the DECLARE lb kept;
     LIFO FREE restores the prior live bound. */
 fixed_override_test: procedure options(main);
   dcl i fixed bin(31);
   dcl s fixed bin(31);
   dcl fds(10) fixed bin(31) controlled;
   dcl b(0:9) fixed bin(31) controlled;
   /* bare ALLOCATE keeps the descriptor bounds */
   allocate fds;
   if hbound(fds) ^= 10 then do;
      put skip list('FAIL controlled_fixed_override: expected 10, got',
         hbound(fds));
      stop;
   end;
   if lbound(fds) ^= 1 then do;
      put skip list('FAIL controlled_fixed_override: expected 1, got',
         lbound(fds));
      stop;
   end;
   if dim(fds) ^= 10 then do;
      put skip list('FAIL controlled_fixed_override: expected 10, got',
         dim(fds));
      stop;
   end;
   fds(10) = 100;
   if fds(10) ^= 100 then do;
      put skip list('FAIL controlled_fixed_override: expected 100, got',
         fds(10));
      stop;
   end;
   /* override smaller: live bound follows the ALLOCATE */
   allocate fds (5);
   if hbound(fds) ^= 5 then do;
      put skip list('FAIL controlled_fixed_override: expected 5, got',
         hbound(fds));
      stop;
   end;
   if dim(fds) ^= 5 then do;
      put skip list('FAIL controlled_fixed_override: expected 5, got',
         dim(fds));
      stop;
   end;
   do i = 1 to 5;
     fds(i) = i * 10;
   end;
   s = 0;
   do i = 1 to 5;
     s = s + fds(i);
   end;
   if s ^= 150 then do;
      put skip list('FAIL controlled_fixed_override: expected 150, got',
         s);
      stop;
   end;
   free fds;
   /* LIFO pops back to the descriptor-sized generation */
   if hbound(fds) ^= 10 then do;
      put skip list('FAIL controlled_fixed_override: expected 10, got',
         hbound(fds));
      stop;
   end;
   if fds(10) ^= 100 then do;
      put skip list('FAIL controlled_fixed_override: expected 100, got',
         fds(10));
      stop;
   end;
   free fds;
   /* override larger than declared: no static reject */
   allocate fds (12);
   fds(12) = 42;
   if fds(12) ^= 42 then do;
      put skip list('FAIL controlled_fixed_override: expected 42, got',
         fds(12));
      stop;
   end;
   if hbound(fds) ^= 12 then do;
      put skip list('FAIL controlled_fixed_override: expected 12, got',
         hbound(fds));
      stop;
   end;
   free fds;
   /* lb:ub DECLARE keeps its lb across the override */
   allocate b;
   if lbound(b) ^= 0 then do;
      put skip list('FAIL controlled_fixed_override: expected 0, got',
         lbound(b));
      stop;
   end;
   if hbound(b) ^= 9 then do;
      put skip list('FAIL controlled_fixed_override: expected 9, got',
         hbound(b));
      stop;
   end;
   b(0) = 7;
   allocate b (5);
   if lbound(b) ^= 0 then do;
      put skip list('FAIL controlled_fixed_override: expected 0, got',
         lbound(b));
      stop;
   end;
   if hbound(b) ^= 4 then do;
      put skip list('FAIL controlled_fixed_override: expected 4, got',
         hbound(b));
      stop;
   end;
   b(4) = 9;
   if b(4) ^= 9 then do;
      put skip list('FAIL controlled_fixed_override: expected 9, got',
         b(4));
      stop;
   end;
   free b;
   free b;
   put skip list('PASS fixed_override');
 end fixed_override_test;
