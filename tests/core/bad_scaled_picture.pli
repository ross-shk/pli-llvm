 /* A PICTURE formatter works in decimal (val*10^-scale), so a scaled
    FIXED BINARY would print its stored integer against a decimal point
    (2.5 became 0.00). Diagnose it instead, rule (53), ADR-282. */
 badscaledpic: procedure options(main);
    declare b fixed bin(15,2);
    b = 2.5;
    put skip edit (b) (p('ZZ9.99'));
 end badscaledpic;
