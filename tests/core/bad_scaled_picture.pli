 /* A scaled FIXED BINARY picture is served (ADR-288). More than 18
    fractional positions exceed the formatter's 64-bit decimal value,
    so that picture keeps the rule (53) diagnostic. */
 badscaledpic: procedure options(main);
    declare b fixed bin(15,2);
    b = 2.5;
    put skip edit (b) (p('9.9999999999999999999'));
 end badscaledpic;
