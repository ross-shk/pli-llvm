 /* Fixed-size 1-D arrays (rules (12),(13),(126)): DECLARE A(n) declares an
    array with bounds 1..n; A(i) is a subscripted reference usable on both
    sides of an assignment, with a constant or a runtime index. */
 array_test: procedure options(main);
    declare a(5) fixed bin(31);
    declare i fixed bin(31);


    /* write via constant subscripts */
    a(1) = 10;
    a(5) = 50;

    /* read via constant subscripts */
    if a(1) ^= 10 then do;
       put skip list('FAIL a(1) =', a(1));
       stop;
    end;
    if a(5) ^= 50 then do;
       put skip list('FAIL a(5) =', a(5));
       stop;
    end;

    /* fill and read back with a runtime-variable subscript */
    do i = 1 to 5;
       a(i) = i * 10;
    end;
    do i = 1 to 5;
       if a(i) ^= i * 10 then do;
          put skip list('FAIL a(i) at i =', i);
          stop;
       end;
    end;

    /* array element in an arithmetic expression */
    a(3) = a(1) + a(2) + 7;
    if a(3) ^= 37 then do;
       put skip list('FAIL a(3) =', a(3));
       stop;
    end;

   put skip list('PASS array');
 end array_test;
