 /* An exact decimal ROUND (ADR-276): a FIXED DECIMAL argument rounded to a
    constant digit count keeps its exactness — the result is a decimal with
    that scale, rounded half away from zero. A FLOAT argument or a runtime
    digit count is the library's float rounding. Rules (123), QR2.2. */
 round_decimal: procedure options(main);
   declare w decimal(20,4);
   declare z decimal(9,4);
   declare neg decimal(9,4);
   declare r decimal(20,2);
   declare s decimal(9,2);
   declare t decimal(9,1);
   declare cnt fixed bin(31);


   /* A wide decimal: the exact answer keeps every digit. */
   w = 1234567890123456.7891;
   r = round(w, 2);
   if r ^= 1234567890123456.79 then do;
      put skip list('FAIL round_decimal: check at line 22 failed');
      stop;
   end;

   /* Half away from zero, in both directions. */
   z = 2.6750;
   s = round(z, 2);
   if s ^= 2.68 then do;
      put skip list('FAIL round_decimal: expected 2.68, got', s);
      stop;
   end;
   neg = -2.6750;
   s = round(neg, 2);
   if s ^= -2.68 then do;
      put skip list('FAIL round_decimal: expected -2.68, got', s);
      stop;
   end;

   /* The result carries the requested scale. */
   t = round(z, 1);
   if t ^= 2.7 then do;
      put skip list('FAIL round_decimal: expected 2.7, got', t);
      stop;
   end;

   /* A runtime digit count is the float path. */
   cnt = 2;
   put skip list('rt =', round(z, cnt));

   /* The table: the scale of each result is visible here. */
   put skip list('r =', r);
   put skip list('s =', s);
   put skip list('t =', t);

   put skip list('PASS round_decimal');
 end round_decimal;
