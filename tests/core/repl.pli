 /* Replicated string constants (rule (129)): (n)'str' repeats the string
    n times to form a character-string constant. */
 repl_test: procedure options(main);
    declare s char(6);
    declare fails fixed bin(31);

    fails = 0;

    s = (3)'AB';
    if s ^= 'ABABAB' then do;
       fails = fails + 1;
       put skip list('FAIL repl char =', s);
    end;

    s = (2)'XY' || '!';
    if s ^= 'XYXY!' then do;
       fails = fails + 1;
       put skip list('FAIL repl concat =', s);
    end;

    s = (1)'Q';
    if s ^= 'Q' then do;
       fails = fails + 1;
       put skip list('FAIL repl one =', s);
    end;

    if fails = 0 then put skip list('PASS repl');
    else put skip list('FAIL repl: fails =', fails);
 end repl_test;
