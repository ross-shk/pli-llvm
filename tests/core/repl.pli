 /* Replicated string constants (rule (129)): (n)'str' repeats the string
    n times to form a character-string constant. */
 repl_test: procedure options(main);
    declare s char(6);


    s = (3)'AB';
    if s ^= 'ABABAB' then do;
       put skip list('FAIL repl char =', s);
       stop;
    end;

    s = (2)'XY' || '!';
    if s ^= 'XYXY!' then do;
       put skip list('FAIL repl concat =', s);
       stop;
    end;

    s = (1)'Q';
    if s ^= 'Q' then do;
       put skip list('FAIL repl one =', s);
       stop;
    end;

   put skip list('PASS repl');
 end repl_test;
