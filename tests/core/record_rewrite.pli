 /* rule (112): standalone sequential REWRITE - overwrite the current record. */
 record_rewrite: procedure options(main);
    declare f file;
    declare rec fixed binary(31);
    declare i fixed binary(31);

    open file(f) record sequential output
       title('tests/core/out/record_rewrite.dat');
    do i = 1 to 3;
       write file(f) from(i);
    end;
    close file(f);

    open file(f) record sequential update
       title('tests/core/out/record_rewrite.dat');
    read file(f) into(rec);          /* current record = 1 */
    if rec ^= 1 then do;
       put skip list('FAIL read1 got', rec);
       stop;
    end;
    rewrite file(f) from(10);        /* overwrite record 1 with 10 */
    read file(f) into(rec);          /* record 2 */
    if rec ^= 2 then do;
       put skip list('FAIL read2 got', rec);
       stop;
    end;
    close file(f);

    open file(f) record sequential input
       title('tests/core/out/record_rewrite.dat');
    read file(f) into(rec);
    if rec ^= 10 then do;
       put skip list('FAIL rewrite got', rec);
       stop;
    end;
    read file(f) into(rec);
    if rec ^= 2 then do;
       put skip list('FAIL tail got', rec);
       stop;
    end;
    close file(f);
    put skip list('PASS record_rewrite');
 end record_rewrite;
