/* A CHARACTER VARYING argument passed to a VARYING parameter of a
    different declared length is marshalled through a copy, but the
    callee's writes (growth inside the procedure) copy back to the
    caller, clamped to the caller's own capacity. */
  varg: procedure options(main);
    declare body char(8) varying;
    declare wide char(32) varying;

    body = '';
    call grow(body);
    if length(body) ^= 8 then do;
       put skip list('FAIL varying_param: expected 8, got',
          length(body));
       stop;
    end;
    if substr(body, 1, 8) ^= 'hello wo' then do;
       put skip list('FAIL varying_param: expected hello wo, got',
          substr(body, 1, 8));
       stop;
    end;

    wide = '';
    call grow(wide);
    if length(wide) ^= 11 then do;
       put skip list('FAIL varying_param: expected 11, got',
          length(wide));
       stop;
    end;
    if wide ^= 'hello world' then do;
       put skip list('FAIL varying_param: expected hello world, got',
          wide);
       stop;
    end;

   put skip list('PASS varying_param');
  end varg;

  grow: procedure(buf);
    declare buf char(4096) varying;
    buf = buf || 'hello';
    buf = buf || ' world';
  end grow;
