 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* Scaled FIXED BINARY(p,q): the stored integer holds the value scaled
    by 2^q (ADR-006). A scale-2 variable assigned 5 stores 20; + and -
    rescale to the larger scale, * sums the scales, FLOAT conversion
    divides by 2^q, and list-directed output prints the point. This is a
    conformance change (ADR-282): the old test pinned the unscaled
    model.
    TR 25.084 rules (16),(17). */
 scaled: procedure options(main);
    declare a fixed bin(15,2);
    declare b fixed bin(15,2);
    declare c fixed bin(15,4);
    declare d fixed bin(15,0);
    declare p fixed bin(15,2);
    declare araw fixed bin(15,0) defined a;
    declare craw fixed bin(15,0) defined c;
    declare praw fixed bin(15,0) defined p;
    declare i fixed bin(15,2) initial(5);
    declare iraw fixed bin(15,0) defined i;
    declare v fixed bin(15,2) value(2.5);
    declare f float decimal(6);
    declare fails fixed bin(31);

    fails = 0;

    /* A scale-2 target stores value*4: 5 -> 20. */
    a = 5;
    if araw ^= 20 then do;
       fails = fails + 1;
       put skip list('FAIL a=5 raw', araw);
    end;
    f = a;
    if abs(f - 5.0) > 1e-9 then do;
       fails = fails + 1;
       put skip list('FAIL a=5 float', f);
    end;

    /* A decimal literal keeps its fraction in the binary scale. */
    a = 2.5;
    if araw ^= 10 then do;
       fails = fails + 1;
       put skip list('FAIL a=2.5 raw', araw);
    end;
    f = a;
    if abs(f - 2.5) > 1e-9 then do;
       fails = fails + 1;
       put skip list('FAIL a=2.5 float', f);
    end;

    /* A negative literal is stored and read back with its sign. */
    a = -2.5;
    if araw ^= -10 then do;
       fails = fails + 1;
       put skip list('FAIL a=-2.5 raw', araw);
    end;
    f = a;
    if abs(f + 2.5) > 1e-9 then do;
       fails = fails + 1;
       put skip list('FAIL a=-2.5 float', f);
    end;

    /* FLOAT -> FIXED multiplies by 2^q; FIXED -> FLOAT divides. */
    a = 1.5e0;
    if araw ^= 6 then do;
       fails = fails + 1;
       put skip list('FAIL a=1.5e0 raw', araw);
    end;

    /* Mixed scales: + and - rescale to the larger scale. */
    b = 1.0e0;
    p = a + b;
    if praw ^= 10 then do;
       fails = fails + 1;
       put skip list('FAIL a+b raw', praw);
    end;
    d = 2;
    p = a - d;
    if praw ^= -2 then do;
       fails = fails + 1;
       put skip list('FAIL a-d raw', praw);
    end;

    /* Multiplication: the product scale is the sum of the scales. */
    a = 1.5;
    b = 2.5;
    c = a * b;
    if craw ^= 60 then do;
       fails = fails + 1;
       put skip list('FAIL a*b raw', craw);
    end;
    p = a * b;
    if praw ^= 15 then do;
       fails = fails + 1;
       put skip list('FAIL product raw', praw);
    end;
    f = c;
    if abs(f - 3.75) > 1e-9 then do;
       fails = fails + 1;
       put skip list('FAIL product float', f);
    end;

    /* Comparison rescales across scales. */
    a = 1.5e0;
    d = 1;
    if a <= d then do;
       fails = fails + 1;
       put skip list('FAIL 1.5 <= 1');
    end;
    if a ^= 1.5e0 then do;
       fails = fails + 1;
       put skip list('FAIL 1.5 = 1.5');
    end;
    d = 2;
    if a >= d then do;
       fails = fails + 1;
       put skip list('FAIL 1.5 >= 2');
    end;

    /* INITIAL and VALUE constants use the same scaling. */
    if iraw ^= 20 then do;
       fails = fails + 1;
       put skip list('FAIL initial raw', iraw);
    end;
    f = i;
    if abs(f - 5.0) > 1e-9 then do;
       fails = fails + 1;
       put skip list('FAIL initial float', f);
    end;
    f = v;
    if abs(f - 2.5) > 1e-9 then do;
       fails = fails + 1;
       put skip list('FAIL value float', f);
    end;

    /* List-directed output prints the point. */
    a = 2.5;
    put skip list('scaled a =', a);
    p = a * b;
    put skip list('product p =', p);

    if fails = 0 then
       put skip list('PASS');
    else
       put skip list('FAILED checks:', fails);
 end scaled;
