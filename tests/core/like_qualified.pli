 /* LIKE with a qualified template (rule 43): the declared item takes
    the shape of a minor structure of an already-declared structure,
    narrowing to any depth; the copy owns independent storage. */
 like_qualified: procedure options(main);
    declare 1 s,
           2 a fixed bin(31),
           2 g,
            3 x fixed bin(31),
            3 y fixed bin(31),
           2 h,
            3 k,
             4 v fixed bin(31);
    declare 1 t like s.g;
    declare 1 u like s.h.k;
    declare 1 p,
           2 m like s.g;

    s.g.x = 1;
    s.g.y = 2;
    /* narrowed copies expose the minor structure's members */
    t.x = 7;
    t.y = 8;
    if t.x ^= 7 or t.y ^= 8 then do;
       put skip list('FAIL like_qualified: check at line 27 failed');
       stop;
    end;
    u.v = 9;
    if u.v ^= 9 then do;
       put skip list('FAIL like_qualified: expected 9, got', u.v);
       stop;
    end;
    /* independent storage: the template is untouched */
    if s.g.x ^= 1 or s.g.y ^= 2 then do;
       put skip list('FAIL like_qualified: check at line 31 failed');
       stop;
    end;
    /* nested LIKE of a qualified template */
    p.m.x = 5;
    p.m.y = 6;
    if p.m.x ^= 5 or p.m.y ^= 6 then do;
       put skip list('FAIL like_qualified: check at line 35 failed');
       stop;
    end;
    /* the same narrowed shape assigns whole */
    t = s.g;
    if t.x ^= 1 or t.y ^= 2 then do;
       put skip list('FAIL like_qualified: check at line 38 failed');
       stop;
    end;

   put skip list('PASS like qualified');
 end like_qualified;
