 /* Copyright 2026 Ross S. - plic: a PL/I compiler targeting LLVM */
 /* ADR-171 (IBM ENTRY VARIABLE extension): a procedure value is
    stored in a variable and called indirectly. Exercises assignment
    from a procedure name, reassignment, indirect CALL, indirect
    function reference, and passing entry values (a variable or a
    procedure name) to a dispatcher whose parameter is an ENTRY
    variable, including a varying-CHARACTER signature with write-back.
    Callbacks are top-level so they carry no static link. */
 entry_var: procedure options(main);
   dcl shared  fixed bin(31) external;
   dcl fails   fixed bin(31) init(0);
   dcl on_ping entry (fixed bin(31)) variable;
   dcl on_get  entry (fixed bin(31)) returns (fixed bin(31)) variable;
   dcl on_txt  entry (pointer, char(16) varying) variable;

   /* assign a procedure name then CALL through the entry variable */
   shared = 0;
   on_ping = ping;
   call on_ping(7);
   if shared ^= 7 then fails = fails + 1;

   /* an indirect function reference */
   on_get = add1;
   if on_get(41) ^= 42 then fails = fails + 1;

   /* reassign to a different procedure */
   on_get = dbl;
   if on_get(21) ^= 42 then fails = fails + 1;

   /* pass an entry variable and a procedure name to a dispatcher */
   on_get = add1;
   if dispatch(on_get) ^= 42 then fails = fails + 1;
   if dispatch(add1) ^= 42 then fails = fails + 1;
   if apply(on_get, 41) ^= 42 then fails = fails + 1;

   /* a varying-CHAR callback writes back through the arg */
   on_txt = wants;
   if tdispatch(on_txt) ^= 42 then fails = fails + 1;

   if fails = 0 then put skip list('PASS entry_var');
   else put skip list('FAIL entry_var: fails =', fails);

 dispatch: procedure (cb) returns (fixed bin(31));
   dcl cb entry (fixed bin(31)) returns (fixed bin(31)) variable;
   return (cb(41));
 end dispatch;

 apply: procedure (cb, v) returns (fixed bin(31));
   dcl cb entry (fixed bin(31)) returns (fixed bin(31)) variable;
   dcl v fixed bin(31);
   return (cb(v));
 end apply;

 tdispatch: procedure (cb) returns (fixed bin(31));
   dcl cb entry (pointer, char(16) varying) variable;
   dcl s char(16) varying;
   s = 'abc';
   call cb(null(), s);
   if s = 'xyz' then return (42);
   return (0);
 end tdispatch;

 end entry_var;

 ping: procedure (n);
   dcl n fixed bin(31);
   dcl shared fixed bin(31) external;
   shared = n;
 end ping;

 add1: procedure (n) returns (fixed bin(31));
   dcl n fixed bin(31);
   return (n + 1);
 end add1;

 dbl: procedure (n) returns (fixed bin(31));
   dcl n fixed bin(31);
   return (n + n);
 end dbl;

 wants: procedure (p, s);
   dcl p pointer;
   dcl s char(16) varying;
   s = 'xyz';
 end wants;
