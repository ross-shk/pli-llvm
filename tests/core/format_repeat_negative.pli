/* Format iteration (rule (47)): negative repetition count skips the group. */
format_repeat_negative: procedure options(main);
    declare buf char(40);
    declare a fixed bin(31);
    declare c fixed bin(31);

    /* Negative count skips the format group. */
    a = 2;
    put string(buf) edit(a) ((-1)(f(4)), f(4));
    get string(buf) edit(c) (f(4));
    if c ^= 2 then do;
        put skip list('FAIL negative count', c);
        stop;
    end;

    /* Variable negative count skips. */
    declare n fixed bin(31) init(-2);
    a = 3;
    put string(buf) edit(a) ((n)(f(4)), f(4));
    get string(buf) edit(c) (f(4));
    if c ^= 3 then do;
        put skip list('FAIL variable negative count', c);
        stop;
    end;

    put skip list('PASS format_repeat_negative');
end format_repeat_negative;