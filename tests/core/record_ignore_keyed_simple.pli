/* rule (113): KEYED IGNORE option — simple test matching keyed_record style */

record_ignore_keyed_simple: procedure options(main);
  declare f file;
  declare rk char(8);
  declare rec fixed binary(31);
  declare i fixed binary(31);

  /* Phase 1: write five records by KEY; OUTPUT creates the file. */
  open file(f) record keyed output
     title('tests/core/out/record_ignore_keyed_simple.dat');
  do i = 1 to 5;
    rk = 'K' || i;  /* 'K1', 'K2', etc. padded to 8 chars */
    rec = i * 10;
    write file(f) from(rec) key(rk);
  end;
  close file(f);

  /* Phase 2: read first record by KEY */
  open file(f) record keyed input
     title('tests/core/out/record_ignore_keyed_simple.dat');
  rk = 'K1';
  read file(f) into(rec) key(rk);
  put skip list('first=' || rec);

  /* Phase 3: skip 2 records using IGNORE without KEY */
  read file(f) ignore(2) into(rec);
  put skip list('after ignore(2)=' || rec);

  close file(f);
  put skip list('PASS');
end record_ignore_keyed_simple;