/* Rule (119): non-character operands in || are implicitly converted to
   CHAR(24) before concatenation, mirroring the CHAR builtin. Numeric
   operands are placed at the end so trim() can strip trailing blanks.
   Note: 3.5 is a FIXED DECIMAL literal (rule 135); use a FLOAT variable
   to exercise the pli_char_of_float path. */
 concat_mixed: procedure options(main);
   declare fails fixed bin(31);
   declare f float(6);
   fails = 0;
   if trim('port:' || 8080) ^= 'port:8080' then fails = fails + 1;
   if trim('v=' || 5) ^= 'v=5' then fails = fails + 1;
   f = 3.5;
   if trim('x' || f) ^= 'x3.5' then fails = fails + 1;
   /* 'a' || 1 || 2: 1 and 2 each produce 24-char blank-padded images.
      The interior blanks are not stripped by trim(), so verify the
      '2' lands at position 26 (1 + 24 + 1). */
   if index('a' || 1 || 2, '2') ^= 26 then fails = fails + 1;
   /* char-only concat is unchanged (no conversion overhead): */
   if trim('ab' || 'cd' || 'ef') ^= 'abcdef' then fails = fails + 1;
   if fails = 0 then put skip list('PASS concat_mixed');
   else put skip list('FAIL concat_mixed: fails =', fails);
 end concat_mixed;
