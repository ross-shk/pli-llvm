 /* WS-D1 (ADR-245): the PL/I string padding invariant — the declared
    extent is the whole value. A store writes no byte outside the
    declared extent, and a fetch reads no byte outside it. So two
    adjacent strings do not disturb each other, a substring of a CHAR(3)
    is the three characters it names (not a blank-padded eight), and a
    BIT(n) carries no bit above n. */
 string_padding: procedure options(main);
   declare a char(3);
   declare b char(3);
   declare s char(8);
   declare 1 rec,
            2 x char(3),
            2 y char(3);
   declare bits bit(9);
   declare v fixed bin(31);

   /* two adjacent strings: the second store must not touch the first */
   a = 'abc';
   b = 'xyz';
   put skip list('a=', a, 'b=', b);

   /* a substring is exactly the characters it names */
   s = 'hello';
   put skip list('sub=', substr(s, 2, 3));

   /* a string inside a structure, likewise */
   rec.x = 'one';
   rec.y = 'two';
   put skip list('x=', rec.x, 'y=', rec.y);

   /* a BIT(n) is ceil(n/8) bytes and the bits above n are zero */
   bits = '101010101'B;
   v = bits;
   put skip list('bits=', v);
 end string_padding;
