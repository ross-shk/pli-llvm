 /* Rules (22),(88),(124): declaring an array of OFFSET does not make
    the whole array a SET target or a `->` locator, a heap SET of an
    OFFSET needs an IN area, an OFFSET element cannot qualify a
    non-BASED name, and the area association is still checked. Each
    statement must fail with its rule cite. */
 bad_offset_array: procedure options(main);
   dcl region area(4096);
   dcl n fixed bin(31);
   dcl prec offset(region);
   dcl slots(2) offset(region);
   dcl after offset(region);
   dcl heap offset;               /* no area association */
   dcl nosuch(2) offset(n);       /* n is not an AREA (22) */
   dcl 1 rec based(prec),
       2 v fixed bin(31);
   allocate rec in(region) set(slots);  /* whole array (88) */
   allocate rec set(heap);              /* OFFSET needs IN (88) */
   n = slots -> rec.v;                  /* whole array (124) */
   after = offsetadd(slots, 4);         /* whole array (22) */
   n = slots(1) -> n;                   /* n is not BASED (124) */
 end bad_offset_array;
