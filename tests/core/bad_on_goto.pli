/* rule (77): a GO TO inside an ON-unit to a label that does not exist
   in this procedure is still diagnosed. */
bad_on_goto: procedure options(main);
   declare i fixed bin(31) init(0);
   on zerodivide begin;
      i = 1;
      goto nowhere;
   end;
   signal zerodivide;
   put skip list('i=', i);
 end bad_on_goto;
