 /* AREA is a storage attribute (rule (20)): it cannot be combined
    with a computational attribute, nor can AREA and OFFSET coexist. */
 bad_area_attr: procedure options(main);
   dcl a fixed bin(31) area;
   dcl b area offset;
 end bad_area_attr;
