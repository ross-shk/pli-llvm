 /* General iSUB index arithmetic (rule 134): the iSUB dummy may appear in an
    affine base subscript `m * 1SUB + c`. Y(i) is then a live overlay of
    X(m*i + c) — a strided or offset 1-D view of one axis of X. Writes through
    the overlay are visible in the base and vice versa. */
 isub_arith_test: procedure options(main);
    declare a(10) fixed bin(31);
    declare r(5) fixed bin(31) defined a(2*1SUB);      /* r(i) -> a(2*i) */
    declare b(10) fixed bin(31);
    declare s(8) fixed bin(31) defined b(1SUB+2);      /* s(i) -> b(i+2) */
    declare c(10) fixed bin(31);
    declare t(4) fixed bin(31) defined c(2*1SUB-1);    /* t(i) -> c(2*i-1) */


    /* base -> strided overlay */
    do i = 1 to 10;
       a(i) = i * 10;
    end;
    do i = 1 to 5;
       if r(i) ^= i * 20 then do;
          put skip list('FAIL isub_arith: check at line 23 failed');
          stop;
       end;
    end;
    r(3) = 999;                       /* write through the strided overlay */
    if a(6) ^= 999 then do;
       put skip list('FAIL isub_arith: expected 999, got', a(6));
       stop;
    end;

    /* offset overlay */
    do i = 1 to 10;
       b(i) = i;
    end;
    do i = 1 to 8;
       if s(i) ^= i + 2 then do;
          put skip list('FAIL isub_arith: check at line 33 failed');
          stop;
       end;
    end;
    s(1) = 100;
    if b(3) ^= 100 then do;
       put skip list('FAIL isub_arith: expected 100, got', b(3));
       stop;
    end;

    /* combined multiplier + offset */
    do i = 1 to 10;
       c(i) = i;
    end;
    do i = 1 to 4;
       if t(i) ^= 2 * i - 1 then do;
          put skip list('FAIL isub_arith: check at line 43 failed');
          stop;
       end;
    end;
    t(2) = 77;
    if c(3) ^= 77 then do;
       put skip list('FAIL isub_arith: expected 77, got', c(3));
       stop;
    end;

   put skip list('PASS isub_arith');
 end isub_arith_test;
