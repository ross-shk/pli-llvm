/* rule (101): BACKWARDS requires RECORD SEQUENTIAL INPUT. */
bad_open_backwards_invalid: procedure options(main);
    declare f file;
    open file(f) title('test.dat') output record sequential backwards;
end bad_open_backwards_invalid;