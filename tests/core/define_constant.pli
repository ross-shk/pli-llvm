  /* extension (ADR-205): DEFINE CONSTANT declares a
     named constant usable in expressions and bounds;
     reassignment is diagnosed. */
  constdemo: procedure options(main);
     define constant max 100;
     define constant pi 3.14;
     define constant tag 'pli';
     define constant yes '1'b;
     define constant neg -7;
     declare total fixed bin(31);
     declare xd fixed dec(5, 2);
     declare x float;
     declare t(max) fixed bin(31);
     declare f fixed bin(31);
     f = 0;
     total = max + 1;
     if total ^= 101 then do;
        f = f + 1;
        put skip list('FAIL total', total);
     end;
     total = max * 2 + neg;
     if total ^= 193 then do;
        f = f + 1;
        put skip list('FAIL expr', total);
     end;
     xd = pi;
     if xd ^= 3.14 then do;
        f = f + 1;
        put skip list('FAIL dec', xd);
     end;
     x = pi;
     if x ^= 3.14 then do;
        f = f + 1;
        put skip list('FAIL float', x);
     end;
     if tag ^= 'pli' then do;
        f = f + 1;
        put skip list('FAIL tag', tag);
     end;
     if yes ^= '1'b then do;
        f = f + 1;
        put skip list('FAIL bit', yes);
     end;
     if neg ^= -7 then do;
        f = f + 1;
        put skip list('FAIL neg', neg);
     end;
     if hbound(t) ^= 100 then do;
        f = f + 1;
        put skip list('FAIL bound', hbound(t));
     end;
     if f = 0 then put skip list('PASS define-constant');
     else put skip list('FAIL define-constant: ', f);
  end constdemo;
