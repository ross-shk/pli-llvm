 /* INITIAL on a structure with a trailing dynamic
    member (rules (13),(26)): the flat itemlist fills
    scalar leaves first, then one buffer element per
    remaining value; it re-runs on every activation and
    each variable keeps its own buffer. Bounds come from
    parameters (the entry-time value extents read). */
 struct_dyn_init_test: procedure options(main);
    call check(4);
    call short(3);
    call twice(4);
    call twice(4);
   put skip list('PASS struct_dyn_init');
 check: procedure(n);
    declare n fixed bin(31);
    declare 1 s init(7, 10, 20, 30, 40),
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    declare 1 t init(1, (2)(5, 6)),
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    if s.a ^= 7 then do;
       put skip list('FAIL struct_dyn_init: expected 7, got', s.a);
       stop;
    end;
    if s.v(1) ^= 10 then do;
       put skip list('FAIL struct_dyn_init: expected 10, got', s.v(1));
       stop;
    end;
    if s.v(4) ^= 40 then do;
       put skip list('FAIL struct_dyn_init: expected 40, got', s.v(4));
       stop;
    end;
    if lbound(s.v) ^= 1 then do;
       put skip list('FAIL struct_dyn_init: expected 1, got',
          lbound(s.v));
       stop;
    end;
    if hbound(s.v) ^= n then do;
       put skip list('FAIL struct_dyn_init: check at line 31 failed');
       stop;
    end;
    if dim(s.v) ^= n then do;
       put skip list('FAIL struct_dyn_init: check at line 32 failed');
       stop;
    end;
    if sum(s.v) ^= 100 then do;
       put skip list('FAIL struct_dyn_init: expected 100, got',
          sum(s.v));
       stop;
    end;
    /* iteration factors flatten before the split */
    if t.a ^= 1 then do;
       put skip list('FAIL struct_dyn_init: expected 1, got', t.a);
       stop;
    end;
    if t.v(3) ^= 5 then do;
       put skip list('FAIL struct_dyn_init: expected 5, got', t.v(3));
       stop;
    end;
    if sum(t.v) ^= 22 then do;
       put skip list('FAIL struct_dyn_init: expected 22, got',
          sum(t.v));
       stop;
    end;
    /* separate buffers: dirtying one spares the other */
    s.v(1) = 111;
    if t.v(1) ^= 5 then do;
       put skip list('FAIL struct_dyn_init: expected 5, got', t.v(1));
       stop;
    end;
 end check;
 short: procedure(n);
    declare n fixed bin(31);
    declare 1 s init(7, 10, 20),
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    if s.a ^= 7 then do;
       put skip list('FAIL struct_dyn_init: expected 7, got', s.a);
       stop;
    end;
    if s.v(1) ^= 10 then do;
       put skip list('FAIL struct_dyn_init: expected 10, got', s.v(1));
       stop;
    end;
    if s.v(2) ^= 20 then do;
       put skip list('FAIL struct_dyn_init: expected 20, got', s.v(2));
       stop;
    end;
 end short;
 twice: procedure(n);
    declare n fixed bin(31);
    declare 1 s init(7, 10, 20, 30, 40),
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    if s.v(1) ^= 10 then do;
       put skip list('FAIL struct_dyn_init: expected 10, got', s.v(1));
       stop;
    end;
    s.v(1) = 0;
 end twice;
 end struct_dyn_init_test;
