   /* rules (15),(26),(87)-(90): a scalar CONTROLLED INITIAL value is assigned
      with each allocation — the implicit entry generation and every explicit
      ALLOCATE — so a popped generation re-exposes the initial value. */
   controlled_init_scalar_test: procedure options(main);
      declare a fixed bin(31) controlled initial(5);

      /* the implicit entry generation holds the initial value */
      if a ^= 5 then do;
         put skip list('FAIL controlled_init_scalar: expected 5, got',
            a);
         stop;
      end;
      /* an explicit ALLOCATE re-initialises the fresh generation */
      allocate a;
      if a ^= 5 then do;
         put skip list('FAIL controlled_init_scalar: expected 5, got',
            a);
         stop;
      end;
      a = 9;
      if a ^= 9 then do;
         put skip list('FAIL controlled_init_scalar: expected 9, got',
            a);
         stop;
      end;
      /* popping re-exposes the lower generation's initial value */
      free a;
      if a ^= 5 then do;
         put skip list('FAIL controlled_init_scalar: expected 5, got',
            a);
         stop;
      end;

   put skip list('PASS controlled_init_scalar');
   end controlled_init_scalar_test;
