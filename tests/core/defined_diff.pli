 /* DEFINED (rule 24): a different-type overlay with the same storage
    size shares the base's memory; writes through either name show
    through the other. */
 defined_diff: procedure options(main);
    declare x fixed bin(31);
    declare y fixed dec(9) defined x;
    declare fails fixed bin(31);
    fails = 0;
    x = 12345;
    if y ^= 12345 then fails = fails + 1;
    y = 99;
    if x ^= 99 then fails = fails + 1;
    if fails = 0 then put skip list('PASS defined diff');
    else put skip list('FAIL defined diff: fails =', fails);
 end defined_diff;
