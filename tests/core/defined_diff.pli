 /* DEFINED (rule 24): a different-type overlay with the same storage
    size shares the base's memory; writes through either name show
    through the other. */
 defined_diff: procedure options(main);
    declare x fixed bin(31);
    declare y fixed dec(9) defined x;
    x = 12345;
    if y ^= 12345 then do;
       put skip list('FAIL defined_diff: expected 12345, got', y);
       stop;
    end;
    y = 99;
    if x ^= 99 then do;
       put skip list('FAIL defined_diff: expected 99, got', x);
       stop;
    end;
   put skip list('PASS defined diff');
 end defined_diff;
