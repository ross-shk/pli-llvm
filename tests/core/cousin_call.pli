 /* extension (ADR-109): cousin calls — sibling procs share package-level data
    and call each other across different signatures; tests multi-var init, indirect
    access, and flag-driven branches through deep call chains. */
 pkg: package exports(cousin_a);
     declare counter fixed bin(31) init(0);
     declare flag fixed bin(31) init(0);
     declare buf fixed bin(31) init(42);
     
     cousin_a: procedure(x) returns(fixed bin(31));
        declare x fixed bin(31);
        flag = 1;
        counter = counter + x;
        return(helper_x());
     end cousin_a;
     
     cousin_b: procedure returns(fixed bin(31));
        counter = counter * 2;
        flag = 0;
        return(cousin_c(flag));
     end cousin_b;
     
     cousin_c: procedure(v) returns(fixed bin(31));
        declare v fixed bin(31);
        buf = buf + v;
        return(buf);
     end cousin_c;
     
     helper_x: procedure returns(fixed bin(31));
        if flag = 1 then counter = counter + 10;
        return(cousin_b());
     end helper_x;
  end pkg;
  
  main: procedure options(main);
     declare cousin_a entry(fixed bin(31)) returns(fixed bin(31)) external;
     put skip list(cousin_a(5));
  end main;
