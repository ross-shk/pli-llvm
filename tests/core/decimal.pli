 /* Copyright 2026 Ross S. - plic: a PL/I compiler targeting LLVM */
 /* FIXED DECIMAL(p,q) values are stored scaled by 10^q (ADR-006). A value is
    entered from a FLOAT literal and its scale is honoured in conversion and
    in + - * and comparison, which rescale operands to a common scale. */
 DEC: PROCEDURE OPTIONS(MAIN);
   DECLARE FAILS FIXED BINARY(31);
   FAILS = 0;
   DECLARE A FIXED DECIMAL(5,2);   /* cents: 2 fraction digits */
   DECLARE B FIXED DECIMAL(5,2);
   DECLARE C FIXED DECIMAL(7,4);
   DECLARE D FLOAT DECIMAL(6);
   DECLARE I FIXED BINARY(31);

   /* entry from a FLOAT literal: value * 10^2 is stored */
   A = 2.5;                        /* 2.50 */
   IF A ^= 2.50 THEN FAILS = FAILS + 1;

   /* FIXED DECIMAL -> FLOAT divides back by 10^q */
   D = A;
   IF D ^= 2.5 THEN FAILS = FAILS + 1;

   /* scaled addition: operands rescaled to the common (max) scale */
   B = 1.75;                       /* 1.75 */
   C = A + B;                      /* 2.50 + 1.75 = 4.25, widened to scale 4 */
   IF C ^= 4.25 THEN FAILS = FAILS + 1;

   /* mixed-scale addition: 1.2 (scale 1) + 1.50 (scale 2) = 2.70 */
   B = 1.2;
   A = 1.50;
   C = B + A;
   IF C ^= 2.7 THEN FAILS = FAILS + 1;

   /* scaled subtraction */
   B = 1.25;
   C = A - B;                      /* 1.50 - 1.25 = 0.25 */
   IF C ^= 0.25 THEN FAILS = FAILS + 1;

   /* multiplication: scale of the product is the sum of the operand scales */
   A = 2.5;
   B = 4.0;
   C = A * B;                      /* 2.5 * 4.0 = 10.0000 */
   IF C ^= 10.0 THEN FAILS = FAILS + 1;

   /* scale-reducing assignment rounds half up: 3.15 -> 3.2 (scale 1) */
   A = 3.15;
   DECLARE E FIXED DECIMAL(5,1);
   E = A;
   IF E ^= 3.2 THEN FAILS = FAILS + 1;

   /* 3.14 -> 3.1 (rounds down) */
   A = 3.14;
   E = A;
   IF E ^= 3.1 THEN FAILS = FAILS + 1;

   /* FIXED DECIMAL -> FIXED BINARY rounds at scale 0 */
   A = 2.4;
   I = A;
   IF I ^= 2 THEN FAILS = FAILS + 1;
   A = 2.6;
   I = A;
   IF I ^= 3 THEN FAILS = FAILS + 1;

   /* comparison compares the rescaled integer values */
   A = 1.5;
   B = 1.5;
   IF A ^= B THEN FAILS = FAILS + 1;
   B = 1.4;
   IF A <= B THEN FAILS = FAILS + 1;

   IF FAILS = 0 THEN PUT SKIP LIST('PASS decimal');
   ELSE PUT SKIP LIST('FAIL decimal: fails =', FAILS);
 END DEC;
