 /* rule (101): IDENT accepted, no runtime effect on stream files. */
 open_ident: proc options(main);
     dcl f file;
     open file(f) title('test.dat') ident('VOL001') output;
     put file(f) list('hello');
     close file(f) ident('VOL001');
     put skip list('PASS open_ident');
 end open_ident;