/* STATIC INITIAL accepts folded constant expressions (rules (23),(26)); the
   global initializer must carry the folded values. */
static_folded_const: procedure options(main);
    dcl s fixed bin(31) static initial(5+3);
    dcl d fixed dec(6,2) static initial(99.99+0.01);
    if (s = 8) & (d = 100.00) then
      put skip list('PASS static_folded_const');
    else
      put skip list('FAIL static_folded_const');
 end static_folded_const;
