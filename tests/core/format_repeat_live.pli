 /* Format iteration (rule 47): runtime-evaluated repetition counts with
    nonpositive skip semantics. */
 format_repeat_live: procedure options(main);
    declare buf char(40);
    declare a fixed bin(31);
    declare b fixed bin(31);
    declare c fixed bin(31);
    declare d fixed bin(31);
    declare n fixed bin(31);
    declare i fixed bin(31);
    declare f entry(fixed bin(31)) returns(fixed bin(31));

    /* Variable count: (n)(F(4)) with n=2 -> two fields. */
    n = 2;
    a = 7;
    b = 9;
    put string(buf) edit(a, b) ((n)(f(4)));
    get string(buf) edit(c, d) (f(4), f(4));
    if c ^= 7 then do;
       put skip list('FAIL var count c', c);
       stop;
    end;
    if d ^= 9 then do;
       put skip list('FAIL var count d', d);
       stop;
    end;

    /* Zero count: (0)(F(4)) -> skipped, data item pairs with next format. */
    a = 2;
    put string(buf) edit(a) ((0)(f(4)), f(4));
    get string(buf) edit(c) (f(4));
    if c ^= 2 then do;
       put skip list('FAIL zero count', c);
       stop;
    end;

    /* Nested: (2)((2)(F(4))) -> 4 fields. */
    a = 1; b = 2; c = 3; d = 4;
    put string(buf) edit(a, b, c, d) ((2)((2)(f(4))));
    get string(buf) edit(a, b, c, d) (f(4), f(4), f(4), f(4));
    if a ^= 1 then do; put skip list('FAIL nested 1'); stop; end;
    if b ^= 2 then do; put skip list('FAIL nested 2'); stop; end;
    if c ^= 3 then do; put skip list('FAIL nested 3'); stop; end;
    if d ^= 4 then do; put skip list('FAIL nested 4'); stop; end;

    /* Function-call count: (f(2))(F(4)) evaluates once. */
    a = 5;
    put string(buf) edit(a) ((f(2))(f(4)));
    get string(buf) edit(c) (f(4));
    if c ^= 5 then do;
       put skip list('FAIL func count', c);
       stop;
    end;

    /* Count expression with side effect: call counter increments once. */
    call reset_counter();
    a = 6;
    put string(buf) edit(a) ((call_counter())(f(4)));
    get string(buf) edit(c) (f(4));
    if c ^= 6 then do;
       put skip list('FAIL side effect count', c);
       stop;
    end;
    call get_counter(d);
    if d ^= 1 then do;
       put skip list('FAIL count evaluated once', d);
       stop;
    end;

    put skip list('PASS format_repeat_live');
 end format_repeat_live;

 f: proc(k) returns(fixed bin(31));
    declare k fixed bin(31);
    return(k);
 end f;

 reset_counter: procedure;
    declare counter fixed bin(31) static initial(0);
    counter = 0;
 end reset_counter;

 call_counter: procedure returns(fixed bin(31));
    declare counter fixed bin(31) static initial(0);
    counter = counter + 1;
    return(2);
 end call_counter;

 get_counter: procedure(out_val);
    declare out_val fixed bin(31);
    declare counter fixed bin(31) static;
    out_val = counter;
 end get_counter;
