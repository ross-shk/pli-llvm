 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* ADR-169: UNALIGNED packs a structure's members with no inter-member
    padding. This pins member read/write, whole-structure assignment,
    nested structures, arrays of unaligned structures, a LIKE copy of an
    unaligned template, and an explicit ALIGNED member inside an
    UNALIGNED structure. Layout is pinned by tests/ir/unaligned.pli and
    tests/multimodule/unaligned.*. */
 unaligned_test: procedure options(main);
   dcl 1 p_rec unaligned,
      2 fd   fixed bin(31),
      2 flag bit(1),
      2 code fixed bin(31);
   dcl 1 q_rec unaligned,
      2 fd   fixed bin(31),
      2 flag bit(1),
      2 code fixed bin(31);
   dcl 1 nested unaligned,
      2 a fixed bin(31),
      2 inner,
        3 b fixed bin(31),
        3 c bit(1);
   dcl 1 arr(3) unaligned,
      2 x fixed bin(31),
      2 y fixed bin(31);
   dcl 1 mixed unaligned,
      2 m1 fixed bin(31),
      2 m2 aligned,
        3 n1 bit(1),
        3 n2 fixed bin(31);
   dcl 1 like_rec like p_rec;
   dcl i fixed bin(31);

   /* scalar members in a packed record */
   p_rec.fd = 7;
   p_rec.flag = '1'b;
   p_rec.code = 12345;
   if p_rec.fd ^= 7 then do;
      put skip list('FAIL unaligned: expected 7, got', p_rec.fd);
      stop;
   end;
   if p_rec.code ^= 12345 then do;
      put skip list('FAIL unaligned: expected 12345, got', p_rec.code);
      stop;
   end;

   /* whole-structure assignment between two packed records */
   q_rec = p_rec;
   if q_rec.code ^= 12345 then do;
      put skip list('FAIL unaligned: expected 12345, got', q_rec.code);
      stop;
   end;
   if q_rec.fd ^= 7 then do;
      put skip list('FAIL unaligned: expected 7, got', q_rec.fd);
      stop;
   end;

   /* nested members inherit the enclosing UNALIGNED */
   nested.a = 1;
   nested.inner.b = 2;
   nested.inner.c = '1'b;
   if nested.a + nested.inner.b ^= 3 then do;
      put skip list('FAIL unaligned: check at line 51 failed');
      stop;
   end;

   /* an explicit ALIGNED member overrides the inherited packing */
   mixed.m1 = 4;
   mixed.m2.n1 = '0'b;
   mixed.m2.n2 = 5;
   if mixed.m1 + mixed.m2.n2 ^= 9 then do;
      put skip list('FAIL unaligned: check at line 57 failed');
      stop;
   end;

   /* arrays of unaligned structures */
   do i = 1 to 3;
     arr(i).x = i;
     arr(i).y = i * 10;
   end;
   do i = 1 to 3;
     if arr(i).x ^= i then do;
        put skip list('FAIL unaligned: check at line 65 failed');
        stop;
     end;
     if arr(i).y ^= i * 10 then do;
        put skip list('FAIL unaligned: check at line 66 failed');
        stop;
     end;
   end;

   /* a LIKE copy of an unaligned template is assignment-compatible */
   like_rec.code = p_rec.code;
   if like_rec.code ^= 12345 then do;
      put skip list('FAIL unaligned: expected 12345, got',
         like_rec.code);
      stop;
   end;

   put skip list('PASS unaligned');
 end unaligned_test;
