 /* ADR-169: UNALIGNED packs a structure's members with no inter-member
    padding. This pins member read/write, whole-structure assignment,
    nested structures, arrays of unaligned structures, a LIKE copy of an
    unaligned template, and an explicit ALIGNED member inside an
    UNALIGNED structure. Layout is pinned by tests/ir/unaligned.pli and
    tests/multimodule/unaligned.*. */
 unaligned_test: procedure options(main);
   dcl 1 p_rec unaligned,
      2 fd   fixed bin(31),
      2 flag bit(1),
      2 code fixed bin(31);
   dcl 1 q_rec unaligned,
      2 fd   fixed bin(31),
      2 flag bit(1),
      2 code fixed bin(31);
   dcl 1 nested unaligned,
      2 a fixed bin(31),
      2 inner,
        3 b fixed bin(31),
        3 c bit(1);
   dcl 1 arr(3) unaligned,
      2 x fixed bin(31),
      2 y fixed bin(31);
   dcl 1 mixed unaligned,
      2 m1 fixed bin(31),
      2 m2 aligned,
        3 n1 bit(1),
        3 n2 fixed bin(31);
   dcl 1 like_rec like p_rec;
   dcl fails fixed bin(31) init(0);
   dcl i fixed bin(31);

   /* scalar members in a packed record */
   p_rec.fd = 7;
   p_rec.flag = '1'b;
   p_rec.code = 12345;
   if p_rec.fd ^= 7 then fails = fails + 1;
   if p_rec.code ^= 12345 then fails = fails + 1;

   /* whole-structure assignment between two packed records */
   q_rec = p_rec;
   if q_rec.code ^= 12345 then fails = fails + 1;
   if q_rec.fd ^= 7 then fails = fails + 1;

   /* nested members inherit the enclosing UNALIGNED */
   nested.a = 1;
   nested.inner.b = 2;
   nested.inner.c = '1'b;
   if nested.a + nested.inner.b ^= 3 then fails = fails + 1;

   /* an explicit ALIGNED member overrides the inherited packing */
   mixed.m1 = 4;
   mixed.m2.n1 = '0'b;
   mixed.m2.n2 = 5;
   if mixed.m1 + mixed.m2.n2 ^= 9 then fails = fails + 1;

   /* arrays of unaligned structures */
   do i = 1 to 3;
     arr(i).x = i;
     arr(i).y = i * 10;
   end;
   do i = 1 to 3;
     if arr(i).x ^= i then fails = fails + 1;
     if arr(i).y ^= i * 10 then fails = fails + 1;
   end;

   /* a LIKE copy of an unaligned template is assignment-compatible */
   like_rec.code = p_rec.code;
   if like_rec.code ^= 12345 then fails = fails + 1;

   if fails = 0 then put skip list('PASS unaligned');
   else put skip list('FAIL unaligned: fails =', fails);
 end unaligned_test;
