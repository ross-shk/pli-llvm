/* Companion to c_struct_return.pli: defines the external entry returning a
   structure through the caller's hidden sret buffer (ptr first argument). */
 cstructlib: package exports(e);

  dcl 1 s,
         2 a fixed bin(31),
         2 b fixed bin(31);

  e: procedure returns(s);
   s.a = 10;
   s.b = 20;
   return(s);
  end e;

 end cstructlib;
