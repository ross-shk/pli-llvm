 /* Whole-structure copy with a dynamic member (rules
    (13),(127)): `t = s` copies scalars and each
    dynamic buffer's contents, so later writes through
    one side stay visible only there. */
 struct_dyn_copy_test: procedure options(main);
    declare n fixed bin(31);
    declare 1 s,
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    declare 1 t,
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    declare fails fixed bin(31);
    n = 4;
    fails = 0;
    s.a = 7;
    s.v(1) = 111;
    s.v(2) = 20;
    s.v(3) = 30;
    s.v(4) = 444;
    t = s;
    if t.a ^= 7 then fails = fails + 1;
    if t.v(1) ^= 111 then fails = fails + 1;
    if t.v(4) ^= 444 then fails = fails + 1;
    if lbound(t.v) ^= 1 then fails = fails + 1;
    if hbound(t.v) ^= n then fails = fails + 1;
    if dim(t.v) ^= n then fails = fails + 1;
    if sum(t.v) ^= 111 + 20 + 30 + 444 then
       fails = fails + 1;
    /* deep, not aliased: writes diverge after copy */
    t.v(1) = 1;
    s.v(2) = 2;
    if s.v(1) ^= 111 then fails = fails + 1;
    if t.v(2) ^= 20 then fails = fails + 1;
    if fails = 0 then put skip list('PASS struct_dyn_copy');
    else put skip list('FAIL struct_dyn_copy: fails =',
       fails);
 end struct_dyn_copy_test;
