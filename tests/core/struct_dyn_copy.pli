 /* Whole-structure copy with a dynamic member (rules
    (13),(127)): `t = s` copies scalars and each
    dynamic buffer's contents, so later writes through
    one side stay visible only there. */
 struct_dyn_copy_test: procedure options(main);
    declare n fixed bin(31);
    declare 1 s,
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    declare 1 t,
           2 a fixed bin(31),
           2 v(n) fixed bin(31);
    n = 4;
    s.a = 7;
    s.v(1) = 111;
    s.v(2) = 20;
    s.v(3) = 30;
    s.v(4) = 444;
    t = s;
    if t.a ^= 7 then do;
       put skip list('FAIL struct_dyn_copy: expected 7, got', t.a);
       stop;
    end;
    if t.v(1) ^= 111 then do;
       put skip list('FAIL struct_dyn_copy: expected 111, got', t.v(1));
       stop;
    end;
    if t.v(4) ^= 444 then do;
       put skip list('FAIL struct_dyn_copy: expected 444, got', t.v(4));
       stop;
    end;
    if lbound(t.v) ^= 1 then do;
       put skip list('FAIL struct_dyn_copy: expected 1, got',
          lbound(t.v));
       stop;
    end;
    if hbound(t.v) ^= n then do;
       put skip list('FAIL struct_dyn_copy: check at line 28 failed');
       stop;
    end;
    if dim(t.v) ^= n then do;
       put skip list('FAIL struct_dyn_copy: check at line 29 failed');
       stop;
    end;
    if sum(t.v) ^= 111 + 20 + 30 + 444 then do;
       put skip list('FAIL struct_dyn_copy: check at line 31 failed');
       stop;
    end;
    /* deep, not aliased: writes diverge after copy */
    t.v(1) = 1;
    s.v(2) = 2;
    if s.v(1) ^= 111 then do;
       put skip list('FAIL struct_dyn_copy: expected 111, got', s.v(1));
       stop;
    end;
    if t.v(2) ^= 20 then do;
       put skip list('FAIL struct_dyn_copy: expected 20, got', t.v(2));
       stop;
    end;
   put skip list('PASS struct_dyn_copy');
 end struct_dyn_copy_test;
