  /* rule (81): a void alternate entry cannot RETURN
     a value, even when the primary entry returns one. */
  badentryvoid: procedure options(main);
     put skip list(once());
  end badentryvoid;

  once: procedure returns(fixed bin(31));
     return(1);

    twice: entry;
     return(2);
  end once;
