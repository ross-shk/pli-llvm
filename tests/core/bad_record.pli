 /* rules (112),(113): REWRITE takes a FROM source and
    DELETE takes no data clause; the keyed options
    stay diagnosed. */
 badrecord: procedure options(main);
    declare f file;
    declare x fixed bin(31);
    rewrite file(f) into(x);
    delete file(f) from(x);
 end badrecord;
