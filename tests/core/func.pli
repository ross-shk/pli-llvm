 /* Function procedures via RETURNS, and function references in
    expressions. A recursive function (the M1 exit criterion) compiles
    and runs. TR 25.084 rules (5) RETURNS, (34)-(38) function
    procedures, (81) RETURN with a value, (123) function reference. */
 func: procedure options(main);
    declare n fixed bin(31);
    declare f fixed bin(31);

    /* A recursive function procedure. */
    fact: procedure(n) returns(fixed bin(31));
       declare n fixed bin(31);
       if n <= 1 then return(1);
       return(n * fact(n - 1));
    end fact;

    /* A simple function used in an expression. */
    double_it: procedure(x) returns(fixed bin(31));
       declare x fixed bin(31);
       return(x + x);
    end double_it;

    n = 5;
    f = fact(n);
    if f = 120 then put skip list('PASS fact(5) = 120');
    else put skip list('FAIL fact(5) =', f);

    f = double_it(21) + 1;
    if f = 43 then put skip list('PASS double(21)+1 = 43');
    else put skip list('FAIL double(21)+1 =', f);
 end func;
