 /* SPDX-License-Identifier: Apache-2.0 */
 /* W2 search/scan operations: INDEX, VERIFY, SEARCH, TALLY — rules
    (92) and extension ADR-107. Boundary cases: empty strings, zero
    length, start below 1, start past end, one-based results, early
    exit, non-overlapping tally stride. Exercises emitVerify/emitVerifyFrom/
    emitSearch/emitTally dispatch + direct LLVM lowerings. */
 w2_ops: procedure options(main);

    /* --- INDEX (rule 92): 1-based position, empty needle → 1 --- */
    if index('hello', 'll') ^= 3 then do;
       put skip list('FAIL w2_search_ops: expected 3, got',
          index('hello', 'll'));
       stop;
    end;
    if index('hello', '') ^= 1 then do;
       put skip list('FAIL w2_search_ops: expected 1, got',
          index('hello', ''));
       stop;
    end;
    if index('hello', 'x') ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          index('hello', 'x'));
       stop;
    end;

    /* --- VERIFY(s, t): first char of s NOT in t, 0 if all present --- */
    if verify('ABCD', 'BCD') ^= 1 then do;
       put skip list('FAIL w2_search_ops: expected 1, got',
          verify('ABCD', 'BCD'));
       stop;
    end;
    if verify('ABCD', 'ABCD') ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          verify('ABCD', 'ABCD'));
       stop;
    end;
    if verify('A1B2', 'ABCD') ^= 2 then do;
       put skip list('FAIL w2_search_ops: expected 2, got',
          verify('A1B2', 'ABCD'));
       stop;
    end;
    if verify('', 'ABC') ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          verify('', 'ABC'));
       stop;
    end;
    if verify('ABC', '') ^= 1 then do;
       put skip list('FAIL w2_search_ops: expected 1, got',
          verify('ABC', ''));
       stop;
    end;

    /* --- VERIFY(s, t, start): from position start (1-based, <1→1) --- */
    if verify('A1B2C3', 'ABC', 2) ^= 2 then do;
       put skip list('FAIL w2_search_ops: expected 2, got',
          verify('A1B2C3', 'ABC', 2));
       stop;
    end;
    if verify('A1B2C3', 'A1', 1) ^= 3 then do;
       put skip list('FAIL w2_search_ops: expected 3, got',
          verify('A1B2C3', 'A1', 1));
       stop;
    end;
    if verify('ABC', 'ABCD', 0) ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          verify('ABC', 'ABCD', 0));
       stop;
    end;
    if verify('ABC', 'ABCD', 10) ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          verify('ABC', 'ABCD', 10));
       stop;
    end;
    if verify('', 'ABC', 1) ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          verify('', 'ABC', 1));
       stop;
    end;

    /* --- SEARCH(s, t, start): first char of s (from start) IN t --- */
    if search('hello world', 'xdz', 1) ^= 11 then do;
       put skip list('FAIL w2_search_ops: expected 11, got',
          search('hello world', 'xdz', 1));
       stop;
    end;
    if search('hello', 'ax', 1) ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          search('hello', 'ax', 1));
       stop;
    end;
    if search('hello', 'a', 1) ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          search('hello', 'a', 1));
       stop;
    end;
    if search('hello', 'ol', 0) ^= 3 then do;
       put skip list('FAIL w2_search_ops: expected 3, got',
          search('hello', 'ol', 0));
       stop;
    end;
    if search('hello', 'ol', 10) ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          search('hello', 'ol', 10));
       stop;
    end;
    if search('', 'abc', 1) ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          search('', 'abc', 1));
       stop;
    end;

    /* --- TALLY(x, y): non-overlapping count, empty → 0 --- */
    if tally('abcabc', 'bc') ^= 2 then do;
       put skip list('FAIL w2_search_ops: expected 2, got',
          tally('abcabc', 'bc'));
       stop;
    end;
    if tally('aaa', 'aa') ^= 1 then do;
       put skip list('FAIL w2_search_ops: expected 1, got',
          tally('aaa', 'aa'));
       stop;
    end;
    if tally('abc', 'z') ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          tally('abc', 'z'));
       stop;
    end;
    if tally('', 'a') ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          tally('', 'a'));
       stop;
    end;
    if tally('abc', '') ^= 0 then do;
       put skip list('FAIL w2_search_ops: expected 0, got',
          tally('abc', ''));
       stop;
    end;
    if tally('a b c', ' ') ^= 2 then do;
       put skip list('FAIL w2_search_ops: expected 2, got',
          tally('a b c', ' '));
       stop;
    end;

   put skip list('PASS w2 search ops');
 end w2_ops;
