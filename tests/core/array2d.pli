 /* Fixed-size 2-D arrays (rules (12),(13),(126)): DECLARE A(m,n) declares an
    m x n array in row-major order; A(i,j) is a subscripted reference usable
    on both sides of an assignment with constant or runtime subscripts. */
 array2d_test: procedure options(main);
    declare a(2,3) fixed bin(31);
    declare b(0:1, 1:2) fixed bin(31);
    declare i fixed bin(31);
    declare j fixed bin(31);


    /* write via constant subscripts */
    a(1,1) = 11;
    a(1,2) = 12;
    a(1,3) = 13;
    a(2,1) = 21;
    a(2,2) = 22;
    a(2,3) = 23;

    /* read back via constant subscripts */
    if a(1,1) ^= 11 then do;
       put skip list('FAIL array2d: expected 11, got', a(1,1));
       stop;
    end;
    if a(1,3) ^= 13 then do;
       put skip list('FAIL array2d: expected 13, got', a(1,3));
       stop;
    end;
    if a(2,1) ^= 21 then do;
       put skip list('FAIL array2d: expected 21, got', a(2,1));
       stop;
    end;
    if a(2,3) ^= 23 then do;
       put skip list('FAIL array2d: expected 23, got', a(2,3));
       stop;
    end;

    /* fill and read back with runtime subscripts (row-major) */
    do i = 1 to 2;
       do j = 1 to 3;
          a(i,j) = i * 10 + j;
       end;
    end;
    do i = 1 to 2;
       do j = 1 to 3;
          if a(i,j) ^= i * 10 + j then do;
             put skip list('FAIL a(i,j) at', i, j, a(i,j));
             stop;
          end;
       end;
    end;

    /* element in an arithmetic expression */
    a(2,2) = a(1,3) + a(2,1) + 1;
    if a(2,2) ^= 35 then do;
       put skip list('FAIL a(2,2) =', a(2,2));
       stop;
    end;

    /* explicit lower bounds on each axis */
    b(0,1) = 7;
    b(1,2) = 9;
    if b(0,1) ^= 7 then do;
       put skip list('FAIL array2d: expected 7, got', b(0,1));
       stop;
    end;
    if b(1,2) ^= 9 then do;
       put skip list('FAIL array2d: expected 9, got', b(1,2));
       stop;
    end;

    /* DIM of a 2-D array is the total element count */
    if dim(a) ^= 6 then do;
       put skip list('FAIL dim(a) =', dim(a));
       stop;
    end;
    if lbound(a) ^= 1 then do;
       put skip list('FAIL array2d: expected 1, got', lbound(a));
       stop;
    end;
    if hbound(a) ^= 2 then do;
       put skip list('FAIL array2d: expected 2, got', hbound(a));
       stop;
    end;

   put skip list('PASS array2d');
 end array2d_test;
