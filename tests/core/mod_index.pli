/* P6.3: MOD(DO_index, k) must produce the same result as MOD(literal, k)
   for all indices, including sign-of-divisor correctness. */
mod_index: procedure options(main);
   declare i, s fixed bin(31);
   declare fails fixed bin(31);
   fails = 0;
   s = 0;
   /* DO i = 1 TO n: the index is non-negative, so MOD(i, k) with positive k
      is just i rem k. Verify a few known values: MOD(3,3)=0, MOD(4,3)=1,
      MOD(6,3)=0, MOD(7,3)=1. */
   do i = 1 to 100;
     s = s + mod(i, 3);
     if mod(i, 3) ^= i - 3 * (i / 3) then fails = fails + 1;
   end;
   /* Expected sum: 0+1+2+0+1+2+... for i=1..100 (i rem 3) */
   if s ^= 100 then fails = fails + 1;
   /* Negative dividend must still take sign of divisor (MOD(-7,3) = 2). */
   i = -7;
   if mod(i, 3) ^= 2 then fails = fails + 1;
   if fails = 0 then put skip list('PASS mod_index');
   else put skip list('FAIL mod_index: fails =', fails);
end mod_index;
