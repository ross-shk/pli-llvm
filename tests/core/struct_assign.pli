 /* Whole-structure assignment (rule 127): S = T copies one structure's storage
    into another of identical shape, including array members; S.X = T.X copies a
    nested (minor) structure member. */
 struct_assign_test: procedure options(main);
    declare 1 s,
           2 a fixed bin(31),
           2 v(3) fixed bin(31),
           2 x,
             3 y fixed bin(31);
    declare 1 t,
           2 a fixed bin(31),
           2 v(3) fixed bin(31),
           2 x,
             3 y fixed bin(31);

    t.a = 11;
    t.v(1) = 1;
    t.v(2) = 2;
    t.v(3) = 3;
    t.x.y = 33;

    /* whole-structure copy, including an array member */
    s = t;
    if s.a ^= 11 then do;
       put skip list('FAIL struct_assign: expected 11, got', s.a);
       stop;
    end;
    if s.v(2) ^= 2 or s.v(3) ^= 3 then do;
       put skip list('FAIL struct_assign: check at line 29 failed');
       stop;
    end;
    if s.x.y ^= 33 then do;
       put skip list('FAIL struct_assign: expected 33, got', s.x.y);
       stop;
    end;

    /* member-to-member whole-structure copy */
    s.x = t.x;
    if s.x.y ^= 33 then do;
       put skip list('FAIL struct_assign: expected 33, got', s.x.y);
       stop;
    end;

    /* self-assignment is a no-op */
    s = s;
    if s.a ^= 11 then do;
       put skip list('FAIL struct_assign: expected 11, got', s.a);
       stop;
    end;

   put skip list('PASS struct_assign');
 end struct_assign_test;
