/* W3 clipping/padding/capacity operations: SUBSTR (rule 30), REPEAT
   (rule 31), TRANSLATE (rule 32), TRIM (extension ADR-077). Boundary
   cases: start < 1, length > available, empty source, zero-length,
   VARYING-length growth, pad characters, capacity clamping. */
w3_ops: procedure options(main);
    declare fails fixed bin(31) init(0);
    declare result char(20) varying;

    /* --- SUBSTR (rule 30): 1-based start, length clamping --- */
    result = substr('hello', 2, 3);
    if result ^= 'ell' then fails = fails + 1;
    result = substr('hello', 1, 3);
    if result ^= 'hel' then fails = fails + 1;
    result = substr('hello', 1, 10);
    if result ^= 'hello' then fails = fails + 1;
    result = substr('hello', 3, 0);
    if result ^= '' then fails = fails + 1;

    /* --- REPEAT --- */
    result = repeat('ab', 3);
    if result ^= 'ababab' then fails = fails + 1;
    result = repeat('x', 0);
    if result ^= '' then fails = fails + 1;

    /* --- TRANSLATE --- */
    result = translate('abc', 'def', 'a');
    if result ^= 'dbc' then fails = fails + 1;
    result = translate('hello', 'H', 'h');
    if result ^= 'Hello' then fails = fails + 1;

    /* --- TRIM --- */
    result = trim('  hello  ');
    if result ^= 'hello' then fails = fails + 1;
    result = trim('hello');
    if result ^= 'hello' then fails = fails + 1;
    result = trim('   ', ' ');
    if result ^= '' then fails = fails + 1;

    if fails = 0 then put skip list('PASS w3 ops');
    else put skip list('FAIL w3 ops: fails =', fails);
end w3_ops;
