 /* Dynamic lower-bound array params (rules (12),(13),
    (34)): a param `x(l:u)` sizes its view from the bound
    args at entry, so subscripting and LBOUND/HBOUND/
    DIM/SUM use the live bounds and writes are visible. */
 dyn_param_lower_test: procedure options(main);
    declare a(10) fixed bin(31);
    declare m(4) fixed bin(31);
    declare i fixed bin(31);
    declare fails fixed bin(31);
    fails = 0;
    do i = 1 to 10;
       a(i) = i;
    end;
    call check(a, 1, 10);
    call check(a, 0, 9);
    call bump(a, 2, 11);
    if a(1) ^= 2 then fails = fails + 1;
    if a(10) ^= 11 then fails = fails + 1;
    do i = 1 to 4;
       m(i) = i * 10;
    end;
    call checkm(m, 5, 8);
    if total(a, 2, 11) ^= 65 then fails = fails + 1;
    if fails = 0 then put skip list('PASS dyn_param_lower');
    else put skip list('FAIL dyn_param_lower: fails =',
       fails);
 check: procedure(x, l, u);
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    declare t fixed bin(31);
    declare i fixed bin(31);
    t = 0;
    do i = l to u;
       t = t + x(i);
    end;
    if lbound(x) ^= l then fails = fails + 1;
    if hbound(x) ^= u then fails = fails + 1;
    if dim(x) ^= u - l + 1 then fails = fails + 1;
    if sum(x) ^= t then fails = fails + 1;
 end check;
 bump: procedure(x, l, u);
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    declare i fixed bin(31);
    do i = l to u;
       x(i) = x(i) + 1;
    end;
 end bump;
 checkm: procedure(x, l, u);
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    if lbound(x) ^= 5 then fails = fails + 1;
    if hbound(x) ^= 8 then fails = fails + 1;
    if dim(x) ^= 4 then fails = fails + 1;
    if x(5) ^= 10 then fails = fails + 1;
    if x(8) ^= 40 then fails = fails + 1;
    if sum(x) ^= 100 then fails = fails + 1;
 end checkm;
 total: procedure(x, l, u) returns(fixed bin(31));
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    declare t fixed bin(31);
    declare i fixed bin(31);
    t = 0;
    do i = l to u;
       t = t + x(i);
    end;
    return(t);
 end total;
 end dyn_param_lower_test;
