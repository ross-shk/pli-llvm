 /* Dynamic lower-bound array params (rules (12),(13),
    (34)): a param `x(l:u)` sizes its view from the bound
    args at entry, so subscripting and LBOUND/HBOUND/
    DIM/SUM use the live bounds and writes are visible. */
 dyn_param_lower_test: procedure options(main);
    declare a(10) fixed bin(31);
    declare m(4) fixed bin(31);
    declare i fixed bin(31);
    do i = 1 to 10;
       a(i) = i;
    end;
    call check(a, 1, 10);
    call check(a, 0, 9);
    call bump(a, 2, 11);
    if a(1) ^= 2 then do;
       put skip list('FAIL dyn_param_lower: expected 2, got', a(1));
       stop;
    end;
    if a(10) ^= 11 then do;
       put skip list('FAIL dyn_param_lower: expected 11, got', a(10));
       stop;
    end;
    do i = 1 to 4;
       m(i) = i * 10;
    end;
    call checkm(m, 5, 8);
    if total(a, 2, 11) ^= 65 then do;
       put skip list('FAIL dyn_param_lower: expected 65, got',
          total(a, 2, 11));
       stop;
    end;
   put skip list('PASS dyn_param_lower');
 check: procedure(x, l, u);
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    declare t fixed bin(31);
    declare i fixed bin(31);
    t = 0;
    do i = l to u;
       t = t + x(i);
    end;
    if lbound(x) ^= l then do;
       put skip list('FAIL dyn_param_lower: check at line 39 failed');
       stop;
    end;
    if hbound(x) ^= u then do;
       put skip list('FAIL dyn_param_lower: check at line 40 failed');
       stop;
    end;
    if dim(x) ^= u - l + 1 then do;
       put skip list('FAIL dyn_param_lower: check at line 41 failed');
       stop;
    end;
    if sum(x) ^= t then do;
       put skip list('FAIL dyn_param_lower: check at line 42 failed');
       stop;
    end;
 end check;
 bump: procedure(x, l, u);
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    declare i fixed bin(31);
    do i = l to u;
       x(i) = x(i) + 1;
    end;
 end bump;
 checkm: procedure(x, l, u);
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    if lbound(x) ^= 5 then do;
       put skip list('FAIL dyn_param_lower: expected 5, got',
          lbound(x));
       stop;
    end;
    if hbound(x) ^= 8 then do;
       put skip list('FAIL dyn_param_lower: expected 8, got',
          hbound(x));
       stop;
    end;
    if dim(x) ^= 4 then do;
       put skip list('FAIL dyn_param_lower: expected 4, got', dim(x));
       stop;
    end;
    if x(5) ^= 10 then do;
       put skip list('FAIL dyn_param_lower: expected 10, got', x(5));
       stop;
    end;
    if x(8) ^= 40 then do;
       put skip list('FAIL dyn_param_lower: expected 40, got', x(8));
       stop;
    end;
    if sum(x) ^= 100 then do;
       put skip list('FAIL dyn_param_lower: expected 100, got', sum(x));
       stop;
    end;
 end checkm;
 total: procedure(x, l, u) returns(fixed bin(31));
    declare l fixed bin(31);
    declare u fixed bin(31);
    declare x(l:u) fixed bin(31);
    declare t fixed bin(31);
    declare i fixed bin(31);
    t = 0;
    do i = l to u;
       t = t + x(i);
    end;
    return(t);
 end total;
 end dyn_param_lower_test;
