 /* Negative lower bounds (rules (12),(13)): arrays may
    span negative subscripts; lbound/hbound plus reads
    and writes follow the declared range (P4 audit). */
 negbounds: procedure options(main);
    declare a(-3:3) fixed bin(31);
    declare i fixed bin(31);
    declare s fixed bin(31);
    do i = -3 to 3;
       a(i) = i * 10;
    end;
    s = 0;
    do i = -3 to 3;
       s = s + a(i);
    end;
    if s ^= 0 then do;
       put skip list('FAIL sum =', s);
       stop;
    end;
    if lbound(a) ^= -3 then do;
       put skip list('FAIL lbound');
       stop;
    end;
    if hbound(a) ^= 3 then do;
       put skip list('FAIL hbound');
       stop;
    end;
    if a(-3) ^= -30 then do;
       put skip list('FAIL edge');
       stop;
    end;
   put skip list('PASS negbounds');
 end negbounds;
