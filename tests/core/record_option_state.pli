 /* rules (112),(113): READ ... INTO on a sequential file (record option state). */
 record_option_state: procedure options(main);
    declare f file;
    declare a fixed bin(31);
    declare b fixed bin(31);
    a = 42;
    open file(f) record sequential output
       title('tests/core/out/record_option_state.dat');
    write file(f) from(a);
    close file(f);
    open file(f) record sequential input
       title('tests/core/out/record_option_state.dat');
    read file(f) into(b);
    close file(f);
    if b ^= 42 then do;
       put skip list('FAIL record_option_state', b);
       stop;
    end;
    put skip list('PASS record_option_state');
 end record_option_state;
