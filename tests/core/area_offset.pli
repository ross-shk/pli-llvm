 /* AREA/OFFSET region allocation (rules (20),(22),(88),(90)): BASED
    records are allocated IN an area, freed out of order, and the
    region's storage is reused. An offset is a locator into the area. */
 area_offset: procedure options(main);
   dcl region  area(4096);
   dcl region2 area(256);
   dcl 1 a based(pa),
       2 v fixed bin(31);
   dcl 1 b based(pb),
       2 v fixed bin(31);
   dcl 1 c based(pc),
       2 v fixed bin(31);
   dcl 1 d based(pd),
       2 v fixed bin(31);
   dcl pa offset(region);
   dcl pb offset(region);
   dcl pc offset(region);
   dcl pd offset(region2);

   /* allocate three blocks from the region */
   allocate a in(region) set(pa);
   allocate b in(region) set(pb);
   allocate c in(region) set(pc);
   a.v = 11;
   b.v = 22;
   c.v = 33;
   if a.v ^= 11 then do;
      put skip list('FAIL area_offset: expected 11, got', a.v);
      stop;
   end;
   if b.v ^= 22 then do;
      put skip list('FAIL area_offset: expected 22, got', b.v);
      stop;
   end;
   if c.v ^= 33 then do;
      put skip list('FAIL area_offset: expected 33, got', c.v);
      stop;
   end;

   /* free the middle block first (out of order); the others survive */
   free b in(region);
   if a.v ^= 11 then do;
      put skip list('FAIL area_offset: expected 11, got', a.v);
      stop;
   end;
   if c.v ^= 33 then do;
      put skip list('FAIL area_offset: expected 33, got', c.v);
      stop;
   end;
   free a in(region);
   if c.v ^= 33 then do;
      put skip list('FAIL area_offset: expected 33, got', c.v);
      stop;
   end;
   free c in(region);

   /* NULL offset assignment and comparison */
   pa = null();
   if pa ^= null() then do;
      put skip list('FAIL area_offset: check at line 44 failed');
      stop;
   end;

   /* a second region is independent of the first */
   allocate d in(region2) set(pd);
   d.v = 77;
   if d.v ^= 77 then do;
      put skip list('FAIL area_offset: expected 77, got', d.v);
      stop;
   end;
   free d in(region2);

   /* reusing the region after a full free cycle works */
   allocate a in(region) set(pa);
   a.v = 88;
   if a.v ^= 88 then do;
      put skip list('FAIL area_offset: expected 88, got', a.v);
      stop;
   end;
   free a in(region);

   put skip list('PASS area_offset');
 end area_offset;
