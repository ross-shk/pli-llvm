 /* P4 power fast path (rule 121): x**2 with a constant integer
    exponent 2 is a single fmul. A negative base still squares
    positive; other exponents keep llvm.pow. */
 power_square: procedure options(main);
    declare x float decimal(6);
    declare i fixed bin(31);
    declare bad fixed bin(31);
    bad = 0;
    x = -3.0;
    if x ** 2 ^= 9.0 then bad = bad + 1;
    x = 2.5;
    if x ** 2 ^= 6.25 then bad = bad + 1;
    x = 0.0;
    if x ** 2 ^= 0.0 then bad = bad + 1;
    i = (-4) ** 2;
    if i ^= 16 then bad = bad + 1;
    x = -2.0;
    if x ** 3 ^= -8.0 then bad = bad + 1;
    if bad = 0 then put skip list('PASS power_square');
    else put skip list('MISMATCH power_square:', bad);
 end power_square;
