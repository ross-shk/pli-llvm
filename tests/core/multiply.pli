 /* MULTIPLY built-in function: multiply(a, b) yields the product of two
    numeric values, computed in their common arithmetic type. M2 arithmetic
    built-in (Y33-6003 MULTIPLY). */
 multiply_test: procedure options(main);
    declare x fixed bin(31);
    declare y float dec(6);
    declare fails fixed bin(31);

    fails = 0;

    x = multiply(6, 7);
    if x ^= 42 then do;
       fails = fails + 1;
       put skip list('FAIL multiply(6,7) =', x);
    end;

    x = multiply(-4, 5);
    if x ^= -20 then do;
       fails = fails + 1;
       put skip list('FAIL multiply(-4,5) =', x);
    end;

    y = multiply(2.5, 4.0);
    if y ^= 10.0 then do;
       fails = fails + 1;
       put skip list('FAIL multiply(2.5,4.0) =', y);
    end;

    if fails = 0 then put skip list('PASS multiply');
    else put skip list('FAIL multiply: fails =', fails);
 end multiply_test;
