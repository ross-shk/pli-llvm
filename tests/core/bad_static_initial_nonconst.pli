/* STATIC INITIAL with non-constant expression (rule 26) — must be diagnosed */
bad_static_initial_nonconst: procedure options(main);
    dcl x fixed bin(31) init(5);
    dcl y fixed bin(31) static init(x);  /* ERROR (26): non-constant INITIAL */
    put skip list('FAIL - should not reach here');
end bad_static_initial_nonconst;