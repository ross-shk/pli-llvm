/* Picture-directed input diagnoses binary pictures (1/2/3) with (148). */
bad_picture_input: procedure options(main);
    declare buf char(10);
    declare x fixed dec(5,2);
    get string(buf) edit(x) (p('111V99'));
end bad_picture_input;