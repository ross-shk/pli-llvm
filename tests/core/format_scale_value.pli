 /* rules (52),(53): format iteration with expression count and F(w,d,s) scale */
 format_scale_iter: procedure options(main);
     declare buf char(40);
     declare x fixed dec(5,2) init(1.23);
     declare y fixed dec(5,2) init(4.56);
     declare z fixed dec(5,2) init(7.89);
     
     /* Format iteration with expression count: (2)(F(8,2)) */
     put string(buf) edit(x, y) ((2)(F(8,2)));
     put skip list('iter_2=', buf);
     
     /* Format iteration with variable count */
     declare n fixed bin(15) init(3);
     put string(buf) edit(x, y, z) ((n)(F(8,2)));
     put skip list('iter_n=', buf);
     
     /* F(w,d,s) scale factor: F(8,2,1) scales by 10^1 */
     put string(buf) edit(x) (F(10,2,1));
     put skip list('scale_1=', buf);
     
     /* F(w,d,s) negative scale: F(8,2,-1) scales by 10^-1 */
     put string(buf) edit(x) (F(10,2,-1));
     put skip list('scale_m1=', buf);
     
     /* Nested iteration: (3)(F(6,1)) */
     put string(buf) edit(x, y, z) ((3)(F(6,1)));
     put skip list('nested=', buf);
     
     put skip list('PASS format_scale_iter');
 end format_scale_iter;