 /* P2 litmus: BASED pointer access. P->X(i) aliases through a hidden
    pointer (ADR-164): the pointed-to memory may be shared. Must NOT
    be marked noalias — output identical before/after P2. */
 alias_based: PROCEDURE OPTIONS(MAIN);
    DECLARE (i, n, sum) FIXED BINARY(31);
    DECLARE p POINTER;
    DECLARE a(1000) FIXED BINARY(31);
    DECLARE b(1000) FIXED BINARY(31) BASED(p);

    n = 1000;
    p = ADDR(a(1));

    DO i = 1 TO n;
      a(i) = i;
      b(i) = a(i) * 2;
    END;

    sum = 0;
    DO i = 1 TO n;
      sum = sum + b(i);
    END;

    PUT SKIP LIST(sum);
 END alias_based;
