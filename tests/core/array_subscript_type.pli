 /* A subscript must be of an integer type (rule (126), ADR-277). The types
    that carry an integer are accepted: FIXED BINARY, and a FIXED DECIMAL
    with scale 0 (its stored value *is* the integer — an integer literal has
    that type here). A scaled FIXED (binary or decimal), a FLOAT and a
    CHARACTER are rejected
    (bad_array_subscript_type.pli). */
 subok: procedure options(main);
    declare a(1:3) fixed bin(31);
    declare d fixed dec(5,0);
    declare i fixed bin(31);
    declare x fixed bin(31);
    declare fails fixed bin(31);
    fails = 0;

    a(1) = 10;
    a(2) = 20;
    a(3) = 30;

    /* an integer literal */
    x = a(2);
    if x ^= 20 then fails = fails + 1;

    /* an integer variable */
    i = 3;
    x = a(i);
    if x ^= 30 then fails = fails + 1;

    /* a FIXED DECIMAL with scale 0: the value is the integer */
    d = 1;
    x = a(d);
    if x ^= 10 then fails = fails + 1;

    if fails = 0 then
       put skip list('PASS');
    else
       put skip list('FAIL');
 end subok;
