 /* rule (101): LINESIZE(n) auto-wraps stream output. */
 open_linesize: procedure options(main);
    declare f file;
    declare buf char(20);
    open file(f) output title('tests/core/out/open_linesize.dat') linesize(8);
    put file(f) list('abcd', 'efgh');
    close file(f);

    open file(f) input title('tests/core/out/open_linesize.dat');
    get file(f) edit (buf) (a(10));
    close file(f);

    if substr(buf, 6, 1) ^= ' ' then
       put skip list('PASS open_linesize');
    else
       put skip list('FAIL open_linesize');
 end open_linesize;
