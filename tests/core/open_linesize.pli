/* rule (101): OPEN LINESIZE option — auto-wraps stream output. */
open_linesize: procedure options(main);
    declare f file;
    declare buf char(100);
    open file(f) title('open_linesize.dat') output linesize(20);
    put file(f) edit('123456789012345678901234567890') (a(30));
    close file(f);
    put skip list('PASS open_linesize');
end open_linesize;