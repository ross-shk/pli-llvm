  /* rules (91)-(94): nested ON units; an ON-unit may establish
     another handler and SIGNAL it before resuming. A unit armed
     inside an ON-unit ends with that unit (ADR-350), so the direct
     nested form re-exposes the procedure's own ZERODIVIDE unit. */
  on_nested: procedure options(main);
     on error begin;
        put skip list('outer');
        on zerodivide begin;
           put skip list('inner');
           return;
        end;
        signal zerodivide;
        put skip list('outer-after');
     end;
     signal error;
     put skip list('mid');
     on zerodivide put skip list('outer-zd');
     on error on zerodivide put skip list('direct');
     signal error;
     signal zerodivide;
     put skip list('done');
  end on_nested;
