 /* Rules (87)-(90): CONTROLLED generation reuse. LIFO
    allocate/free pairs of identical size may reuse one
    cached buffer; contents stay undefined and live
    generations never alias across keys or depths. */
 controlled_reuse: procedure options(main);
   dcl i fixed bin(31);
   dcl k fixed bin(31);
   dcl s fixed bin(63);
   dcl fds fixed bin(31) controlled;
   dcl g fixed bin(31) controlled;
   dcl x(*,*) fixed bin(31) controlled;
   /* same-size churn: fill, sum, free, repeat */
   do k = 1 to 20;
     allocate fds (100);
     do i = 1 to 100;
       fds(i) = k;
     end;
     s = 0;
     do i = 1 to 100;
       s = s + fds(i);
     end;
     if s ^= k * 100 then do;
        put skip list('FAIL controlled_reuse: check at line 26 failed');
        stop;
     end;
     free fds;
   end;
   /* size change evicts the cached buffer */
   allocate fds (100);
   do i = 1 to 100;
     fds(i) = 1;
   end;
   free fds;
   allocate fds (50);
   if hbound(fds) ^= 50 then do;
      put skip list('FAIL controlled_reuse: expected 50, got',
         hbound(fds));
      stop;
   end;
   s = 0;
   do i = 1 to 50;
     fds(i) = 2;
   end;
   do i = 1 to 50;
     s = s + fds(i);
   end;
   if s ^= 100 then do;
      put skip list('FAIL controlled_reuse: expected 100, got', s);
      stop;
   end;
   free fds;
   allocate fds (100);
   if hbound(fds) ^= 100 then do;
      put skip list('FAIL controlled_reuse: expected 100, got',
         hbound(fds));
      stop;
   end;
   free fds;
   /* LIFO depth: a freed top never disturbs livegens */
   allocate fds (10);
   do i = 1 to 10;
     fds(i) = 5;
   end;
   allocate fds (20);
   if hbound(fds) ^= 20 then do;
      put skip list('FAIL controlled_reuse: expected 20, got',
         hbound(fds));
      stop;
   end;
   do i = 1 to 20;
     fds(i) = 7;
   end;
   if fds(1) ^= 7 then do;
      put skip list('FAIL controlled_reuse: expected 7, got', fds(1));
      stop;
   end;
   free fds;
   if hbound(fds) ^= 10 then do;
      put skip list('FAIL controlled_reuse: expected 10, got',
         hbound(fds));
      stop;
   end;
   if fds(1) ^= 5 then do;
      put skip list('FAIL controlled_reuse: expected 5, got', fds(1));
      stop;
   end;
   if fds(10) ^= 5 then do;
      put skip list('FAIL controlled_reuse: expected 5, got', fds(10));
      stop;
   end;
   free fds;
   /* cross-key: interleaved stacks stay separate */
   allocate fds (10);
   allocate g (10);
   do i = 1 to 10;
     fds(i) = 1;
     g(i) = 2;
   end;
   s = fds(1) + g(1);
   if s ^= 3 then do;
      put skip list('FAIL controlled_reuse: expected 3, got', s);
      stop;
   end;
   if fds(10) ^= 1 then do;
      put skip list('FAIL controlled_reuse: expected 1, got', fds(10));
      stop;
   end;
   if g(10) ^= 2 then do;
      put skip list('FAIL controlled_reuse: expected 2, got', g(10));
      stop;
   end;
   free g;
   free fds;
   /* N-D path bypasses the 1-D cache, still works */
   allocate x (2,3);
   x(2,3) = 99;
   if x(2,3) ^= 99 then do;
      put skip list('FAIL controlled_reuse: expected 99, got', x(2,3));
      stop;
   end;
   allocate x (*,*);
   if dim(x,1) ^= 2 then do;
      put skip list('FAIL controlled_reuse: expected 2, got', dim(x,1));
      stop;
   end;
   if dim(x,2) ^= 3 then do;
      put skip list('FAIL controlled_reuse: expected 3, got', dim(x,2));
      stop;
   end;
   free x;
   free x;
   put skip list('PASS controlled_reuse');
 end controlled_reuse;
