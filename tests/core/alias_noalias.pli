 /* P2 litmus: two plain AUTOMATIC arrays in a loop. After P2 the allocas
    carry !noalias and LLVM vectorizes the loop. Output must be identical
    before and after the change. */
 alias_noalias: PROCEDURE OPTIONS(MAIN);
    DECLARE (i, n, sum) FIXED BINARY(31);
    DECLARE a(1000) FIXED BINARY(31);
    DECLARE b(1000) FIXED BINARY(31);

    n = 1000;
    DO i = 1 TO n;
      a(i) = i;
      b(i) = i * 2;
    END;

    sum = 0;
    DO i = 1 TO n;
      sum = sum + a(i) + b(i);
    END;

    PUT SKIP LIST(sum);
 END alias_noalias;
