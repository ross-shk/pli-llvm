 /* Dynamic array param forms still rejected (rules
    (12),(13)): a multi-axis dynamic param stays
    diagnosed; single-axis `x(l:u)` is served (see
    dyn_param_lower.pli). */
 bad_dyn_param: procedure options(main);
    declare a(4,4) fixed bin(31);
    declare n fixed bin(31);
    n = 4;
    call two(a, n, n);

 two: procedure(x, r, c);
    declare r fixed bin(31);
    declare c fixed bin(31);
    declare x(r,c) fixed bin(31);   /* multi-axis -> rule (13) */
 end two;
 end bad_dyn_param;
