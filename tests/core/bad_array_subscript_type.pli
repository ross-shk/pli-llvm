 /* A subscript must be of an integer type (rule (126), ADR-277): the value
    addresses an element, so it needs an integer to address with. A scaled
    FIXED DECIMAL, a FLOAT and a CHARACTER have none — the compiler used to
    take the stored bits as the index, so a decimal subscript of 2.00
    addressed element 200 of a three-element array, and the range check
    trapped on a legal program. */
 badsubtype: procedure options(main);
    declare a(1:3) fixed bin(31);
    declare d fixed dec(5,2);
    declare f float decimal(6);
    declare c char(2);
    declare x fixed bin(31);
    d = 2.00;
    x = a(d);
    x = a(f);
    x = a(c);
 end badsubtype;
