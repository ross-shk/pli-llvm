 /* INDEX built-in function: index(s1, s2) returns the 1-based position of the
    first occurrence of s2 within s1, or 0 if s2 is not present. M2 string
    built-in (Y33-6003 INDEX). */
 index_test: procedure options(main);
    declare s char(8);
    declare p fixed bin(31);
    declare fails fixed bin(31);

    fails = 0;

    s = 'ABCDEFGH';
    p = index(s, 'CD');
    if p ^= 3 then do;
       fails = fails + 1;
       put skip list('FAIL index CD =', p);
    end;

    p = index('hello world', 'world');
    if p ^= 7 then do;
       fails = fails + 1;
       put skip list('FAIL index world =', p);
    end;

    p = index('hello', 'xyz');
    if p ^= 0 then do;
       fails = fails + 1;
       put skip list('FAIL index absent =', p);
    end;

    /* INDEX returns a value usable in an expression. */
    p = index('abcabc', 'bc') + 1;
    if p ^= 3 then do;
       fails = fails + 1;
       put skip list('FAIL index expr =', p);
    end;

    if fails = 0 then put skip list('PASS index');
    else put skip list('FAIL index: fails =', fails);
 end index_test;
