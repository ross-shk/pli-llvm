 /* Per-member structure INIT (rule (26)): each member's own
    INITIAL value fills its field; replication on a member fans
    out within that member. */
 sinit: procedure options(main);
    declare 1 s, 2 a init(1), 2 b init(2);
    declare 1 t, 2 x init(7), 2 y, 2 z init(9);
    if s.a ^= 1 then do;
       put skip list('FAIL struct_init: expected 1, got', s.a);
       stop;
    end;
    if s.b ^= 2 then do;
       put skip list('FAIL struct_init: expected 2, got', s.b);
       stop;
    end;
    if t.x ^= 7 then do;
       put skip list('FAIL struct_init: expected 7, got', t.x);
       stop;
    end;
    if t.y ^= 0 then do;
       put skip list('FAIL struct_init: expected 0, got', t.y);
       stop;
    end;
    if t.z ^= 9 then do;
       put skip list('FAIL struct_init: expected 9, got', t.z);
       stop;
    end;
   put skip list('PASS sinit');
 end sinit;
