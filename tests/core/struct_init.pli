 /* Per-member structure INIT (rule (26)): each member's own
    INITIAL value fills its field; replication on a member fans
    out within that member. */
 sinit: procedure options(main);
    declare 1 s, 2 a init(1), 2 b init(2);
    declare 1 t, 2 x init(7), 2 y, 2 z init(9);
    declare fails fixed bin(31);
    fails = 0;
    if s.a ^= 1 then fails = fails + 1;
    if s.b ^= 2 then fails = fails + 1;
    if t.x ^= 7 then fails = fails + 1;
    if t.y ^= 0 then fails = fails + 1;
    if t.z ^= 9 then fails = fails + 1;
    if fails = 0 then put skip list('PASS sinit');
    else put skip list('FAIL sinit: fails =', fails);
 end sinit;
