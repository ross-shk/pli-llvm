 /* CHAR/FIXED conversions (rule (123)): FIXED parses character
    text with truncation, CHAR renders numerics as text, and the
    trim(char(...)) || char(...) corpus chains resolve. */
 conv: procedure options(main);
    declare p fixed bin(31);
    declare f float;
    declare s char(16);
    declare t char(16);
    declare fails fixed bin(31);
    fails = 0;
    p = fixed('42');
    if p ^= 42 then fails = fails + 1;
    p = fixed('  -17x');
    if p ^= -17 then fails = fails + 1;
    p = fixed('12.9 tail');
    if p ^= 12 then fails = fails + 1;
    s = char(42);
    if trim(s) ^= '42' then fails = fails + 1;
    s = char(-7);
    if trim(s) ^= '-7' then fails = fails + 1;
    f = 3.5;
    t = char(f);
    if index(t, '3') ^= 1 then fails = fails + 1;
    p = fixed(9.9);
    if p ^= 10 then do;
       put skip list('fixed-dec got', p);
       fails = fails + 1;
    end;
    s = 'port:' || char(8080);
    if index(s, '8080') ^= 6 then fails = fails + 1;
    if fails = 0 then put skip list('PASS conv');
    else put skip list('FAIL conv: fails =', fails);
 end conv;
