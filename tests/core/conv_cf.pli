 /* CHAR/FIXED conversions (rule (123)): FIXED parses character
    text with truncation, CHAR renders numerics as text, and the
    trim(char(...)) || char(...) corpus chains resolve. */
 conv: procedure options(main);
    declare p fixed bin(31);
    declare f float;
    declare s char(16);
    declare t char(16);
    p = fixed('42');
    if p ^= 42 then do;
       put skip list('FAIL conv_cf: expected 42, got', p);
       stop;
    end;
    p = fixed('  -17x');
    if p ^= -17 then do;
       put skip list('FAIL conv_cf: expected -17, got', p);
       stop;
    end;
    p = fixed('12.9 tail');
    if p ^= 12 then do;
       put skip list('FAIL conv_cf: expected 12, got', p);
       stop;
    end;
    s = char(42);
    if trim(s) ^= '42' then do;
       put skip list('FAIL conv_cf: expected 42, got', trim(s));
       stop;
    end;
    s = char(-7);
    if trim(s) ^= '-7' then do;
       put skip list('FAIL conv_cf: expected -7, got', trim(s));
       stop;
    end;
    f = 3.5;
    t = char(f);
    if index(t, '3') ^= 1 then do;
       put skip list('FAIL conv_cf: expected 1, got', index(t, '3'));
       stop;
    end;
    p = fixed(9.9);
    if p ^= 9 then do;
       put skip list('fixed-dec got', p);
       do;
          put skip list('FAIL conv_cf: check at line 29 failed');
          stop;
       end;
    end;
    s = 'port:' || char(8080);
    if index(s, '8080') ^= 6 then do;
       put skip list('FAIL conv_cf: expected 6, got', index(s, '8080'));
       stop;
    end;
   put skip list('PASS conv');
 end conv;
