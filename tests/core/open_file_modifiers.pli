/* rules (39),(40),(100),(101): FILE modifiers BUFFERED/UNBUFFERED/EXCLUSIVE. */
 open_file_modifiers: procedure options(main);
     declare f file;
     declare g file;
     declare h file;
     open file(f) title('buf.dat') output buffered;
     open file(g) title('unbuf.dat') output unbuffered;
     open file(h) title('excl.dat') output exclusive;
     put file(f) list('buffered');
     put file(g) list('unbuffered');
     put file(h) list('exclusive');
     close file(f);
     close file(g);
     close file(h);
     put skip list('PASS open_file_modifiers');
 end open_file_modifiers;