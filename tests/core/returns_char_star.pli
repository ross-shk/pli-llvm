 /* Rule (34): a function returns a non-VARYING CHAR(*) value through a
    caller-sized max buffer; the callee blank-pads/truncates to the live
    length and the caller sees the full returned string. */
 returns_char_star: procedure options(main);
    declare s character(20);
    s = show();
    if s = 'hello' then
      put skip list('PASS returns_char_star');
    else
      put skip list('FAIL returns_char_star', s);
 end returns_char_star;

 show: procedure returns(character(*));
    return('hello');
 end show;
