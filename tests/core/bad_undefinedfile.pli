 /* rule (97): UNDEFINEDFILE names a FILE variable and is raised by
    OPEN, never by SIGNAL. */
 badundefinedfile: procedure options(main);
    declare x fixed bin(31);
    declare f file;
    on undefinedfile(x) x = x + 1;
    signal undefinedfile(f);
 end badundefinedfile;
