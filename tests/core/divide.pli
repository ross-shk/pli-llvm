 /* DIVIDE built-in function: divide(a, b) yields the quotient of two numeric
    values, computed in floating point (ADR-014; exact decimal division is M2).
    M2 arithmetic built-in (Y33-6003 DIVIDE). */
 divide_test: procedure options(main);
    declare y float dec(6);


    y = divide(10, 4);
    if y ^= 2.5 then do;
       put skip list('FAIL divide(10,4) =', y);
       stop;
    end;

    y = divide(7.5, 2.5);
    if y ^= 3.0 then do;
       put skip list('FAIL divide(7.5,2.5) =', y);
       stop;
    end;

   put skip list('PASS divide');
 end divide_test;
