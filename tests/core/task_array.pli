 /* rules (79),(82): CALL EVENT and WAIT accept an EVENT array element;
    CALL TASK accepts a TASK array element; EVENT(ev) polls one. */
 task_array: procedure options(main);
    declare ev(2) event;
    declare tk(2) task;
    declare counter fixed binary(31);
    counter = 0;
    call worker task(tk(1)) event(ev(1));
    wait(ev(1));
    if counter = 1 then
       if event(ev(1)) then
          put skip list('PASS');
       else
          put skip list('FAIL event poll');
    else
       put skip list('FAIL counter', counter);
    worker: procedure;
       counter = counter + 1;
    end worker;
 end task_array;
