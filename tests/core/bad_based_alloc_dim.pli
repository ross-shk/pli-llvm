 /* Rules (13),(89): a per-ALLOCATE dimension is served for a
    1-D BASED array; the multi-axis and '*' forms stay diagnosed,
    and a '*' BASED array needs an explicit extent. */
 bad_based_alloc_dim: procedure options(main);
   dcl p pointer;
   dcl w(2,2) fixed bin(31) based(p);
   dcl z(*) fixed bin(31) based(p);
   allocate w(3,3) set(p);
   allocate z set(p);
 end bad_based_alloc_dim;
