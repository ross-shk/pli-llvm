/* STATIC on a parameter (rule 23): invalid — parameters have no storage. */
bad_static_param: procedure options(main);
    dcl x fixed bin(31) static;  /* valid at block level */
    call foo(x);
    foo: proc(p) options(bypass);
        dcl p fixed bin(31) static;  /* (23) - invalid */
    end foo;
end bad_static_param;