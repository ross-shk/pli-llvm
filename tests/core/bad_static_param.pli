/* STATIC on PARAMETER (rule 23) — must be diagnosed */
bad_static_param: procedure options(main);
    call test_static_param(0);
    put skip list('FAIL - should not reach here');
end bad_static_param;

test_static_param: proc(p) options(bypass);
    dcl p fixed bin(31) static;  /* ERROR (23): STATIC on PARAMETER */
    return;
end test_static_param;