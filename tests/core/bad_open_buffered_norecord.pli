/* rule (101): BUFFERED/UNBUFFERED require RECORD SEQUENTIAL. */
bad_open_buffered_norecord: procedure options(main);
    declare f file;
    open file(f) title('test.dat') output stream buffered;
end bad_open_buffered_norecord;