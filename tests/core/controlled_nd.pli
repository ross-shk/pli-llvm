  /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
  /* Rules (13),(23),(87)-(90),(123),(126): N-D CONTROLLED numeric
     arrays (IBM asterisk notation). Fixed, (*), and mixed DECLARE
     forms take one bound per axis from each ALLOCATE; a * bound
     copies that axis from the previous generation. Lower bounds
     are static (DECLARE lb, else 1); extents are per-generation
     live with LIFO restore. */
 nd_ctl_test: procedure options(main);
   dcl i fixed bin(31);
   dcl j fixed bin(31);
   dcl a(3,4) fixed bin(31) controlled;
   dcl x(*,*) fixed bin(31) controlled;
   dcl y(10,*) fixed bin(31) controlled;
   dcl b(0:2, 1:3) fixed bin(31) controlled;
   /* fixed 2-D bare ALLOCATE: descriptor bounds, row-major */
   allocate a;
   do i = 1 to 3;
     do j = 1 to 4;
       a(i,j) = i * 10 + j;
     end;
   end;
   if a(2,3) ^= 23 then do;
      put skip list('FAIL controlled_nd: expected 23, got', a(2,3));
      stop;
   end;
   if hbound(a,1) ^= 3 then do;
      put skip list('FAIL controlled_nd: expected 3, got', hbound(a,1));
      stop;
   end;
   if hbound(a,2) ^= 4 then do;
      put skip list('FAIL controlled_nd: expected 4, got', hbound(a,2));
      stop;
   end;
   if dim(a,1) ^= 3 then do;
      put skip list('FAIL controlled_nd: expected 3, got', dim(a,1));
      stop;
   end;
   if dim(a,2) ^= 4 then do;
      put skip list('FAIL controlled_nd: expected 4, got', dim(a,2));
      stop;
   end;
   if dim(a) ^= 12 then do;
      put skip list('FAIL controlled_nd: expected 12, got', dim(a));
      stop;
   end;
   if lbound(a,1) ^= 1 then do;
      put skip list('FAIL controlled_nd: expected 1, got', lbound(a,1));
      stop;
   end;
   /* override + LIFO */
   allocate a (2,2);
   if hbound(a,1) ^= 2 then do;
      put skip list('FAIL controlled_nd: expected 2, got', hbound(a,1));
      stop;
   end;
   if dim(a) ^= 4 then do;
      put skip list('FAIL controlled_nd: expected 4, got', dim(a));
      stop;
   end;
   a(2,2) = 22;
   allocate a (5,1);
   if hbound(a,1) ^= 5 then do;
      put skip list('FAIL controlled_nd: expected 5, got', hbound(a,1));
      stop;
   end;
   if hbound(a,2) ^= 1 then do;
      put skip list('FAIL controlled_nd: expected 1, got', hbound(a,2));
      stop;
   end;
   a(5,1) = 51;
   if a(5,1) ^= 51 then do;
      put skip list('FAIL controlled_nd: expected 51, got', a(5,1));
      stop;
   end;
   free a;
   if hbound(a,1) ^= 2 then do;
      put skip list('FAIL controlled_nd: expected 2, got', hbound(a,1));
      stop;
   end;
   if a(2,2) ^= 22 then do;
      put skip list('FAIL controlled_nd: expected 22, got', a(2,2));
      stop;
   end;
   free a;
   free a;
   /* (*,*) DECLARE sized by each ALLOCATE */
   allocate x (2,3);
   x(2,3) = 99;
   if x(2,3) ^= 99 then do;
      put skip list('FAIL controlled_nd: expected 99, got', x(2,3));
      stop;
   end;
   if dim(x,1) ^= 2 then do;
      put skip list('FAIL controlled_nd: expected 2, got', dim(x,1));
      stop;
   end;
   if dim(x,2) ^= 3 then do;
      put skip list('FAIL controlled_nd: expected 3, got', dim(x,2));
      stop;
   end;
   /* (*,*) reuses the previous shape (fresh data) */
   allocate x (*,*);
   if dim(x,1) ^= 2 then do;
      put skip list('FAIL controlled_nd: expected 2, got', dim(x,1));
      stop;
   end;
   if dim(x,2) ^= 3 then do;
      put skip list('FAIL controlled_nd: expected 3, got', dim(x,2));
      stop;
   end;
   free x;
   free x;
   /* mixed DECLARE with partial reuse */
   allocate y (2,3);
   y(2,3) = 55;
   if y(2,3) ^= 55 then do;
      put skip list('FAIL controlled_nd: expected 55, got', y(2,3));
      stop;
   end;
   allocate y (*,4);
   if dim(y,1) ^= 2 then do;
      put skip list('FAIL controlled_nd: expected 2, got', dim(y,1));
      stop;
   end;
   if dim(y,2) ^= 4 then do;
      put skip list('FAIL controlled_nd: expected 4, got', dim(y,2));
      stop;
   end;
   free y;
   free y;
   /* lb:ub DECLARE keeps its lbs across the override */
   allocate b;
   if lbound(b,1) ^= 0 then do;
      put skip list('FAIL controlled_nd: expected 0, got', lbound(b,1));
      stop;
   end;
   if lbound(b,2) ^= 1 then do;
      put skip list('FAIL controlled_nd: expected 1, got', lbound(b,2));
      stop;
   end;
   if hbound(b,1) ^= 2 then do;
      put skip list('FAIL controlled_nd: expected 2, got', hbound(b,1));
      stop;
   end;
   if hbound(b,2) ^= 3 then do;
      put skip list('FAIL controlled_nd: expected 3, got', hbound(b,2));
      stop;
   end;
   b(2,3) = 23;
   allocate b (2,2);
   if lbound(b,1) ^= 0 then do;
      put skip list('FAIL controlled_nd: expected 0, got', lbound(b,1));
      stop;
   end;
   if hbound(b,1) ^= 1 then do;
      put skip list('FAIL controlled_nd: expected 1, got', hbound(b,1));
      stop;
   end;
   if hbound(b,2) ^= 2 then do;
      put skip list('FAIL controlled_nd: expected 2, got', hbound(b,2));
      stop;
   end;
   b(1,2) = 42;
   if b(1,2) ^= 42 then do;
      put skip list('FAIL controlled_nd: expected 42, got', b(1,2));
      stop;
   end;
   free b;
   free b;
   put skip list('PASS controlled_nd');
 end nd_ctl_test;
