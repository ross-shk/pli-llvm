 /* P picture output of a scaled FIXED BINARY (rule (53), ADR-288):
    the formatter works in decimal, so the stored raw/2^q value is
    truncated at the picture's fractional positions before it is edited.
    TR 25.084 rules (16),(17),(53). */
 scaledpic: procedure options(main);
    declare b fixed bin(15,2);
    declare h fixed bin(31,15);
    declare a char(20);

    /* 2.5 -> 250 at scale 2; the picture prints the point. */
    b = 2.5;
    put string(a) edit(b) (p('ZZ9.99'));
    if substr(a,1,6) ^= '  2.50' then do;
       put skip list('FAIL 2.5: got >', substr(a,1,6), '<');
       stop;
    end;

    /* A negative value keeps its sign position. */
    b = -2.5;
    put string(a) edit(b) (p('SZZ9.99'));
    if substr(a,1,7) ^= '-  2.50' then do;
       put skip list('FAIL -2.5: got >', substr(a,1,7), '<');
       stop;
    end;

    /* Fewer fractional positions: truncate toward zero, no rounding. */
    b = 1.25;
    put string(a) edit(b) (p('9.9'));
    if substr(a,1,3) ^= '1.2' then do;
       put skip list('FAIL 1.25: got >', substr(a,1,3), '<');
       stop;
    end;

    /* A picture with no fractional positions truncates to an integer. */
    b = 2.75;
    put string(a) edit(b) (p('9'));
    if substr(a,1,1) ^= '2' then do;
       put skip list('FAIL 2.75: expected 2, got >', substr(a,1,1), '<');
       stop;
    end;

    /* A value below one keeps all of its fractional digits. */
    b = 0.75;
    put string(a) edit(b) (p('9.99'));
    if substr(a,1,4) ^= '0.75' then do;
       put skip list('FAIL 0.75: got >', substr(a,1,4), '<');
       stop;
    end;

    /* A high binary scale rescales exactly for the positions shown. */
    h = 0.75;
    put string(a) edit(h) (p('9.99'));
    if substr(a,1,4) ^= '0.75' then do;
       put skip list('FAIL bin(31,15): got >', substr(a,1,4), '<');
       stop;
    end;

    /* Truncation to zero keeps the sign of the original value. */
    b = -0.5;
    put string(a) edit(b) (p('-9'));
    if substr(a,1,2) ^= '-0' then do;
       put skip list('FAIL -0.5 sign: got >', substr(a,1,2), '<');
       stop;
    end;

    /* Zero fills the fractional positions. */
    b = 0.0;
    put string(a) edit(b) (p('ZZ9.99'));
    if substr(a,1,6) ^= '  0.00' then do;
       put skip list('FAIL zero: got >', substr(a,1,6), '<');
       stop;
    end;

    put skip list('PASS scaled_picture');
 end scaledpic;
