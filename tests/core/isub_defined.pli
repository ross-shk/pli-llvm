   /* iSUB (rule 134) and subscripted DEFINED base (rule 24): DECLARE Y DEFINED
      X(1SUB) overlays one axis of X as a live 1-D view; DECLARE Z DEFINED X(c, c)
      overlays a single element. Reads/writes through the overlay are visible in
      the base and vice versa. */
   isub_defined_test: procedure options(main);
      declare a(3, 4) fixed bin(31);
      declare r(4) fixed bin(31) defined a(2, 1SUB);
      declare x(3) fixed bin(31);
      declare y(3) fixed bin(31) defined x(1SUB);
      declare z fixed bin(31) defined a(2, 3);

      do i = 1 to 3;
         do j = 1 to 4;
            a(i, j) = 10 * i + j;
         end;
      end;


      /* r(i) is a live view of a(2, i) */
      do j = 1 to 4;
         if r(j) ^= 20 + j then do;
            put skip list('FAIL isub_defined: check at line 25 failed');
            stop;
         end;
      end;
      r(1) = 100;
      if a(2, 1) ^= 100 then do;
         put skip list('FAIL isub_defined: expected 100, got', a(2, 1));
         stop;
      end;

      /* whole-array iSUB: y(i) aliases x(i) */
      do i = 1 to 3;
         x(i) = i * 7;
      end;
      do i = 1 to 3;
         if y(i) ^= i * 7 then do;
            put skip list('FAIL isub_defined: check at line 35 failed');
            stop;
         end;
      end;
      y(2) = 99;
      if x(2) ^= 99 then do;
         put skip list('FAIL isub_defined: expected 99, got', x(2));
         stop;
      end;

      /* element overlay: z aliases a(2, 3) */
      if z ^= 23 then do;
         put skip list('FAIL isub_defined: expected 23, got', z);
         stop;
      end;
      z = 44;
      if a(2, 3) ^= 44 then do;
         put skip list('FAIL isub_defined: expected 44, got', a(2, 3));
         stop;
      end;

   put skip list('PASS isub_defined');
   end isub_defined_test;
