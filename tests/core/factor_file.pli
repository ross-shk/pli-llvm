 /* Rules (11),(39): a factored declaration gives FILE to every name,
    so both names open, write and read as their own file. */
 factor_file: procedure options(main);
    declare (fa, fb) file;
    declare x char(20);
    declare y char(20);
    open file(fa) title('tests/core/out/factor_file_a.txt') output;
    put file(fa) skip list('alpha');
    close file(fa);
    open file(fb) title('tests/core/out/factor_file_b.txt') output;
    put file(fb) skip list('beta');
    close file(fb);
    open file(fa) title('tests/core/out/factor_file_a.txt') input;
    get file(fa) skip list(x);
    close file(fa);
    open file(fb) title('tests/core/out/factor_file_b.txt') input;
    get file(fb) skip list(y);
    close file(fb);
    if x = 'alpha' & y = 'beta' then
       put skip list('PASS factor_file');
    else
       put skip list('FAIL factor_file', x, y);
 end factor_file;
