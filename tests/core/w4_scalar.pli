 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* W4: scalar math and conversion operations — MOD (float), ROUND,
    FIXED(float), FIXED(char), CHAR(fixed), CHAR(float).
    Edge cases: sign-of-divisor, round-half, truncation, NaN, Inf,
    empty/no-digit text, leading blanks. */
 w4_scalar: procedure options(main);
    declare f float(6);
    declare x fixed bin(31);
    declare s char(24);
    declare v char(24) varying;
    declare d fixed dec(5,2);
    declare w fixed dec(31,0);


    /* --- MOD (float): result takes sign of divisor --- */
    f = mod(7.5, 2.0);
    if f ^= 1.5 then do;
       put skip list('FAIL mod(7.5,2.0) =', f);
       stop;
    end;
    f = mod(-7.5, 2.0);
    if f ^= 0.5 then do;
       put skip list('FAIL mod(-7.5,2.0) =', f);
       stop;
    end;
    f = mod(7.5, -2.0);
    if f ^= -0.5 then do;
       put skip list('FAIL mod(7.5,-2.0) =', f);
       stop;
    end;

    /* --- ROUND: round-half-away-from-zero --- */
    f = round(2.5, 0);
    if f ^= 3.0 then do;
       put skip list('FAIL round(2.5,0) =', f);
       stop;
    end;
    f = round(3.5, 0);
    if f ^= 4.0 then do;
       put skip list('FAIL round(3.5,0) =', f);
       stop;
    end;
    f = round(2.345, 2);
    if f ^= 2.35 then do;
       put skip list('FAIL round(2.345,2) =', f);
       stop;
    end;
    f = round(2.344, 2);
    if f ^= 2.34 then do;
       put skip list('FAIL round(2.344,2) =', f);
       stop;
    end;

    /* --- FIXED(float): truncate toward zero --- */
    x = fixed(3.14);
    if x ^= 3 then do;
       put skip list('FAIL fixed(3.14) =', x);
       stop;
    end;
    x = fixed(-3.9);
    if x ^= -3 then do;
       put skip list('FAIL fixed(-3.9) =', x);
       stop;
    end;
    x = fixed(0.0);
    if x ^= 0 then do;
       put skip list('FAIL fixed(0.0) =', x);
       stop;
    end;

    /* --- FIXED(char): parse with sign and leading blanks --- */
    x = fixed('123');
    if x ^= 123 then do;
       put skip list('FAIL fixed(123) =', x);
       stop;
    end;
    x = fixed('  -42abc');
    if x ^= -42 then do;
       put skip list('FAIL fixed(-42abc) =', x);
       stop;
    end;

    /* --- FIXED(char) exponent text --- */
    x = fixed('1e3');
    if x ^= 1000 then do;
       put skip list('FAIL fixed(1e3) =', x);
       stop;
    end;
    x = fixed('2.5e2');
    if x ^= 250 then do;
       put skip list('FAIL fixed(2.5e2) =', x);
       stop;
    end;
    x = fixed('-1.25e1');
    if x ^= -12 then do;
       put skip list('FAIL fixed(-1.25e1) =', x);
       stop;
    end;
    x = fixed('1.5e-1');
    if x ^= 0 then do;
       put skip list('FAIL fixed(1.5e-1) =', x);
       stop;
    end;
    d = fixeddec('1.25e2', 5, 2);
    if d ^= 125.00 then do;
       put skip list('FAIL fixeddec(1.25e2) =', d);
       stop;
    end;
    x = fixed('0e999');
    if x ^= 0 then do;
       put skip list('FAIL fixed(0e999) =', x);
       stop;
    end;
    x = fixed('0e-999');
    if x ^= 0 then do;
       put skip list('FAIL fixed(0e-999) =', x);
       stop;
    end;
    /* A wide mantissa with a positive exponent exercises i512. */
    w = fixeddec('12345678901234567890e2', 31, 0);
    if w ^= 1234567890123456789000 then do;
       put skip list('FAIL fixeddec(wide exponent) =', w);
       stop;
    end;

    /* FIXED(char) with no digits raises CONVERSION; with NOCONVERSION,
       the resume value is 0 (runtime: the fixed-text parser sets ok=0). */
    (noconversion):
       x = fixed('xyz');
    if x ^= 0 then do;
       put skip list('FAIL noconv fixed(xyz) =', x);
       stop;
    end;

    /* --- CHAR(fixed) via concatenation (rule 119) --- */
    s = trim('v=' || 42);
    if s ^= 'v=42' then do;
       put skip list('FAIL char(42) =', trim('v=' || 42));
       stop;
    end;
    s = trim('x=' || -7);
    if s ^= 'x=-7' then do;
       put skip list('FAIL char(-7) =', trim('x=' || -7));
       stop;
    end;
    s = trim('z=' || 0);
    if s ^= 'z=0' then do;
       put skip list('FAIL char(0) =', trim('z=' || 0));
       stop;
    end;

    /* --- CHAR(float) via concatenation (rule 119) --- */
    f = 3.5;
    v = trim('r=' || f);
    if v ^= 'r=3.5' then do;
       put skip list('FAIL char(3.5) =', trim('r=' || f));
       stop;
    end;
    f = 0.0;
    v = trim('z=' || f);
    if v ^= 'z=0' then do;
       put skip list('FAIL char(0.0) =', trim('z=' || f));
       stop;
    end;

   put skip list('PASS w4_scalar');
 end w4_scalar;
