 /* Copyright 2026 Ross S. - plic: a PL/I compiler targeting LLVM */
 /* W4: scalar math and conversion operations — MOD (float), ROUND,
    FIXED(float), FIXED(char), CHAR(fixed), CHAR(float).
    Edge cases: sign-of-divisor, round-half, truncation, NaN, Inf,
    empty/no-digit text, leading blanks. */
 w4_scalar: procedure options(main);
    declare fails fixed bin(31);
    declare f float(6);
    declare x fixed bin(31);
    declare s char(24);
    declare v char(24) varying;

    fails = 0;

    /* --- MOD (float): result takes sign of divisor --- */
    f = mod(7.5, 2.0);
    if f ^= 1.5 then do;
       fails = fails + 1;
       put skip list('FAIL mod(7.5,2.0) =', f);
    end;
    f = mod(-7.5, 2.0);
    if f ^= 0.5 then do;
       fails = fails + 1;
       put skip list('FAIL mod(-7.5,2.0) =', f);
    end;
    f = mod(7.5, -2.0);
    if f ^= -0.5 then do;
       fails = fails + 1;
       put skip list('FAIL mod(7.5,-2.0) =', f);
    end;

    /* --- ROUND: round-half-away-from-zero --- */
    f = round(2.5, 0);
    if f ^= 3.0 then do;
       fails = fails + 1;
       put skip list('FAIL round(2.5,0) =', f);
    end;
    f = round(3.5, 0);
    if f ^= 4.0 then do;
       fails = fails + 1;
       put skip list('FAIL round(3.5,0) =', f);
    end;
    f = round(2.345, 2);
    if f ^= 2.35 then do;
       fails = fails + 1;
       put skip list('FAIL round(2.345,2) =', f);
    end;
    f = round(2.344, 2);
    if f ^= 2.34 then do;
       fails = fails + 1;
       put skip list('FAIL round(2.344,2) =', f);
    end;

    /* --- FIXED(float): truncate toward zero --- */
    x = fixed(3.14);
    if x ^= 3 then do;
       fails = fails + 1;
       put skip list('FAIL fixed(3.14) =', x);
    end;
    x = fixed(-3.9);
    if x ^= -3 then do;
       fails = fails + 1;
       put skip list('FAIL fixed(-3.9) =', x);
    end;
    x = fixed(0.0);
    if x ^= 0 then do;
       fails = fails + 1;
       put skip list('FAIL fixed(0.0) =', x);
    end;

    /* --- FIXED(char): parse with sign and leading blanks --- */
    x = fixed('123');
    if x ^= 123 then do;
       fails = fails + 1;
       put skip list('FAIL fixed(123) =', x);
    end;
    x = fixed('  -42abc');
    if x ^= -42 then do;
       fails = fails + 1;
       put skip list('FAIL fixed(-42abc) =', x);
    end;

    /* FIXED(char) with no digits raises CONVERSION; with NOCONVERSION,
       the resume value is 0 (runtime: pli_fixed_of_char sets ok=0). */
    (noconversion):
       x = fixed('xyz');
    if x ^= 0 then do;
       fails = fails + 1;
       put skip list('FAIL noconv fixed(xyz) =', x);
    end;

    /* --- CHAR(fixed) via concatenation (rule 119) --- */
    s = trim('v=' || 42);
    if s ^= 'v=42' then do;
       fails = fails + 1;
       put skip list('FAIL char(42) =', trim('v=' || 42));
    end;
    s = trim('x=' || -7);
    if s ^= 'x=-7' then do;
       fails = fails + 1;
       put skip list('FAIL char(-7) =', trim('x=' || -7));
    end;
    s = trim('z=' || 0);
    if s ^= 'z=0' then do;
       fails = fails + 1;
       put skip list('FAIL char(0) =', trim('z=' || 0));
    end;

    /* --- CHAR(float) via concatenation (rule 119) --- */
    f = 3.5;
    v = trim('r=' || f);
    if v ^= 'r=3.5' then do;
       fails = fails + 1;
       put skip list('FAIL char(3.5) =', trim('r=' || f));
    end;
    f = 0.0;
    v = trim('z=' || f);
    if v ^= 'z=0' then do;
       fails = fails + 1;
       put skip list('FAIL char(0.0) =', trim('z=' || f));
    end;

    if fails = 0 then put skip list('PASS w4_scalar');
    else put skip list('FAIL w4_scalar: fails =', fails);
 end w4_scalar;
