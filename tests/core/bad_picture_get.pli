 /* Picture-directed input is a B1 item: GET into a PICTURE variable is
    diagnosed rather than copying the field characters (rule (109)). */
 bad_picture_get: procedure options(main);
    declare p picture('ZZ9.99');
    get list(p);
 end bad_picture_get;
