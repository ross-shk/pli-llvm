 /* Rules (11),(26): factored INITIAL — each name gets its own initializer. */
 factored_initial: procedure options(main);
     declare (a, b, c) fixed bin(31) initial((1), (2), (3));
     if a ¬= 1 | b ¬= 2 | c ¬= 3 then do;
        put skip list('FAIL factored_initial scalars', a, b, c);
        stop;
     end;
     declare (x, y)(5) fixed bin(31) initial((1,2,3,4,5), (5,4,3,2,1));
     if x(3) ¬= 3 | y(3) ¬= 3 then do;
        put skip list('FAIL factored_initial arrays', x(3), y(3));
        stop;
     end;
     /* Iteration factor in factored INITIAL — each name gets its own itemlist.
        Per PL/I, per-name itemlists are parenthesized: ((itemlist1)), ((itemlist2)). */
     declare (p, q)(6) fixed bin(31) initial(((6)(0)), ((3)(1,2)));
     /* p = 0,0,0,0,0,0 ; q = 1,2,1,2,1,2 */
     if p(1) ¬= 0 | q(1) ¬= 1 | q(2) ¬= 2 | q(3) ¬= 1 then do;
        put skip list('FAIL factored_initial iter', p(1), q(1), q(2), q(3));
        stop;
     end;
     put skip list('PASS factored_initial');
 end factored_initial;