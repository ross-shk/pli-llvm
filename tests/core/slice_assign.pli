   /* Slice assignment (rule 126): a cross-section A(i, *) on the
      left of '=' denotes a reduced-rank view that is written
      element-wise. Covers a numeric row and column, a 3-D
      sub-block, a whole array into a slice, a scalar broadcast,
      and a CHARACTER(1) array member. */
   slice_assign_test: procedure options(main);
      declare a(3, 4) fixed bin(31);
      declare b(3, 4) fixed bin(31);
      declare m(3, 4) fixed bin(31);
      declare r(4) fixed bin(31);
      declare c(3) fixed bin(31);
      declare d(2, 3, 4) fixed bin(31);
      declare 1 s,
             2 q(2, 3) char(1);
      declare i fixed bin(31), j fixed bin(31);

      do i = 1 to 3;
         do j = 1 to 4;
            a(i, j) = 10 * i + j;
            b(i, j) = 10 * i + j;
         end;
      end;
      do j = 1 to 4;
         r(j) = 100 + j;
      end;
      do i = 1 to 3;
         c(i) = 200 + i;
      end;


      /* row slice to row slice: a(3, *) = a(1, *) -> {11,12,13,14} */
      a(3, *) = a(1, *);
      do j = 1 to 4;
         if a(3, j) ^= 10 + j then do;
            put skip list('FAIL slice_assign: check at line 38 failed');
            stop;
         end;
      end;

      /* column slice to column slice: b(*, 4) = b(*, 2) */
      b(*, 4) = b(*, 2);
      do i = 1 to 3;
         if b(i, 4) ^= 10 * i + 2 then do;
            put skip list('FAIL slice_assign: check at line 44 failed');
            stop;
         end;
      end;

      /* whole array into a row slice, then a scalar broadcast */
      m(2, *) = r;
      do j = 1 to 4;
         if m(2, j) ^= 100 + j then do;
            put skip list('FAIL slice_assign: check at line 50 failed');
            stop;
         end;
      end;
      m(3, *) = 0;
      do j = 1 to 4;
         if m(3, j) ^= 0 then do;
            put skip list('FAIL slice_assign: expected 0, got',
               m(3, j));
            stop;
         end;
      end;

      /* whole array into a column slice: m(*, 1) = c */
      m(*, 1) = c;
      do i = 1 to 3;
         if m(i, 1) ^= 200 + i then do;
            put skip list('FAIL slice_assign: check at line 60 failed');
            stop;
         end;
      end;

      /* 3-D sub-block with a runtime first axis */
      do i = 1 to 2;
         do j = 1 to 3;
            do k = 1 to 4;
               d(i, j, k) = 100 * i + 10 * j + k;
            end;
         end;
      end;
      i = 2;
      d(i, *, *) = d(1, *, *);
      do j = 1 to 3;
         do k = 1 to 4;
            if d(2, j, k) ^= 100 + 10 * j + k then do;
               put skip list('FAIL slice_assign: check at line 75 failed');
               stop;
            end;
         end;
      end;

      /* CHARACTER(1) array member slice: s.q(2, *) = s.q(1, *) */
      do j = 1 to 3;
         s.q(1, j) = 'x';
         s.q(2, j) = 'y';
      end;
      s.q(2, *) = s.q(1, *);
      do j = 1 to 3;
         if s.q(2, j) ^= 'x' then do;
            put skip list('FAIL slice_assign: expected x, got',
               s.q(2, j));
            stop;
         end;
      end;

   put skip list('PASS slice_assign');
   end slice_assign_test;
