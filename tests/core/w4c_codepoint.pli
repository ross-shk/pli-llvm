/* W4c: RANK, COLLATE, ISOCHAR — code-point operations.
   Edge cases: empty string (RANK->0), n mod 256 for COLLATE,
   ISOCHAR range lo>hi (zero fill), ISOCHAR range > dstcap (clip). */
w4c_codepoint: procedure options(main);
   declare c char(1);
   declare s char(16);
   declare n fixed bin(31);


   /* RANK: code point of first character */
   c = 'A';
   n = rank(c);
   if n ^= 65 then do;
      put skip list('FAIL rank(A) =', n);
      stop;
   end;

   c = 'a';
   n = rank(c);
   if n ^= 97 then do;
      put skip list('FAIL rank(a) =', n);
      stop;
   end;

   /* RANK of space-only string: first char is space, code 32 */
   s = '';
   n = rank(s);
   if n ^= 32 then do;
      put skip list('FAIL rank(" ") =', n);
      stop;
   end;

   /* COLLATE: character for code n (mod 256) */
   s = collate(65);
   if substr(s, 1, 1) ^= 'A' then do;
      put skip list('FAIL collate(65) =', substr(s, 1, 1));
      stop;
   end;

   s = collate(65 + 256);
   if substr(s, 1, 1) ^= 'A' then do;
      put skip list('FAIL collate(321) mod =', substr(s, 1, 1));
      stop;
   end;

   /* ISOCHAR: fill dst with chars from lo to hi */
   s = isochar(65, 67);
   if substr(s, 1, 1) ^= 'A' then do;
      put skip list('FAIL isochar(65,67)[1] =', substr(s, 1, 1));
      stop;
   end;
   if substr(s, 2, 1) ^= 'B' then do;
      put skip list('FAIL isochar(65,67)[2] =', substr(s, 2, 1));
      stop;
   end;
   if substr(s, 3, 1) ^= 'C' then do;
      put skip list('FAIL isochar(65,67)[3] =', substr(s, 3, 1));
      stop;
   end;

   put skip list('PASS w4c_codepoint');
end w4c_codepoint;
