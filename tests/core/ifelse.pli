/* IF ... THEN ... ELSE, including nested statements and a DO group as
   the then-branch.  TR 25.084 rules (74) if-statement, (75) if-clause,
   (76) balanced-statement, (115)-(118) expressions. */
 IFELSE: PROCEDURE OPTIONS(MAIN);
   DECLARE I FIXED BINARY(31);
   DECLARE GRADE CHARACTER(4);

   I = 17;

   IF I > 10 THEN
      PUT SKIP LIST('big');
   ELSE
      PUT SKIP LIST('small');

   /* The ELSE binds to the innermost unmatched IF (rule 76). */
   IF I > 10 THEN
      IF I > 100 THEN PUT SKIP LIST('huge');
      ELSE PUT SKIP LIST('medium');

   /* A DO group as the controlled statement. */
   IF I ¬= 0 & I < 20 THEN DO;
      GRADE = 'PASS';
      PUT SKIP LIST('grade', GRADE);
   END;

   IF I = 17 | I = 18 THEN PUT SKIP LIST('seventeen-ish');

   IF ¬(I = 17) THEN PUT SKIP LIST('not 17');
   ELSE PUT SKIP LIST('is 17');
 END IFELSE;
