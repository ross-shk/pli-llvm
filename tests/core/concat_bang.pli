 /* Concatenation with the !! alias (rule (119)): 'a' !! 'b'
    concatenates exactly like ||, including chained uses. */
 bang: procedure options(main);
    declare s char(8);
    declare fails fixed bin(31);
    fails = 0;
    s = 'a' !! 'b';
    if substr(s, 1, 2) ^= 'ab' then fails = fails + 1;
    s = 'x' !! 'y' !! 'z';
    if substr(s, 1, 3) ^= 'xyz' then fails = fails + 1;
    if fails = 0 then put skip list('PASS bang');
    else put skip list('FAIL bang: fails =', fails);
 end bang;
