 /* extension (ADR-109): bad EXPORTS names and unsupported
    PACKAGE attribute combinations are diagnosed; basic
    package-level data (static scalar) compiles cleanly. */
 lib: package exports(nosuch);
     declare counter fixed bin(31) init(0);
     getter: procedure;
        declare dummy fixed bin(31);
        dummy = 0;
     end getter;
  end lib;
  main: procedure options(main);
     put skip list('x');
  end main;
