 /* MIN built-in function: min(a, b) returns the smaller of two numeric
    values, computed in their common arithmetic type. M2 arithmetic built-in
    (Y33-6003 MIN). */
 min_test: procedure options(main);
    declare x fixed bin(31);
    declare y float dec(6);
    declare fails fixed bin(31);

    fails = 0;

    x = min(3, 7);
    if x ^= 3 then do;
       fails = fails + 1;
       put skip list('FAIL min(3,7) =', x);
    end;

    x = min(-5, 2);
    if x ^= -5 then do;
       fails = fails + 1;
       put skip list('FAIL min(-5,2) =', x);
    end;

    y = min(2.5, 1.5);
    if y ^= 1.5 then do;
       fails = fails + 1;
       put skip list('FAIL min(2.5,1.5) =', y);
    end;

    /* MIN with mixed FIXED/FLOAT computes in FLOAT. */
    y = min(3, 2.5);
    if y ^= 2.5 then do;
       fails = fails + 1;
       put skip list('FAIL min(3,2.5) =', y);
    end;

    if fails = 0 then put skip list('PASS min');
    else put skip list('FAIL min: fails =', fails);
 end min_test;
