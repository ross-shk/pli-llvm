   /* iSUB / DEFINED subscript restrictions (rules 134,24): the iSUB dummy may
      appear only once, and an iSUB base requires a matching 1-D array item. */
   bad_isub_defined: procedure options(main);
      declare a(3, 4) fixed bin(31);
      declare bad1(4) fixed bin(31) defined a(1SUB, 2SUB);  /* two iSUBs */
      declare bad2 fixed bin(31) defined a(2, 1SUB);        /* scalar item, iSUB base */
   end bad_isub_defined;
