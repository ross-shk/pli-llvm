/* STATIC structure INITIAL with non-constant expression (rules 23,26) */
bad_struct_static: procedure options(main);
    dcl x fixed bin(31) init(5);
    dcl 1 s static,
        2 a fixed bin(31) init(x);  /* ERROR (23),(26): not a constant */
    put skip list('FAIL - should not reach here');
end bad_struct_static;