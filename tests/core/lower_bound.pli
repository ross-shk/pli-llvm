 /* SPDX-License-Identifier: Apache-2.0 */
 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* rules (12),(13),(126): a constant subscript selects (index minus
    the lower bound), so A(-3:7), B(0:9) and C(1:10) address the same
     ten-element sequence from three origins (ADR-278, the B1 gate).
    Each store below is reached by a constant subscript, and a compiler
    that dropped the lower bound would store the second value over the
    first. */
 lower_bound: procedure options(main);
    declare a(-3:7) fixed bin(31);
    declare b(0:9) fixed bin(31);
    declare c(1:10) fixed bin(31);

    /* the first, a middle and the last element of each range */
    a(-3) = 1;
    a(0) = 4;
    a(7) = 11;
    b(0) = 1;
    b(3) = 4;
    b(9) = 11;
    c(1) = 1;
    c(4) = 4;
    c(10) = 11;

    /* every range answers with the value its own store put there */
    if a(-3) ^= 1 then do;
       put skip list('FAIL lower_bound: expected 1, got', a(-3));
       stop;
    end;
    if a(0) ^= 4 then do;
       put skip list('FAIL lower_bound: expected 4, got', a(0));
       stop;
    end;
    if a(7) ^= 11 then do;
       put skip list('FAIL lower_bound: expected 11, got', a(7));
       stop;
    end;
    if b(0) ^= 1 then do;
       put skip list('FAIL lower_bound: expected 1, got', b(0));
       stop;
    end;
    if b(3) ^= 4 then do;
       put skip list('FAIL lower_bound: expected 4, got', b(3));
       stop;
    end;
    if b(9) ^= 11 then do;
       put skip list('FAIL lower_bound: expected 11, got', b(9));
       stop;
    end;
    if c(1) ^= 1 then do;
       put skip list('FAIL lower_bound: expected 1, got', c(1));
       stop;
    end;
    if c(4) ^= 4 then do;
       put skip list('FAIL lower_bound: expected 4, got', c(4));
       stop;
    end;
    if c(10) ^= 11 then do;
       put skip list('FAIL lower_bound: expected 11, got', c(10));
       stop;
    end;

    /* the same position in the three ranges answers identically */
    if a(-3) ^= b(0) then do;
       put skip list('FAIL lower_bound: check at line 39 failed');
       stop;
    end;
    if b(0) ^= c(1) then do;
       put skip list('FAIL lower_bound: check at line 40 failed');
       stop;
    end;
    if a(0) ^= b(3) then do;
       put skip list('FAIL lower_bound: check at line 41 failed');
       stop;
    end;
    if b(3) ^= c(4) then do;
       put skip list('FAIL lower_bound: check at line 42 failed');
       stop;
    end;
    if a(7) ^= b(9) then do;
       put skip list('FAIL lower_bound: check at line 43 failed');
       stop;
    end;
    if b(9) ^= c(10) then do;
       put skip list('FAIL lower_bound: check at line 44 failed');
       stop;
    end;

    /* the declared bounds are the ones the program sees */
    if lbound(a) ^= -3 then do;
       put skip list('FAIL lower_bound: expected -3, got', lbound(a));
       stop;
    end;
    if hbound(a) ^= 7 then do;
       put skip list('FAIL lower_bound: expected 7, got', hbound(a));
       stop;
    end;
    if lbound(b) ^= 0 then do;
       put skip list('FAIL lower_bound: expected 0, got', lbound(b));
       stop;
    end;
    if hbound(c) ^= 10 then do;
       put skip list('FAIL lower_bound: expected 10, got', hbound(c));
       stop;
    end;

   put skip list('PASS lower_bound');
 end lower_bound;
