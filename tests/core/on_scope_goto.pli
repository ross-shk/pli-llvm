 /* Copyright 2026 Ross S. - plic: a PL/I compiler targeting LLVM */
 /* Rules (81),(91): a local GO TO that leaves BEGIN blocks
    terminates them (Y33 "Activation and Termination of
    Blocks"), reverting the ON-units those blocks established;
    the enclosing handler is top again. Each loop iteration
    re-arms a fresh inner handler; the block exit disarms it. */
 on_scope_goto: procedure options(main);
   dcl i    fixed bin(31);
   dcl z    fixed bin(31) init(0);
   dcl x    fixed bin(31);
   dcl hits fixed bin(31) init(0);

   /* Procedure-body handler: fallback once blocks are left. */
   on zerodivide hits = hits + 100;

   /* Leave two nested blocks: both inner handlers are reverted. */
   do i = 1 to 2;
     begin;                               /* block A */
       on zerodivide hits = hits + 10;
       begin;                             /* block B */
         on zerodivide hits = hits + i;
         if i = 1 then goto after_both;   /* leaves B and A */
       end;
     end;
   after_both: ;
     x = 100 / z;                         /* top = fallback (+100) */
   end;

   /* Leave only the inner block: block A's handler is exposed. */
   do i = 1 to 2;
     begin;                               /* block A */
       on zerodivide hits = hits + 1000;
       begin;                             /* block B */
         on zerodivide hits = hits + i;
         if i = 1 then goto after_b;      /* leaves B only */
       end;
     after_b: ;
       x = 100 / z;                    /* top = A's handler (+1000) */
     end;
   end;

   /* Phase 1: 2 * 100 = 200; phase 2: 2 * 1000 = 2000; total 2200. */
   put skip list('hits=', hits);
   if hits = 2200 then put skip list('PASS on_scope_goto');
   else put skip list('FAIL on_scope_goto');
 end on_scope_goto;
