/* rule (113): LOCATE on READ should be diagnosed. */
bad_record_locate_read: proc options(main);
  dcl f file;
  dcl x based(p) fixed bin(31);
  dcl p pointer;
  open file(f) record sequential input title('bad_locate.dat');
  read file(f) locate(x) into(x);  /* LOCATE only valid on WRITE */
  close file(f);
end bad_record_locate_read;