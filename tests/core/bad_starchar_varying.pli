 /* Rule (18): CHARACTER(*) VARYING parameters are not implemented in this
    stage; diagnosed, never silently treated as fixed-length. */
 bad_starchar_varying: procedure options(main);
    declare buf char(10);
    call s(buf);
 s: procedure(b);
    declare b char(*) varying;
    b = 'hi';
 end s;
 end bad_starchar_varying;
