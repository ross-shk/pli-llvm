 /* P6.1b: by-value params must preserve PL/I by-reference semantics —
    recursion, visible param stores, nested capture, mixed conventions,
    and OPTIONAL omission must all behave exactly as before. */
 byval_semantics: procedure options(main);
   declare (y, y2) fixed bin(31);
   declare r fixed bin(63);
   fact: procedure(n) recursive returns(fixed bin(31));
     declare n fixed bin(31);
     if n <= 1 then return(1);
     return(n * fact(n - 1));
   end fact;
   /* A stored-to param stays by reference: the caller must observe it. */
   bump: procedure(x) returns(fixed bin(31));
     declare x fixed bin(31);
     x = x + 10;
     return(x);
   end bump;
   /* A param captured by a nested procedure stays by reference. */
   outer: procedure(q) returns(fixed bin(31));
     declare q fixed bin(31);
     inner: procedure() returns(fixed bin(31));
       return(q * 2);
     end inner;
     return(inner() + q);
   end outer;
   /* Mixed convention: a stays by value, b stays by reference. */
   mix: procedure(a, b) returns(fixed bin(31));
     declare a fixed bin(31);
     declare b fixed bin(31);
     b = b + 1;
     return(a + b);
   end mix;
   /* An OPTIONAL param stays by reference so omission still works. */
   maybe: procedure(v) returns(fixed bin(31));
     declare v fixed bin(31) optional;
     if omitted(v) then return(-1);
     return(v);
   end maybe;
   if fact(10) ^= 3628800 then do;
      put skip list('FAIL byval_semantics: expected 3628800, got',
         fact(10));
      stop;
   end;
   if fact(0) ^= 1 then do;
      put skip list('FAIL byval_semantics: expected 1, got', fact(0));
      stop;
   end;
   if fact(1) ^= 1 then do;
      put skip list('FAIL byval_semantics: expected 1, got', fact(1));
      stop;
   end;
   y = 5;
   r = bump(y);
   if r ^= 15 then do;
      put skip list('FAIL byval_semantics: expected 15, got', r);
      stop;
   end;
   if y ^= 15 then do;
      put skip list('FAIL byval_semantics: expected 15, got', y);
      stop;
   end;
   if outer(21) ^= 63 then do;
      put skip list('FAIL byval_semantics: expected 63, got',
         outer(21));
      stop;
   end;
   y2 = 5;
   r = mix(100, y2);
   if r ^= 106 then do;
      put skip list('FAIL byval_semantics: expected 106, got', r);
      stop;
   end;
   if y2 ^= 6 then do;
      put skip list('FAIL byval_semantics: expected 6, got', y2);
      stop;
   end;
   if maybe(7) ^= 7 then do;
      put skip list('FAIL byval_semantics: expected 7, got', maybe(7));
      stop;
   end;
   if maybe(*) ^= -1 then do;
      put skip list('FAIL byval_semantics: expected -1, got', maybe(*));
      stop;
   end;
   put skip list('PASS byval_semantics');
 end byval_semantics;
