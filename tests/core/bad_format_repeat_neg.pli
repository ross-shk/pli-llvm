 /* rule (47): a negative repetition count is diagnosed. */
 bad_format_repeat_neg: procedure options(main);
    declare buf char(40);
    declare a fixed bin(31);
    a = 1;
    put string(buf) edit(a) ((-1)(f(4)));
 end bad_format_repeat_neg;

 f: proc(k) returns(fixed bin(31));
    declare k fixed bin(31);
    return(k);
 end f;
