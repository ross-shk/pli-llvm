  /* extension (ADR-109) + rules (13),(15),(26),(87)-(90): package-scope
     CONTROLLED declarations. A package member shares one
     program-lifetime generation: fixed arrays serve bare and
     overriding ALLOCATEs with live bounds, and member INITIAL
     assigns with each allocation (SC26-3114), not once. */
 arraypkg: package exports(fill, getcell, gethb, initcheck);
    declare grid(3,4) fixed bin(31) controlled;
    declare 1 rec controlled aligned,
       2 n fixed bin(31) init(0);
    fill: procedure();
       allocate grid (2,2);
       grid(2,2) = 22;
    end fill;
    getcell: procedure() returns(fixed bin(31));
       return(grid(2,2));
    end getcell;
    gethb: procedure(k) returns(fixed bin(31));
       declare k fixed bin(31);
       if k = 1 then return(hbound(grid,1));
       return(hbound(grid,2));
    end gethb;
    initcheck: procedure() returns(fixed bin(31));
       declare fails fixed bin(31);
       fails = 0;
       allocate rec;
       if rec.n ^= 0 then fails = fails + 1;
       rec.n = 5;
       free rec;
       allocate rec;
       if rec.n ^= 0 then fails = fails + 1;
       free rec;
       return(fails);
    end initcheck;
 end arraypkg;
 main: procedure options(main);
    declare fill entry() external;
    declare getcell entry() returns(fixed bin(31)) external;
    declare gethb entry(fixed bin(31))
       returns(fixed bin(31)) external;
    declare initcheck entry() returns(fixed bin(31)) external;
    declare fails fixed bin(31);
    fails = 0;
    call fill();
    if getcell() ^= 22 then fails = fails + 1;
    if gethb(1) ^= 2 then fails = fails + 1;
    if gethb(2) ^= 2 then fails = fails + 1;
    fails = fails + initcheck();
    if fails = 0 then put skip list('PASS package_ctl_array');
    else put skip list('FAIL package_ctl_array: fails =', fails);
 end main;
