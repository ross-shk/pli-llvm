 /* rule (97): UNDEFINEDFILE is a file condition, so it needs a FILE
    reference to key its handler. */
 badundefinedfilenofile: procedure options(main);
    declare x fixed bin(31);
    on undefinedfile put skip list(x);
    x = 1;
 end badundefinedfilenofile;
