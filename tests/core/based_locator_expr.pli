 /* SPDX-License-Identifier: Apache-2.0 */
 /* Rules (25),(124): locator is any pointer-valued
    reference, not only a plain pointer variable.
    A handle-pool element s.handles(i) addresses
    a BASED view directly, with no temp copy. */
 blocxpr: procedure options(main);
   dcl i fixed bin(31);
   dcl k fixed bin(31);
   dcl dead pointer;
   dcl 1 tmpl aligned,
     2 fd fixed bin(31),
     2 tag fixed bin(31);
   dcl 1 view based(dead) like tmpl;
   dcl 1 srv aligned,
     2 n fixed bin(31),
     2 handles(4) pointer;
   dcl slots(4) pointer;
   dcl 1 r1 aligned,
     2 fd fixed bin(31),
     2 tag fixed bin(31);
   dcl 1 r2 aligned,
     2 fd fixed bin(31),
     2 tag fixed bin(31);
   r1.fd = 11; r1.tag = 111;
   r2.fd = 22; r2.tag = 222;
   srv.handles(1) = addr(r1);
   srv.handles(2) = addr(r2);
   slots(1) = addr(r1);
   slots(2) = addr(r2);
   /* read through a member-array locator */
   if srv.handles(1) -> view.fd ^= 11 then do;
      put skip list('FAIL based_locator_expr: check at line 33 failed');
      stop;
   end;
   if srv.handles(2) -> view.tag ^= 222 then do;
      put skip list('FAIL based_locator_expr: check at line 35 failed');
      stop;
   end;
   /* read through a plain-array locator */
   if slots(1) -> view.fd ^= 11 then do;
      put skip list('FAIL based_locator_expr: check at line 38 failed');
      stop;
   end;
   /* write through a member-array locator */
   srv.handles(1) -> view.fd = 33;
   if r1.fd ^= 33 then do;
      put skip list('FAIL based_locator_expr: expected 33, got', r1.fd);
      stop;
   end;
   if srv.handles(1) -> view.fd ^= 33 then do;
      put skip list('FAIL based_locator_expr: check at line 43 failed');
      stop;
   end;
   /* a runtime index rides the same path */
   k = 2;
   slots(k) -> view.tag = 444;
   if r2.tag ^= 444 then do;
      put skip list('FAIL based_locator_expr: expected 444, got',
         r2.tag);
      stop;
   end;
   if slots(k) -> view.tag ^= 444 then do;
      put skip list('FAIL based_locator_expr: check at line 49 failed');
      stop;
   end;
   /* locator in a wider expression */
   if (srv.handles(2) -> view.fd) + 1 ^= 23
     then do;
        put skip list('FAIL based_locator_expr: check at line 52 failed');
        stop;
     end;
   /* loop over the pool with a variable index */
   r1.fd = 10; r2.fd = 20;
   do i = 1 to 2;
     if srv.handles(i) -> view.fd <= 0 then do;
        put skip list('FAIL based_locator_expr: check at line 57 failed');
        stop;
     end;
   end;
   if srv.handles(1) -> view.fd ^= 10 then do;
      put skip list('FAIL based_locator_expr: check at line 60 failed');
      stop;
   end;
   if srv.handles(2) -> view.fd ^= 20 then do;
      put skip list('FAIL based_locator_expr: check at line 62 failed');
      stop;
   end;
   put skip list('PASS based_locator_expr');
 end blocxpr;
