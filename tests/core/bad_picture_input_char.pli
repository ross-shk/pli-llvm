 /* A P input target must be numeric or a PICTURE variable; a plain
    CHARACTER item is diagnosed (rule (53), ADR-291). */
 bad_picture_input_char: procedure options(main);
    declare buf char(10);
    declare c char(6);
    get string(buf) edit(c) (p('999.99'));
 end bad_picture_input_char;
