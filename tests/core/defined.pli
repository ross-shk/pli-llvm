   /* DEFINED (rule 24): a declaration overlays the storage of an already-
      declared same-type variable, so the two names share the same memory.
      Covers a scalar overlay and an array overlay (ADR-018 address rule). */
   defined_test: procedure options(main);
      declare x fixed bin(31);
      declare y fixed bin(31) defined x;
      declare a(3) fixed bin(31);
      declare b(3) fixed bin(31) defined a;


      /* scalar overlay: x and y are the same storage */
      x = 7;
      if y ^= 7 then do;
         put skip list('FAIL defined: expected 7, got', y);
         stop;
      end;
      y = 99;
      if x ^= 99 then do;
         put skip list('FAIL defined: expected 99, got', x);
         stop;
      end;

      /* array overlay: writing through b is visible via a, and vice versa */
      a(1) = 10;
      a(2) = 20;
      a(3) = 30;
      if b(1) ^= 10 or b(2) ^= 20 or b(3) ^= 30 then do;
         put skip list('FAIL defined: check at line 25 failed');
         stop;
      end;
      b(2) = 22;
      if a(2) ^= 22 then do;
         put skip list('FAIL defined: expected 22, got', a(2));
         stop;
      end;

   put skip list('PASS defined');
   end defined_test;
