 /* rules (79),(82): the shutdown path under a fan-out. Every round starts
    200 tasks at once, so a thief can move MAIN to another worker while it
    waits; MAIN may then finish there. Worker 0 must not go to sleep after
    that finish, or its wakeup is lost and the process never exits
    (ADR-332). Also guards fiber reuse under contention. */
 task_pool_stress: procedure options(main);
    declare ev(200) event;
    declare i fixed binary(31);
    declare r fixed binary(31);
    declare bad fixed binary(31);
    bad = 0;
    do r = 1 to 20;
       do i = 1 to 200;
          call worker event(ev(i));
       end;
       wait(ev);
       do i = 1 to 200;
          if ^event(ev(i)) then bad = bad + 1;
       end;
    end;
    if bad = 0 then
       put skip list('PASS task_pool_stress');
    else
       put skip list('FAIL task_pool_stress', bad);
    worker: procedure;
    end worker;
 end task_pool_stress;
