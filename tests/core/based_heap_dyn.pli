  /* Dynamic BASED heap arrays (rules (25),
     (89)): ALLOCATE x SET(p) sizes the
     block from the live DECLARE bounds;
     element refs and LBOUND/HBOUND/DIM
     read the same live extent. */
  based_heap_dyn: procedure options(main);
     declare p pointer;
     declare q pointer;
     declare n fixed bin(31);
     declare i fixed bin(31);
     declare j fixed bin(31);
     declare x(n) fixed bin(31) based(p);
     declare h(n) pointer based(q);
     declare g(n, 2) fixed bin(31) based(p);
     declare region area;
     declare xa(n) fixed bin(31) based(p);
     /* 1-D numeric heap with live bounds */
     n = 4;
     allocate x set(p);
     do i = 1 to n;
        x(i) = i * 10;
     end;
     do i = 1 to n;
        if x(i) ^= i * 10 then do;
           put skip list('FAIL based_heap_dyn: check at line 28 failed');
           stop;
        end;
     end;
     if lbound(x) ^= 1 then do;
        put skip list('FAIL based_heap_dyn: expected 1, got',
           lbound(x));
        stop;
     end;
     if hbound(x) ^= 4 then do;
        put skip list('FAIL based_heap_dyn: expected 4, got',
           hbound(x));
        stop;
     end;
     if dim(x) ^= 4 then do;
        put skip list('FAIL based_heap_dyn: expected 4, got', dim(x));
        stop;
     end;
     free x;
     /* re-allocate a new extent: refs
        follow the ALLOCATE-time bound */
     n = 2;
     allocate x set(p);
     x(1) = 21; x(2) = 22;
     if x(1) ^= 21 | x(2) ^= 22
        then do;
           put skip list('FAIL based_heap_dyn: check at line 40 failed');
           stop;
        end;
     if hbound(x) ^= 2 then do;
        put skip list('FAIL based_heap_dyn: expected 2, got',
           hbound(x));
        stop;
     end;
     free x;
     /* POINTER elements on the heap */
     n = 3;
     allocate h set(q);
     h(1) = addr(n);
     h(3) = addr(n);
     if h(1) ^= addr(n) then do;
        put skip list('FAIL based_heap_dyn: check at line 48 failed');
        stop;
     end;
     if h(3) ^= addr(n) then do;
        put skip list('FAIL based_heap_dyn: check at line 49 failed');
        stop;
     end;
     if dim(h) ^= 3 then do;
        put skip list('FAIL based_heap_dyn: expected 3, got', dim(h));
        stop;
     end;
     free h;
     /* 2-D heap, dynamic first axis */
     n = 3;
     allocate g set(p);
     do i = 1 to n;
        do j = 1 to 2;
           g(i, j) = i * 10 + j;
        end;
     end;
     do i = 1 to n;
        do j = 1 to 2;
           if g(i, j) ^= i * 10 + j
              then do;
                 put skip list('FAIL based_heap_dyn: check at line 63 failed');
                 stop;
              end;
        end;
     end;
     if hbound(g, 1) ^= 3 then do;
        put skip list('FAIL based_heap_dyn: expected 3, got',
           hbound(g, 1));
        stop;
     end;
     if hbound(g, 2) ^= 2 then do;
        put skip list('FAIL based_heap_dyn: expected 2, got',
           hbound(g, 2));
        stop;
     end;
     free g;
     /* heap block inside an AREA region */
     n = 4;
     allocate xa in(region) set(p);
     do i = 1 to n;
        xa(i) = i;
     end;
     do i = 1 to n;
        if xa(i) ^= i then do;
           put skip list('FAIL based_heap_dyn: check at line 76 failed');
           stop;
        end;
     end;
     free xa in(region);
   put skip list('PASS based-heap-dyn');
  end based_heap_dyn;
