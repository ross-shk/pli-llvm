  /* extension (ADR-205): DEFINE CONSTANT needs a
     constant value; writes are diagnosed. */
  badconst: procedure options(main);
     define constant max 100;
     define constant max 200;
     declare other fixed bin(31);
     define constant doubled other + 1;
     max = 5;
  end badconst;
