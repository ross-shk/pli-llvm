 /* A FIXED DECIMAL scale factor wider than the precision cannot be
    represented (rule (16)): FIXED DECIMAL(p,q) takes q <= p decimal
    digits. It used to be accepted silently, and the runtime's
    fixed-point formatters sized their buffers from the scale alone. */
 badscale: procedure options(main);
    declare x decimal(3, 5);
    put skip list(x);
 end badscale;
