/* Genuinely invalid FIXED scale cases per TR 25.084 rule (16):
   - Non-integer scale (not allowed by syntax)
   - Invalid precision (0 or negative)
   The cases with q > p and q < 0 are now VALID per Y33-6003-0 §4.5. */
badscale: procedure options(main);
    declare x fixed bin(0);    /* precision 0 is invalid */
    put skip list(x);
end badscale;

* .check
BINARY precision must be positive
