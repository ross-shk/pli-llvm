 /* F scale factor (rule (50)): non-numeric scale factor diagnosed. */
 bad_fixed_scale: procedure options(main);
    declare buf char(20);
    declare a fixed bin(31);
    a = 1;
    put string(buf) edit(a) (f(6, 0, 'x'));
 end bad_fixed_scale;
