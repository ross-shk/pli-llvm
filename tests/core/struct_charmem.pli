 /* CHARACTER structure members (rule (11)): fixed strings live
    in struct fields with blank-padding; member arrays and
    member INIT ride along. */
 charmem: procedure options(main);
    declare 1 s, 2 a char(4), 2 b fixed bin(31);
    declare 1 t, 2 v(2) char(3), 2 w char(2) init('hi');
    s.a = 'ab';
    s.b = 7;
    if s.a ^= 'ab  ' then do;
       put skip list('FAIL struct_charmem: expected ab  , got', s.a);
       stop;
    end;
    if s.b ^= 7 then do;
       put skip list('FAIL struct_charmem: expected 7, got', s.b);
       stop;
    end;
    t.v(1) = 'x';
    t.v(2) = 'yz';
    if t.v(1) ^= 'x  ' then do;
       put skip list('FAIL struct_charmem: expected x  , got', t.v(1));
       stop;
    end;
    if t.v(2) ^= 'yz ' then do;
       put skip list('FAIL struct_charmem: expected yz , got', t.v(2));
       stop;
    end;
    if t.w ^= 'hi' then do;
       put skip list('FAIL struct_charmem: expected hi, got', t.w);
       stop;
    end;
   put skip list('PASS charmem');
 end charmem;
