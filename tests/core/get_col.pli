 /* GET COLUMN positioning (rules 48, 108): COL(n) on input skips
    forward so the next item starts at 1-based column n. */
 getcol: procedure options(main);
    declare src char(16);
    declare a char(3);
    declare b char(3);
    declare k fixed bin(31);

    /* "abc  def": column 1 is a, column 6 is d. */
    src = 'abc  def';
    get string(src) edit (a, b) (a(3), col(6), a(3));
    if a ^= 'abc' then do;
       put skip list('FAIL col fixed a: expected abc, got', a);
       stop;
    end;
    if b ^= 'def' then do;
       put skip list('FAIL col fixed b: expected def, got', b);
       stop;
    end;

    /* Dynamic column: a variable expression. */
    k = 4;
    src = 'xyz  uvw';
    get string(src) edit (a, b) (a(3), col(k+2), a(3));
    if a ^= 'xyz' then do;
       put skip list('FAIL col dynamic a: expected xyz, got', a);
       stop;
    end;
    if b ^= 'uvw' then do;
       put skip list('FAIL col dynamic b: expected uvw, got', b);
       stop;
    end;

    put skip list('PASS get_col');
 end getcol;
