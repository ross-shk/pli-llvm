 /* BY NAME assignment with a dynamic member (rules
    (13),(86)): a same-named dynamic member copies
    buffer contents, not the pointer; other members
    match by name as usual, unmatched names are
    skipped. Bounds come from parameters. */
 struct_by_name_dyn_test: procedure options(main);
    call check(4);
   put skip list('PASS struct_by_name_dyn');
 check: procedure(n);
    declare n fixed bin(31);
    declare 1 s,
           2 a fixed bin(31),
           2 v(n) fixed bin(31),
           2 skip fixed bin(31);
    declare 1 t,
           2 v(n) fixed bin(31),
           2 a fixed bin(31),
           2 extra fixed bin(31);
    s.a = 7;
    s.v(1) = 111;
    s.v(2) = 20;
    s.v(3) = 30;
    s.v(4) = 444;
    s.skip = 999;
    t.extra = -1;
    t = s, by name;
    if t.a ^= 7 then do;
       put skip list('FAIL struct_by_name_dyn: expected 7, got', t.a);
       stop;
    end;
    if t.v(1) ^= 111 then do;
       put skip list('FAIL struct_by_name_dyn: expected 111, got',
          t.v(1));
       stop;
    end;
    if t.v(4) ^= 444 then do;
       put skip list('FAIL struct_by_name_dyn: expected 444, got',
          t.v(4));
       stop;
    end;
    if sum(t.v) ^= 605 then do;
       put skip list('FAIL struct_by_name_dyn: expected 605, got',
          sum(t.v));
       stop;
    end;
    /* unmatched names are skipped on both sides */
    if t.extra ^= -1 then do;
       put skip list('FAIL struct_by_name_dyn: expected -1, got',
          t.extra);
       stop;
    end;
    /* deep, not aliased: writes diverge after copy */
    s.v(1) = 0;
    if t.v(1) ^= 111 then do;
       put skip list('FAIL struct_by_name_dyn: expected 111, got',
          t.v(1));
       stop;
    end;
 end check;
 end struct_by_name_dyn_test;
