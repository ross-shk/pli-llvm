 /* BY NAME assignment with a dynamic member (rules
    (13),(86)): a same-named dynamic member copies
    buffer contents, not the pointer; other members
    match by name as usual, unmatched names are
    skipped. Bounds come from parameters. */
 struct_by_name_dyn_test: procedure options(main);
    declare fails fixed bin(31);
    fails = 0;
    call check(4);
    if fails = 0 then put skip list('PASS struct_by_name_dyn');
    else put skip list('FAIL struct_by_name_dyn: fails =',
       fails);
 check: procedure(n);
    declare n fixed bin(31);
    declare 1 s,
           2 a fixed bin(31),
           2 v(n) fixed bin(31),
           2 skip fixed bin(31);
    declare 1 t,
           2 v(n) fixed bin(31),
           2 a fixed bin(31),
           2 extra fixed bin(31);
    s.a = 7;
    s.v(1) = 111;
    s.v(2) = 20;
    s.v(3) = 30;
    s.v(4) = 444;
    s.skip = 999;
    t.extra = -1;
    t = s, by name;
    if t.a ^= 7 then fails = fails + 1;
    if t.v(1) ^= 111 then fails = fails + 1;
    if t.v(4) ^= 444 then fails = fails + 1;
    if sum(t.v) ^= 605 then fails = fails + 1;
    /* unmatched names are skipped on both sides */
    if t.extra ^= -1 then fails = fails + 1;
    /* deep, not aliased: writes diverge after copy */
    s.v(1) = 0;
    if t.v(1) ^= 111 then fails = fails + 1;
 end check;
 end struct_by_name_dyn_test;
