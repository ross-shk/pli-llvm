/* Dynamic later axis + CALL ABI (rules 12, 13, 126): runtime bounds, LBOUND/HBOUND/DIM */
dynamic_later_axis: procedure options(main);
    declare n fixed bin(31) init(5);
    declare m fixed bin(31) init(3);

    /* 2D array with dynamic first axis, fixed second */
    declare a(n, 4) fixed bin(31);
    declare b(m, 4) fixed bin(31) controlled;  /* same fixed second axis as parameter */

    call init_array(a, n);
    call check_bounds(a, n, 4);

    allocate b(m, 4);
    call init_array(b, m);
    call check_bounds(b, m, 4);
    free b;

    put skip list('PASS dynamic_later_axis');
end dynamic_later_axis;

/* Parameter with dynamic first axis (leading *) and fixed later axes */
init_array: proc(arr, k) options(bypass);
    declare k fixed bin(31);
    declare arr(*, 4) fixed bin(31);  /* leading * with constant later axis */
    declare i fixed bin(31), j fixed bin(31);
    do i = lbound(arr,1) to hbound(arr,1);
        do j = lbound(arr,2) to hbound(arr,2);
            arr(i,j) = i * 10 + j;
        end;
    end;
end init_array;

check_bounds: proc(arr, k, expected_cols) options(bypass);
    declare k fixed bin(31);
    declare expected_cols fixed bin(31);
    declare arr(*, 4) fixed bin(31);  /* leading * with constant later axis */
    declare lb1 fixed bin(31), ub1 fixed bin(31);
    declare lb2 fixed bin(31), ub2 fixed bin(31);
    declare dim1 fixed bin(31), dim2 fixed bin(31);

    lb1 = lbound(arr,1); ub1 = hbound(arr,1);
    lb2 = lbound(arr,2); ub2 = hbound(arr,2);
    dim1 = dim(arr,1); dim2 = dim(arr,2);

    /* Verify bounds match expectations */
    if lb1 ^= 1 | ub1 ^= k | dim1 ^= k then do;
        put skip list('FAIL bounds axis 1:', lb1, ub1, dim1);
        stop;
    end;
    if lb2 ^= 1 | ub2 ^= expected_cols | dim2 ^= expected_cols then do;
        put skip list('FAIL bounds axis 2:', lb2, ub2, dim2);
        stop;
    end;
    /* Verify values were stored correctly */
    declare i fixed bin(31), j fixed bin(31);
    do i = 1 to k;
        do j = 1 to expected_cols;
            if arr(i,j) ^= i * 10 + j then do;
                put skip list('FAIL value at', i, j, ':', arr(i,j));
                stop;
            end;
        end;
    end;
end check_bounds;