 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* Rules (12),(13): dynamic LATER axes (2nd/3rd runtime extents). Bounds
    are evaluated at block entry on any axis; subscripting uses the
    row-major flat index with per-axis bounds checks (rule (60)), and
    LBOUND/HBOUND/DIM read the live per-axis bounds. Companion IR and
    multimodule tests pin the flat index and the hidden ABI arguments. */
 dynamic_later_axis: procedure options(main);
   declare n fixed bin(31) init(2);
   declare m fixed bin(31) init(3);
   declare a(n, m) fixed bin(31);
   declare i fixed bin(31);
   declare j fixed bin(31);
   declare s fixed bin(31);
   s = 0;
   do i = 1 to n;
     do j = 1 to m;
       a(i, j) = i * 10 + j;
       s = s + a(i, j);
     end;
   end;
   if a(1, 2) ^= 12 then do;
      put skip list('FAIL a12', a(1, 2));
      stop;
   end;
   if s ^= 102 then do;
      put skip list('FAIL sum', s);
      stop;
   end;
   if lbound(a, 1) ^= 1 then do;
      put skip list('FAIL lb1', lbound(a, 1));
      stop;
   end;
   if hbound(a, 1) ^= n then do;
      put skip list('FAIL hb1');
      stop;
   end;
   if hbound(a, 2) ^= m then do;
      put skip list('FAIL hb2', hbound(a, 2));
      stop;
   end;
   if dim(a, 1) ^= n then do;
      put skip list('FAIL dim1');
      stop;
   end;
   if dim(a, 2) ^= m then do;
      put skip list('FAIL dim2');
      stop;
   end;
   if dim(a) ^= n * m then do;
      put skip list('FAIL dimtot');
      stop;
   end;
   /* Cross-section over a dynamic later axis (rule (126)). */
   declare r(m) fixed bin(31);
   r = a(1,*);
   if r(2) ^= 12 then do;
      put skip list('FAIL xs', r(2));
      stop;
   end;
   r = a(2,*);
   if r(1) ^= 21 then do;
      put skip list('FAIL xs2', r(1));
      stop;
   end;
   /* Zero extent on the first axis with a dynamic later axis. */
   begin;
      declare b(0, 3) fixed bin(31); /* constant zero extent */
      if dim(b) ^= 0 then do;
         put skip list('FAIL zero', dim(b));
         stop;
      end;
   end;
   /* Default 1 lower bound per axis (rule (59)). */
   begin;
      declare c(1:3, 2:4) fixed bin(31); /* constant bounds for test */
      if lbound(c, 2) ^= 2 then do;
         put skip list('FAIL c.lb2');
         stop;
      end;
      if hbound(c, 2) ^= 4 then do;
         put skip list('FAIL c.hb2');
         stop;
      end;
      c(1, 2) = 5;
      c(2, 4) = 9;
      if c(1, 2) + c(2, 4) ^= 14 then do;
         put skip list('FAIL c.elem');
         stop;
      end;
   end;
   /* A third dynamic axis compounds the flat index. */
   begin;
      declare t(2, 2, 2) fixed bin(31);
      declare k fixed bin(31);
      do i = 1 to 2;
        do j = 1 to 2;
          do k = 1 to 2;
            t(i, j, k) = 100 * i + 10 * j + k;
          end;
        end;
      end;
      if t(2, 1, 2) ^= 212 then do;
         put skip list('FAIL t.212', t(2, 1, 2));
         stop;
      end;
      if dim(t) ^= 8 then do;
         put skip list('FAIL t.dim');
         stop;
      end;
   end;
   /* Bounds re-evaluate per activation (rule (5) recursion). */
   call rec(2, 3);
   put skip list('PASS dynamic_later_axis');
 rec: procedure(p, q) recursive;
   declare p fixed bin(31);
   declare q fixed bin(31);
   declare x(p, q) fixed bin(31);
   if dim(x) ^= p * q then do;
      put skip list('FAIL rec.dim', dim(x));
      stop;
   end;
   if q > 1 then call rec(p, q - 1);
 end rec;
 end dynamic_later_axis;
