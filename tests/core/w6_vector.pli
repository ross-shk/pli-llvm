/* W6 witness: aggregate/vector copy of a 10000-entry char(64) array,
   copied 1000 times, exercised in both runtime and LLVM modes. */
w6_vector_test: procedure options(main);
   declare
      /* 10000 * 64 = 640000 bytes per buffer */
      a(10000) char(64),
      b(10000) char(64),
      i, rep fixed bin(31),
      fails fixed bin(31);

   fails = 0;

   /* fill a with a known pattern */
   do i = 1 to 10000;
      a(i) = 'buffer content ';
   end;

   /* copy the whole array 1000 times via whole-array assignment */
   do rep = 1 to 1000;
      b = a;
   end;

   /* verify the copy is correct */
   do i = 1 to 10000;
      if b(i) ^= a(i) then do;
         fails = fails + 1;
      end;
   end;

   /* verify a known value is present */
   if b(1) ^= 'buffer content ' then fails = fails + 1;

   if fails = 0 then put skip list('PASS w6_vector');
   else put skip list('FAIL w6_vector: fails =', fails);
end w6_vector_test;
