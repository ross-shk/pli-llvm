/* rule (60)-(63): SNAP prefix on ON condition — warned, no effect. */
on_snap: procedure options(main);
    on error snap begin;
        put skip list('ON ERROR SNAP triggered');
    end;
    signal error;
    put skip list('PASS on_snap');
end on_snap;