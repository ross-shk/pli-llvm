  /* BASED member in RETURN (rules (25),(81),(124)): an accessor
     returns a based member of an enclosing procedure through the
     static link, and the locator form returns through its own
     pointer parameter. */
  based_return: procedure options(main);
     declare p pointer;
     declare 1 y, 2 fd fixed bin(31);
     declare 1 c based(p), 2 fd fixed bin(31);
     declare r fixed bin(31);
     y.fd = 21;
     p = addr(y);
     r = get_fd();
     if r ^= 21 then do;
        put skip list('FAIL based_return: expected 21, got', r);
        stop;
     end;
     r = get_loc(p);
     if r ^= 21 then do;
        put skip list('FAIL based_return: expected 21, got', r);
        stop;
     end;
   put skip list('PASS based_return');
     get_fd: procedure returns(fixed bin(31));
        return(c.fd);
        end get_fd;
     get_loc: procedure(h) returns(fixed bin(31));
        declare h pointer;
        declare 1 c based(p), 2 fd fixed bin(31);
        return(h -> c.fd);
        end get_loc;
     end based_return;
