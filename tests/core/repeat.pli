 /* REPEAT built-in function: repeat(s, n) returns the character string s
    repeated n times. M2 string built-in (Y33-6003 REPEAT). */
 repeat_test: procedure options(main);
    declare t char(6);
    declare fails fixed bin(31);

    fails = 0;

    t = repeat('AB', 3);
    if t ^= 'ABABAB' then do;
       fails = fails + 1;
       put skip list('FAIL repeat AB 3 =', t);
    end;

    t = repeat('x', 5);
    if t ^= 'xxxxx' then do;
       fails = fails + 1;
       put skip list('FAIL repeat x 5 =', t);
    end;

    if fails = 0 then put skip list('PASS repeat');
    else put skip list('FAIL repeat: fails =', fails);
 end repeat_test;
