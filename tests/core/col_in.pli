 /* COLUMN positioning on input (rules (48),(108)): COL(n) skips
    forward so the next item starts at 1-based column n, then the
    paired item reads from that position. */
 col_in: procedure options(main);
    declare src char(16);
    declare a char(3);
    declare b char(3);
    /* "abc  def" — column 1 starts a, column 6 starts d (after 2 blanks). */
    src = 'abc  def';
    get string(src) edit (a, b) (a(3), col(6), a(3));
    if a ^= 'abc' then do;
       put skip list('FAIL col_in: expected abc, got', a);
       stop;
    end;
    if b ^= 'def' then do;
       put skip list('FAIL col_in: expected def, got', b);
       stop;
    end;
   put skip list('PASS col_in');
 end col_in;
