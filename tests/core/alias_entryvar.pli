 /* WS-A4 (ADR-265) litmus: an ENTRY VARIABLE (ADR-171) beside plain
    AUTOMATIC locals. The taxonomy says an ENTRY VARIABLE may be called from
    anywhere, so it must not be given the plain-local disjointness claim; the
    program must compute the same answer either way. */
 alias_entryvar: procedure options(main);
    declare i fixed bin(31);
    declare sum fixed bin(31);
    declare a(10) fixed bin(31);
    declare on_ping entry (fixed bin(31)) variable;

    do i = 1 to 10;
       a(i) = i * i;
    end;

    /* the entry variable holds a procedure value, not data */
    on_ping = ping;

    sum = 0;
    do i = 1 to 10;
       sum = sum + a(i);
    end;
    put skip list(sum);

    ping: procedure(x);
       declare x fixed bin(31);
       x = x + 1;
    end ping;
 end alias_entryvar;
