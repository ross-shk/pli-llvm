 /* rules (79),(82): a WAIT waits for its own event.
    Two tasks and two events. The first waits for evb; the second ends
    early and completes evc, which nobody waits for. The second's
    completion must not release the first, which waits for evb: the
    runtime signals the event that completed, not every waiter of the
    event table (ADR-236). A third task ends late and completes evb, and
    only then may the first proceed - a keyed signal that never matched
    would leave it waiting for ever. */
 task_keyed: procedure options(main);
    declare evb event;
    declare evc event;
    declare evd event;
    declare released fixed bin(31);
    declare fails fixed bin(31);
    fails = 0;
    released = 0;
    /* The third task ends late and completes evb. It is started first, so
       that evb is reset (a fresh EVENT is complete) before the waiter
       looks at it. */
    call late event(evb);
    delay(20);
    /* The first task waits for evb and records that it was released. */
    call waiter event(evd);
    /* The second ends early: it completes evc, which nobody waits for. */
    call early event(evc);
    delay(50);
    if released ^= 0 then
       do;
          put skip list('FAIL a task was released by the wrong event');
          fails = fails + 1;
       end;
    if event(evc) = 0 then
       do;
          put skip list('FAIL the early event never completed');
          fails = fails + 1;
       end;
    /* Now wait for the late task, which completes evb and releases the
       first task. */
    wait(evb);
    delay(50);
    if released = 0 then
       do;
          put skip list('FAIL the waited event never released the waiter');
          fails = fails + 1;
       end;
    if fails = 0 then
       put skip list('PASS');
    waiter: procedure;
       wait(evb);
       released = 1;
    end waiter;
    early: procedure;
       delay(5);
    end early;
    late: procedure;
       delay(400);
    end late;
 end task_keyed;
