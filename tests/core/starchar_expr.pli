/* Adjustable-length CHARACTER parameter with expression argument:
   TRIM, literals, and concatenation chains are accepted.
   The hidden length comes from the expression's declared capacity.
   Rules (18), (34)-(38). */
starchar_expr_test: procedure options(main);
   declare hoststr char(10) varying;
   declare buf char(20);
   declare len fixed bin(31);
   declare fails fixed bin(31);

   fails = 0;
   hoststr = 'hello';

   /* trim(hoststr): expr arg to CHAR(*) — compiled length of trim result */
   call read_len(trim(hoststr));

   /* literal string */
   call read_len('world');

   /* concatenation */
   call read_len('a' || 'b' || 'c');

   if fails = 0 then put skip list('PASS starchar_expr');
   else put skip list('FAIL starchar_expr: fails =', fails);

read_len: procedure(s);
   declare s char(*);
   declare r fixed bin(31);
   r = length(s);
   if r < 0 then fails = fails + 1;
end read_len;
end starchar_expr_test;
