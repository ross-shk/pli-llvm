 /* WS-A1 (ADR-264): the memory-effect attributes must not change what the
    program computes. Each procedure here gets a different promise — none,
    argmem-read, argmem-readwrite, or none at all — and the values the
    program produces must be the same as before the attributes existed. */
 purity_test: procedure options(main);
   declare i fixed bin(31);
   declare v fixed bin(31);
   declare s fixed bin(63);


   /* a procedure that touches no memory at all */
   i = pure();
   if i ^= 7 then do;
      put skip list('FAIL purity: expected 7, got', i);
      stop;
   end;

   /* a procedure that reads its argument and writes nothing */
   v = 41;
   i = reader(v);
   if i ^= 42 then do;
      put skip list('FAIL purity: expected 42, got', i);
      stop;
   end;
   if v ^= 41 then do;
      put skip list('FAIL purity: expected 41, got', v);
      stop;
   end;

   /* a procedure that writes its argument */
   v = 41;
   call writer(v);
   if v ^= 42 then do;
      put skip list('FAIL purity: expected 42, got', v);
      stop;
   end;

   /* a procedure that does I/O: nothing is promised about it */
   v = 5;
   call io_proc(v);
   if v ^= 5 then do;
      put skip list('FAIL purity: expected 5, got', v);
      stop;
   end;

   /* a loop over the pure procedures: the promises let the optimizer hoist
      the calls, and the values must still be the same */
   s = 0;
   do i = 1 to 1000;
      s = s + pure() + reader(i);
   end;
   if s ^= 1000 * 7 + 501500 then do;
      put skip list('FAIL purity: check at line 41 failed');
      stop;
   end;

   put skip list('PASS purity');

   /* touches no memory at all */
   pure: procedure returns(fixed bin(31));
      declare y fixed bin(31);
      y = 7;
      return(y);
   end pure;

   /* reads its argument and writes nothing */
   reader: procedure(x) returns(fixed bin(31));
      declare x fixed bin(31);
      return(x + 1);
   end reader;

   /* writes its argument */
   writer: procedure(x);
      declare x fixed bin(31);
      x = x + 1;
   end writer;

   /* does I/O: nothing may be promised */
   io_proc: procedure(x);
      declare x fixed bin(31);
      put skip list(x);
   end io_proc;
 end purity_test;
