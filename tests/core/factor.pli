 /* Factored declarations (rule 11): DECLARE (A, B, C) FIXED BIN(31) gives every
    name in the parenthesised list the shared attribute (and dimension) set.
    Factored arrays use a factored dimension: (X, Y) (5) FIXED BIN(31). */
 factor_test: procedure options(main);
    declare (a, b, c) fixed bin(31);
    declare (x, y) (5) fixed bin(31);
    declare i fixed bin(31);

    a = 1;
    b = 2;
    c = 3;
    if a + b + c ^= 6 then do;
       put skip list('FAIL factor: check at line 16 failed');
       stop;
    end;

    do i = 1 to 5;
       x(i) = i;
       y(i) = i * 2;
    end;
    if x(1) ^= 1 or x(5) ^= 5 then do;
       put skip list('FAIL factor: check at line 22 failed');
       stop;
    end;
    if y(1) ^= 2 or y(5) ^= 10 then do;
       put skip list('FAIL factor: check at line 23 failed');
       stop;
    end;

   put skip list('PASS factor');
 end factor_test;
