 /* Factored declarations (rule 11): DECLARE (A, B, C) FIXED BIN(31) gives every
    name in the parenthesised list the shared attribute (and dimension) set.
    Factored arrays use a factored dimension: (X, Y) (5) FIXED BIN(31). */
 factor_test: procedure options(main);
    declare (a, b, c) fixed bin(31);
    declare (x, y) (5) fixed bin(31);
    declare i fixed bin(31);
    declare fails fixed bin(31);

    fails = 0;
    a = 1;
    b = 2;
    c = 3;
    if a + b + c ^= 6 then fails = fails + 1;

    do i = 1 to 5;
       x(i) = i;
       y(i) = i * 2;
    end;
    if x(1) ^= 1 or x(5) ^= 5 then fails = fails + 1;
    if y(1) ^= 2 or y(5) ^= 10 then fails = fails + 1;

    if fails = 0 then put skip list('PASS factor');
    else put skip list('FAIL factor: fails =', fails);
 end factor_test;
