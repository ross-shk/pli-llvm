 /* Aggregate items in stream output (rules (104)-(110); QR2.1):
    whole arrays and cross-sections transmit element-wise in
    row-major order; EDIT items pair with formats after expansion. */
 put_array: procedure options(main);
    declare a(3) fixed bin(31);
    declare m(2, 2) fixed bin(31);
    declare 1 s, 2 v(2) fixed bin(31);
    declare q fixed bin(31) init(2);
    declare dm(q, 2) fixed bin(31);
    a(1) = 10; a(2) = 20; a(3) = 30;
    m(1, 1) = 1; m(1, 2) = 2; m(2, 1) = 3; m(2, 2) = 4;
    s.v(1) = 50; s.v(2) = 60;
    dm(1, 1) = 11; dm(1, 2) = 12; dm(2, 1) = 13; dm(2, 2) = 14;
    put skip list(a);
    put skip list(m);
    put skip list(m(1, *));
    put skip list(m(*, 2));
    put skip list(s.v);
    put skip list(dm(1, *));
    put edit (a) (f(6), f(6), f(6));
    put skip list('end');
    put edit (m(2, *)) (f(6), f(6));
    put skip list('end');
 end put_array;
