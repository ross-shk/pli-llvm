 /* Rule (13): a BASED adjustable extent is served for a leading
    '*' with constant later axes; a second '*' stays diagnosed.
    (A 1-D `(*)` BASED array is served since ADR-296.) */
 bad_based_array: procedure options(main);
   dcl p pointer;
   dcl c(4) char(1) based(p);
   dcl s(*,*) fixed bin(31) based(p);
 end bad_based_array;
