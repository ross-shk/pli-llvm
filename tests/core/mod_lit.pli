 MOD_LIT: PROCEDURE OPTIONS(MAIN);
    DECLARE R FIXED BINARY(31);
    R = MOD(100, 3); PUT SKIP LIST(R);
    R = MOD(100, 4); PUT SKIP LIST(R);
    R = MOD(100, 8); PUT SKIP LIST(R);
    R = MOD(-100, 3); PUT SKIP LIST(R);
    R = MOD(-100, 4); PUT SKIP LIST(R);
    R = MOD(-100, 8); PUT SKIP LIST(R);
    R = MOD(7, 3); PUT SKIP LIST(R);
    R = MOD(7, 4); PUT SKIP LIST(R);
    R = MOD(7, 8); PUT SKIP LIST(R);
    PUT SKIP LIST('PASS');
 END MOD_LIT;
