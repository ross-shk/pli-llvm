 /* A replicated string constant is expanded at parse time (rule 129):
    bound the result so a short source line cannot ask for gigabytes. */
 badrepl: procedure options(main);
    declare s char(20);
    s = (2000000000)'A';
    put skip list(s);
 end badrepl;
