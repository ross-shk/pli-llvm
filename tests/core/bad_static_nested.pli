/* STATIC inside a nested BEGIN block (rule 23): program-lifetime storage must
   not hang off an activating block, so it is diagnosed in this stage. */
static_in_begin: procedure options(main);
    dcl a fixed bin(31) static initial(1);
    begin;
      dcl b fixed bin(31) static initial(2);  /* (23) - nested block */
    end;
    put skip list(a);
 end static_in_begin;
