  /* Runtime aggregate lengths on a dynamic-array structure member (rules
     (11),(12),(13),(123)): the member v(n) is a single-axis AUTOMATIC array
     whose extent comes from a runtime expression. LBOUND/HBOUND/DIM report the
     live member bounds (including a dynamic lower bound), and the array
     reduction built-ins SUM/PROD walk the runtime-sized member buffer. */
  struct_dyn_len_test: procedure options(main);
     declare fails fixed bin(31);
     fails = 0;
     call check(5);
     call check(1);
     call check(0);
     call check_lb(5);
     if fails = 0 then put skip list('PASS struct_dyn_len');
     else put skip list('FAIL struct_dyn_len: fails =', fails);

     check: procedure(n);
        declare n fixed bin(31);
        declare 1 s,
               2 v(n) fixed bin(31);
        declare i fixed bin(31);
        declare t fixed bin(31);
        /* the live member extent drives the attribute built-ins */
        if lbound(s.v) ^= 1 then do;
           fails = fails + 1;
           put skip list('FAIL lbound', lbound(s.v));
        end;
        if hbound(s.v) ^= n then do;
           fails = fails + 1;
           put skip list('FAIL hbound', hbound(s.v));
        end;
        if dim(s.v) ^= n then do;
           fails = fails + 1;
           put skip list('FAIL dim', dim(s.v));
        end;
        /* fill the member buffer and reduce over its full extent */
        do i = 1 to n;
           s.v(i) = i;
        end;
        t = sum(s.v);
        if t ^= (n * (n + 1)) / 2 then do;
           fails = fails + 1;
           put skip list('FAIL sum', t, 'want', (n * (n + 1)) / 2);
        end;
     end check;

     check_lb: procedure(n);
        declare n fixed bin(31);
        declare 1 s,
               2 v(2:n+1) fixed bin(31);
        /* a dynamic lower bound member reports its live bounds */
        if lbound(s.v) ^= 2 then do;
           fails = fails + 1;
           put skip list('FAIL lb lbound', lbound(s.v));
        end;
        if hbound(s.v) ^= n + 1 then do;
           fails = fails + 1;
           put skip list('FAIL lb hbound', hbound(s.v));
        end;
        if dim(s.v) ^= n then do;
           fails = fails + 1;
           put skip list('FAIL lb dim', dim(s.v));
        end;
     end check_lb;
  end struct_dyn_len_test;
