 /* Per-member structure INIT limits (rule (26)): a member
    INITIAL combined with a structure-level INITIAL list, and a
    non-constant member value, stay diagnosed. */
 bad_sinit: procedure options(main);
    declare 1 s init(1, 2), 2 a init(3), 2 b;
    declare 1 t, 2 x init(foo(1));
 end bad_sinit;
