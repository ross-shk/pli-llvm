 MOD_FAST: PROCEDURE OPTIONS(MAIN);
    DECLARE (A, B, R) FIXED BINARY(31);
    A = 100;
    B = 3;
    R = MOD(A, B);
    PUT SKIP LIST(R);
    R = MOD(A, 3);
    PUT SKIP LIST(R);
    A = -100;
    R = MOD(A, B);
    PUT SKIP LIST(R);
    R = MOD(A, 3);
    PUT SKIP LIST(R);
    R = MOD(A, 4);
    PUT SKIP LIST(R);
    A = 100;
    R = MOD(A, 4);
    PUT SKIP LIST(R);
    R = MOD(A, 8); PUT SKIP LIST(R);
    PUT SKIP LIST('PASS');
 END MOD_FAST;
