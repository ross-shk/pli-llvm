 /* extension (ADR-110): (NOSIZE) elides the
    overflow trap so arithmetic wraps; (SIZE)
    is accepted and behaves normally. */
 nosizedemo: procedure options(main);
    declare x fixed bin(31);
    (nosize):
       x = 2147483647 + 1;
    put skip list(x);
    (size):
       x = 41 + 1;
    put skip list(x);
    (nosize):
       do;
          x = 2147483647;
          x = x + 1;
       end;
    put skip list(x);
 end nosizedemo;
