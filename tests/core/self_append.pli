 /* Variable-tail self-append must match the generic path exactly:
    values, truncation at capacity, self-concatenation, and growth. */
 self_append: procedure options(main);
   declare i fixed bin(31);
   declare r character(10) varying;
   declare t character(10) varying;
   declare e character(10) varying;
   r = 'a';
   t = 'bc';
   e = '';
   /* Simple variable tail. */
   r = r || t;
   if r ^= 'abc' then do;
      put skip list('FAIL self_append: expected abc, got', r);
      stop;
   end;
   if length(r) ^= 3 then do;
      put skip list('FAIL self_append: expected 3, got', length(r));
      stop;
   end;
   /* Mixed literal and variable tails. */
   r = r || '-' || t || '!';
   if r ^= 'abc-bc!' then do;
      put skip list('FAIL self_append: expected abc-bc!, got', r);
      stop;
   end;
   /* Self-concatenation reads the old content while growing. */
   r = 'xy';
   r = r || r;
   if r ^= 'xyxy' then do;
      put skip list('FAIL self_append: expected xyxy, got', r);
      stop;
   end;
   /* Truncation at capacity, exactly like the generic path. */
   r = '12345678';
   r = r || t;
   if r ^= '12345678bc' then do;
      put skip list('FAIL self_append: expected 12345678bc, got', r);
      stop;
   end;
   r = r || t;
   if length(r) ^= 10 then do;
      put skip list('FAIL self_append: expected 10, got', length(r));
      stop;
   end;
   if r ^= '12345678bc' then do;
      put skip list('FAIL self_append: expected 12345678bc, got', r);
      stop;
   end;
   /* Empty tail changes nothing. */
   r = 'q' || e;
   if r ^= 'q' then do;
      put skip list('FAIL self_append: expected q, got', r);
      stop;
   end;
   /* Growth across loop iterations. */
   r = '';
   do i = 1 to 5;
     r = r || t;
   end;
   if r ^= 'bcbcbcbcbc' then do;
      put skip list('FAIL self_append: expected bcbcbcbcbc, got', r);
      stop;
   end;
   put skip list('PASS self_append');
 end self_append;
