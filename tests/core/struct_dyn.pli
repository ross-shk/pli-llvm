  /* A dynamic array as a structure member (rules (11),(13),(126)): the member
     v(n) is a single-axis AUTOMATIC array whose extent comes from the runtime
     expression n, allocated at block entry. It is reached by qualification
     s.v(i) on both sides of an assignment, bounds-checked against the live
     extent, alongside fixed scalar members. */
  struct_dyn_test: procedure options(main);
     declare fails fixed bin(31);
     fails = 0;
     call check(5);
     call check(1);
     if fails = 0 then put skip list('PASS struct_dyn');
     else put skip list('FAIL struct_dyn: fails =', fails);

     check: procedure(n);
        declare n fixed bin(31);
        declare 1 s,
               2 a fixed bin(31),
               2 v(n) fixed bin(31);
        declare i fixed bin(31);
        /* a fixed scalar member sits beside the dynamic member */
        s.a = 100;
        if s.a ^= 100 then fails = fails + 1;
        /* write and read the dynamic member element by element */
        do i = 1 to n;
           s.v(i) = i * 7;
        end;
        do i = 1 to n;
           if s.v(i) ^= i * 7 then do;
              fails = fails + 1;
              put skip list('FAIL s.v(i) at i =', i);
           end;
        end;
        if s.a ^= 100 then fails = fails + 1;
     end check;
  end struct_dyn_test;
