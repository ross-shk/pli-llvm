  /* rule (81): a bare RETURN is not valid in a
     valued primary segment. */
  badentryret: procedure options(main);
     put skip list(once());
  end badentryret;

  once: procedure returns(fixed bin(31));
     put skip list('body');
     return;

    twice: entry returns(fixed bin(31));
     return(2);
  end once;
