 /* Rules (11),(27): factored INITIAL CALL — each name calls the function. */
 factored_initial_call: procedure options(main);
     declare (u, v) fixed bin(31) initial(call get_val());
     if u ¬= 42 | v ¬= 42 then do;
        put skip list('FAIL factored_initial_call', u, v);
        stop;
     end;
     put skip list('PASS factored_initial_call');
 end factored_initial_call;

 get_val: procedure returns(fixed bin(31));
     return(42);
 end get_val;