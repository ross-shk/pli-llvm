 /* Rule (26): INITIAL requires constant expressions. */
 bad_factored_initial_nonconst: procedure options(main);
     declare x fixed bin(31) init(1);
     declare (a, b) fixed bin(31) initial(x);  /* ERROR (26): x not constant */
 end bad_factored_initial_nonconst;