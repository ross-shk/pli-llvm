 /* Hex X literals (rule (143)): 'hex'X is a character string of
    the decoded bytes (NUL bytes included); expression repetition
    lands the full byte count. INITIAL-list replication of hex is
    diagnosed (rule (129)) — assign or repeat in the body instead. */
 hexx: procedure options(main);
    declare s char(4);
    declare t char(64);
    s = '4142'X;
    if s ^= 'AB  ' then do;
       put skip list('FAIL hexx: expected AB  , got', s);
       stop;
    end;
    /* '00'X is one NUL byte; assignment pads the field with blanks */
    s = '00'X;
    if length(s) ^= 4 then do;
       put skip list('FAIL hexx: expected 4, got', length(s));
       stop;
    end;
    if substr(s, 1, 1) ^= '00'X then do;
       put skip list('FAIL hexx: expected 00X, got', substr(s, 1, 1));
       stop;
    end;
    t = (64)'00'X;
    if substr(t, 64, 1) ^= '00'X then do;
       put skip list('FAIL hexx: expected 00X, got', substr(t, 64, 1));
       stop;
    end;
   put skip list('PASS hexx');
 end hexx;
