 /* Hex X literals (rule (143)): 'hex'X is a character string of
    the decoded bytes (NUL bytes included); expression repetition
    lands the full byte count. INITIAL-list replication of hex is
    diagnosed (rule (129)) — assign or repeat in the body instead. */
 hexx: procedure options(main);
    declare s char(4);
    declare t char(64);
    declare fails fixed bin(31);
    fails = 0;
    s = '4142'X;
    if s ^= 'AB  ' then fails = fails + 1;
    /* '00'X is one NUL byte; assignment pads the field with blanks */
    s = '00'X;
    if length(s) ^= 4 then fails = fails + 1;
    if substr(s, 1, 1) ^= '00'X then fails = fails + 1;
    t = (64)'00'X;
    if substr(t, 64, 1) ^= '00'X then fails = fails + 1;
    if fails = 0 then put skip list('PASS hexx');
    else put skip list('FAIL hexx: fails =', fails);
 end hexx;
