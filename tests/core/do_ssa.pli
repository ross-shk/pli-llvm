/* ADR-213: verify that vectorized DO loops produce correct results.
   This test exercises a simple array write + read loop that LLVM
   vectorizes with the target-aware pipeline. Output must be
   identical whether or not vectorization fires. */
DO_SSA_TEST: PROCEDURE OPTIONS(MAIN);
   DECLARE I, S FIXED BINARY(31);
   DECLARE A(1000) FIXED BINARY(31);
   S = 0;
   DO I = 1 TO 1000;
     A(I) = I;
   END;
   DO I = 1 TO 1000;
     S = S + A(I);
   END;
   /* Sum of 1..1000 = 500500. If vectorization produces wrong results,
      S will differ. */
   IF S = 500500 THEN PUT SKIP LIST('PASS do_ssa_test');
   ELSE PUT SKIP LIST('FAIL do_ssa_test: S =', S, 'expected 500500');
END DO_SSA_TEST;
