 /* rule (101): PAGESIZE(n) is stored per file. */
 open_pagesize: procedure options(main);
    declare f file;
    open file(f) output title('tests/core/out/open_pagesize.dat') pagesize(5);
    put file(f) list('x');
    close file(f);
    put skip list('PASS open_pagesize');
 end open_pagesize;
