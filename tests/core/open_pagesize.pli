/* rule (101): OPEN PAGESIZE option — page tracking only. */
open_pagesize: procedure options(main);
    declare f file;
    open file(f) title('open_pagesize.dat') output pagesize(10);
    put file(f) list('test');
    close file(f);
    put skip list('PASS open_pagesize');
end open_pagesize;