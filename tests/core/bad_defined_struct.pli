   /* DEFINED (rule 24): negative tests for structure overlays - */
   /* size mismatch, alignedness mismatch, scalar base too small. */
     bad_defined_struct: procedure options(main);
       declare 1 big, 2 a fixed bin(31), 2 b fixed bin(31),
        2 c fixed bin(31);
       declare 1 too_big defined big, 2 w fixed bin(31),
        2 x fixed bin(31), 2 y fixed bin(31),
        2 z fixed bin(31);
       /* 16 vs 12 bytes */
       declare 1 packed defined big unaligned, 2 x fixed bin(31);
       /* alignedness mismatch */
       declare s fixed bin(31);
       declare 1 wide defined s, 2 x fixed bin(31), 2 y fixed bin(31);
       /* 8 vs 4 bytes */
       put skip list('PASS bad_defined_struct');
     end bad_defined_struct;