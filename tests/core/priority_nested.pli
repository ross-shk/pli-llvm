 /* rule (79): a task's PRIORITY option is relative to the spawning task,
    so a child spawned by a priority-5 task with PRIORITY(10) runs at
    absolute 15; a read from main (priority 0) sees 15 (ADR-298). */
 priority_nested: procedure options(main);
    declare ev event;
    declare child task;
    declare absolute fixed binary(15);
    declare relative fixed binary(15);
    declare ok fixed binary(31);

    ok = 1;
    absolute = 0;
    relative = 0;

    /* The parent runs at absolute 5 and spawns the child at +10. */
    call parent priority(5) event(ev);
    wait(ev);

    absolute = priority(child);
    if absolute ^= 15 then do;
       put skip list('FAIL nested absolute', absolute);
       ok = 0;
    end;

    /* The parent reads the child relative to itself: 15 - 5 = 10. */
    if relative ^= 10 then do;
       put skip list('FAIL nested relative', relative);
       ok = 0;
    end;

    if ok then
       put skip list('PASS priority_nested');
    else
       put skip list('FAIL priority_nested');

    parent: procedure;
       declare cev event;
       call grandchild priority(10) event(cev) task(child);
       wait(cev);
       relative = priority(child);
    end parent;

    grandchild: procedure;
    end grandchild;
 end priority_nested;
