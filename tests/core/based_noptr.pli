 /* Bare BASED (rule (25)): a based variable declared without a locator
    is unconnected, so every reference must be explicitly locator-
    qualified with P -> X (rule (124)). Pins locator-qualified member
    read/write, a LIKE template, ALLOCATE ... SET, an array subscript,
    and FREE with a locator. */
 based_noptr: procedure options(main);
   dcl 1 y,
       2 a fixed bin(31);
   dcl 1 rec based,
       2 a fixed bin(31);
   dcl p pointer;

   /* explicit members, locator-qualified read and write */
   p = addr(y);
   p -> rec.a = 42;
   if y.a ^= 42 then do;
      put skip list('FAIL based_noptr: expected 42, got', y.a);
      stop;
   end;
   if p -> rec.a ^= 42 then do;
      put skip list('FAIL based_noptr: check at line 20 failed');
      stop;
   end;
   y.a = 7;
   if p -> rec.a ^= 7 then do;
      put skip list('FAIL based_noptr: check at line 22 failed');
      stop;
   end;

   /* LIKE template plus ALLOCATE ... SET, then FREE with a locator */
   dcl 1 tpl,
       2 v fixed bin(31);
   dcl 1 view based like tpl;
   dcl q pointer;
   allocate view set(q);
   q -> view.v = 99;
   if q -> view.v ^= 99 then do;
      put skip list('FAIL based_noptr: check at line 31 failed');
      stop;
   end;
   free (q -> view);

   /* bare-based array addressed through a locator (rule (126)) */
   dcl a(3) fixed bin(31) based;
   dcl r pointer;
   allocate a set(r);
   r -> a(2) = 5;
   if r -> a(2) ^= 5 then do;
      put skip list('FAIL based_noptr: check at line 39 failed');
      stop;
   end;
   free (r -> a);

   /* a scalar bare-based variable (empty member path) stores/loads */
   dcl sv fixed bin(31) based;
   dcl sp pointer;
   dcl sval fixed bin(31);
   sp = addr(sval);
   sp -> sv = 13;
   if sval ^= 13 then do;
      put skip list('FAIL based_noptr: expected 13, got', sval);
      stop;
   end;
   if sp -> sv ^= 13 then do;
      put skip list('FAIL based_noptr: check at line 49 failed');
      stop;
   end;

   put skip list('PASS based_noptr');
 end based_noptr;
