  /* ALLOCATE/FREE (rules (87)-(90)): heap-allocate a based structure, store
     the address in a POINTER via SET, address its members through the locator,
     and release the block with FREE. Two allocations of the same based
     variable produce independent blocks. */
  alloc_test: procedure options(main);
     declare p pointer;
     declare q pointer;
     declare 1 rec based(p),
            2 a fixed bin(31),
            2 b fixed bin(31);
     allocate rec set (p);
     if p = null() then do;
        put skip list('FAIL p null after ALLOCATE');
        stop;
     end;
     /* write and read through the locator */
     p -> rec.a = 42;
     p -> rec.b = 7;
     if p -> rec.a ^= 42 then do;
        put skip list('FAIL rec.a after alloc');
        stop;
     end;
     if p -> rec.b ^= 7 then do;
        put skip list('FAIL rec.b after alloc');
        stop;
     end;
     /* a second allocation of the same based variable gives a fresh block */
     q = p;
     allocate rec set (p);
     if p = null() then do;
        put skip list('FAIL second ALLOCATE null');
        stop;
     end;
     if p = q then do;
        put skip list('FAIL second block equals first');
        stop;
     end;
     /* writes through the new block do not disturb the first */
     p -> rec.a = 99;
     if q -> rec.a ^= 42 then do;
        put skip list('FAIL first block corrupted');
        stop;
     end;
     /* FREE: the locator form and the based variable's own BASED pointer */
     free q -> rec;
     free rec;
   put skip list('PASS alloc');
  end alloc_test;
