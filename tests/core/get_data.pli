   /* rules (104)-(106),(109),(110): GET
     DATA reads NAME=value pairs in any
     order, skipping unknown names; a
     PUT DATA / GET DATA round-trip
     recovers every value. */
   get_data: procedure options(main);
      declare a fixed bin(31);
      declare x float;
      declare s char(4);
      declare v char(8) varying;
      declare b bit(1);
      declare c fixed bin(31);
      declare y float;
      declare buf char(64);
      a = 42;
      x = 2.5;
      s = 'ab';
      b = '1'b;
      put string(buf) data(a, x, s, b);
      a = 0;
      x = 0;
      s = '';
      b = '0'b;
      get string(buf) data(a, x, s, b);
      if a ^= 42 then do;
         put skip list('FAIL a');
         stop;
      end;
      if x ^= 2.5 then do;
         put skip list('FAIL x');
         stop;
      end;
      if s ^= 'ab' then do;
         put skip list('FAIL s');
         stop;
      end;
      if b ^= '1'b then do;
         put skip list('FAIL b');
         stop;
      end;
      buf = 'Y=7.0, ZZ=99, C=3;';
      c = 0;
      y = 0;
      get string(buf) data(c, y);
      if c ^= 3 then do;
         put skip list('FAIL reorder c');
         stop;
      end;
      if y ^= 7.0 then do;
         put skip list('FAIL reorder y');
         stop;
      end;
      /* VARYING takes the value length, not the maximum. */
      buf = 'V=Alice;';
      get string(buf) data(v);
      if length(v) ^= 5 then do;
         put skip list('FAIL varying len', length(v));
         stop;
      end;
      if v ^= 'Alice' then do;
         put skip list('FAIL varying value', v);
         stop;
      end;
   put skip list('PASS get-data');
   end get_data;
