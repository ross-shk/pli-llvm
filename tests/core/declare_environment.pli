/* rule (39),(40): ENVIRONMENT in DECLARE accepted, no effect. */
declare_environment: procedure options(main);
    declare f file environment('RECSIZE(80) BLKSIZE(800)');
    open file(f) title('declare_env.dat') output;
    put file(f) list('test');
    close file(f);
    put skip list('PASS declare_environment');
end declare_environment;