 /* BIT(n>1) limits (rule (12),(18)): adjustable BIT(*) wide arrays
    and wide BIT arrays as ENTRY descriptors stay diagnosed. */
 bad_bitn_array: procedure options(main);
    declare arr(*) bit(8);
    put skip list('unreachable');
 end bad_bitn_array;
