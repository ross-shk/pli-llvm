/* rule (101): OPEN PAGESIZE option — raises ENDPAGE on page overflow. */
open_pagesize_endpage: procedure options(main);
    declare f file;
    declare endpage_hit fixed bin(31) init(0);
    on endpage(f) begin;
        endpage_hit = 1;
    end;
    open file(f) title('open_pagesize_endpage.dat') output stream print pagesize(3);
    put file(f) list('line1');
    put file(f) list('line2');
    put file(f) list('line3');
    put file(f) list('line4'); /* This should trigger ENDPAGE */
    put file(f) list('line5');
    close file(f);
    if endpage_hit = 1 then put skip list('PASS open_pagesize_endpage');
    else put skip list('FAIL open_pagesize_endpage');
end open_pagesize_endpage;