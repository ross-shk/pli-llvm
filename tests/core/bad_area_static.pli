 /* rule (20): STATIC areas are served (ADR-310) and an EXTERNAL area is
    one shared region (ADR-318), but a parameter has no storage of its
    own, so STATIC stays diagnosed there. */
 bad_area_static: procedure options(main);
    declare b area(1000) static;
    call inner(b);

 inner: procedure(x);
    declare x area(1000) static;
 end inner;
 end bad_area_static;
