 /* BEGIN as a real scope (rule (68)): a block declares names of its own,
    enclosing names stay visible inside, and an inner declaration shadows an
    outer one without disturbing it after the block ends. */
 begin_test: procedure options(main);
    declare x fixed bin(31);


    /* An inner declaration shadows the outer x inside the block... */
    x = 1;
    begin;
       declare x fixed bin(31);
       declare y fixed bin(31);
       x = 100;
       y = x + 1;
       if y ¬= 101 then do;
          put skip list('FAIL: shadowed x y =', y);
          stop;
       end;
    end;

    /* ...and the outer x is untouched after the block. */
    if x ¬= 1 then do;
       put skip list('FAIL: outer x =', x);
       stop;
    end;

   put skip list('PASS begin scope');
 end begin_test;
