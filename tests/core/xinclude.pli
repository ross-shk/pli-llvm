  /* IBM Enterprise %XINCLUDE (ADR-157):
     include-once list with quoted, bare,
     parenthesized names; repeats skip. */
 xinclude: procedure options(main);
    declare xa fixed bin(31) init(0);
    declare xb fixed bin(31) init(0);
    declare xc fixed bin(31) init(0);
    declare xd fixed bin(31) init(0);
    declare xe fixed bin(31) init(0);
    declare xf fixed bin(31) init(0);
    declare xg fixed bin(31) init(0);
    declare xh fixed bin(31) init(0);
    declare fails fixed bin(31) init(0);
    %xinclude 'xinc_once.inc';
    %xinclude 'xinc_once.inc';
    %xinclude 'xinc_b.inc', 'xinc_c.inc';
    %xinclude xinc_d;
    %xinclude 'xinc_d.inc';
    %xinclude (xinc_e);
    %include 'xinc_f.inc';
    %xinclude 'xinc_f.inc';
    %xinclude 'xinc_g.inc';
    %include 'xinc_g.inc';
    %xinclude 'xinc_cycle_a.inc';
    if xa ^= 1 then fails = fails + 1;
    if xb ^= 10 then fails = fails + 1;
    if xc ^= 20 then fails = fails + 1;
    if xd ^= 1 then fails = fails + 1;
    if xe ^= 40 then fails = fails + 1;
    if xf ^= 1 then fails = fails + 1;
    if xh ^= 2 then fails = fails + 1;
    if xg ^= 11 then fails = fails + 1;
    if fails = 0 then put skip list('PASS xinclude');
    else put skip list('FAIL xinclude fails =',
       fails);
 end xinclude;
