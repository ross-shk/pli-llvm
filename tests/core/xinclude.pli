  /* IBM Enterprise %XINCLUDE (ADR-157):
     include-once list with quoted, bare,
     parenthesized names; repeats skip. */
 xinclude: procedure options(main);
    declare xa fixed bin(31) init(0);
    declare xb fixed bin(31) init(0);
    declare xc fixed bin(31) init(0);
    declare xd fixed bin(31) init(0);
    declare xe fixed bin(31) init(0);
    declare xf fixed bin(31) init(0);
    declare xg fixed bin(31) init(0);
    declare xh fixed bin(31) init(0);
    %xinclude 'xinc_once.inc';
    %xinclude 'xinc_once.inc';
    %xinclude 'xinc_b.inc', 'xinc_c.inc';
    %xinclude xinc_d;
    %xinclude 'xinc_d.inc';
    %xinclude (xinc_e);
    %include 'xinc_f.inc';
    %xinclude 'xinc_f.inc';
    %xinclude 'xinc_g.inc';
    %include 'xinc_g.inc';
    %xinclude 'xinc_cycle_a.inc';
    if xa ^= 1 then do;
       put skip list('FAIL xinclude: expected 1, got', xa);
       stop;
    end;
    if xb ^= 10 then do;
       put skip list('FAIL xinclude: expected 10, got', xb);
       stop;
    end;
    if xc ^= 20 then do;
       put skip list('FAIL xinclude: expected 20, got', xc);
       stop;
    end;
    if xd ^= 1 then do;
       put skip list('FAIL xinclude: expected 1, got', xd);
       stop;
    end;
    if xe ^= 40 then do;
       put skip list('FAIL xinclude: expected 40, got', xe);
       stop;
    end;
    if xf ^= 1 then do;
       put skip list('FAIL xinclude: expected 1, got', xf);
       stop;
    end;
    if xh ^= 2 then do;
       put skip list('FAIL xinclude: expected 2, got', xh);
       stop;
    end;
    if xg ^= 11 then do;
       put skip list('FAIL xinclude: expected 11, got', xg);
       stop;
    end;
   put skip list('PASS xinclude');
 end xinclude;
