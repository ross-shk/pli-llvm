 /* OPEN LINESIZE/PAGESIZE runtime behavior (rules 100,101) */
 open_linesize_pagesize: proc options(main);
     dcl f file print;
     open file(f) title('test_linesize.dat') output linesize(10) pagesize(3);
     put file(f) list('This line should wrap at column 10');
     put file(f) page list('New page at line 4');
     close file(f);
     put skip list('PASS open_linesize_pagesize');
 end open_linesize_pagesize;