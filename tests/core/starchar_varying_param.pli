  /* Rule (18): CHARACTER(*) VARYING parameters — caller's max capacity from hidden i64 arg. */
  starchar_var: procedure options(main);
     declare buf char(20) varying;
     declare len fixed bin(31);
     buf = 'hello';
     call show_len(buf);
     call grow_buf(buf);
     if length(buf) ^= 7 then do;
        put skip list('FAIL starchar_varying_param: expected 7, got', length(buf));
        stop;
     end;
     if buf ^= 'hello!!' then do;
        put skip list('FAIL starchar_varying_param: expected hello!!, got', buf);
        stop;
     end;
     put skip list('PASS starchar_varying_param');
  end starchar_var;
  show_len: procedure(s);
     declare s char(*) varying;
     declare n fixed bin(31);
     n = length(s);
     /* Just verify the param works — no assertion needed here */
  end show_len;
  grow_buf: procedure(s);
     declare s char(*) varying;
     s = s || '!!';
  end grow_buf;
