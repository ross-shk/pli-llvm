/* Rule (23): STATIC declared inside nested BEGIN block has program lifetime. */
static_nested_begin: procedure options(main);
    call outer();
    call outer();
    put skip list('PASS static_nested_begin');
end static_nested_begin;

outer: proc options(bypass);
    begin;
        dcl x fixed bin(31) static initial(5);  /* STATIC declared INSIDE BEGIN */
        x = x + 1;
        put skip list('x=', x);
    end;
    return;
end outer;