  /* lane B3: socket calls route through
     ENTRY ... EXTERNAL (no new compiler
     work); a C stub socketpair round-trips
     a value between the two ends. */
  socket_pair: procedure options(main);
     declare a fixed bin(31);
     declare b fixed bin(31);
     declare v fixed bin(31);
     declare rc fixed bin(31);
     declare fails fixed bin(31);
     declare sk_pair entry(fixed bin(31),
        fixed bin(31)) returns(fixed bin(31))
        external('sk_pair');
     declare sk_send entry(fixed bin(31),
        fixed bin(31)) external('sk_send');
     declare sk_recv entry(fixed bin(31))
        returns(fixed bin(31))
        external('sk_recv');
     declare sk_close entry(fixed bin(31))
        external('sk_close');
     fails = 0;

     rc = sk_pair(a, b);
     if rc ^= 0 then do;
        fails = fails + 1;
        put skip list('FAIL pair', rc);
     end;

     call sk_send(a, 42);
     v = sk_recv(b);
     if v ^= 42 then do;
        fails = fails + 1;
        put skip list('FAIL roundtrip', v);
     end;

     call sk_close(a);
     call sk_close(b);
     if fails = 0
        then put skip list('PASS socket-pair');
        else put skip list('FAIL socket-pair');
  end socket_pair;
