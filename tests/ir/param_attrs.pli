 /* WS-G3 (ADR-271): the shape of a by-ref array parameter. The dummy's
    declared extent is known at compile time, so its base pointer addresses
    at least that many elements and LLVM may widen the loads it makes
    through it. */
 param_attrs: procedure options(main);
   declare a(16) fixed bin(31);
   declare s fixed bin(63);
   s = total(a);
   put skip list(s);

   total: procedure(x) returns(fixed bin(63));
      declare x(16) fixed bin(31);
      declare i fixed bin(31);
      declare t fixed bin(63);
      t = 0;
      do i = 1 to 16;
         t = t + x(i);
      end;
      return(t);
   end total;
 end param_attrs;
