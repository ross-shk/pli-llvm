 /* Copyright 2026 Ross S. - plic: a PL/I compiler targeting LLVM */
 /* Runtime ABI attributes (OPTIMIZATION.md P0, §6): the pli_*
    declarations carry LLVM-only facts from runtimeFn's side table —
    noreturn aborts, alloc-family allocation, pure math, argmem string
    helpers — while the shared .def stays signature-only. */
 attrs: procedure options(main);
   declare s char(8);
   declare a(4) fixed bin(31);
   declare i fixed bin(31);
   declare p pointer;
   declare x fixed bin(31) based(p);
   s = 'hi';
   i = index(s, 'i');
   a(2) = i;
   i = mod(i + a(2), 3);
   allocate x set(p);
   free x;
   put skip list(i);
 end attrs;
