/* W4b IR golden (runtime mode): math transcendentals must use pli_* runtime
   calls, not llvm.* intrinsics. */
w4b_math_rt: procedure options(main);
   declare f float(6);
   f = sqrt(4.0) + exp(1.0) + atan2(1.0, 1.0);
   put skip list(f);
end w4b_math_rt;
