/* W6 IR golden: aggregate/char array copy must lower to llvm.memmove,
   not pli_assign_char. */
w6_vector_llvm: procedure options(main);
   declare
      a(1000) char(64),
      b(1000) char(64),
      i fixed bin(31),
      fails fixed bin(31);
   fails = 0;
   do i = 1 to 1000;
      a(i) = 'content';
   end;
   b = a;
   do i = 1 to 1000;
      if b(i) ^= a(i) then do;
         fails = fails + 1;
      end;
   end;
   if fails = 0 then put skip list('PASS w6_vector_llvm');
   else put skip list('FAIL w6_vector_llvm: fails =', fails);
end w6_vector_llvm;
