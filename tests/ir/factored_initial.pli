 /* IR check: factored scalar STATIC INITIAL produces independent globals
    (rules 11, 23, 26). */
 FACTORED_IR: PROCEDURE OPTIONS(MAIN);
   DECLARE (A, B, C)(3) FIXED BIN(31) STATIC INITIAL((2)1, 2);
   /* A: 1,1,2  B: 1,1,2  C: 1,1,2 — three independent store sequences */
 END FACTORED_IR;