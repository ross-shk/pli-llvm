 /* Rules (11),(26): factored STATIC INITIAL — two distinct globals. */
 factored_initial_ir: procedure options(main);
     declare (s1, s2) fixed bin(31) static initial((10), (20));
     put skip list(s1, s2);
 end factored_initial_ir;