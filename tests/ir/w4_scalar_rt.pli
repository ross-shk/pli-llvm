/* W4 IR check: runtime mode. CHECK confirms pli_* calls present. */
w4_rt: procedure options(main);
    declare x fixed bin(31);
    declare f float(6);
    declare s char(20);
    declare y char(24);
    f = 3.5;
    x = fixed(f);
    x = fixed(s);
    x = fixed('123');
    y = 'val=' || 42;
    y = 'flt=' || f;
    y = 'neg=' || -7;
    y = 'zero=' || 0;
end w4_rt;
