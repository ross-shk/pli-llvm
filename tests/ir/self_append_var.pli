 /* P6.1b-string litmus: X = X || V with a variable tail must append in
    place like the literal-tail peephole — no temp buffer, so no pli_alloc
    anywhere in the procedure. */
 self_append_var: procedure options(main);
   declare r character(100) varying;
   declare t character(100) varying;
   declare n fixed bin(31);
   r = 'a';
   t = 'bc';
   r = r || t;
   n = length(r);
   put skip list(n);
 end self_append_var;
