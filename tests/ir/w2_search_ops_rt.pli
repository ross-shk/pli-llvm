 /* W2 search/scan IR check: runtime mode. CHECK confirms pli_* calls present. */
 w2_rt: procedure options(main);
    declare r fixed bin(31);
    declare s char(20) varying;
    s = 'hello';
    r = index(s, 'll');
    r = verify('ABCD', 'BCD');
    r = search('hello world', 'xdz', 1);
    r = tally('abcabc', 'bc');
 end w2_rt;
