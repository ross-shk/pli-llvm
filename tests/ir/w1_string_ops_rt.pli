 /* W1 runtime mode checks: pli_* calls present for migrated operations. */
 w1_rt: procedure options(main);
    declare v char(20) varying;
    v = 'hello';
    declare h char(3);
    h = high(3);
    declare l char(3);
    l = low(3);
    declare u char(5);
    u = uppercase('hello');
    declare lc char(5);
    lc = lowercase('HeLLo');
    declare r char(5);
    r = reverse('hello');
    declare c char(5);
    c = center('x', 5);
    if 'abc' ^= 'abd' then put skip list('diff');
    else put skip list('same');
 end w1_rt;
