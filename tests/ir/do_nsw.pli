/* P5.3 / P3.1 litmus: at -O2 with checks off, the DO step add must
   carry the nsw flag (rule (86): DO overflow is trapped by SIZE
   condition when checks are on; at -O2 without traps nsw is safe). */
DO_NSW_IR: PROCEDURE OPTIONS(MAIN);
   DECLARE I, S FIXED BINARY(31);
   S = 0;
   DO I = 1 TO 1000;
     S = S + I;
   END;
   PUT SKIP LIST(S);
END DO_NSW_IR;
