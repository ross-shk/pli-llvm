/* P1.3 MOD fast path: constant dividend and divisor that provably non-negative
   must not emit the adjust/select chain (modadj/modnz/modneg/mods). */
MOD_LIT_IR: PROCEDURE OPTIONS(MAIN);
   DECLARE R FIXED BINARY(31);
   R = MOD(100, 3); PUT SKIP LIST(R);
   R = MOD(100, 4); PUT SKIP LIST(R);
   R = MOD(100, 8); PUT SKIP LIST(R);
   R = MOD(-100, 3); PUT SKIP LIST(R);
   R = MOD(-100, 4); PUT SKIP LIST(R);
   R = MOD(-100, 8); PUT SKIP LIST(R);
END MOD_LIT_IR;
