/* W4c IR golden (llvm mode): RANK/COLLATE/ISOCHAR must use direct LLVM,
   not pli_* runtime calls. */
w4c_codepoint_llvm: procedure options(main);
   declare c char(1);
   declare n fixed bin(31);
   c = 'A';
   n = rank(c);
   put skip list(n);
   c = collate(65);
   put skip list(c);
end w4c_codepoint_llvm;
