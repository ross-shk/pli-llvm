/* W4 scalar conversion IR check: exercises FIXED(float) and FIXED(char)
   in direct LLVM mode. CHECK-NOT confirms no pli_* calls remain. */
w4_ir: procedure options(main);
    declare x fixed bin(31);
    declare f float(6);
    declare s char(20);
    x = fixed(f);
    x = fixed(s);
    x = fixed('123');
end w4_ir;
