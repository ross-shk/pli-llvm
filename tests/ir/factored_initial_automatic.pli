 /* IR check: factored AUTOMATIC INITIAL emits entry-block stores, no globals
    (rules 11, 26). */
 FACTORED_AUTO_IR: PROCEDURE OPTIONS(MAIN);
   DECLARE (X, Y)(2) FIXED BIN(31) INITIAL(1, 2);
   /* Automatic: stores in entry block, not globals */
 END FACTORED_AUTO_IR;