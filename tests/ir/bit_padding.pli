 /* A BIT(5) is left-justified in one byte: the low three bits are
    storage padding, not part of the value. `^` complements the five
    value bits and normalises the padding bits to zero (ADR-281,
    ADR-243, ADR-275). */
 bit_padding: procedure options(main);
    declare b bit(5);
    declare c bit(5);
    b = '00011'b;
    c = ^b;
    if c = '11100'b then put skip list('ok');
 end bit_padding;
