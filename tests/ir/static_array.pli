/* STATIC array with INITIAL — verify global constant array initializer. Rule (26). */
static_array_ir: procedure options(main);
    declare a(3) fixed bin(31) static initial((1, 2, 3));
    put skip list(a(1), a(2), a(3));
    if a(1) = 1 & a(2) = 2 & a(3) = 3 then
        put skip list('PASS static_array_ir');
    else
        put skip list('FAIL static_array_ir');
end static_array_ir;