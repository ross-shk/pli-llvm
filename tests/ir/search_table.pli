 /* ADR-241: VERIFY and SEARCH with a constant alphabet lower to a 256-entry
    membership table, not a byte-at-a-time scan of the alphabet. The .check
    asserts the table global and that no pli_verify/pli_search call is left. */
 search_table: procedure options(main);
    declare r fixed bin(31);
    declare s char(20) init('hello world');
    r = verify(s, '0123456789');
    r = search(s, '0123456789', 1);
 end search_table;
