/* P6.3 litmus: MOD(DO_index, k) with FROM >= 0 and positive constant k
   must emit a plain srem (no modadj/modnz/modneg/select chain). The existing
   mod_lit test covers constant dividends; this pins the DO-index path. */
MOD_INDEX_IR: PROCEDURE OPTIONS(MAIN);
   DECLARE I, S FIXED BINARY(31);
   S = 0;
   DO I = 1 TO 1000;
     S = S + MOD(I, 3);
   END;
   PUT SKIP LIST(S);
END MOD_INDEX_IR;
