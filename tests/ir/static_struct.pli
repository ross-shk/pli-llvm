/* STATIC structure with INITIAL — verify global constant struct initializer. Rule (26). */
static_struct_ir: procedure options(main);
    declare 1 s static,
        2 x fixed bin(31) init(10),
        2 y fixed bin(31) init(20);
    put skip list(s.x, s.y);
    if s.x = 10 & s.y = 20 then
        put skip list('PASS static_struct_ir');
    else
        put skip list('FAIL static_struct_ir');
end static_struct_ir;