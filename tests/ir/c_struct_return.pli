 /* Rule (34)/(127): external ENTRY RETURNS(structure) returns through
    the caller's hidden sret buffer (first pointer argument). */
  cstruct: procedure options(main);
    dcl 1 s,
           2 a fixed bin(31),
           2 b fixed bin(31);
    dcl 1 t,
           2 a fixed bin(31),
           2 b fixed bin(31);
    dcl e entry returns(s) external;

    t = e();
    if t.a ^= 10 then do;
       put skip list('FAIL c_struct_return: a');
       stop;
    end;
    if t.b ^= 20 then do;
       put skip list('FAIL c_struct_return: b');
       stop;
    end;

    put skip list('PASS c_struct_return');
  end cstruct;
