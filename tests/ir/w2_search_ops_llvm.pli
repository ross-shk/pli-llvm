 /* W2 search/scan IR check: exercises VERIFY, SEARCH, TALLY, INDEX
    in direct LLVM mode. INDEX lowers to an inline memchr+memcmp fast path
    (no byte loop) with a cold pli_index slow-path call for first-candidate
    mismatches; VERIFY/SEARCH/TALLY stay fully inline with no pli_* calls. */
 w2_ir: procedure options(main);
    declare r fixed bin(31);
    declare s char(20) varying;
    s = 'hello';
    r = index(s, 'll');
    r = verify('ABCD', 'BCD');
    r = search('hello world', 'xdz', 1);
    r = tally('abcabc', 'bc');
 end w2_ir;
