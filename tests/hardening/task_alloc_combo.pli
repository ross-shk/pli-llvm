 /* rules (8),(25),(79),(82),(87)-(90):
    workers allocate their own heap BASED
    blocks and CONTROLLED generations and
    also reach the main block through its
    locator link (a bare BASED static-link
    slot carries an explicit null); disjoint
    cells keep the workers race-free under
    WAIT-for-all. */
 talloc: procedure options(main);
    declare e1 event;
    declare e2 event;
    declare res(2) fixed bin(31);
    declare fails fixed bin(31);
    declare p pointer;
    declare pa pointer;
    declare 1 mrec based,
              2 v fixed bin(31);
    declare marr(2) fixed bin(31) based;
    fails = 0;
    res(1) = 0;
    res(2) = 0;
    /* main-side heap use interleaved with
       the workers' own allocations */
    allocate mrec set(p);
    p -> mrec.v = 7;
    allocate marr set(pa);
    pa -> marr(1) = 0;
    pa -> marr(2) = 0;
    call w(1) event(e1);
    call w(2) event(e2);
    wait(e1, e2);
    if res(1) ^= 111 then
       fails = fails + 1;
    if res(2) ^= 222 then
       fails = fails + 1;
    /* each worker stored through the
       enclosing locator into its cell */
    if pa -> marr(1) ^= 101 then
       fails = fails + 1;
    if pa -> marr(2) ^= 202 then
       fails = fails + 1;
    /* the scalar block is untouched */
    if p -> mrec.v ^= 7 then
       fails = fails + 1;
    free pa -> marr;
    free p -> mrec;
    if fails = 0 then
       put skip list('PASS task_alloc_combo');
    else
       put skip list('FAIL task_alloc: ',
          fails);
    w: procedure(k);
       declare k fixed bin(31);
       declare q pointer;
       declare 1 wrec based,
                 2 v fixed bin(31);
       declare c fixed bin(31) controlled;
       allocate wrec set(q);
       q -> wrec.v = k * 100;
       allocate c;
       c = k * 10;
       res(k) = q -> wrec.v + c + k;
       pa -> marr(k) = q -> wrec.v + k;
       free q -> wrec;
       free c;
    end w;
 end talloc;
