 /* A call actual is evaluated exactly once (rule 78). The hidden
    CHAR(*) length argument used to re-evaluate the actual, so an
    argument expression with a side effect ran twice: once for the
    buffer and once for its length. The two evaluations could
    disagree, leaving the callee with a buffer and a length from
    different calls. */
 once_test: proc options(main);
    declare t char(20) varying;
    declare n fixed bin(31);
    declare len fixed bin(31);
    declare fails fixed bin(31);
    fails = 0;
    t = 'hello';
    n = 0;
    len = show(mk(t));
    /* one evaluation: the counter advanced once ... */
    if n ^= 1 then fails = fails + 1;
    /* ... and the length is the first result, not the second */
    if len ^= 3 then fails = fails + 1;
    if fails = 0 then put skip list('PASS');
    else put skip list('FAIL call-actual-once: n =', n,
       'len =', len);

 show: procedure(s) returns(fixed bin(31));
    declare s char(*);
    return(length(s));
 end show;

 mk: procedure(v) returns(char(10) varying);
    declare v char(20) varying;
    declare r char(10) varying;
    n = n + 1;
    if n = 1 then r = 'abc';
    else r = 'abcdefgh';
    return(r);
 end mk;
 end once_test;
