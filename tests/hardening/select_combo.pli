 /* SPDX-License-Identifier: Apache-2.0 */
 /* Subset G hardening: SELECT first-match
    wins, nested groups, missing OTHERWISE,
    CHAR selector, loop-driven dispatch. */
 select_combo: procedure options(main);
    declare fails fixed bin(31);
    declare k fixed bin(31);
    declare hits fixed bin(31);
    declare st char(8);
    declare i fixed bin(31);
    fails = 0;
    /* first match wins even when the body
       mutates the selector variable */
    k = 1;
    hits = 0;
    select (k);
       when (1) do;
          hits = hits + 1;
          k = 2;
       end;
       when (2) hits = hits + 10;
       otherwise hits = hits + 100;
    end;
    if hits ^= 1 then fails = fails + 1;
    if k ^= 2 then fails = fails + 1;
    /* multi-value lists pick the right arm */
    k = 5;
    hits = 0;
    select (k);
       when (1, 2, 3) hits = 1;
       when (4, 5, 6) hits = 2;
       when (7, 8, 9) hits = 3;
       otherwise hits = 9;
    end;
    if hits ^= 2 then fails = fails + 1;
    /* no OTHERWISE leaves state unchanged */
    k = 42;
    hits = 0;
    select (k);
       when (1) hits = 1;
       when (2) hits = 2;
    end;
    if hits ^= 0 then fails = fails + 1;
    /* CHAR selector with string lists */
    st = 'active';
    hits = 0;
    select (st);
       when ('pending') hits = 1;
       when ('active') hits = 2;
       otherwise hits = 3;
    end;
    if hits ^= 2 then fails = fails + 1;
    /* nested SELECT inside a WHEN arm */
    k = 2;
    hits = 0;
    select (k);
       when (2) do;
          st = 'x';
          select;
             when (st = 'x') hits = 20;
             otherwise hits = 21;
          end;
       end;
       otherwise hits = 22;
    end;
    if hits ^= 20 then fails = fails + 1;
    /* bare-predicate form orders by test */
    hits = 0;
    k = -4;
    select;
       when (k > 0) hits = 1;
       when (k < 0) hits = 2;
       otherwise hits = 3;
    end;
    if hits ^= 2 then fails = fails + 1;
    /* dispatch inside a loop sees each key */
    hits = 0;
    do i = 1 to 4;
       select (i);
          when (1, 3) hits = hits + 1;
          when (2, 4) hits = hits + 10;
          otherwise hits = hits + 100;
       end;
    end;
    if hits ^= 22 then fails = fails + 1;
    if fails = 0 then put skip list('PASS');
    else put skip list('FAIL select_combo: ',
       fails);
 end select_combo;
