 /* SPDX-License-Identifier: Apache-2.0 */
 /* Subset G hardening: custom lower
    bounds, negative bounds, generic (*)
    procs, per-axis bounds and reductions
    combined. */
 array_generic_combo: proc options(main);
    declare i fixed bin(31);
    declare j fixed bin(31);
    declare t(-1:1, 0:2) fixed bin(31);
    declare v(5) fixed bin(31);
    declare u(-2:2) fixed bin(31);
    declare m(2, 3) fixed bin(31);
    /* A(5) means A(1:5) */
    do i = 1 to 5;
       v(i) = i * 10;
    end;
    if lbound(v) ^= 1 then do;
       put skip list('FAIL array_generic_combo: expected 1, got',
          lbound(v));
       stop;
    end;
    if hbound(v) ^= 5 then do;
       put skip list('FAIL array_generic_combo: expected 5, got',
          hbound(v));
       stop;
    end;
    if dim(v) ^= 5 then do;
       put skip list('FAIL array_generic_combo: expected 5, got',
          dim(v));
       stop;
    end;
    if sum(v) ^= 150 then do;
       put skip list('FAIL array_generic_combo: expected 150, got',
          sum(v));
       stop;
    end;
    /* a second 1-D shape with a lower
       bound below 1 */
    do i = -2 to 2;
       u(i) = i + 3;
    end;
    if lbound(u) ^= -2 then do;
       put skip list('FAIL array_generic_combo: expected -2, got',
          lbound(u));
       stop;
    end;
    if hbound(u) ^= 2 then do;
       put skip list('FAIL array_generic_combo: expected 2, got',
          hbound(u));
       stop;
    end;
    if dimension(u) ^= 5 then do;
       put skip list('FAIL array_generic_combo: expected 5, got',
          dimension(u));
       stop;
    end;
    /* one (*) callee serves both shapes */
    if total(v) ^= 150 then do;
       put skip list('FAIL array_generic_combo: expected 150, got',
          total(v));
       stop;
    end;
    if total(u) ^= 15 then do;
       put skip list('FAIL array_generic_combo: expected 15, got',
          total(u));
       stop;
    end;
    call dbl(v);
    call dbl(u);
    if v(1) ^= 20 then do;
       put skip list('FAIL array_generic_combo: expected 20, got',
          v(1));
       stop;
    end;
    if v(5) ^= 100 then do;
       put skip list('FAIL array_generic_combo: expected 100, got',
          v(5));
       stop;
    end;
    if u(-2) ^= 2 then do;
       put skip list('FAIL array_generic_combo: expected 2, got',
          u(-2));
       stop;
    end;
    if u(2) ^= 10 then do;
       put skip list('FAIL array_generic_combo: expected 10, got',
          u(2));
       stop;
    end;
    /* negative 2-D bounds hold i * j */
    do i = -1 to 1;
       do j = 0 to 2;
          t(i, j) = i * j;
       end;
    end;
    if t(-1, 2) ^= -2 then do;
       put skip list('FAIL array_generic_combo: expected -2, got',
          t(-1, 2));
       stop;
    end;
    if t(0, 1) ^= 0 then do;
       put skip list('FAIL array_generic_combo: expected 0, got',
          t(0, 1));
       stop;
    end;
    if lbound(t, 1) ^= -1 then do;
       put skip list('FAIL array_generic_combo: expected -1, got',
          lbound(t, 1));
       stop;
    end;
    if hbound(t, 1) ^= 1 then do;
       put skip list('FAIL array_generic_combo: expected 1, got',
          hbound(t, 1));
       stop;
    end;
    if lbound(t, 2) ^= 0 then do;
       put skip list('FAIL array_generic_combo: expected 0, got',
          lbound(t, 2));
       stop;
    end;
    if hbound(t, 2) ^= 2 then do;
       put skip list('FAIL array_generic_combo: expected 2, got',
          hbound(t, 2));
       stop;
    end;
    if dimension(t, 1) ^= 3 then do;
       put skip list('FAIL array_generic_combo: expected 3, got',
          dimension(t, 1));
       stop;
    end;
    if dimension(t, 2) ^= 3 then do;
       put skip list('FAIL array_generic_combo: expected 3, got',
          dimension(t, 2));
       stop;
    end;
    call fill(t);
    if t(1, 2) ^= 3 then do;
       put skip list('FAIL array_generic_combo: expected 3, got',
          t(1, 2));
       stop;
    end;
    if t(-1, 0) ^= -1 then do;
       put skip list('FAIL array_generic_combo: expected -1, got',
          t(-1, 0));
       stop;
    end;
    if trace(t) ^= 3 then do;
       put skip list('FAIL array_generic_combo: expected 3, got',
          trace(t));
       stop;
    end;
    /* a second 2-D shape, same pattern */
    do i = 1 to 2;
       do j = 1 to 3;
          m(i, j) = i + j;
       end;
    end;
    call fillm(m);
    if m(2, 3) ^= 5 then do;
       put skip list('FAIL array_generic_combo: expected 5, got',
          m(2, 3));
       stop;
    end;
    if tracem(m) ^= 10 then do;
       put skip list('FAIL array_generic_combo: expected 10, got',
          tracem(m));
       stop;
    end;
   put skip list('PASS array_generic_combo');
 total: procedure(w)
    returns(fixed bin(31));
    declare w(*) fixed bin(31);
    declare k fixed bin(31);
    declare s fixed bin(31);
    s = 0;
    do k = lbound(w) to hbound(w);
       s = s + w(k);
    end;
    return(s);
 end total;
 dbl: procedure(w);
    declare w(*) fixed bin(31);
    declare k fixed bin(31);
    do k = lbound(w) to hbound(w);
       w(k) = w(k) * 2;
    end;
 end dbl;
 fill: procedure(g);
    declare g(-1:1, 0:2) fixed bin(31);
    declare a fixed bin(31);
    declare q fixed bin(31);
    do a = lbound(g, 1) to hbound(g, 1);
       do q = lbound(g, 2) to
          hbound(g, 2);
          g(a, q) = a + q;
       end;
    end;
 end fill;
 trace: procedure(g)
    returns(fixed bin(31));
    declare g(-1:1, 0:2) fixed bin(31);
    return(g(-1, 0) + g(0, 1) +
       g(1, 2));
 end trace;
 fillm: procedure(g);
    declare g(2, 3) fixed bin(31);
    declare a fixed bin(31);
    declare q fixed bin(31);
    do a = 1 to 2;
       do q = 1 to 3;
          g(a, q) = a + q;
       end;
    end;
 end fillm;
 tracem: procedure(g)
    returns(fixed bin(31));
    declare g(2, 3) fixed bin(31);
    return(g(1, 1) + g(1, 2) +
       g(2, 3));
 end tracem;
 end array_generic_combo;
