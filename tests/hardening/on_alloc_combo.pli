 /* rules (87)-(94): heap BASED blocks and
    CONTROLLED generations stay intact across
    condition traps and resumes. Slips run
    over AUTOMATIC, heap BASED, and CONTROLLED
    arrays (each clamps into range), a SIZE
    trap fires on heap decimal arithmetic,
    and ERROR sees the live top generation.
    Units only touch CONTROLLED data (91). */
 onalloc: procedure options(main);
    declare a(5) fixed bin(31);
    declare d fixed decimal(5,2);
    declare i fixed bin(31);
    declare v fixed bin(31);
    declare c(4) fixed bin(31) controlled;
    declare mark fixed bin(31) controlled;
    declare code fixed bin(31);
    declare p pointer;
    declare q pointer;
    declare h(5) fixed bin(31) based;
    declare 1 rec based,
              2 m fixed decimal(5,2),
              2 f fixed bin(31);
    code = 0;
    do i = 1 to 5;
       a(i) = i * 10;
    end;
    allocate c;
    c(1) = 10;
    c(4) = 40;
    allocate mark;
    mark = 0;
    allocate h set(p);
    p -> h(1) = 10;
    p -> h(5) = 50;
    allocate rec set(q);
    q -> rec.f = 333;
    q -> rec.m = 999.99;
    /* slips clamp on every storage class */
    on subscriptrange begin;
       mark = mark + 1;
    end;
    i = 0;
    v = a(i);
    if v ^= 10 then do;
       put skip list('FAIL on_alloc_combo: expected 10, got', v);
       stop;
    end;
    i = 6;
    v = p -> h(i);
    if v ^= 50 then do;
       put skip list('FAIL on_alloc_combo: expected 50, got', v);
       stop;
    end;
    i = 5;
    v = c(i);
    if v ^= 40 then do;
       put skip list('FAIL on_alloc_combo: expected 40, got', v);
       stop;
    end;
    i = 7;
    c(i) = 99;
    if c(4) ^= 99 then do;
       put skip list('FAIL on_alloc_combo: expected 99, got', c(4));
       stop;
    end;
    i = 8;
    p -> h(i) = 77;
    if p -> h(5) ^= 77 then do;
       put skip list('FAIL on_alloc_combo: check at line 65 failed');
       stop;
    end;
    revert subscriptrange;
    if mark ^= 5 then do;
       put skip list('FAIL on_alloc_combo: expected 5, got', mark);
       stop;
    end;
    /* an overflow reaches SIZE; only the
       firing is asserted, not the wrap */
    on size begin;
       mark = mark + 100;
    end;
    q -> rec.m = q -> rec.m + 0.01;
    revert size;
    if mark ^= 105 then do;
       put skip list('FAIL on_alloc_combo: expected 105, got', mark);
       stop;
    end;
    /* ERROR sees the live top generation */
    on error begin;
       mark = mark + 1000;
       code = oncode();
    end;
    signal error;
    revert error;
    if mark ^= 1105 then do;
       put skip list('FAIL on_alloc_combo: expected 1105, got', mark);
       stop;
    end;
    if code ^= 1 then do;
       put skip list('FAIL on_alloc_combo: expected 1, got', code);
       stop;
    end;
    /* every allocation survived */
    if p -> h(1) ^= 10 then do;
       put skip list('FAIL on_alloc_combo: check at line 91 failed');
       stop;
    end;
    if q -> rec.f ^= 333 then do;
       put skip list('FAIL on_alloc_combo: check at line 93 failed');
       stop;
    end;
    if c(1) ^= 10 then do;
       put skip list('FAIL on_alloc_combo: expected 10, got', c(1));
       stop;
    end;
    if c(4) ^= 99 then do;
       put skip list('FAIL on_alloc_combo: expected 99, got', c(4));
       stop;
    end;
    free p -> h;
    free q -> rec;
    free c;
    free mark;
   put skip list('PASS on_alloc_combo');
 end onalloc;
