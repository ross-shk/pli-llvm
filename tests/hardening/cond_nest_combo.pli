 /* SPDX-License-Identifier: Apache-2.0 */
 /* Subset G hardening: ON units nested
    with SIGNAL, REVERT, ONCODE, RETURN
    and prefix guards in one flow. */
 cond_nest_combo: proc options(main);
    declare x fixed bin(31);
    declare y fixed bin(31);
    declare idx fixed bin(31);
    declare a(10) fixed bin(31);
    declare seen fixed bin(31);
    seen = 0;
    /* SIZE resumes with the wrapped
       value after the handler runs */
    on size begin;
       seen = seen + 1;
    end;
    x = 2147483647;
    x = x + 1;
    if seen ^= 1 then do;
       put skip list('FAIL cond_nest_combo: expected 1, got', seen);
       stop;
    end;
    if x ^= -2147483648 then do;
       put skip list('FAIL cond_nest_combo: expected -2147483648, got',
          x);
       stop;
    end;
    /* ZERODIVIDE resumes with zero */
    on zerodivide begin;
       seen = seen + 10;
    end;
    y = 10 / 0;
    if seen ^= 11 then do;
       put skip list('FAIL cond_nest_combo: expected 11, got', seen);
       stop;
    end;
    if y ^= 0 then do;
       put skip list('FAIL cond_nest_combo: expected 0, got', y);
       stop;
    end;
    /* SUBSCRIPTRANGE clamps the index;
       idx keeps the slip past the
       compile-time check */
    on subscriptrange begin;
       seen = seen + 100;
    end;
    a(5) = 5;
    idx = 15;
    a(idx) = 99;
    if seen ^= 111 then do;
       put skip list('FAIL cond_nest_combo: expected 111, got', seen);
       stop;
    end;
    if a(10) ^= 99 then do;
       put skip list('FAIL cond_nest_combo: expected 99, got', a(10));
       stop;
    end;
    /* ONCODE is 1 inside, 0 outside */
    on error begin;
       if oncode() ^= 1 then seen = -1;
       else seen = seen + 1000;
    end;
    if oncode() ^= 0 then do;
       put skip list('FAIL cond_nest_combo: expected 0, got', oncode());
       stop;
    end;
    signal error;
    if seen ^= 1111 then do;
       put skip list('FAIL cond_nest_combo: expected 1111, got', seen);
       stop;
    end;
    /* RETURN in a unit resumes after
       the SIGNAL statement */
    on error begin;
       seen = seen + 10000;
       return;
    end;
    seen = seen + 1;
    signal error;
    seen = seen + 2;
    if seen ^= 11114 then do;
       put skip list('FAIL cond_nest_combo: expected 11114, got', seen);
       stop;
    end;
    /* a unit may arm and fire the next
       unit; inner bodies only PUT */
    on error begin;
       put skip list('outer unit');
       on zerodivide begin;
          put skip list('inner unit');
          return;
       end;
       signal zerodivide;
       put skip list('outer after');
    end;
    signal error;
    /* REVERT pops, so the first three
       arms are gone */
    revert size;
    revert zerodivide;
    revert subscriptrange;
    revert error;
    /* prefixes suppress without arms */
    (nosize): do;
       x = 2147483647;
       x = x + 1;
    end;
    if x ^= -2147483648 then do;
       put skip list('FAIL cond_nest_combo: expected -2147483648, got',
          x);
       stop;
    end;
    (nozerodivide): do;
       y = 10 / 0;
    end;
    (nosubscriptrange): do;
       a(3) = 33;
    end;
    if a(3) ^= 33 then do;
       put skip list('FAIL cond_nest_combo: expected 33, got', a(3));
       stop;
    end;
   put skip list('PASS cond_nest_combo');
 end cond_nest_combo;
