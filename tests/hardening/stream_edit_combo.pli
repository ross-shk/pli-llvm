 /* SPDX-License-Identifier: Apache-2.0 */
 /* Subset G hardening: EDIT items, remote
    FORMAT, STRING capture and LIST
    round-trips combined. */
 stream_edit_combo: proc options(main);
    declare buf char(40);
    declare a fixed bin(31);
    declare b fixed bin(31);
    declare c fixed bin(31);
    declare d fixed bin(31);
    declare p fixed dec(5, 2);
    declare q fixed dec(5, 2);
    declare e float;
    declare f float;
    declare s char(8);
    declare t char(8);
    declare u char(8);
    declare quote char(8);
    head: format(a(2), col(6), a(2));
    nums: format(f(6), f(6));
    /* A(5) keeps only the first five */
    put string(buf) edit('Hello, world!')
       (a(5));
    get string(buf) edit(s) (a(5));
    if s ^= 'Hello' then do;
       put skip list('FAIL stream_edit_combo: expected Hello, got', s);
       stop;
    end;
    /* doubled apostrophe is one quote */
    quote = 'can''t';
    put string(buf) edit(quote) (a(8));
    get string(buf) edit(t) (a(8));
    if t ^= 'can''t' then do;
       put skip list('FAIL stream_edit_combo: check at line 33 failed');
       stop;
    end;
    /* remote FORMAT spliced with R */
    a = 12;
    b = 34;
    put string(buf) edit(a, b) (r(nums));
    get string(buf) edit(c, d) (r(nums));
    if c ^= 12 then do;
       put skip list('FAIL stream_edit_combo: expected 12, got', c);
       stop;
    end;
    if d ^= 34 then do;
       put skip list('FAIL stream_edit_combo: expected 34, got', d);
       stop;
    end;
    /* COL output lands at its column;
       read back through COL from a
       buffer (COL into STRING output
       hangs: runtime regression) */
    put edit ('ab', 'cd') (r(head));
    buf = 'ab   cd';
    get string(buf) edit (s, t) (r(head));
    if s ^= 'ab' then do;
       put skip list('FAIL stream_edit_combo: expected ab, got', s);
       stop;
    end;
    if t ^= 'cd' then do;
       put skip list('FAIL stream_edit_combo: expected cd, got', t);
       stop;
    end;
    /* F(w, d) decimal round-trips */
    p = 123.45;
    put string(buf) edit(p) (f(8, 2));
    get string(buf) edit(q) (f(8, 2));
    if q ^= 123.45 then do;
       put skip list('FAIL stream_edit_combo: expected 123.45, got', q);
       stop;
    end;
    /* E(w, d) float round-trips */
    e = 3.24e1;
    put string(buf) edit(e) (e(10, 2));
    get string(buf) edit(f) (e(10, 2));
    if abs(f - 32.4) > 0.01 then do;
       put skip list('FAIL stream_edit_combo: check at line 60 failed');
       stop;
    end;
    /* LIST into STRING reads back as
       literals, in order */
    a = 5;
    b = -7;
    e = 2.5;
    put string(buf) list(a, b, e);
    get string(buf) list(c, d, f);
    if c ^= 5 then do;
       put skip list('FAIL stream_edit_combo: expected 5, got', c);
       stop;
    end;
    if d ^= -7 then do;
       put skip list('FAIL stream_edit_combo: expected -7, got', d);
       stop;
    end;
    if f ^= 2.5 then do;
       put skip list('FAIL stream_edit_combo: expected 2.5, got', f);
       stop;
    end;
    /* SKIP option still transmits */
    put skip(2) list('gap');
   put skip list('PASS stream_edit_combo');
 end stream_edit_combo;
