/* Rule (18): adjustable CHAR(*) parameters cross-module.
   Build: two -c units linked together. */
starparam: procedure options(main);
  dcl buf1 char(20) varying;
  dcl buf2 char(50) varying;
  dcl buf3 char(10) varying;
  dcl result fixed bin(31);
  dcl str    char(64) varying;

  dcl fill_buf    entry (char(*), fixed bin(31)) external;
  dcl get_len     entry (char(*)) returns(fixed bin(31)) external;
  dcl concat_buf  entry (char(*), char(*)) external;
  dcl uppercase   entry (char(*)) external;
  dcl get_content entry (char(*)) returns(char(64) varying) external;

  /* Test 1: different buffer sizes */
  buf1 = '';
  call fill_buf(buf1, 10);
  result = get_len(buf1);
  if result ^= 10 then do;
     put skip list('FAIL star_param: expected 10, got', result);
     stop;
  end;
  str = get_content(buf1);
  if str ^= 'xxxxxxxxxx' then do;
     put skip list('FAIL star_param: expected xxxxxxxxxx, got', str);
     stop;
  end;

  buf2 = '';
  call fill_buf(buf2, 30);
  result = get_len(buf2);
  if result ^= 30 then do;
     put skip list('FAIL star_param: expected 30, got', result);
     stop;
  end;
  str = get_content(buf2);
  if str ^= 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' then do;
     put skip list('FAIL star_param: check at line 32 failed');
     stop;
  end;

  buf3 = '';
  call fill_buf(buf3, 15);  /* truncates to 10 */
  result = get_len(buf3);
  if result ^= 10 then do;
     put skip list('FAIL star_param: expected 10, got', result);
     stop;
  end;

  /* Test 2: concatenate two buffers */
  buf1 = 'hello';
  buf2 = 'world';
  call concat_buf(buf1, buf2);
  result = get_len(buf1);
  if result ^= 10 then do;
     put skip list('FAIL star_param: expected 10, got', result);
     stop;
  end;
  str = get_content(buf1);
  if str ^= 'helloworld' then do;
     put skip list('FAIL star_param: expected helloworld, got', str);
     stop;
  end;

  /* Test 3: uppercase in place (get_len stops at first blank per lib spec) */
  buf1 = 'Hello World';
  call uppercase(buf1);
  str = get_content(buf1);
  if str ^= 'HELLO' then do;
     put skip list('FAIL star_param: expected HELLO, got', str);
     stop;
  end;

  /* Test 4: VARYING actual into CHAR(*) dummy (fill overwrites from 1) */
  buf1 = 'varying test';
  call fill_buf(buf1, 20);
  result = get_len(buf1);
  if result ^= 20 then do;
     put skip list('FAIL star_param: expected 20, got', result);
     stop;
  end;

   put skip list('PASS star_param');
end starparam;
