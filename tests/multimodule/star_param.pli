/* Rule (18): adjustable CHAR(*) parameters cross-module.
   Build: two -c units linked together. */
starparam: procedure options(main);
  dcl fails fixed bin(31) init(0);
  dcl buf1 char(20) varying;
  dcl buf2 char(50) varying;
  dcl buf3 char(10) varying;
  dcl result fixed bin(31);
  dcl str    char(64) varying;

  dcl fill_buf    entry (char(*), fixed bin(31)) external;
  dcl get_len     entry (char(*)) returns(fixed bin(31)) external;
  dcl concat_buf  entry (char(*), char(*)) external;
  dcl uppercase   entry (char(*)) external;
  dcl get_content entry (char(*)) returns(char(64) varying) external;

  /* Test 1: different buffer sizes */
  buf1 = '';
  call fill_buf(buf1, 10);
  result = get_len(buf1);
  if result ^= 10 then fails = fails + 1;
  str = get_content(buf1);
  if str ^= 'xxxxxxxxxx' then fails = fails + 1;

  buf2 = '';
  call fill_buf(buf2, 30);
  result = get_len(buf2);
  if result ^= 30 then fails = fails + 1;
  str = get_content(buf2);
  if str ^= 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx' then fails = fails + 1;

  buf3 = '';
  call fill_buf(buf3, 15);  /* truncates to 10 */
  result = get_len(buf3);
  if result ^= 10 then fails = fails + 1;

  /* Test 2: concatenate two buffers */
  buf1 = 'hello';
  buf2 = 'world';
  call concat_buf(buf1, buf2);
  result = get_len(buf1);
  if result ^= 10 then fails = fails + 1;  /* 'helloworld' = 10 */
  str = get_content(buf1);
  if str ^= 'helloworld' then fails = fails + 1;

  /* Test 3: uppercase in place */
  buf1 = 'Hello World';
  call uppercase(buf1);
  str = get_content(buf1);
  if str ^= 'HELLO WORLD' then fails = fails + 1;

  /* Test 4: VARYING actual into CHAR(*) dummy */
  buf1 = 'varying test';
  call fill_buf(buf1, 20);
  result = get_len(buf1);
  if result ^= 14 then fails = fails + 1;  /* 'varying test' + 6 x's = 14 */

  if fails = 0 then put skip list('PASS star_param');
  else put skip list('FAIL star_param: fails=', fails);
end starparam;