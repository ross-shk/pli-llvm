 /* Rules (25),(126): BASED arrays cross-module. The library owns
    heap blocks behind fixed BASED arrays; the caller views its
    own storage through runtime-(n) overlays in library
    procedures. Companion of based_arr_xfer_lib.pli. */
 basedarrxfer: procedure options(main);
   dcl create_block entry (fixed bin(31)) returns (pointer)
     external;
   dcl fill_block entry (pointer, fixed bin(31),
     fixed bin(31)) external;
   dcl at_block entry (pointer, fixed bin(31),
     fixed bin(31)) returns (fixed bin(31)) external;
   dcl free_block entry (pointer) external;
   dcl view_sum entry (pointer, fixed bin(31)) returns (fixed bin(31))
     external;
   dcl p pointer;
   dcl i fixed bin(31);
   dcl n fixed bin(31);
   dcl fails fixed bin(31) init(0);
   dcl buf(4) fixed bin(31);
   n = 4;
   /* heap block round-trip: independent cells per block */
   p = create_block(n);
   call fill_block(p, n, 9);
   if at_block(p, n, 3) ^= 9 then fails = fails + 1;
   call free_block(p);
   /* caller storage viewed from the library via (n) overlay */
   buf(1) = 1; buf(2) = 2; buf(3) = 3; buf(4) = 4;
   if view_sum(addr(buf), n) ^= 10 then fails = fails + 1;
   call fill_block(addr(buf), n, 5);
   do i = 1 to n;
     if buf(i) ^= 5 then fails = fails + 1;
   end;
   if fails = 0 then put skip list('PASS based_arr_xfer');
   else put skip list('FAIL based_arr_xfer: fails =', fails);
 end basedarrxfer;
