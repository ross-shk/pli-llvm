 /* Copyright 2026 Ross S. - plic: a PL/I compiler targeting LLVM */
 /* Rule (126): slice assignment on a 2-D member array across
    modules. The library writes caller-owned storage through a
    BASED view; the caller keeps only the structure and reads
    the results back. Companion of slice_xfer_lib.pli. */
 slicexfer: procedure options(main);
   dcl fill entry (pointer) external;
   dcl copyrow entry (pointer, fixed bin(31),
     fixed bin(31)) external;
   dcl copycol entry (pointer, fixed bin(31),
     fixed bin(31)) external;
   dcl setrow entry (pointer, fixed bin(31),
     fixed bin(31)) external;
   dcl getel entry (pointer, fixed bin(31),
     fixed bin(31)) returns (fixed bin(31)) external;
   dcl 1 rec,
      2 m(3, 4) fixed bin(31);
   dcl i fixed bin(31), j fixed bin(31);
   dcl exp(4) fixed bin(31);
   dcl fails fixed bin(31) init(0);

   call fill(addr(rec));

   /* lib copies row 1 to row 3 through a row slice */
   do j = 1 to 4;
     exp(j) = getel(addr(rec), 1, j);
   end;
   call copyrow(addr(rec), 1, 3);
   do j = 1 to 4;
     if getel(addr(rec), 3, j) ^= exp(j) then
       fails = fails + 1;
   end;

   /* lib copies column 2 to column 4 through a column slice */
   do i = 1 to 3;
     exp(i) = getel(addr(rec), i, 2);
   end;
   call copycol(addr(rec), 2, 4);
   do i = 1 to 3;
     if getel(addr(rec), i, 4) ^= exp(i) then
       fails = fails + 1;
   end;

   /* lib broadcasts a scalar over row 2 */
   call setrow(addr(rec), 2, 7);
   do j = 1 to 4;
     if getel(addr(rec), 2, j) ^= 7 then
       fails = fails + 1;
   end;

   if fails = 0 then
     put skip list('PASS slice_xfer');
   else put skip list('FAIL slice_xfer: fails =', fails);
 end slicexfer;
