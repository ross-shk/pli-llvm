/* Rule (25): BASED/POINTER cross-module scenarios.
   Build: two -c units linked together. */
basedxfer: procedure options(main);
  dcl p     pointer;
  dcl p2    pointer;
  dcl val   fixed bin(31);
  dcl val2  fixed bin(31);

  dcl create_rec  entry returns(pointer) external;
  dcl read_rec    entry (pointer) returns(fixed bin(31)) external;
  dcl write_rec   entry (pointer, fixed bin(31)) external;
  dcl free_rec    entry (pointer) external;
  dcl create_two  entry (pointer, pointer) external;

  /* Test 1: create in lib, use in main, free in lib */
  p = create_rec();
  val = read_rec(p);
  if val ^= 123 then do;
     put skip list('FAIL based_xfer: expected 123, got', val);
     stop;
  end;

  call write_rec(p, 456);
  val = read_rec(p);
  if val ^= 456 then do;
     put skip list('FAIL based_xfer: expected 456, got', val);
     stop;
  end;

  call free_rec(p);

  /* Test 2: create two records in lib, use both in main */
  call create_two(p, p2);
  val = read_rec(p);
  val2 = read_rec(p2);
  if val ^= 100 then do;
     put skip list('FAIL based_xfer: expected 100, got', val);
     stop;
  end;
  if val2 ^= 200 then do;
     put skip list('FAIL based_xfer: expected 200, got', val2);
     stop;
  end;

  call write_rec(p, 111);
  call write_rec(p2, 222);
  val = read_rec(p);
  val2 = read_rec(p2);
  if val ^= 111 then do;
     put skip list('FAIL based_xfer: expected 111, got', val);
     stop;
  end;
  if val2 ^= 222 then do;
     put skip list('FAIL based_xfer: expected 222, got', val2);
     stop;
  end;

  call free_rec(p);
  call free_rec(p2);

  /* Test 3: main allocates via ADDR, passes to lib */
  dcl 1 local_rec,
       2 data fixed bin(31);
  dcl local_p pointer;
  local_p = addr(local_rec);
  call write_rec(local_p, 777);
  val = read_rec(local_p);
  if val ^= 777 then do;
     put skip list('FAIL based_xfer: expected 777, got', val);
     stop;
  end;

   put skip list('PASS based_xfer');
end basedxfer;
