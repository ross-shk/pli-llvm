 /* Rules (15),(23),(25),(123),(126): cross-module ADDR on array */
 /* elements. Caller passes addr(buf(i)) / addr(fds(1)) to the */
 /* library; the library pokes/peeks via a scalar BASED view */
 /* and sums a buffer via a runtime-(n) overlay. Companion of */
 /* addr_elem_lib.pli. Poll_multi passes pointers the same way. */
 addrelemxfer: procedure options(main);
   dcl poke entry (pointer, fixed bin(31)) external;
   dcl peek entry (pointer) returns (fixed bin(31))
     external;
   dcl view_sum entry (pointer, fixed bin(31))
     returns (fixed bin(31)) external;
   dcl buf(4) fixed bin(31);
   dcl fds fixed bin(31) controlled;
   dcl bp pointer;
   dcl e(4) fixed bin(31) based(bp);
   dcl n fixed bin(31);
   dcl i fixed bin(31);
   buf(1) = 11; buf(2) = 22; buf(3) = 33; buf(4) = 44;
   /* fixed element across the boundary, scaled per elem */
   call poke(addr(buf(2)), 27);
   if buf(2) ^= 27 then do;
      put skip list('FAIL addr_elem: expected 27, got', buf(2));
      stop;
   end;
   if buf(1) ^= 11 then do;
      put skip list('FAIL addr_elem: expected 11, got', buf(1));
      stop;
   end;
   if peek(addr(buf(2))) ^= 27 then do;
      put skip list('FAIL addr_elem: check at line 26 failed');
      stop;
   end;
   buf(2) = 22;
   if peek(addr(buf(1))) ^= 11 then do;
      put skip list('FAIL addr_elem: check at line 28 failed');
      stop;
   end;
   /* CONTROLLED dyn element across the boundary */
   n = 4;
   allocate fds(n);
   do i = 1 to n;
     fds(i) = i * 10;
   end;
   call poke(addr(fds(3)), 37);
   if fds(3) ^= 37 then do;
      put skip list('FAIL addr_elem: expected 37, got', fds(3));
      stop;
   end;
   if fds(2) ^= 20 then do;
      put skip list('FAIL addr_elem: expected 20, got', fds(2));
      stop;
   end;
   if peek(addr(fds(1))) ^= 10 then do;
      put skip list('FAIL addr_elem: check at line 38 failed');
      stop;
   end;
   /* library (n) overlay over our buffer via base addr */
   if view_sum(addr(buf), n) ^= 110 then do;
      put skip list('FAIL addr_elem: check at line 40 failed');
      stop;
   end;
   call poke(addr(buf(4)), 48);
   if view_sum(addr(buf), n) ^= 114 then do;
      put skip list('FAIL addr_elem: check at line 42 failed');
      stop;
   end;
   buf(4) = 44;
   /* BASED overlay element across the boundary */
   bp = addr(buf);
   call poke(addr(e(2)), 29);
   if buf(2) ^= 29 then do;
      put skip list('FAIL addr_elem: expected 29, got', buf(2));
      stop;
   end;
   if peek(addr(e(3))) ^= 33 then do;
      put skip list('FAIL addr_elem: check at line 48 failed');
      stop;
   end;
   buf(2) = 22;
   free fds;
   put skip list('PASS addr_elem_xfer');
 end addrelemxfer;
