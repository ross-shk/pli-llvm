/* Rules (3),(56): Multiple entry names and ENTRY statement cross-module.
   Build: two -c units linked together. */
multientry: procedure options(main);
  dcl result fixed bin(31);

  /* Main entry and alternate entries from lib */
  dcl lib_main    entry returns(fixed bin(31)) external;
  dcl lib_entry_a entry (fixed bin(31)) returns(fixed bin(31)) external;
  dcl lib_entry_b entry (fixed bin(31), fixed bin(31)) returns(fixed bin(31)) external;
  dcl lib_reset   entry external;
  dcl lib_get_cnt entry returns(fixed bin(31)) external;

  /* Call main entry */
  result = lib_main();
  if result ^= 100 then do;
     put skip list('FAIL multi_entry: expected 100, got', result);
     stop;
  end;

  /* Call alternate entry A */
  result = lib_entry_a(10);
  if result ^= 110 then do;
     put skip list('FAIL multi_entry: expected 110, got', result);
     stop;
  end;

  result = lib_entry_a(20);
  if result ^= 130 then do;
     put skip list('FAIL multi_entry: expected 130, got', result);
     stop;
  end;

  /* Call alternate entry B */
  result = lib_entry_b(5, 3);
  if result ^= 138 then do;
     put skip list('FAIL multi_entry: expected 138, got', result);
     stop;
  end;

  result = lib_entry_b(2, 2);
  if result ^= 142 then do;
     put skip list('FAIL multi_entry: expected 142, got', result);
     stop;
  end;

  /* Reset and verify */
  call lib_reset();
  result = lib_get_cnt();
  if result ^= 0 then do;
     put skip list('FAIL multi_entry: expected 0, got', result);
     stop;
  end;

  result = lib_main();
  if result ^= 100 then do;
     put skip list('FAIL multi_entry: expected 100, got', result);
     stop;
  end;

   put skip list('PASS multi_entry');
end multientry;
