/* PACKAGE / EXPORTS (ADR-109): cross-module package with shared data.
   Build: two -c units linked together. */
pkgxfer: procedure options(main);
  dcl result fixed bin(31);

  /* Call exported procedures from pkgxfer_lib */
  dcl pkg_init    entry external;
  dcl pkg_add     entry (fixed bin(31)) external;
  dcl pkg_get     entry returns(fixed bin(31)) external;
  dcl pkg_mul     entry (fixed bin(31)) returns(fixed bin(31)) external;
  dcl pkg_reset   entry external;
  dcl pkg_get_arr entry returns(fixed bin(31)) external;

  call pkg_init();

  /* Test package-level static data */
  result = pkg_get();
  if result ^= 10 then do;
     put skip list('FAIL pkg_xfer: expected 10, got', result);
     stop;
  end;

  call pkg_add(5);
  result = pkg_get();
  if result ^= 15 then do;
     put skip list('FAIL pkg_xfer: expected 15, got', result);
     stop;
  end;

  result = pkg_mul(3);
  if result ^= 45 then do;
     put skip list('FAIL pkg_xfer: expected 45, got', result);
     stop;
  end;

  result = pkg_get();
  if result ^= 45 then do;
     put skip list('FAIL pkg_xfer: expected 45, got', result);
     stop;
  end;

  call pkg_reset();
  result = pkg_get();
  if result ^= 10 then do;
     put skip list('FAIL pkg_xfer: expected 10, got', result);
     stop;
  end;

  /* Test package-level array */
  call pkg_add(1);
  call pkg_add(2);
  call pkg_add(3);
  result = pkg_get_arr();
  if result ^= 11 then do;
     put skip list('FAIL pkg_xfer: expected 11, got', result);
     stop;
  end;

   put skip list('PASS pkg_xfer');
end pkgxfer;
