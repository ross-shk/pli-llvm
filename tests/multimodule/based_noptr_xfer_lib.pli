 /* Rule (25): the library's bare BASED view is locator-qualified by
    each call's POINTER argument. Companion to based_noptr_xfer.pli. */
 basednplib: package exports(read_field, write_field);

 dcl 1 based_rec based,
      2 id   fixed bin(31),
      2 data fixed bin(31);

 read_field: procedure(p) returns(fixed bin(31));
   dcl p pointer;
   return(p -> based_rec.data);
 end read_field;

 write_field: procedure(p, val);
   dcl p   pointer;
   dcl val fixed bin(31);
   p -> based_rec.data = val;
 end write_field;

 end basednplib;
