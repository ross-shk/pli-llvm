 /* ADR-168 / rule (18): VARYINGZ parameters cross a PL/I module
    boundary through the ordinary varying inter-procedure ABI
    (descriptor pointer plus hidden maximum-length argument).
    Companion: varyingz_xfer_lib.pli. */
 varyingz_xfer: procedure options(main);
   dcl fails fixed bin(31) init(0);
   dcl buf   char(16) varying;
   dcl n     fixed bin(31);

   dcl vz_getlen entry (char(*) varyingz)
       returns(fixed bin(31)) external;
   dcl vz_setlen entry (char(*) varyingz, fixed bin(31)) external;
   dcl vz_first  entry (char(*) varyingz) returns(char(1)) external;

   buf = 'hello';
   if vz_getlen(buf) ^= 5 then fails = fails + 1;
   if vz_first(buf) ^= 'h' then fails = fails + 1;

   call vz_setlen(buf, 4);
   if buf ^= 'abcd' then fails = fails + 1;

   buf = '';
   if vz_getlen(buf) ^= 0 then fails = fails + 1;

   if fails = 0 then put skip list('PASS varyingz_xfer');
   else put skip list('FAIL varyingz_xfer: fails =', fails);
 end varyingz_xfer;
