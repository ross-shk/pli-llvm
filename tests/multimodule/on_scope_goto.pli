 /* Rules (91)-(94): a local GO TO out of a BEGIN block
    reverts the ON-unit the block established; the enclosing
    handler is top again. The condition is raised across the
    object boundary by on_scope_goto_lib.pli, so the unwind
    is observed through the runtime handler stack. */
 on_scope_goto: procedure options(main);
   dcl evt  condition;
   dcl fire entry (fixed bin(31)) external;
   dcl i    fixed bin(31);
   dcl hits fixed bin(31) init(0);

   /* Procedure-body handler: the fallback after the block is left. */
   on condition(evt) hits = hits + 100;

   do i = 1 to 2;
     begin;
       on condition(evt) hits = hits + i;   /* disarmed on block exit */
       if i = 1 then goto skip;             /* leaves the block */
       call fire(i);                        /* top = inner (+i) */
     end;
   skip: ;
     call fire(i);                          /* top = fallback (+100) */
   end;

   /* i=1: goto skips the inner raise, fallback adds 100.
      i=2: inner adds 2, then fallback adds 100. Total 202. */
   put skip list('hits=', hits);
   if hits = 202 then put skip list('PASS on_scope_goto');
   else put skip list('FAIL on_scope_goto');
 end on_scope_goto;
