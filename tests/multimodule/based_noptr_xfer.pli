 /* Rule (25): a bare BASED view in one module addresses caller
    storage through a POINTER parameter. Companion to
    based_noptr_xfer_lib.pli. */
 basednoptr: procedure options(main);
   dcl 1 local_rec,
       2 id   fixed bin(31),
       2 data fixed bin(31);
   dcl p pointer;

   dcl read_field  entry(pointer) returns(fixed bin(31)) external;
   dcl write_field entry(pointer, fixed bin(31)) external;

   p = addr(local_rec);
   call write_field(p, 314);
   if local_rec.data ^= 314 then do;
      put skip list('FAIL based_noptr_xfer: expected 314, got',
         local_rec.data);
      stop;
   end;
   local_rec.data = 271;
   if read_field(p) ^= 271 then do;
      put skip list('FAIL based_noptr_xfer: expected 271, got',
         read_field(p));
      stop;
   end;

   put skip list('PASS based_noptr_xfer');
 end basednoptr;
