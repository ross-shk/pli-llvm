 /* Rules (15),(18),(87)-(90): a CHAR(*) VARYING CONTROLLED dummy of a
    procedure compiled in a different module (ctl_xfer_lib.pli) grows,
    trims and tops up the caller's generation stack through the hidden
    slot-key argument. Build: two -c units linked together. */
 ctlxfer: procedure options(main);
   dcl body        char(*) varying controlled;
   dcl cap         fixed bin(31);
   dcl got         fixed bin(31);
   dcl grow        entry (char(*) varying controlled, fixed bin(31),
                  fixed bin(31)) returns (fixed bin(31)) external;
   dcl topup       entry (char(*) varying controlled, fixed bin(31))
                  external;

   /* grow allocates, doubles past 16, appends 100 bytes, trims. */
   cap = 16;
   got = grow(body, cap, 100);
   if got ^= 100 then do;
      put skip list('FAIL ctl_xfer: expected 100, got', got);
      stop;
   end;
   if cap ^= 128 then do;
      put skip list('FAIL ctl_xfer: expected 128, got', cap);
      stop;
   end;
   if length(body) ^= 100 then do;
      put skip list('FAIL ctl_xfer: expected 100, got', length(body));
      stop;
   end;
   if substr(body, 1, 8) ^= 'xxxxxxxx' then do;
      put skip list('FAIL ctl_xfer: expected xxxxxxxx, got',
         substr(body, 1, 8));
      stop;
   end;
   if substr(body, 46, 8) ^= 'xxxxxxxx' then do;
      put skip list('FAIL ctl_xfer: expected xxxxxxxx, got',
         substr(body, 46, 8));
      stop;
   end;
   if substr(body, 93, 8) ^= 'xxxxxxxx' then do;
      put skip list('FAIL ctl_xfer: expected xxxxxxxx, got',
         substr(body, 93, 8));
      stop;
   end;

   /* topup pushed a second generation onto the caller's stack. */
   call topup(body, 8);
   if length(body) ^= 8 then do;
      put skip list('FAIL ctl_xfer: expected 8, got', length(body));
      stop;
   end;
   if substr(body, 1, 8) ^= 'yyyyyyyy' then do;
      put skip list('FAIL ctl_xfer: expected yyyyyyyy, got',
         substr(body, 1, 8));
      stop;
   end;
   free body;
   if length(body) ^= 100 then do;
      put skip list('FAIL ctl_xfer: expected 100, got', length(body));
      stop;
   end;
   free body;

   put skip list('PASS ctl_xfer');
 end ctlxfer;
