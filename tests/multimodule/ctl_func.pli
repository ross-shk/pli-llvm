/* Rules (18),(34)-(38): CHAR(*) VARYING CONTROLLED as function parameter
   and return value across modules.
   Build: two -c units linked together. */
ctlfunc: procedure options(main);
  dcl input  char(*) varying controlled;
  dcl output char(*) varying controlled;
  dcl len    fixed bin(31);

  dcl process_str entry (char(*) varying controlled) returns(char(*) varying controlled) external;
  dcl transform   entry (char(*) varying controlled, char(*) varying controlled) external;

  /* Test 1: function takes CONTROLLED param and returns CONTROLLED */
  allocate input (10) character varying;
  input = 'test';
  output = process_str(input);
  len = length(output);
  if len ^= 13 then do;
     put skip list('FAIL ctl_func: expected 13, got', len);
     stop;
  end;
  if substr(output, 1, 9) ^= 'processed' then do;
     put skip list('FAIL ctl_func: expected processed, got',
        substr(output, 1, 9));
     stop;
  end;
  free output;

  /* Test 2: function transforms input in-place, returns same generation */
  allocate input (20) character varying;
  input = 'transform';
  output = process_str(input);
  len = length(output);
  if len ^= 18 then do;
     put skip list('FAIL ctl_func: expected 18, got', len);
     stop;
  end;
  if substr(output, 1, 11) ^= 'processed t' then do;
     put skip list('FAIL ctl_func: expected processed t, got',
        substr(output, 1, 11));
     stop;
  end;
  free output;

  /* Test 3: procedure with two CONTROLLED params */
  allocate input (15) character varying;
  allocate output (15) character varying;
  input = 'hello';
  call transform(input, output);
  len = length(output);
  if len ^= 11 then do;
     put skip list('FAIL ctl_func: expected 11, got', len);
     stop;
  end;
  free input;
  free output;

   put skip list('PASS ctl_func');
end ctlfunc;
