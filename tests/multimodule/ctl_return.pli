/* Rules (18),(23),(87)-(90): Cross-module function returning CONTROLLED.
   Build: two -c units linked together. */
ctlreturn: procedure options(main);
  dcl result char(*) varying controlled;
  dcl result2 char(*) varying controlled;
  dcl len fixed bin(31);

  dcl create_str  entry returns(char(*) varying controlled) external;
  dcl create_fixed entry (fixed bin(31)) returns(char(*) varying controlled) external;
  dcl append_str  entry (char(*) varying controlled, char(*)) returns(char(*) varying controlled) external;

  /* Test 1: function creates and returns CONTROLLED string */
  result = create_str();
  len = length(result);
  if len ^= 11 then do;
     put skip list('FAIL ctl_return: expected 11, got', len);
     stop;
  end;
  if substr(result, 1, 11) ^= 'hello world' then do;
     put skip list('FAIL ctl_return: expected hello world, got',
        substr(result, 1, 11));
     stop;
  end;
  free result;

  /* Test 2: function creates fixed-size CONTROLLED string */
  result = create_fixed(20);
  len = length(result);
  if len ^= 8 then do;
     put skip list('FAIL ctl_return: expected 8, got', len);
     stop;
  end;
  if substr(result, 1, 8) ^= 'fixedstr' then do;
     put skip list('FAIL ctl_return: expected fixedstr, got',
        substr(result, 1, 8));
     stop;
  end;
  free result;

  /* Test 3: function appends to caller's CONTROLLED and returns it */
  allocate result (10) character varying;
  result = 'start';
  result2 = append_str(result, ' appended');
  len = length(result2);
  if len ^= 14 then do;
     put skip list('FAIL ctl_return: expected 14, got', len);
     stop;
  end;
  if substr(result2, 1, 5) ^= 'start' then do;
     put skip list('FAIL ctl_return: expected start, got',
        substr(result2, 1, 5));
     stop;
  end;
  if substr(result2, 6, 9) ^= ' appended' then do;
     put skip list('FAIL ctl_return: expected  appended, got',
        substr(result2, 6, 9));
     stop;
  end;
  /* result and result2 should be the same generation */
  free result2;

   put skip list('PASS ctl_return');
end ctlreturn;
