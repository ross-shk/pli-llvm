/* Rules (15),(18),(23),(87)-(90): cross-module CONTROLLED with
   ALLOCATE in caller, FREE in callee, and vice versa.
   Build: two -c units linked together. */
ctlxfer2: procedure options(main);
  dcl body        char(*) varying controlled;
  dcl body2       char(*) varying controlled;
  dcl cap         fixed bin(31);
  dcl got         fixed bin(31);

  dcl grow        entry (char(*) varying controlled, fixed bin(31),
                   fixed bin(31)) returns (fixed bin(31)) external;
  dcl trim_free   entry (char(*) varying controlled) external;
  dcl alloc_free  entry (char(*) varying controlled, fixed bin(31))
                   external;
  dcl double_gen  entry (char(*) varying controlled) external;

  /* Test 1: caller allocates, callee fills and trims, caller frees */
  cap = 32;
  allocate body (cap) character varying;
  got = grow(body, cap, 20);
  if got ^= 20 then do;
     put skip list('FAIL ctl_xfer2: expected 20, got', got);
     stop;
  end;
  if length(body) ^= 20 then do;
     put skip list('FAIL ctl_xfer2: expected 20, got', length(body));
     stop;
  end;
  call trim_free(body);
  if length(body) ^= 20 then do;
     put skip list('FAIL ctl_xfer2: expected 20, got', length(body));
     stop;
  end;
  free body;

  /* Test 2: callee allocates and frees on caller's stack */
  call alloc_free(body2, 16);
  if length(body2) ^= 9 then do;
     put skip list('FAIL ctl_xfer2: expected 9, got', length(body2));
     stop;
  end;
  if substr(body2, 1, 9) ^= 'allocated' then do;
     put skip list('FAIL ctl_xfer2: expected allocated, got',
        substr(body2, 1, 9));
     stop;
  end;
  free body2;

  /* Test 3: callee pushes second generation, caller pops both */
  cap = 8;
  allocate body (cap) character varying;
  body = 'firstgen';
  call double_gen(body);
  if length(body) ^= 7 then do;
     put skip list('FAIL ctl_xfer2: expected 7, got', length(body));
     stop;
  end;
  if substr(body, 1, 7) ^= 'secondg' then do;
     put skip list('FAIL ctl_xfer2: expected secondg, got',
        substr(body, 1, 7));
     stop;
  end;
  free body;  /* pop second */
  if length(body) ^= 8 then do;
     put skip list('FAIL ctl_xfer2: expected 8, got', length(body));
     stop;
  end;
  if substr(body, 1, 8) ^= 'firstgen' then do;
     put skip list('FAIL ctl_xfer2: expected firstgen, got',
        substr(body, 1, 8));
     stop;
  end;
  free body;  /* pop first */

   put skip list('PASS ctl_xfer2');
end ctlxfer2;
