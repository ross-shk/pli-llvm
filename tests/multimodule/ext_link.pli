/* Rule (42): Multiple external procedures in one module - testing linkage.
   Build: two -c units linked together. */
extlink: procedure options(main);
  dcl result fixed bin(31);

  /* External procedures from lib */
  dcl func_a entry (fixed bin(31)) returns(fixed bin(31)) external;
  dcl func_b entry (fixed bin(31)) returns(fixed bin(31)) external;
  dcl func_c entry (fixed bin(31), fixed bin(31)) returns(fixed bin(31)) external;
  dcl init_all entry external;
  dcl get_a entry returns(fixed bin(31)) external;
  dcl get_b entry returns(fixed bin(31)) external;
  dcl get_c entry returns(fixed bin(31)) external;

  call init_all();

  /* Test each function */
  result = func_a(10);
  if result ^= 20 then do;
     put skip list('FAIL ext_link: expected 20, got', result);
     stop;
  end;

  result = func_b(10);
  if result ^= 30 then do;
     put skip list('FAIL ext_link: expected 30, got', result);
     stop;
  end;

  result = func_c(4, 5);
  if result ^= 20 then do;
     put skip list('FAIL ext_link: expected 20, got', result);
     stop;
  end;

  /* Verify internal state */
  result = get_a();
  if result ^= 20 then do;
     put skip list('FAIL ext_link: expected 20, got', result);
     stop;
  end;

  result = get_b();
  if result ^= 30 then do;
     put skip list('FAIL ext_link: expected 30, got', result);
     stop;
  end;

  result = get_c();
  if result ^= 20 then do;
     put skip list('FAIL ext_link: expected 20, got', result);
     stop;
  end;

  /* Call again */
  result = func_a(7);
  if result ^= 14 then do;
     put skip list('FAIL ext_link: expected 14, got', result);
     stop;
  end;

   put skip list('PASS ext_link');
end extlink;
