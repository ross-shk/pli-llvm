 /* Rules (20),(22),(88),(90): cross-module AREA/OFFSET allocation.
    The library allocates into the caller's region and returns the
    offset; the caller views the same block. Companion of
    area_offset_lib.pli. */
 area_offset: procedure options(main);
   dcl mk_alloc entry (area) returns (offset) external;
   dcl mk_free entry (area, offset) external;
   dcl region area(8192);
   dcl off offset;
   dcl 1 rec based(off),
       2 v fixed bin(31);

   off = mk_alloc(region);
   if off = null() then do;
      put skip list('FAIL area_offset: check at line 17 failed');
      stop;
   end;
   if rec.v ^= 1234 then do;
      put skip list('FAIL area_offset: expected 1234, got', rec.v);
      stop;
   end;

   call mk_free(region, off);
   off = null();

   put skip list('PASS area_offset');
 end area_offset;
