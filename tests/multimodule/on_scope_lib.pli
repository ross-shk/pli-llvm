 /* Library side of on_scope.pli: raises the programmer-named
    condition `evt` with SET ONCODE(k), so the caller's per-iteration
    ON-unit observes which iteration fired it. */
 on_scope_lib: package exports(fire);
 fire: procedure (k);
   dcl k fixed bin(31);
   dcl evt condition;
   signal condition(evt) set oncode(k);
 end fire;
 end on_scope_lib;
