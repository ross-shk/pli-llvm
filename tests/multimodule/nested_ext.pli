/* Rule (42): External procedure callback across modules.
   Build: two -c units linked together. */
nestedext: procedure options(main);
  dcl result fixed bin(31);

  /* External entries from lib */
  dcl lib_call_cb   entry (fixed bin(31)) returns(fixed bin(31)) external;
  dcl lib_set_cb    entry (fixed bin(31)) external;
  dcl lib_invoke_cb entry returns(fixed bin(31)) external;

  /* Test callback via external procedure */
  call lib_set_cb(10);
  result = lib_invoke_cb();
  if result ^= 21 then do;
     put skip list('FAIL nested_ext: expected 21, got', result);
     stop;
  end;

  result = lib_call_cb(5);
  if result ^= 11 then do;
     put skip list('FAIL nested_ext: expected 11, got', result);
     stop;
  end;

   put skip list('PASS nested_ext');
end nestedext;
