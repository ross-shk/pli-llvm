/* Chapter 9 (ADR-305): %GOTO skips code; %LABEL targets %GOTO jumps.
   %GO TO (two-word form) is equivalent to %GOTO. */
%declare flag;
%flag = 0;
pp_goto: procedure options(main);
  %if flag = 0 %then %goto skip;
  put skip list('should not print');
  %skip:;
  put skip list('PASS pp_goto');
end pp_goto;
