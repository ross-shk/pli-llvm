/* FIXED DECIMAL edge cases (ADR-006, TR 25.084 rules 16,17,135): 
   Precision/scale arithmetic, overflow, rounding, conversions.
   Stored as scaled binary integers (i64 for p<=18, i128 for p<=38). */
decimal_edge: procedure options(main);
    declare fails fixed bin(31);
    fails = 0;
put skip list('START decimal_edge');

    /* Large precision at scale 0 - test without overflow */
    declare big1 fixed dec(18,0);
    declare big2 fixed dec(18,0);
    declare big3 fixed dec(18,0);
    big1 = 123456789;
    big2 = 987654321;
    (nosize): do;
       big3 = big1 + big2;  /* 1111111110 - no SIZE condition */
    end;
    put skip list('big3 =', big3);
    if big3 ^= 1111111110 then do; fails = fails + 1; put skip list('FAIL big3 =', big3); end;

    /* Scale arithmetic: result scale is max of operand scales for + - */
    declare s1 fixed dec(10,5);
    declare s2 fixed dec(10,3);
    declare s3 fixed dec(10,5);
    s1 = 1.12345;   /* scale 5 */
    s2 = 2.123;     /* scale 3 */
    s3 = s1 + s2;   /* 3.24645, scale 5 */
    put skip list('s3 =', s3);
    if s3 ^= 3.24645 then do; fails = fails + 1; put skip list('FAIL s3 =', s3); end;

    /* Multiplication: result scale = sum of operand scales */
    declare m1 fixed dec(10,3);
    declare m2 fixed dec(10,2);
    declare m3 fixed dec(10,5);
    m1 = 1.500;     /* scale 3 */
    m2 = 2.00;      /* scale 2 */
    m3 = m1 * m2;   /* 3.00000, scale 5 */
    put skip list('m3 =', m3);
    if m3 ^= 3.0 then do; fails = fails + 1; put skip list('FAIL m3 =', m3); end;

    /* Division: result scale per Y33-6003 rules (scale of dividend - scale of divisor + precision) */
    /* This is complex - test basic case */
    declare d1 fixed dec(10,2);
    declare d2 fixed dec(10,2);
    declare d3 fixed dec(10,4);
    d1 = 10.00;     /* scale 2 */
    d2 = 4.00;      /* scale 2 */
    d3 = d1 / d2;   /* 2.5 -> scale depends on rules */
    put skip list('d3 =', d3);
    if d3 ^= 2.5 then do; fails = fails + 1; put skip list('FAIL d3 =', d3); end;

/* Assignment rounding: round half away from zero */
    declare r1 fixed dec(5,2);
    declare r2 fixed dec(5,1);
    r1 = 1.25;      /* .25 rounds to .3 at scale 1 */
    r2 = r1;        /* 1.3 */
    put skip list('r2=', r2);
    if r2 ^= 1.3 then do; fails = fails + 1; put skip list('FAIL r2 =', r2); end;

    r1 = 1.24;      /* .24 rounds to .2 at scale 1 */
    r2 = r1;        /* 1.2 */
    put skip list('r2=', r2);
    if r2 ^= 1.2 then do; fails = fails + 1; put skip list('FAIL r2 =', r2); end;

    r1 = 1.35;      /* .35 rounds to .4 at scale 1 */
    r2 = r1;        /* 1.4 */
    put skip list('r2=', r2);
    if r2 ^= 1.4 then do; fails = fails + 1; put skip list('FAIL r2 =', r2); end;

    /* Negative rounding */
    r1 = -1.25;     /* -.25 rounds to -.3 (away from zero) */
    r2 = r1;        /* -1.3 */
    put skip list('r2=', r2);
    if r2 ^= -1.3 then do; fails = fails + 1; put skip list('FAIL r2 =', r2); end;

    r1 = -1.24;     /* -.24 rounds to -.2 */
    r2 = r1;        /* -1.2 */
    put skip list('r2=', r2);
    if r2 ^= -1.2 then do; fails = fails + 1; put skip list('FAIL r2 =', r2); end;

/* Precision overflow in assignment - test with nosize */
    declare p1 fixed dec(3,2);
    (nosize): p1 = 12.34;     /* precision 3, scale 2 -> only 1 digit before decimal */
    /* 12.34 has 2 digits before decimal, precision 3 only allows 1 (3-2=1) */
    /* This should raise SIZE but nosize suppresses it */

/* Mixed FIXED DECIMAL and FLOAT */
    declare fd fixed dec(5,2);
    declare fl float dec(6);
    fd = 3.14;
    fl = fd;
    put skip list('fl=', fl);
    if fl ^= 3.14 then do; fails = fails + 1; put skip list('FAIL fl =', fl); end;

    fl = 2.5;
    fd = fl;
    put skip list('fd=', fd);
    if fd ^= 2.50 then do; fails = fails + 1; put skip list('FAIL fd =', fd); end;

    /* Mixed FIXED DECIMAL and FIXED BINARY */
    declare fb fixed bin(31);
    fd = 10.50;
    fb = fd;        /* converts to binary, truncates */
    put skip list('fb=', fb);
    if fb ^= 10 then do; fails = fails + 1; put skip list('FAIL fb =', fb); end;

    fb = 7;
    fd = fb;
    put skip list('fd=', fd);
    if fd ^= 7.00 then do; fails = fails + 1; put skip list('FAIL fd =', fd); end;

    /* Comparison with different scales */
    declare c1 fixed dec(5,2);
    declare c2 fixed dec(5,4);
    c1 = 1.50;
    c2 = 1.5000;
    put skip list('c1=', c1, 'c2=', c2);
    if c1 ^= c2 then do; fails = fails + 1; put skip list('FAIL c1=c2'); end;

    c2 = 1.5001;
    put skip list('c1=', c1, 'c2=', c2);
    if c1 = c2 then do; fails = fails + 1; put skip list('FAIL c1!=c2'); end;

    /* Exponentiation with FIXED DECIMAL */
    declare e1 fixed dec(10,2);
    declare e2 fixed dec(10,4);
    e1 = 2.00;
    e2 = e1 ** 3;   /* 8.0000 */
    put skip list('e2=', e2);
    if e2 ^= 8.0 then do; fails = fails + 1; put skip list('FAIL e2 =', e2); end;

    e1 = 1.50;
    e2 = e1 ** 2;   /* 2.2500 */
    put skip list('e2=', e2);
    if e2 ^= 2.25 then do; fails = fails + 1; put skip list('FAIL e2 =', e2); end;

   if fails = 0 then put skip list('PASS decimal_edge');
   else put skip list('FAIL decimal_edge: fails =', fails);
end decimal_edge;