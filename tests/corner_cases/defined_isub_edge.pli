/* DEFINED and iSUB overlay edge cases (ADR-018, TR 25.084 rules 24, 134):
   DEFINED overlays one variable on another's storage. iSUB defines a
   subscript transformation (affine overlay of one axis). Tests cover
   simple overlay, iSUB with constant/affine, and diagnostics. */
defined_isub_edge: procedure options(main);
    declare fails fixed bin(31);
    fails = 0;

    /* Simple DEFINED overlay - same type */
    declare base fixed bin(31);
    declare overlay fixed bin(31) defined base;
    base = 42;
    put skip list('base=', base, 'overlay=', overlay);
    if overlay ^= 42 then do; fails = fails + 1; put skip list('FAIL overlay1'); end;
    overlay = 99;
    put skip list('base=', base, 'overlay=', overlay);
    if base ^= 99 then do; fails = fails + 1; put skip list('FAIL overlay2'); end;

    /* DEFINED with array (scalar overlay) */
    declare base_arr(5) fixed bin(31);
    declare overlay_arr(5) fixed bin(31) defined base_arr;
    declare i fixed bin(31);
    do i = 1 to 5;
       base_arr(i) = i * 10;
    end;
    do i = 1 to 5;
       if overlay_arr(i) ^= i * 10 then do; fails = fails + 1; put skip list('FAIL overlay_arr', i); end;
    end;
    overlay_arr(3) = 999;
    if base_arr(3) ^= 999 then do; fails = fails + 1; put skip list('FAIL base_arr'); end;

    /* iSUB: 1SUB - overlay one axis of array - separate array */
    declare isub_base(5) fixed bin(31);
    declare isub_1d(5) fixed bin(31) defined isub_base(1sub);
    do i = 1 to 5;
       isub_base(i) = i * 10;
    end;
    do i = 1 to 5;
       put skip list('isub_1d(', i, ')=', isub_1d(i), ' expected=', i * 10);
       if isub_1d(i) ^= i * 10 then do; fails = fails + 1; put skip list('FAIL isub_1d', i); end;
    end;
    isub_1d(3) = 888;
    if isub_base(3) ^= 888 then do; fails = fails + 1; put skip list('FAIL isub_base from isub'); end;

    /* iSUB with constant offset */
    declare base_arr2(10) fixed bin(31);
    declare isub_const(4) fixed bin(31) defined base_arr2(1sub + 2);
    /* isub_const(i) maps to base_arr2(i + 2) */
    do i = 1 to 10;
       base_arr2(i) = i * 100;
    end;
    put skip list('isub_const(1)=', isub_const(1), 'expected=300');
    put skip list('isub_const(2)=', isub_const(2), 'expected=400');
    if isub_const(1) ^= 300 then do; fails = fails + 1; put skip list('FAIL isub_const1'); end;
    if isub_const(2) ^= 400 then do; fails = fails + 1; put skip list('FAIL isub_const2'); end;

    /* iSUB on 2D array - overlay one row */
    declare base_2d(3,4) fixed bin(31);
    declare isub_row(4) fixed bin(31) defined base_2d(2, 1sub);
    declare j fixed bin(31);
    do i = 1 to 3;
       do j = 1 to 4;
          base_2d(i,j) = i * 100 + j;
       end;
    end;
    do j = 1 to 4;
       put skip list('isub_row(', j, ')=', isub_row(j), 'expected=', 200 + j);
       if isub_row(j) ^= 200 + j then do; fails = fails + 1; put skip list('FAIL isub_row', j); end;
    end;
    isub_row(3) = 888;
    if base_2d(2,3) ^= 888 then do; fails = fails + 1; put skip list('FAIL base_2d from isub_row'); end;

    /* iSUB on 2D array - overlay one column (diagnosed as unimplemented) */
    /* declare isub_col(3) fixed bin(31) defined base_2d(1sub, 3); */
    /* do i = 1 to 3;
       if isub_col(i) ^= i * 100 + 3 then fails = fails + 1;
    end; */

    /* DEFINED with POSITION (diagnosed as unimplemented) */
    /* declare pos_over fixed bin(31) defined base position(5); */

    /* Multiple iSUB (diagnosed) */
    /* declare multi_isub(5,5) fixed bin(31) defined base_2d(1sub, 2sub); */

    /* Non-affine iSUB (diagnosed) */
    /* declare nonaffine(5) fixed bin(31) defined base_arr(1sub*1sub); */

    /* DEFINED with different type (diagnosed) */
    /* declare diff_type float dec(6) defined base; */

    /* DEFINED with undeclared base (diagnosed) */
    /* declare undef_base fixed bin(31) defined nonexistent; */

    /* DEFINED with structure base (diagnosed in this stage) */
    /* declare struct_over fixed bin(31) defined base_struct; */

    /* iSUB out of bounds (diagnosed at compile time for constant) */
    /* declare oob_isub(10) fixed bin(31) defined base_arr(1sub + 10); */

    if fails = 0 then put skip list('PASS defined_isub_edge');
    else put skip list('FAIL defined_isub_edge: fails =', fails);
end defined_isub_edge;