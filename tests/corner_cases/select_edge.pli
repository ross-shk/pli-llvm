/* SELECT/WHEN/OTHERWISE edge cases (ADR-104, TR 25.084 extension):
   SELECT [(expr)]; WHEN ...; [OTHERWISE ...] END;
   Desugars to IF chain. Tests cover bare predicates, value lists,
   OTHERWISE, and diagnostics. */
select_edge: procedure options(main);
   declare fails fixed bin(31);
   fails = 0;

   /* SELECT with expression - value matching */
   declare val fixed bin(31);
   val = 2;
   select(val);
      when(1) put skip list('val=1');
      when(2) put skip list('val=2');
      when(3) put skip list('val=3');
      otherwise put skip list('val=other');
   end;
   if val ^= 2 then fails = fails + 1;

   /* SELECT without expression - bare predicates */
   declare x fixed bin(31);
   declare y fixed bin(31);
   x = 5; y = 10;
   select;
      when(x > y) put skip list('x > y');
      when(x < y) put skip list('x < y');
      when(x = y) put skip list('x = y');
      otherwise put skip list('impossible');
   end;

   /* Multiple values in WHEN */
   val = 5;
   select(val);
      when(1, 2, 3) put skip list('1-3');
      when(4, 5, 6) put skip list('4-6');
      when(7, 8, 9) put skip list('7-9');
      otherwise put skip list('other');
   end;

   /* WHEN with expression */
   select;
      when(val > 0 & val < 10) put skip list('small positive');
      when(val >= 10) put skip list('large');
      otherwise put skip list('zero or negative');
   end;

   /* Nested SELECT */
   val = 1;
   select(val);
      when(1) do;
         select;
            when(val = 1) put skip list('nested 1');
            otherwise put skip list('nested other');
         end;
      end;
      otherwise put skip list('outer other');
   end;

   /* SELECT in expression context (not supported, statement only) */
   /* result = select ...; -- not valid */

   /* Empty SELECT (no WHEN) - should be diagnosed */
   /* select; end; */

   /* SELECT with label */
   sel_label: select(val);
      when(10) put skip list('ten');
      otherwise put skip list('not ten');
   end;

   /* OTHERWISE with multiple statements */
   val = 99;
   select(val);
      when(1) put skip list('one');
      otherwise do;
         put skip list('in otherwise block');
         put skip list('val was', val);
      end;
   end;

   /* CASE-insensitive? No, PL/I keywords are case-insensitive but we use lowercase */

   if fails = 0 then put skip list('PASS select_edge');
   else put skip list('FAIL select_edge: fails =', fails);
end select_edge;