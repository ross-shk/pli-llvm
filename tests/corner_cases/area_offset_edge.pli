 /* AREA/OFFSET edge cases (rules (20),(22),(88),(90)): a region is a
    pool for BASED allocations; OFFSET values are locators within it.
    Covers the default area size, an unassociated OFFSET, ALLOCATE
    without SET (the based variable's own locator), multiple items in
    one ALLOCATE, and out-of-order FREE. */
 area_offset_edge: procedure options(main);
   declare fails fixed bin(31);
   fails = 0;

   /* default-sized area, no explicit size */
   declare region area;
   declare 1 one based(po),
       2 v fixed bin(31);
   declare 1 two based(pt),
       2 v fixed bin(31);
   declare po offset(region);
   declare pt offset(region);

   /* two items in one ALLOCATE, SET in either order */
   allocate one in(region) set(po), two in(region) set(pt);
   one.v = 5;
   two.v = 6;
   if one.v ^= 5 then fails = fails + 1;
   if two.v ^= 6 then fails = fails + 1;

   /* free the first block while the second stays live */
   free one in(region);
   if two.v ^= 6 then fails = fails + 1;
   free two in(region);

   /* an unassociated OFFSET is valid for the IN/SET forms */
   declare bare offset;
   allocate one in(region) set(bare);
   one.v = 8;
   if one.v ^= 8 then fails = fails + 1;
   free one in(region);
   bare = null();
   if bare ^= null() then fails = fails + 1;

   if fails = 0 then put skip list('PASS area_offset_edge');
   else put skip list('FAIL area_offset_edge: fails =', fails);
 end area_offset_edge;
