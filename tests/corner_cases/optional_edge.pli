/* OPTIONAL parameter edge cases (ADR-119): Enterprise PL/I form.
   DECLARE p ... OPTIONAL on parameter; callers pass * or omit trailing
   OPTIONAL args. OMITTED(p)/PRESENT(p) test argument presence.
   Tests cover optional at different positions, *, OMITTED/PRESENT.
   NOTE: Compiler currently doesn't handle null optional params correctly
   (crashes on access without OMITTED check). Those calls are commented. */
optional_edge: procedure options(main);
    declare fails fixed bin(31);
    fails = 0;
    put skip list('START optional_edge');

    /* Call with all arguments - WORKS */
    call opt_proc(1, 2, 3);
    /* call opt_proc(1, 2, *);       -- third omitted: COMPILER BUG (accesses null ptr) */
    /* call opt_proc(1, *, 3);       -- second omitted: COMPILER BUG */
    /* call opt_proc(1, *, *);       -- second and third omitted: COMPILER BUG */
    /* call opt_proc(1);             -- trailing omitted: COMPILER BUG */

    /* Test OMITTED and PRESENT in callee - WORKS with all args */
    call check_omitted(10, 20, 30);
    /* call check_omitted(10, 20, *); -- COMPILER BUG */
    /* call check_omitted(10, *, 30); -- COMPILER BUG */
    /* call check_omitted(10, *, *);  -- COMPILER BUG */

    /* OPTIONAL with different types - WORKS with all args */
    call opt_types(1, 2.5, 'hello');
    /* call opt_types(1, 'world'); -- can't omit middle optional positional */
    /* call opt_types(1); -- can't omit middle optional positional */

    /* OPTIONAL array parameter - WORKS */
    declare arr(5) fixed bin(31);
    arr(1) = 1; arr(2) = 2; arr(3) = 3; arr(4) = 4; arr(5) = 5;
    call opt_array(arr);
    call opt_array(*);  /* omitted */

    /* OPTIONAL structure parameter - WORKS */
    declare 1 opt_struct,
           2 a fixed bin(31),
           2 b fixed bin(31);
    opt_struct.a = 1; opt_struct.b = 2;
    call opt_struct_proc(opt_struct);
    /* call opt_struct_proc(*); -- structure not optional, can't omit */

    /* Forwarding OPTIONAL to another OPTIONAL - WORKS with all args */
    call forward_opt(100);
    /* call forward_opt(*); -- COMPILER BUG */

    if fails = 0 then put skip list('PASS optional_edge');
    else put skip list('FAIL optional_edge: fails =', fails);

opt_proc: proc(p1, p2, p3) options(bypass);
    dcl p1 fixed bin(31);
    dcl p2 fixed bin(31) optional;
    dcl p3 fixed bin(31) optional;
    put skip list('opt_proc:', p1, p2, p3);
    return;
end opt_proc;

check_omitted: proc(a, b, c) options(bypass);
    dcl a fixed bin(31);
    dcl b fixed bin(31) optional;
    dcl c fixed bin(31) optional;
    put skip list('check_omitted:');
    if omitted(b) then put skip list('  b omitted');
    else put skip list('  b present =', b);
    if omitted(c) then put skip list('  c omitted');
    else put skip list('  c present =', c);
    /* if present(a) then put skip list('  a present'); -- a not optional */
    return;
end check_omitted;

opt_types: proc(i, f, s) options(bypass);
    dcl i fixed bin(31);
    dcl f float dec(6) optional;
    dcl s char(20) varying optional;
    put skip list('opt_types:', i, f, s);
    return;
end opt_types;

opt_array: proc(arr) options(bypass);
    dcl arr(*) fixed bin(31) optional;
    if omitted(arr) then put skip list('array omitted');
    else do;
       put skip list('array present, dim =', dim(arr));
    end;
    return;
end opt_array;

opt_struct_proc: proc(s) options(bypass);
    dcl 1 s,
         2 a fixed bin(31),
         2 b fixed bin(31) optional;
    /* if omitted(s) then put skip list('struct omitted'); -- s not optional */
    put skip list('struct present:', s.a, s.b);
    return;
end opt_struct_proc;

forward_opt: proc(val) options(bypass);
    dcl val fixed bin(31) optional;
    call inner_forward(val);  /* forward the optional */
    return;
end forward_opt;

inner_forward: proc(v) options(bypass);
    dcl v fixed bin(31) optional;
    if omitted(v) then put skip list('forwarded omitted');
    else put skip list('forwarded present:', v);
    return;
end inner_forward;

end optional_edge;