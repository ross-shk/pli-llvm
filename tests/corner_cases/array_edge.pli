/* Array bounds and cross-section edge cases (ADR-033, ADR-036, TR 25.084
   rules 12,13,126): Fixed-size arrays with constant bounds, negative lower
   bounds, multi-axis row-major layout, cross-sections (single-* and multi-*),
   SUBSCRIPTRANGE checking, DIM/LBOUND/HBOUND built-ins. */
array_edge: procedure options(main);

   /* Single axis with explicit lower bound */
   declare a1(-3:3) fixed bin(31);
   declare i fixed bin(31);
   do i = -3 to 3;
      a1(i) = i * 10;
   end;
   do i = -3 to 3;
      if a1(i) ^= i * 10 then do;
         put skip list('FAIL array_edge: check at line 18 failed');
         stop;
      end;
   end;
   if lbound(a1) ^= -3 then do;
      put skip list('FAIL array_edge: expected -3, got', lbound(a1));
      stop;
   end;
   if hbound(a1) ^= 3 then do;
      put skip list('FAIL array_edge: expected 3, got', hbound(a1));
      stop;
   end;
   if dim(a1) ^= 7 then do;
      put skip list('FAIL array_edge: expected 7, got', dim(a1));
      stop;
   end;

   /* Two-dimensional array */
   declare a2(2,3) fixed bin(31);
   a2(1,1) = 11; a2(1,2) = 12; a2(1,3) = 13;
   a2(2,1) = 21; a2(2,2) = 22; a2(2,3) = 23;
   if a2(1,1) ^= 11 then do;
      put skip list('FAIL array_edge: expected 11, got', a2(1,1));
      stop;
   end;
   if a2(2,3) ^= 23 then do;
      put skip list('FAIL array_edge: expected 23, got', a2(2,3));
      stop;
   end;

   /* Two-dim with explicit bounds */
   declare a3(0:1, 1:2) fixed bin(31);
   a3(0,1) = 7; a3(0,2) = 8;
   a3(1,1) = 9; a3(1,2) = 10;
   if a3(0,1) ^= 7 then do;
      put skip list('FAIL array_edge: expected 7, got', a3(0,1));
      stop;
   end;
   if a3(1,2) ^= 10 then do;
      put skip list('FAIL array_edge: expected 10, got', a3(1,2));
      stop;
   end;
   if lbound(a3) ^= 0 then do;
      put skip list('FAIL array_edge: expected 0, got', lbound(a3));
      stop;
   end;
   if hbound(a3) ^= 1 then do;
      put skip list('FAIL array_edge: expected 1, got', hbound(a3));
      stop;
   end;
   if dim(a3) ^= 4 then do;
      put skip list('FAIL array_edge: expected 4, got', dim(a3));
      stop;
   end;

   /* Three-dimensional array */
   declare a4(2,3,4) fixed bin(31);
   a4(1,1,1) = 111;
   a4(2,3,4) = 234;
   if a4(1,1,1) ^= 111 then do;
      put skip list('FAIL array_edge: expected 111, got', a4(1,1,1));
      stop;
   end;
   if a4(2,3,4) ^= 234 then do;
      put skip list('FAIL array_edge: expected 234, got', a4(2,3,4));
      stop;
   end;
   if dim(a4) ^= 24 then do;
      put skip list('FAIL array_edge: expected 24, got', dim(a4));
      stop;
   end;

   /* Cross-section: single * on first axis */
   declare b1(3,4) fixed bin(31);
   declare b1_row(4) fixed bin(31);
   do i = 1 to 4;
      b1(2,i) = i * 100;
   end;
   b1_row = b1(2,*);  /* copies row 2 */
   do i = 1 to 4;
      if b1_row(i) ^= i * 100 then do;
         put skip list('FAIL array_edge: check at line 57 failed');
         stop;
      end;
   end;

   /* Cross-section: single * on second axis */
   declare b1_col(3) fixed bin(31);
   do i = 1 to 3;
      b1(i,3) = i * 1000;
   end;
   b1_col = b1(*,3);  /* copies column 3 */
   do i = 1 to 3;
      if b1_col(i) ^= i * 1000 then do;
         put skip list('FAIL array_edge: check at line 67 failed');
         stop;
      end;
   end;

   /* Cross-section: multi * (sub-block) */
   declare b2(2,3,4) fixed bin(31);
   declare b2_sub(3,4) fixed bin(31);
   do i = 1 to 3;
      do j = 1 to 4;
         b2(2,i,j) = i * 10 + j;
      end;
   end;
   b2_sub = b2(2,*,*);  /* copies plane at first index 2 */
   do i = 1 to 3;
      do j = 1 to 4;
         if b2_sub(i,j) ^= i * 10 + j then do;
            put skip list('FAIL array_edge: check at line 81 failed');
            stop;
         end;
      end;
   end;

   /* Cross-section assignment to array */
   declare src(2,3) fixed bin(31);
   declare tgt(2,3) fixed bin(31);
   src(1,1) = 1; src(1,2) = 2; src(1,3) = 3;
   src(2,1) = 4; src(2,2) = 5; src(2,3) = 6;
   tgt = src(*,*);  /* whole array copy via cross-section */
   if tgt(1,1) ^= 1 then do;
      put skip list('FAIL array_edge: expected 1, got', tgt(1,1));
      stop;
   end;
   if tgt(2,3) ^= 6 then do;
      put skip list('FAIL array_edge: expected 6, got', tgt(2,3));
      stop;
   end;

/* Cross-section in expression - element-wise operations on arrays */
    declare c1(7) fixed bin(31);
    do i = -3 to 3;
       c1(i + 4) = a1(i) + a1(i);  /* element-wise addition */
    end;
    if c1(1) ^= a1(-3) + a1(-3) then do;
       put skip list('FAIL array_edge: check at line 99 failed');
       stop;
    end;

/* SUBSCRIPTRANGE runtime check with variable index */
    declare idx fixed bin(31);
    idx = 5;
    /* a1(5) = 99;  -- would raise SUBSCRIPTRANGE at runtime */

    /* DIM/LBOUND/HBOUND on parameter arrays - test that they work with fixed bounds */
    declare param_lb fixed bin(31);
    declare param_hb fixed bin(31);
    declare param_dim fixed bin(31);
    call array_param_fixed(a2, param_lb, param_hb, param_dim);
    if param_lb ^= 1 then do;
       put skip list('FAIL array_edge: expected 1, got', param_lb);
       stop;
    end;
    if param_hb ^= 2 then do;
       put skip list('FAIL array_edge: expected 2, got', param_hb);
       stop;
    end;
    if param_dim ^= 6 then do;
       put skip list('FAIL array_edge: expected 6, got', param_dim);
       stop;
    end;

   put skip list('PASS array_edge');

array_param_fixed: proc(x, lb, hb, dm) options(bypass);
   dcl x(2,3) fixed bin(31);
   dcl lb fixed bin(31);
   dcl hb fixed bin(31);
   dcl dm fixed bin(31);
   /* In callee, bounds come from actual argument */
   lb = lbound(x);
   hb = hbound(x);
   dm = dim(x);
   return;
end array_param_fixed;

end array_edge;
