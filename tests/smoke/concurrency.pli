 /* Smoke test port of examples/concurrency.pli: background CALL + EVENT,
    WAIT to join. Prints FAIL per violated check, PASS only if all hold. */

 conc: proc options(main);
   dcl done event;
   dcl counter fixed bin(31) init(0);


   call worker event(done);

   /* main thread stays free here */
   put skip list('main is free while worker runs');
   wait(done);

   if counter ^= 1 then do;
      put skip list('FAIL: counter =', counter);
      stop;
   end;

   put skip list('PASS concurrency');

 worker: proc;
   counter = counter + 1;
 end worker;
 end conc;
