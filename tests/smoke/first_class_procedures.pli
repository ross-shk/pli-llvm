 /* Smoke test port of examples/first_class_procedures.pli: functions
    kept in variables and passed as callbacks. Prints FAIL per violated
    check, PASS only if all hold. */

 firstcls: proc options(main);
   dcl on_get entry(fixed bin(31))
     returns(fixed bin(31)) variable;


   on_get = add1;
   if on_get(41) ^= 42 then do;
      put skip list('FAIL: add1(41) =', on_get(41));
      stop;
   end;

   on_get = dbl;
   if on_get(41) ^= 82 then do;
      put skip list('FAIL: dbl(41) =', on_get(41));
      stop;
   end;
   if dispatch(add1) ^= 42 then do;
      put skip list('FAIL: dispatch(add1) =', dispatch(add1));
      stop;
   end;
   if dispatch(dbl) ^= 82 then do;
      put skip list('FAIL: dispatch(dbl) =', dispatch(dbl));
      stop;
   end;

   put skip list('PASS first_class_procedures');

 add1: proc(x) returns(fixed bin(31));
   dcl x fixed bin(31);
   return(x + 1);
 end add1;

 dbl: proc(x) returns(fixed bin(31));
   dcl x fixed bin(31);
   return(x * 2);
 end dbl;

 dispatch: proc(cb) returns(fixed bin(31));
   dcl cb entry(fixed bin(31))
     returns(fixed bin(31)) variable;
   return(cb(41));
 end dispatch;
 end firstcls;
