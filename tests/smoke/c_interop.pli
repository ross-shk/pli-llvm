 /* Smoke test port of examples/c_interop.pli: call C functions
    declared as ENTRY with LINKAGE(SYSTEM). The runner compiles the
    companion c_interop_helper.c with clang and links it through the
    pli driver. Prints FAIL per violated check, PASS only if all
    hold. */

 cdemo: proc options(main);
   dcl c_add entry(fixed bin(31), fixed bin(31))
     returns(fixed bin(31))
     options(linkage(system))
     external('c_byval_add');

   dcl c_mul entry(fixed bin(31), fixed bin(31))
     returns(fixed bin(31))
     options(linkage(system))
     external('c_byval_mul');

   dcl r fixed bin(31);


   r = c_add(3, 4);
   if r ^= 7 then do;
      put skip list('FAIL: 3 + 4 =', r);
      stop;
   end;

   r = c_mul(6, 7);
   if r ^= 42 then do;
      put skip list('FAIL: 6 * 7 =', r);
      stop;
   end;

   put skip list('PASS c_interop');
 end cdemo;
