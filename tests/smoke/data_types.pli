 /* Smoke test port of examples/data_types.pli: everyday declarations.
    Prints FAIL per violated check, PASS only if all hold. */

 datatypes: proc options(main);
   dcl count fixed bin(31),
       price fixed dec(7,2),
       temp float dec(6);
   dcl name char(20) varying;
   dcl flag bit(1);
   dcl fails fixed bin(31);

   fails = 0;

   count = 42;
   price = 12.34;
   temp = 98.6;
   name = 'ada';
   flag = '1'b;

   if count ^= 42 then do;
      fails = fails + 1;
      put skip list('FAIL: count =', count);
   end;
   if price ^= 12.34 then do;
      fails = fails + 1;
      put skip list('FAIL: price =', price);
   end;
   if name ^= 'ada' then do;
      fails = fails + 1;
      put skip list('FAIL: name =', name);
   end;
   if flag ^= '1'b then do;
      fails = fails + 1;
      put skip list('FAIL: flag =', flag);
   end;

   /* fixed dec keeps cents exact */
   price = price + 0.01;
   if price ^= 12.35 then do;
      fails = fails + 1;
      put skip list('FAIL: price + 1c =', price);
   end;

   if fails = 0 then put skip list('PASS');
 end datatypes;
