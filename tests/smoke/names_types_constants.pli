 /* Smoke test port of examples/names_types_constants.pli: named
    constants (VALUE) and type names (DEFINE ALIAS). Prints FAIL per
    violated check, PASS only if all hold. */

 names: proc options(main);
   dcl max fixed bin(31) value(100);
   dcl greeting char(20) varying value('hi');
   dcl fails fixed bin(31);

   define alias scores fixed bin(31);

   dcl (midterm, final) type scores;

   fails = 0;

   midterm = 88;
   final = 92;

   if max ^= 100 then do;
      fails = fails + 1;
      put skip list('FAIL: cap =', max);
   end;
   if greeting ^= 'hi' then do;
      fails = fails + 1;
      put skip list('FAIL: greeting =', greeting);
   end;
   if midterm ^= 88 then do;
      fails = fails + 1;
      put skip list('FAIL: mid =', midterm);
   end;
   if final ^= 92 then do;
      fails = fails + 1;
      put skip list('FAIL: final =', final);
   end;
   if (midterm + final) / 2 ^= 90 then do;
      fails = fails + 1;
      put skip list('FAIL: avg =', (midterm + final) / 2);
   end;

   if fails = 0 then put skip list('PASS');
 end names;
