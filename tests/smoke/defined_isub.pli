 /* Smoke test port of examples/defined_isub.pli: DEFINED overlays and
    iSUB sliding views. Prints FAIL per violated check, PASS only if
    all hold. */

 overlays: proc options(main);
   dcl x fixed bin(31);
   dcl y fixed bin(31) defined x;
   dcl grid(10,10) fixed bin(31);
   dcl row(10) fixed bin(31) defined grid(1, 1sub);
   dcl i fixed bin(31);
   dcl fails fixed bin(31);

   fails = 0;

   x = 7;
   if y ^= 7 then do;
      fails = fails + 1;
      put skip list('FAIL: y tracks x =', y);
   end;

   y = 9;
   if x ^= 9 then do;
      fails = fails + 1;
      put skip list('FAIL: x tracks y =', x);
   end;

   do i = 1 to 10;
     grid(1,i) = i;
   end;
   if sum(row) ^= 55 then do;
      fails = fails + 1;
      put skip list('FAIL: row sum =', sum(row));
   end;

   grid(1,3) = 99;
   if row(3) ^= 99 then do;
      fails = fails + 1;
      put skip list('FAIL: tracks =', row(3));
   end;

   row(4) = 100;
   if grid(1,4) ^= 100 then do;
      fails = fails + 1;
      put skip list('FAIL: writes back =', grid(1,4));
   end;

   if fails = 0 then put skip list('PASS');
 end overlays;
