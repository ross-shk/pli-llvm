 /* Smoke test port of examples/preprocessor.pli: shared header,
    shorthand and conditional code. Prints FAIL per violated check,
    PASS only if all hold. */

 %include 'preprocessor_defs.inc';

 %replace bound by 5;
 %declare debug value(1);
 %activate debug;

 demo: proc options(main);
   dcl table(%tabcap) char(80) varying;
   dcl small(bound) fixed bin(31);

   dcl i fixed bin(31);


   do i = 1 to bound;
     small(i) = i;
   end;

   if %tabcap ^= 1000 then do;
      put skip list('FAIL: cap =', %tabcap);
      stop;
   end;
   if sum(small) ^= 15 then do;
      put skip list('FAIL: sum =', sum(small));
      stop;
   end;

   table(1) = 'hello';
   if table(1) ^= 'hello' then do;
      put skip list('FAIL: first =', table(1));
      stop;
   end;

   %if debug = 1 %then put skip list('debug is on');
   %else put skip list('debug is off');

   put skip list('PASS preprocessor');
 end demo;
