 /* Smoke test port of examples/conditions.pli: ON/SIGNAL/REVERT with
    resume, condition prefixes. Prints FAIL per violated check, PASS
    only if all hold. */

 conds: proc options(main);
   dcl a(5) fixed bin(31);
   dcl i fixed bin(31);
   dcl (total, bump) fixed dec(7,2);
   dcl fails fixed bin(31);

   fails = 0;

   do i = 1 to 5;
     a(i) = i * 10;
   end;

   /* named-condition resume demo */
   on error begin;
     put skip list('caught an error');
   end;

   signal error;
   revert error;

   /* bounds trap resumes with clamped index */
   on subscriptrange put skip list('bad index');

   i = 0;
   put skip list('a(0)->', a(i));
   if a(i) ^= 10 then do;
      fails = fails + 1;
      put skip list('FAIL: a(0) =', a(i));
   end;
   revert subscriptrange;

   /* overflow guard for money math */
   total = 0;
   bump = 99999.99;
   on size begin;
     put skip list('would overflow, capping');
     total = 99999.99;
   end;

   total = total + bump;
   if total ^= 99999.99 then do;
      fails = fails + 1;
      put skip list('FAIL: total =', total);
   end;
   revert size;

   /* one-shot opt-out when index is known good (a condition prefix
      ends with a colon) */
   i = 2;
   (nosubscriptrange): a(i) = 0;
   if a(2) ^= 0 then do;
      fails = fails + 1;
      put skip list('FAIL: a(2) =', a(2));
   end;

   if fails = 0 then put skip list('PASS');
 end conds;
