 /* Smoke test port of examples/packages.pli: a package exporting its
    public face. Prints FAIL per violated check, PASS only if all hold. */

 mathlib: package exports(doubleit, is_even);
   doubleit: proc(x) returns(fixed bin(31));
     dcl x fixed bin(31);
     return(helper(x) + x);
   end doubleit;

   is_even: proc(x) returns(bit(1));
     dcl x fixed bin(31);
     if mod(x, 2) = 0 then return('1'b);
     return('0'b);
   end is_even;

   helper: proc(x) returns(fixed bin(31));
     dcl x fixed bin(31);
     return(x + 1);
   end helper;
 end mathlib;

 use_pkgs: proc options(main);
   dcl doubleit entry(fixed bin(31))
    returns(fixed bin(31)) external;

   dcl is_even entry(fixed bin(31))
     returns(bit(1)) external;
   dcl fails fixed bin(31);

   fails = 0;

   if doubleit(21) ^= 43 then do;
      fails = fails + 1;
      put skip list('FAIL: double(21) =', doubleit(21));
   end;
   if is_even(4) ^= '1'b then do;
      fails = fails + 1;
      put skip list('FAIL: 4 not even');
   end;

   if fails = 0 then put skip list('PASS');
 end use_pkgs;
