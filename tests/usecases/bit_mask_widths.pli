 /* Rules (115)-(117): masked BIT tests preserve every bit, including
    the top bit of a BIT(32) (bit 31, the signed FIXED BIN(31) sign
    bit) and bits above 31 in a BIT(64). A merged conjunction must
    agree with the same two tests written separately. */
 bit_mask_widths: procedure options(main);
   declare w bit(64);
   declare m bit(64);
   declare w32 bit(32);
   declare m32 bit(32);
   declare w7 bit(7);
   declare m7 bit(7);
   declare hits fixed bin(31);

   hits = 0;

   /* BIT(64): the top bit survives a merged comparison. */
   w = '1'b;
   m = '1'b;
   if ((w & m) = m) & ((w & m) = m) then hits = hits + 1;
   else do;
      put skip list('FAIL bit64 top');
      stop;
   end;

   /* BIT(64): a value differing in the top bit must fail the test. */
   w = '01'b;
   if ((w & m) = m) & ((w & m) = m) then do;
      put skip list('FAIL bit64 differs');
      stop;
   end;

   /* BIT(32): the top bit is outside FIXED BIN(31)'s value range. */
   w32 = '1'b;
   m32 = '1'b;
   if ((w32 & m32) = m32) & ((w32 & m32) = m32) then hits = hits + 1;
   else do;
      put skip list('FAIL bit32 top');
      stop;
   end;

   /* BIT(32): the second bit, next to the sign bit. */
   w32 = '01'b;
   m32 = '01'b;
   if ((w32 & m32) = m32) & ((w32 & m32) = m32) then hits = hits + 1;
   else do;
      put skip list('FAIL bit32 second');
      stop;
   end;

   /* BIT(7): a non-byte width. */
   w7 = '1'b;
   m7 = '1'b;
   if ((w7 & m7) = m7) & ((w7 & m7) = m7) then hits = hits + 1;
   else do;
      put skip list('FAIL bit7 top');
      stop;
   end;

   if hits ¬= 4 then do;
      put skip list('FAIL count', hits);
      stop;
   end;
   put skip list('PASS');
 end bit_mask_widths;
