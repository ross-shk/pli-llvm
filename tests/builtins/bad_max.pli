 /* Diagnostic test: MAX with a non-numeric argument is rejected. */
 BADMAX: PROCEDURE OPTIONS(MAIN);
    DECLARE S CHAR(4);
    DECLARE X FIXED BINARY(31);
    S = 'abcd';
    X = MAX(S, 3);
 END BADMAX;
