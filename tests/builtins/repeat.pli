 /* REPEAT built-in function: repeat(s, n) returns the character string s
    repeated n times. M2 string built-in (Y33-6003 REPEAT). */
 repeat_test: procedure options(main);
    declare t char(6);


    t = repeat('AB', 3);
    if t ^= 'ABABAB' then do;
       put skip list('FAIL repeat AB 3 =', t);
       stop;
    end;

    t = repeat('x', 5);
    if t ^= 'xxxxx' then do;
       put skip list('FAIL repeat x 5 =', t);
       stop;
    end;

   put skip list('PASS repeat');
 end repeat_test;
