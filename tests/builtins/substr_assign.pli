 /* SUBSTR pseudo-variable: substr(v, i, n) = x overwrites part of a character
    variable in place. rule (86) allows a reference on the left of '='; M2
    implements the SUBSTR form. */
 substr_assign_test: procedure options(main);
    declare str char(10) init('abcdefghij');


    substr(str, 1, 3) = 'XYZ';
    if str ^= 'XYZdefghij' then do;
       put skip list('FAIL substr(1,3) =', str);
       stop;
    end;

    str = 'abcdefghij';
    substr(str, 5, 2) = '99';
    if str ^= 'abcd99ghij' then do;
       put skip list('FAIL substr(5,2) =', str);
       stop;
    end;

   put skip list('PASS substr-assign');
 end substr_assign_test;
