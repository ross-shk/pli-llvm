 /* FLOAT(char) (rule (123)): parse the decimal point, fraction digits,
    and an optional exponent, not just the integer prefix. */
 float_char: procedure options(main);
    declare f float dec(6);

    f = float('1.5');
    if abs(f - 1.5) > 1e-9 then do;
       put skip list('FAIL float(1.5)', f);
       stop;
    end;
    f = float('-2.25');
    if abs(f - -2.25) > 1e-9 then do;
       put skip list('FAIL float(-2.25)', f);
       stop;
    end;
    f = float('   +7.125');
    if abs(f - 7.125) > 1e-9 then do;
       put skip list('FAIL float(+7.125)', f);
       stop;
    end;
    f = float('.5');
    if abs(f - 0.5) > 1e-9 then do;
       put skip list('FAIL float(.5)', f);
       stop;
    end;
    f = float('5.');
    if abs(f - 5.0) > 1e-9 then do;
       put skip list('FAIL float(5.)', f);
       stop;
    end;
    f = float('0.001');
    if abs(f - 0.001) > 1e-9 then do;
       put skip list('FAIL float(0.001)', f);
       stop;
    end;
    f = float('-0.125');
    if abs(f - -0.125) > 1e-9 then do;
       put skip list('FAIL float(-0.125)', f);
       stop;
    end;

    /* Exponent text: e/E, an optional sign, and a mantissa. */
    f = float('1e3');
    if abs(f - 1000.0) > 1e-6 then do;
       put skip list('FAIL float(1e3)', f);
       stop;
    end;
    f = float('1.5e-2');
    if abs(f - 0.015) > 1e-12 then do;
       put skip list('FAIL float(1.5e-2)', f);
       stop;
    end;
    f = float('-2E+2');
    if abs(f - -200.0) > 1e-6 then do;
       put skip list('FAIL float(-2E+2)', f);
       stop;
    end;
    f = float('.5e1');
    if abs(f - 5.0) > 1e-9 then do;
       put skip list('FAIL float(.5e1)', f);
       stop;
    end;
    f = float('0e-999');
    if abs(f) > 1e-12 then do;
       put skip list('FAIL float(0e-999)', f);
       stop;
    end;

    put skip list('PASS float_char');
 end float_char;
