  /* SPDX-License-Identifier: Apache-2.0 */
  /* FILEOPEN/LINENO/PAGENO (rule 123): file-state queries by slot. */
  fileopen_test: procedure options(main);
    declare f fixed bin(31);
    declare ln fixed bin(31);
    declare pg fixed bin(31);
    declare op bit(1);

    f = 7;

    /* Never-opened slot reads closed, line 0, page 0. */
    op = fileopen(f);
    if op then do;
       put skip list('FAIL fileopen(7)');
       stop;
    end;
    ln = lineno(f);
    if ln ^= 0 then do;
       put skip list('FAIL lineno(7)', ln);
       stop;
    end;
    pg = pageno(f);
    if pg ^= 0 then do;
       put skip list('FAIL pageno(7)', pg);
       stop;
    end;

    /* PAGENO pseudo-variable round-trips. */
    pageno(f) = 3;
    pg = pageno(f);
    if pg ^= 3 then do;
       put skip list('FAIL pageno = 3', pg);
       stop;
    end;

   put skip list('PASS fileopen');
  end fileopen_test;
