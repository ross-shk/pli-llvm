  /* CM5: complex arithmetic (plus, minus,
     times, divide) over the pair layout;
     mixed real operands convert with a
     zero imaginary part; 2i is an
     imaginary constant. Exact cases only,
     checked via REAL(), IMAG(), = and ^=. */
  complex_arith: procedure options(main);
     declare (z, w, r) complex;
     z = complex(1.0, 2.0);
     w = complex(3.0, 4.0);

     r = z + w;
     if real(r) ^= 4.0 | imag(r) ^= 6.0
        then do;
        put skip list('FAIL add');
        stop;
     end;

     r = w - z;
     if real(r) ^= 2.0 | imag(r) ^= 2.0
        then do;
        put skip list('FAIL sub');
        stop;
     end;

     r = z * w;
     if real(r) ^= -5.0 | imag(r) ^= 10.0
        then do;
        put skip list('FAIL mul');
        stop;
     end;

     r = w / w;
     if real(r) ^= 1.0 | imag(r) ^= 0.0
        then do;
        put skip list('FAIL div');
        stop;
     end;

     r = z + 1.0;
     if real(r) ^= 2.0 | imag(r) ^= 2.0
        then do;
        put skip list('FAIL mixed');
        stop;
     end;

     r = 2i;
     if real(r) ^= 0.0 | imag(r) ^= 2.0
        then do;
        put skip list('FAIL imag');
        stop;
     end;

     if z ^= complex(1.0, 2.0) then do;
        put skip list('FAIL eq');
        stop;
     end;
     if z = w then do;
        put skip list('FAIL ne');
        stop;
     end;

   put skip list('PASS complex-arith');
  end complex_arith;
