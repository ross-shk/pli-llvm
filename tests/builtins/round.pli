 /* ROUND built-in function: round(x, n) rounds the numeric value x to n
    fractional decimal digits. M2 arithmetic built-in (Y33-6003 ROUND). */
 round_test: procedure options(main);
    declare y float dec(6);


    y = round(2.345, 2);
    if y ^= 2.35 then do;
       put skip list('FAIL round(2.345,2) =', y);
       stop;
    end;

    y = round(2.344, 2);
    if y ^= 2.34 then do;
       put skip list('FAIL round(2.344,2) =', y);
       stop;
    end;

    y = round(7.5, 0);
    if y ^= 8.0 then do;
       put skip list('FAIL round(7.5,0) =', y);
       stop;
    end;

   put skip list('PASS round');
 end round_test;
