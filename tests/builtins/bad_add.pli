 /* Diagnostic test: ADD/SUBTRACT with wrong arity and non-numeric args
    are rejected. rule (123), Appendix 1. */
 badadd: procedure options(main);
    declare x fixed bin(31);
    declare s char(4);
    s = 'abcd';
    x = add();        /* error: ADD expects 2-4 arguments */
    x = add(1);       /* error: ADD expects 2-4 arguments */
    x = add(1, 2, 3, 4, 5); /* error: ADD expects 2-4 arguments */
    x = add(s, 2);    /* error: ADD arguments must be numeric */
    x = subtract(s, 1); /* error: SUBTRACT arguments must be numeric */
 end badadd;
