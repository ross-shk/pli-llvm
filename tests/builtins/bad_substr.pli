 /* Diagnostic test: SUBSTR with a non-constant length argument is rejected
    (this stage requires the result length to be a constant). */
 BADSUBSTR: PROCEDURE OPTIONS(MAIN);
    DECLARE S CHAR(8);
    DECLARE N FIXED BINARY(31);
    DECLARE T CHAR(3);
    S = 'ABCDEFGH';
    N = 3;
    T = SUBSTR(S, 2, N);
 END BADSUBSTR;
