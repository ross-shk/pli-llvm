 /* EMPTY built-in (TR 25.084 rule 123, Appendix 1): EMPTY() returns a null
    AREA handle. */
 empty_test: procedure options(main);
   declare a area;
   declare p pointer;


   a = empty();

   if a ^= null() then do;
      put skip list('FAIL empty() != null()');
      stop;
   end;

   put skip list('PASS empty');
 end empty_test;
