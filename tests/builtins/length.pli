 /* LENGTH built-in function: length(s) returns the current length of a string
    as a FIXED BINARY integer — the declared length for a NONVARYING string,
    the current length for VARYING. M2 string built-in (Y33-6003 LENGTH). */
 length_test: procedure options(main);
    declare s char(8);
    declare v char(8) varying;
    declare n fixed bin(31);


    s = 'ABCD';
    n = length(s);
    if n ^= 8 then do;
       put skip list('FAIL length fixed =', n);
       stop;
    end;

    v = 'ABCD';
    n = length(v);
    if n ^= 4 then do;
       put skip list('FAIL length varying =', n);
       stop;
    end;

    n = length('xyz');
    if n ^= 3 then do;
       put skip list('FAIL length lit =', n);
       stop;
    end;

    /* LENGTH is usable in an expression. */
    n = length('ab') + length('c');
    if n ^= 3 then do;
       put skip list('FAIL length expr =', n);
       stop;
    end;

   put skip list('PASS length');
 end length_test;
