 /* SYSTEM built-in (rule (123)): invokes the system command processor with
    command string x and returns the exit code as FIXED BIN(31). */
 system_test: procedure options(main);
    declare rc fixed bin(31);
    declare fails fixed bin(31);

    fails = 0;

    /* Character argument: the common path. */
    rc = system('true');
    if rc ^= 0 then do;
       fails = fails + 1;
       put skip list('FAIL system(true) =', rc, 'expected 0');
    end;

    rc = system('false');
    if rc = 0 then do;
       fails = fails + 1;
       put skip list('FAIL system(false) returned 0');
    end;

    rc = system('exit 42');
    if rc ^= 42 then do;
       fails = fails + 1;
       put skip list('FAIL system(exit 42) =', rc, 'expected 42');
    end;

    /* Numeric argument: converted to character by the CHAR path. */
    rc = system(7);
    if rc = 0 | rc = 1 then do;
       fails = fails + 1;
       put skip list('FAIL system(7) returned', rc, 'expected shell error code');
    end;

    if fails = 0 then put skip list('PASS system');
    else put skip list('FAIL system: fails =', fails);
 end system_test;
