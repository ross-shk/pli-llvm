  /* CM5: complex exponentiation (rule 121)
     over the pair layout; results via
     exp(b*log(a)) so checked within a
     small tolerance. */
  complex_pow: procedure options(main);
     declare (r, z, w) complex;
     declare y float dec(6);
     declare fails fixed bin(31);
     fails = 0;
     z = complex(1.0, 1.0);
     r = z ** 2;
     y = real(r);
     if abs(y - 0.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL sqr re=', y);
     end;
     y = imag(r);
     if abs(y - 2.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL sqr im=', y);
     end;
     z = complex(2.0, 0.0);
     r = z ** 3;
     y = real(r);
     if abs(y - 8.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL cube re=', y);
     end;
     y = imag(r);
     if abs(y - 0.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL cube im=', y);
     end;
     z = complex(0.0, 1.0);
     r = z ** 2;
     y = real(r);
     if abs(y - -1.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL imag re=', y);
     end;
     y = imag(r);
     if abs(y - 0.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL imag im=', y);
     end;
     z = complex(3.0, 4.0);
     r = z ** 2;
     y = real(r);
     if abs(y - -7.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL 3+4i re=', y);
     end;
     y = imag(r);
     if abs(y - 24.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL 3+4i im=', y);
     end;
     w = complex(1.0, 0.0);
     r = z ** w;
     y = real(r);
     if abs(y - 3.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL pow1 re=', y);
     end;
     y = imag(r);
     if abs(y - 4.0) > 1e-6 then do;
        fails = fails + 1;
        put skip list('FAIL pow1 im=', y);
     end;
     if fails = 0
        then put skip list('PASS complex-pow');
        else put skip list('FAIL complex-pow');
  end complex_pow;
