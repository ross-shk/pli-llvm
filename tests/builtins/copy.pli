 /* COPY built-in (TR 25.084 rule 123, Appendix 1): COPY(s, n) duplicates
    string s n times — identical to REPEAT. */
 copy_test: procedure options(main);
   declare t char(6);


   t = copy('AB', 3);
   if t ^= 'ABABAB' then do;
      put skip list('FAIL copy AB 3 =', t);
      stop;
   end;

   t = copy('x', 5);
   if t ^= 'xxxxx' then do;
      put skip list('FAIL copy x 5 =', t);
      stop;
   end;

   t = copy('Hi', 0);
   if t ^= '' then do;
      put skip list('FAIL copy Hi 0 =', t);
      stop;
   end;

   put skip list('PASS copy');
 end copy_test;
