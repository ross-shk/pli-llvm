 /* EXPONENT built-in: EXPONENT(x) returns the binary exponent of x
    (the value e such that x = f * 2^e, 0.5 <= |f| < 1), or 0 for 0/NaN.
    rule (123) Appendix 1. */
 exp_test: procedure options(main);
    declare x fixed bin(31);
    declare z float dec(6);
    declare fails fixed bin(31);

    fails = 0;

    x = exponent(8.0);   if x ^= 4 then do; fails = fails + 1; put skip list('FAIL exp(8)', x); end;
    x = exponent(1.0);   if x ^= 1 then do; fails = fails + 1; put skip list('FAIL exp(1)', x); end;
    x = exponent(0.5);   if x ^= 0 then do; fails = fails + 1; put skip list('FAIL exp(0.5)', x); end;
    x = exponent(0.25);  if x ^= -1 then do; fails = fails + 1; put skip list('FAIL exp(0.25)', x); end;
    x = exponent(0.0);   if x ^= 0 then do; fails = fails + 1; put skip list('FAIL exp(0)', x); end;
    x = exponent(-8.0);  if x ^= 4 then do; fails = fails + 1; put skip list('FAIL exp(-8)', x); end;

    if fails = 0 then put skip list('PASS exponent');
    else put skip list('FAIL exponent: ', fails);
 end exp_test;
