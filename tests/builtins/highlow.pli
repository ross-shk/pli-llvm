 /* HIGH and LOW built-in functions: high(n) and low(n) yield character strings
    of n copies of the highest (lowest) collating character. M2 string
    built-ins (Y33-6003 HIGH, LOW). */
 highlow_test: procedure options(main);
    declare h char(3);
    declare l char(3);


    h = high(3);
    l = low(3);

    if h = l then do;
       put skip list('FAIL high equals low');
       stop;
    end;

    if length(h) ^= 3 then do;
       put skip list('FAIL high length =', length(h));
       stop;
    end;

    if length(l) ^= 3 then do;
       put skip list('FAIL low length =', length(l));
       stop;
    end;

   put skip list('PASS highlow');
 end highlow_test;
