 /* CURRENTSIZE built-in (TR 25.084 rule 123, Appendix 1): CURRENTSIZE(x)
    returns the storage size of variable x. */
 cursize_test: procedure options(main);
   declare x fixed bin(31);
   declare sz fixed bin(31);


   sz = currentsize(x);
   if sz < 0 then do;
      put skip list('FAIL currentsize negative =', sz);
      stop;
   end;

   put skip list('PASS currentsize');
 end cursize_test;
