 /* SPDX-License-Identifier: Apache-2.0 */
 /* CURRENTSIZE built-in (TR 25.084 rule 123, Appendix 1): CURRENTSIZE(x)
    returns the storage size of variable x. */
 cursize_test: procedure options(main);
   declare x fixed bin(31);
   declare sz fixed bin(31);
   declare fails fixed bin(31);

   fails = 0;

   sz = currentsize(x);
   if sz < 0 then do;
      fails = fails + 1;
      put skip list('FAIL currentsize negative =', sz);
   end;

   if fails = 0 then put skip list('PASS currentsize');
   else put skip list('FAIL currentsize: fails =', fails);
 end cursize_test;
