 /* SUBSTR built-in function: substr(s, i, n) extracts n characters of the
    character string s starting at the 1-based position i. M2 string built-in
    (Y33-6003 SUBSTR). */
 substr_test: procedure options(main);
    declare s char(8);
    declare t char(3);


    s = 'ABCDEFGH';
    t = substr(s, 2, 3);
    if t ^= 'BCD' then do;
       put skip list('FAIL substr(2,3) =', t);
       stop;
    end;

    t = substr(s, 1, 1);
    if t ^= 'A' then do;
       put skip list('FAIL substr(1,1) =', t);
       stop;
    end;

    t = substr('abcdef', 4, 3);
    if t ^= 'def' then do;
       put skip list('FAIL substr lit =', t);
       stop;
    end;

   put skip list('PASS substr');
 end substr_test;
