 /* REVERSE (rule (123)): mirrors a string; same-length CHARACTER result. */
 revmax: procedure options(main);
    declare s char(5);
    s = reverse('abcde');
    if s ^= 'edcba' then do;
       put skip list('FAIL revmax: expected edcba, got', s);
       stop;
    end;
    s = reverse('a');
    if substr(s, 1, 1) ^= 'a' then do;
       put skip list('FAIL revmax: expected a, got', substr(s, 1, 1));
       stop;
    end;
   put skip list('PASS revmax');
 end revmax;
