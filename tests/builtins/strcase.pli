 /* String-search builtins (rule (123)): LOWERCASE/CENTER copy
    with case-folding and centering, SEARCH/VERIFY locate by
    set membership, RANK/COLLATE convert codes. */
 strcase: procedure options(main);
    declare s char(9);
    declare c char(6);
    s = lowercase('alphaBETA');
    if trim(s) ^= 'alphabeta' then do;
       put skip list('FAIL strcase: expected alphabeta, got', trim(s));
       stop;
    end;
    c = center('AB', 6);
    if c ^= '  AB  ' then do;
       put skip list('FAIL strcase: expected   AB  , got', c);
       stop;
    end;
    c = center('ABCDEFG', 4);
    if c ^= 'ABCD' then do;
       put skip list('FAIL strcase: expected ABCD, got', c);
       stop;
    end;
    if search('a,b.c', ' ,.', 1) ^= 2 then do;
       put skip list('FAIL strcase: expected 2, got',
          search('a,b.c', ' ,.', 1));
       stop;
    end;
    if search('a,b.c', ' ,.', 3) ^= 4 then do;
       put skip list('FAIL strcase: expected 4, got',
          search('a,b.c', ' ,.', 3));
       stop;
    end;
    if search('abc', ' ,.', 1) ^= 0 then do;
       put skip list('FAIL strcase: expected 0, got',
          search('abc', ' ,.', 1));
       stop;
    end;
    if verify('  hi', ' ,.', 1) ^= 3 then do;
       put skip list('FAIL strcase: expected 3, got',
          verify('  hi', ' ,.', 1));
       stop;
    end;
    if verify('abc', ' ', 4) ^= 0 then do;
       put skip list('FAIL strcase: expected 0, got',
          verify('abc', ' ', 4));
       stop;
    end;
    if rank('A') ^= 65 then do;
       put skip list('FAIL strcase: expected 65, got', rank('A'));
       stop;
    end;
    if rank('') ^= 0 then do;
       put skip list('FAIL strcase: expected 0, got', rank(''));
       stop;
    end;
    c = collate(65);
    if substr(c, 1, 1) ^= 'A' then do;
       put skip list('FAIL strcase: expected A, got', substr(c, 1, 1));
       stop;
    end;
   put skip list('PASS strcase');
 end strcase;
