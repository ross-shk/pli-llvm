 /* String-search builtins (rule (123)): LOWERCASE/CENTER copy
    with case-folding and centering, SEARCH/VERIFY locate by
    set membership, RANK/COLLATE convert codes. */
 strcase: procedure options(main);
    declare s char(9);
    declare c char(6);
    declare fails fixed bin(31);
    fails = 0;
    s = lowercase('alphaBETA');
    if trim(s) ^= 'alphabeta' then fails = fails + 1;
    c = center('AB', 6);
    if c ^= '  AB  ' then fails = fails + 1;
    c = center('ABCDEFG', 4);
    if c ^= 'ABCD' then fails = fails + 1;
    if search('a,b.c', ' ,.', 1) ^= 2 then fails = fails + 1;
    if search('a,b.c', ' ,.', 3) ^= 4 then fails = fails + 1;
    if search('abc', ' ,.', 1) ^= 0 then fails = fails + 1;
    if verify('  hi', ' ,.', 1) ^= 3 then fails = fails + 1;
    if verify('abc', ' ', 4) ^= 0 then fails = fails + 1;
    if rank('A') ^= 65 then fails = fails + 1;
    if rank('') ^= 0 then fails = fails + 1;
    c = collate(65);
    if substr(c, 1, 1) ^= 'A' then fails = fails + 1;
    if fails = 0 then put skip list('PASS strcase');
    else put skip list('FAIL strcase: fails =', fails);
 end strcase;
