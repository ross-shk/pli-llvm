 /* Diagnostic test: COMPLEX combined with a non-arithmetic attribute is
    rejected. COMPLEX with FLOAT/FIXED/DECIMAL/BINARY is valid (rule (16));
    COMPLEX with CHARACTER is not. */
 BADCOMPLEXVAR: PROCEDURE OPTIONS(MAIN);
    DECLARE Z COMPLEX CHARACTER(10);
 END BADCOMPLEXVAR;
