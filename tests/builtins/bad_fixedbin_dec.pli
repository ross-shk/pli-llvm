 /* Diagnostic test: FIXEDBIN/FIXEDDEC reject bad arity/precision. */
 bad_fixedbin_dec: procedure options(main);
    declare x fixed bin(31);
    declare z complex;
    declare p pointer;
    declare a(3) fixed bin(31);

    x = fixedbin();
    x = fixeddec(1, 2, 3, 4);
    x = fixedbin(1, 0);
    x = fixeddec(1, 32);
    x = fixedbin(1, 64);
    x = fixedbin(1, 2, 63);
    x = fixeddec(1, 9, 19);
    x = fixedbin(fixeddec(1, 31, 31));
    x = fixedbin(1, 2, -1);
    x = fixedbin(1, x);
    x = fixedbin(z);
    x = fixeddec(p);
    x = fixedbin(a);
 end bad_fixedbin_dec;
