 /* Diagnostic test: FIXED(x[,p[,q]]) rejects bad arity, precision,
    source, and scale. */
 bad_fixed_precision: procedure options(main);
    declare x fixed bin(31);
    declare z complex;
    declare a(3) fixed bin(31);

    x = fixed();
    x = fixed(1, 2, 3, 4);
    x = fixed(1, 0);
    x = fixed(1, 64);
    x = fixed(1, 8, 63);
    x = fixed(1, 8, -1);
    x = fixed(1.0E0, 64);
    x = fixed(1.0E0, 8, 63);
    x = fixed(fixedbin(1, 31, 0), 64);
    x = fixed(fixedbin(1, 31, 0), 8, 63);
    x = fixed(fixeddec(1, 31, 0), 32);
    x = fixed(1, x);
    x = fixed(1, 8, 1.5);
    x = fixed(z, 8, 2);
    x = fixed(a, 8, 2);
    x = fixed('1'B, 8, 2);
 end bad_fixed_precision;
