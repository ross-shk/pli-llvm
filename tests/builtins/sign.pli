 /* SIGN built-in function: sign(x) returns -1, 0, or +1 for negative,
    zero, or positive numeric arguments; rule (123) Appendix 1. */
 sign_test: procedure options(main);
     declare x fixed bin(31);
     declare y float dec(6);
     declare fails fixed bin(31);

     fails = 0;

     x = sign(-7);   if x ^= -1 then do; fails = fails + 1; put skip list('FAIL sign(-7)', x); end;
     x = sign(0);    if x ^=  0 then do; fails = fails + 1; put skip list('FAIL sign(0)', x);  end;
     x = sign(9);    if x ^=  1 then do; fails = fails + 1; put skip list('FAIL sign(9)', x);  end;

     y = sign(-2.5); if y ^= -1 then do; fails = fails + 1; put skip list('FAIL sign(-2.5)', y); end;
     y = sign(2.5);  if y ^=  1 then do; fails = fails + 1; put skip list('FAIL sign(2.5)', y);  end;

     if fails = 0 then put skip list('PASS sign');
     else put skip list('FAIL sign: ', fails);
 end sign_test;
