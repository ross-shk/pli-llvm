 /* ABS built-in function: abs(x) returns the absolute value of a numeric
    argument, preserving its type (FIXED or FLOAT). M2 arithmetic built-in
    (Y33-6003 ABS). */
 abs_test: procedure options(main);
    declare x fixed bin(31);
    declare y float dec(6);


    x = abs(-7);
    if x ^= 7 then do;
       put skip list('FAIL abs(-7) =', x);
       stop;
    end;

    x = abs(9);
    if x ^= 9 then do;
       put skip list('FAIL abs(9) =', x);
       stop;
    end;

    x = abs(0);
    if x ^= 0 then do;
       put skip list('FAIL abs(0) =', x);
       stop;
    end;

    y = abs(-2.5);
    if y ^= 2.5 then do;
       put skip list('FAIL abs(-2.5) =', y);
       stop;
    end;

   put skip list('PASS abs');
 end abs_test;
