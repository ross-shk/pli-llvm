 /* TRANSLATE built-in function: translate(s, out, in) maps each character of
    s that appears in `in` to the corresponding character of `out`; characters
    not in `in` are left unchanged. M2 string built-in (Y33-6003 TRANSLATE). */
 translate_test: procedure options(main);
    declare t char(4);
    declare fails fixed bin(31);

    fails = 0;

    /* Map A->X and B->Y in 'ABCD': the result is 'XYCD'. */
    t = translate('ABCD', 'XY', 'AB');
    if t ^= 'XYCD' then do;
       fails = fails + 1;
       put skip list('FAIL translate =', t);
    end;

    if fails = 0 then put skip list('PASS translate');
    else put skip list('FAIL translate: fails =', fails);
 end translate_test;
