 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* FIXED(x[,p[,q]]) (rule (123)): explicit precision/scale, with the
    result base taken from a fixed source. */
 fixed_precision: procedure options(main);
    declare b fixed bin(31);
    declare d fixed dec(9,2);
    declare c fixed dec(5,1);
    declare w fixed dec(25,2);

    /* float source: the compiler reads FLOAT as FLOAT DECIMAL */
    b = fixed(3.75E0, 8, 2);
    if b ^= 3 then do;
       put skip list('FAIL fixed(3.75E0,8,2) -> bin', b);
       stop;
    end;
    d = fixed(3.75E0, 8, 2);
    if d ^= 3.75 then do;
       put skip list('FAIL fixed(3.75E0,8,2) -> dec', d);
       stop;
    end;
    b = fixed(-3.75E0, 8, 2);
    if b ^= -3 then do;
       put skip list('FAIL fixed(-3.75E0,8,2) -> bin', b);
       stop;
    end;
    d = fixed(-3.75E0, 8, 2);
    if d ^= -3.75 then do;
       put skip list('FAIL fixed(-3.75E0,8,2) -> dec', d);
       stop;
    end;
    d = fixed(0.1E0, 8, 2);
    if d ^= 0.10 then do;
       put skip list('FAIL fixed(0.1E0,8,2) decimal base', d);
       stop;
    end;

    /* decimal source keeps the decimal base; omitted q means zero */
    c = fixed(fixeddec(7, 2, 1), 5, 1);
    if c ^= 7.0 then do;
       put skip list('FAIL fixed(dec,5,1)', c);
       stop;
    end;
    d = fixed(fixeddec(2.5, 2, 1), 2);
    if d ^= 3.00 then do;
       put skip list('FAIL fixed(dec,2) rounds', d);
       stop;
    end;
    b = fixed(fixeddec(7, 2, 1), 5, 1);
    if b ^= 7 then do;
       put skip list('FAIL fixed(dec,5,1) -> bin', b);
       stop;
    end;

    /* binary source keeps the binary base */
    b = fixed(fixedbin(1.5, 8, 1), 8);
    if b ^= 1 then do;
       put skip list('FAIL fixed(bin,8)', b);
       stop;
    end;
    d = fixed(fixedbin(1.5, 8, 1), 8, 1);
    if d ^= 1.50 then do;
       put skip list('FAIL fixed(bin,8,1)', d);
       stop;
    end;

    /* character text with scale zero */
    b = fixed('12', 5);
    if b ^= 12 then do;
       put skip list('FAIL fixed(char,5)', b);
       stop;
    end;
    d = fixed('12', 5, 0);
    if d ^= 12.00 then do;
       put skip list('FAIL fixed(char,5,0)', d);
       stop;
    end;

    /* character fractions */
    b = fixed('1.5');
    if b ^= 1 then do;
       put skip list('FAIL fixed(1.5)', b);
       stop;
    end;
    b = fixed('.5');
    if b ^= 0 then do;
       put skip list('FAIL fixed(.5)', b);
       stop;
    end;
    b = fixed('-1.9');
    if b ^= -1 then do;
       put skip list('FAIL fixed(-1.9)', b);
       stop;
    end;
    b = fixed('3.75', 8, 2);
    if b ^= 3 then do;
       put skip list('FAIL fixed(3.75,8,2)', b);
       stop;
    end;
    d = fixed('3.75', 8, 2);
    if d ^= 3.75 then do;
       put skip list('FAIL fixed(3.75,8,2) -> dec', d);
       stop;
    end;
    d = fixed('-0.5', 5, 1);
    if d ^= -0.50 then do;
       put skip list('FAIL fixed(-0.5,5,1)', d);
       stop;
    end;
    d = fixedbin('1.5', 8, 1);
    if d ^= 1.50 then do;
       put skip list('FAIL fixedbin(1.5,8,1)', d);
       stop;
    end;
    b = fixedbin('1.5', 31, 0);
    if b ^= 1 then do;
       put skip list('FAIL fixedbin(1.5,31,0)', b);
       stop;
    end;
    d = fixeddec('1.5', 5, 1);
    if d ^= 1.50 then do;
       put skip list('FAIL fixeddec(1.5,5,1)', d);
       stop;
    end;
    d = fixeddec('1.5', 5, 0);
    if d ^= 2.00 then do;
       put skip list('FAIL fixeddec(1.5,5,0)', d);
       stop;
    end;
    d = fixeddec('12.9', 5, 0);
    if d ^= 13.00 then do;
       put skip list('FAIL fixeddec(12.9,5,0)', d);
       stop;
    end;
    d = fixeddec('3.75', 5, 2);
    if d ^= 3.75 then do;
       put skip list('FAIL fixeddec(3.75,5,2)', d);
       stop;
    end;
    d = fixeddec('1.5', 5, 2);
    if d ^= 1.50 then do;
       put skip list('FAIL fixeddec(1.5,5,2)', d);
       stop;
    end;
    d = fixedbin('1.5', 8, 2);
    if d ^= 1.50 then do;
       put skip list('FAIL fixedbin(1.5,8,2)', d);
       stop;
    end;
    b = fixedbin('1.5');
    if b ^= 1 then do;
       put skip list('FAIL fixedbin(1.5)', b);
       stop;
    end;
    d = fixeddec('1.5');
    if d ^= 2.00 then do;
       put skip list('FAIL fixeddec(1.5)', d);
       stop;
    end;
    d = decimal('1.5', 5, 1);
    if d ^= 1.50 then do;
       put skip list('FAIL decimal(1.5,5,1)', d);
       stop;
    end;
    b = binary('3.75', 8);
    if b ^= 3 then do;
       put skip list('FAIL binary(3.75,8)', b);
       stop;
    end;

    /* half-away rounding is signed; binary rescaling truncates */
    d = fixeddec('-0.05', 5, 1);
    if d ^= -0.10 then do;
       put skip list('FAIL fixeddec(-0.05,5,1)', d);
       stop;
    end;
    d = fixedbin('0.75', 8, 1);
    if d ^= 0.50 then do;
       put skip list('FAIL fixedbin(0.75,8,1)', d);
       stop;
    end;

    /* wide decimal target keeps the i128 result path */
    w = fixeddec('12345678901234567890123.45', 25, 2);
    if w ^= 12345678901234567890123.45 then do;
       put skip list('FAIL fixeddec(wide)', w);
       stop;
    end;

    put skip list('PASS fixed precision');
 end fixed_precision;
