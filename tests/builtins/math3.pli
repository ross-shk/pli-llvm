 /* Scalar math built-ins (QR2.7, Appendix 1): degree trig variants SIND,
    COSD, TAND, ATAND. Each takes one numeric argument and yields a FLOAT
    value in degrees (unlike the radian SIN/COS/TAN/ATAN). Results are
    checked against expected values within a small tolerance. */
 math3_test: procedure options(main);
    declare y float dec(6);


    y = sind(30.0);
    if abs(y - 0.5) > 1e-6 then do;
       put skip list('FAIL sind(30) =', y);
       stop;
    end;

    y = cosd(60.0);
    if abs(y - 0.5) > 1e-6 then do;
       put skip list('FAIL cosd(60) =', y);
       stop;
    end;

    y = tand(45.0);
    if abs(y - 1.0) > 1e-6 then do;
       put skip list('FAIL tand(45) =', y);
       stop;
    end;

    y = atand(1.0);
    if abs(y - 45.0) > 1e-5 then do;
       put skip list('FAIL atand(1) =', y);
       stop;
    end;

    y = sind(0.0);
    if abs(y - 0.0) > 1e-6 then do;
       put skip list('FAIL sind(0) =', y);
       stop;
    end;

    y = cosd(0.0);
    if abs(y - 1.0) > 1e-6 then do;
       put skip list('FAIL cosd(0) =', y);
       stop;
    end;

    y = atand(0.0);
    if abs(y - 0.0) > 1e-6 then do;
       put skip list('FAIL atand(0) =', y);
       stop;
    end;

   put skip list('PASS math3');
 end math3_test;
