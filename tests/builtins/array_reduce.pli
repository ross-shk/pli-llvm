 /* Array reduction built-ins (rule (123)): SUM and PROD reduce a numeric
    array, ANY and ALL reduce a BIT array, over the whole single-axis extent. */
 array_reduce: procedure options(main);
    declare a(5) fixed bin(31);
    declare i fixed bin(31);
    declare fails fixed bin(31);

    fails = 0;

    do i = 1 to 5;
       a(i) = i;
    end;

    /* SUM and PROD over the full extent */
    if sum(a) ^= 15 then do;
       fails = fails + 1;
       put skip list('FAIL sum(a) =', sum(a));
    end;
    if prod(a) ^= 120 then do;
       fails = fails + 1;
       put skip list('FAIL prod(a) =', prod(a));
    end;

    /* a sparse partial is also handled: sum(a(3)) is just that element */
    a(2) = 2;
    if sum(a) ^= 15 then do;
       fails = fails + 1;
       put skip list('FAIL sum after reset =', sum(a));
    end;

    /* ANY/ALL over a BIT array */
    declare b(4) bit(1);
    declare allset bit(1);
    declare anyset bit(1);
    b(1) = '1'b;
    b(2) = '1'b;
    b(3) = '1'b;
    b(4) = '1'b;
    if ^all(b) then do;
       fails = fails + 1;
       put skip list('FAIL all(b)');
    end;
    if ^any(b) then do;
       fails = fails + 1;
       put skip list('FAIL any(b)');
    end;
    b(4) = '0'b;
    if all(b) then do;
       fails = fails + 1;
       put skip list('FAIL all(b) after clear');
    end;

    if fails = 0 then put skip list('PASS array_reduce');
    else put skip list('FAIL array_reduce: fails =', fails);
 end array_reduce;
