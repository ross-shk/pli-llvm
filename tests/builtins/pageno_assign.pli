 /* PAGENO pseudo-variable (TR 25.084 rule 123): pageno(f) = n sets the current
    page number counter for file f. */
 pageno_assign_test: procedure options(main);
   declare f fixed bin(31);
   declare pg fixed bin(31);


   f = 0;
   pageno(f) = 5;
   pg = pageno(f);
   if pg ^= 5 then do;
      put skip list('FAIL pageno(0) = 5 gave', pg);
      stop;
   end;

   pageno(f) = 10;
   pg = pageno(f);
   if pg ^= 10 then do;
      put skip list('FAIL pageno(0) = 10 gave', pg);
      stop;
   end;

   put skip list('PASS pageno_assign');
 end pageno_assign_test;
