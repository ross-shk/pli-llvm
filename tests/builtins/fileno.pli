 /* FILEOPEN/LINENO/PAGENO built-ins (TR 25.084 rule 123, Appendix 1).
    These query file state; without an open file they return 0/false. */
 fileno_test: procedure options(main);
   declare f fixed bin(31);
   declare r bit(1);
   declare ln fixed bin(31);
   declare pg fixed bin(31);


   f = 0;
   r = fileopen(f);
   if r ^= '0'b then do;
      put skip list('FAIL fileopen(0) =', r);
      stop;
   end;

   ln = lineno(f);
   if ln < 0 then do;
      put skip list('FAIL lineno(0) =', ln);
      stop;
   end;

   pg = pageno(f);
   if pg < 0 then do;
      put skip list('FAIL pageno(0) =', pg);
      stop;
   end;

   put skip list('PASS fileopen/lineno/pageno');
 end fileno_test;
