 /* ADD/SUBTRACT built-ins: ADD(a,b[,p[,s]]) and SUBTRACT(a,b[,p[,s])
    return the sum/difference in the common arithmetic type, or in
    FIXED BINARY(p,s) when precision/scale override is given.
    rule (123) Appendix 1. */
 add_test: procedure options(main);
    declare x fixed bin(31);
    declare y fixed dec(9,2);
    declare z float dec(6);
    declare fails fixed bin(31);

    fails = 0;

    /* basic integer addition */
    x = add(3, 4);   if x ^= 7 then do; fails = fails + 1; put skip list('FAIL add(3,4)', x); end;
    /* SUBTRACT */
    x = subtract(10, 3); if x ^= 7 then do; fails = fails + 1; put skip list('FAIL sub(10,3)', x); end;

    /* mixed FIXED BINARY + FIXED DECIMAL: common type is DECIMAL */
    y = add(3, 4.5);  if y ^= 7.50 then do; fails = fails + 1; put skip list('FAIL add(3,4.5)', y); end;
    y = subtract(10.0, 2.5); if y ^= 7.50 then do; fails = fails + 1; put skip list('FAIL sub(10.0,2.5)', y); end;

    /* FLOAT */
    z = add(1.5, 2.5); if z ^= 4.0 then do; fails = fails + 1; put skip list('FAIL add(1.5,2.5)', z); end;
    z = subtract(5.5, 1.5); if z ^= 4.0 then do; fails = fails + 1; put skip list('FAIL sub(5.5,1.5)', z); end;

    /* precision override: add(3,4,5) -> FIXED BIN(5) */
    x = add(3, 4, 12); if x ^= 7 then do; fails = fails + 1; put skip list('FAIL add(3,4,12)', x); end;

    /* scale override: add(3,4,10,2) -> FIXED BIN(10,2) */
    x = add(3, 4, 10, 2); if x ^= 7 then do; fails = fails + 1; put skip list('FAIL add(3,4,10,2)', x); end;

    if fails = 0 then put skip list('PASS add');
    else put skip list('FAIL add: ', fails);
 end add_test;
