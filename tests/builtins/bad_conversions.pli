 /* Diagnostic test: BINARY/DECIMAL/FLOAT with wrong arity and non-scalar args
    are rejected. rule (123), Appendix 1. */
badconv: procedure options(main);
     declare x fixed bin(31);
     declare p pointer;
     x = binary();      /* error: BINARY expects 1-2 arguments */
     x = decimal(1, 2, 3, 4); /* error: DECIMAL expects 1-3 arguments */
     x = float(1, 2, 3); /* error: FLOAT expects 1-2 arguments */
     x = binary(p);     /* error: BINARY argument must be character or numeric */
     x = decimal(p);    /* error: DECIMAL argument must be character or numeric */
     x = float(p);      /* error: FLOAT argument must be character or numeric */
   end badconv;
