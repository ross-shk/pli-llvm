 /* UNSPEC built-in (rule 123, ADR-196): UNSPEC(x) returns the raw storage
    of x as a BIT string; UNSPEC(var) = bits copies a bit string into the
    raw storage of var. */
 unspec_test: procedure options(main);
   declare x fixed bin(31);
   declare y fixed bin(31);
   declare b32 bit(32);


   /* Round-trip: set x to a known value, read raw bytes via UNSPEC, write to y. */
   x = 5;
   b32 = unspec(x);
   unspec(y) = b32;
   if y ^= x then do;
      put skip list('FAIL unspec round-trip gave y =', y);
      stop;
   end;

   /* Different value. */
   x = 42;
   b32 = unspec(x);
   unspec(y) = b32;
   if y ^= 42 then do;
      put skip list('FAIL unspec 42 gave y =', y);
      stop;
   end;

   /* Zero. */
   x = 0;
   b32 = unspec(x);
   unspec(y) = b32;
   if y ^= 0 then do;
      put skip list('FAIL unspec 0 gave y =', y);
      stop;
   end;

   put skip list('PASS unspec_test');
 end unspec_test;
