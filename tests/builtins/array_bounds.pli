 /* Array attribute built-ins (rule (123)): LBOUND/HBOUND/DIM on a fixed-size
    single-axis array. LBOUND is 1 by default and honours a declared lower
    bound; HBOUND is the declared upper bound; DIM is the extent ub-lb+1. */
 array_bounds: procedure options(main);
    declare a(5) fixed bin(31);
    declare b(2:5) fixed bin(31);
    declare i fixed bin(31);
    declare fails fixed bin(31);

    fails = 0;

    /* default bounds are 1..n, extent n */
    if lbound(a) ^= 1 then do;
       fails = fails + 1;
       put skip list('FAIL lbound(a) =', lbound(a));
    end;
    if hbound(a) ^= 5 then do;
       fails = fails + 1;
       put skip list('FAIL hbound(a) =', hbound(a));
    end;
    if dim(a) ^= 5 then do;
       fails = fails + 1;
       put skip list('FAIL dim(a) =', dim(a));
    end;

    /* declared lower bound is honoured */
    if lbound(b) ^= 2 then do;
       fails = fails + 1;
       put skip list('FAIL lbound(b) =', lbound(b));
    end;
    if hbound(b) ^= 5 then do;
       fails = fails + 1;
       put skip list('FAIL hbound(b) =', hbound(b));
    end;
    if dim(b) ^= 4 then do;
       fails = fails + 1;
       put skip list('FAIL dim(b) =', dim(b));
    end;

    /* a bounds-driven loop over the array's elements */
    do i = lbound(a) to hbound(a);
       a(i) = i * 10;
    end;
    if a(dim(a)) ^= 50 then do;
       fails = fails + 1;
       put skip list('FAIL a(dim(a)) =', a(dim(a)));
    end;

    if fails = 0 then put skip list('PASS array_bounds');
    else put skip list('FAIL array_bounds: fails =', fails);
 end array_bounds;
