every_some: procedure options(main);
   declare i fixed bin(31);
   declare a(5) bit(1);
   declare b(5) bit(1);
   declare c(5) fixed bin(31);
   declare r bit(1);
   do i = 1 to 5;
      a(i) = '1'b;
   end;
   do i = 1 to 5;
      b(i) = '0'b;
   end;
   if every(a) ^= '1'b then do;
      put skip list('FAIL every(a) all-true');
      stop;
   end;
   if every(b) ^= '0'b then do;
      put skip list('FAIL every(b) all-false');
      stop;
   end;
   if some(a) ^= '1'b then do;
      put skip list('FAIL some(a) all-true');
      stop;
   end;
   if some(b) ^= '0'b then do;
      put skip list('FAIL some(b) all-false');
      stop;
   end;
   /* mixed */
   b(3) = '1'b;
   if every(b) ^= '0'b then do;
      put skip list('FAIL every(b) mixed');
      stop;
   end;
   if some(b) ^= '1'b then do;
      put skip list('FAIL some(b) mixed');
      stop;
   end;
   /* numeric expression via temp assignment (rule 123) */
   do i = 1 to 5;
      c(i) = 0;
   end;
   r = every(c > 0);
   if r ^= '0'b then do;
      put skip list('FAIL every(c>0) all-zero');
      stop;
   end;
   r = some(c > 0);
   if r ^= '0'b then do;
      put skip list('FAIL some(c>0) all-zero');
      stop;
   end;
   c(3) = 5;
   r = every(c > 0);
   if r ^= '0'b then do;
      put skip list('FAIL every(c>0) mixed');
      stop;
   end;
   r = some(c > 0);
   if r ^= '1'b then do;
      put skip list('FAIL some(c>0) mixed');
      stop;
   end;
   put skip list('PASS every_some');
end every_some;
