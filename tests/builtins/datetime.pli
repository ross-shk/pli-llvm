/* DATE and TIME built-in functions: date() returns the current date as a
   CHARACTER(8) 'YYYYMMDD' string, time() the time as a CHARACTER(6) 'HHMMSS'
   string, datetime() as a CHARACTER(14) 'YYYYMMDDHHMMSS' string. */
   datetime_test: procedure options(main);
     declare d char(8);
     declare t char(6);
     declare dt char(14);


     d = date();
     t = time();
     dt = datetime();

     if length(d) ^= 8 then do;
        put skip list('FAIL date length =', length(d));
        stop;
     end;

     if length(t) ^= 6 then do;
        put skip list('FAIL time length =', length(t));
        stop;
     end;

     if length(dt) ^= 14 then do;
        put skip list('FAIL datetime length =', length(dt));
        stop;
     end;

     /* date() and time() differ from an arbitrary fixed string. */
     if d = 'XXXXXXXX' then do;
        put skip list('FAIL date constant');
        stop;
     end;

     if t = '123456' then do;
        put skip list('FAIL time constant');
        stop;
     end;

     /* datetime() = date() + time() */
     if substr(dt, 1, 8) ^= d then do;
        put skip list('FAIL datetime date part');
        stop;
     end;
     if substr(dt, 9, 6) ^= t then do;
        put skip list('FAIL datetime time part');
        stop;
     end;

   put skip list('PASS datetime');
   end datetime_test;
