# Headless runner for pli-produced Windows .exe files (console only, no X).
# NOTE: on ARM Macs run this image with --platform linux/amd64 — ARM Wine
# cannot execute x86_64 Windows binaries, emulation covers it.
FROM debian:trixie-slim
# Minimal Wine; WINEDEBUG silences fixme noise for clean agent logs.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      wine64 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/lib/wine/wine64 /usr/bin/wine64
# arm64 Wine runs ARM64 Windows binaries; x86_64 .exe files need this image
# rebuilt with --platform linux/amd64 (see run-cross-test.sh).
ENV WINEDEBUG=-all
# PowerShell 7 (win-x64) version; bump deliberately, then rebuild the image.
ARG PWSH_VERSION=7.7.0
# Interactive comfort + Windows scripting: curl, less for git paging, bash
# tab-completion, unzip. pwsh win-x64 is self-contained .NET, so it needs no
# Windows install. Own layer so changing it never re-downloads Wine. Debian
# leaves completion opt-in in /etc/bash.bashrc, so enable it for root's
# interactive shells. ca-certificates is required for curl/pwsh HTTPS.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl less bash-completion unzip \
    && curl -fsSL -o /tmp/pwsh.zip "https://github.com/PowerShell/PowerShell/releases/download/v${PWSH_VERSION}/PowerShell-${PWSH_VERSION}-win-x64.zip" \
    && mkdir -p /opt/powershell \
    && unzip -q /tmp/pwsh.zip -d /opt/powershell \
    && rm -f /tmp/pwsh.zip \
    && rm -rf /var/lib/apt/lists/* \
    && echo '. /usr/share/bash-completion/bash_completion' >> /root/.bashrc
# `pwsh` runs the Windows build through Wine; see pwsh.sh for the pty detail.
COPY pwsh.sh /usr/local/bin/pwsh
RUN chmod +x /usr/local/bin/pwsh
# Transparent wrapper: copies a PE off a host bind mount before wine64, so
# `wine64 prog.exe` (and direct invocation) work without a helper command.
COPY wine64.sh /usr/local/bin/wine64
RUN chmod +x /usr/local/bin/wine64
WORKDIR /work
# Default when no command is given: report the Wine version.
ENV PLI_DEFAULT_CMD='wine64 --version'
# Interactive use (`docker run --rm -it pli-wine-test`) lands in bash; commands
# still pass straight through (e.g. `docker run ... wine64 prog.exe`).
# Build context is docker/ (docker build -f docker/Dockerfile.wine-test docker).
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
