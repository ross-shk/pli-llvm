# Native Linux build+test env for plic (glibc, matches --triple *-unknown-linux-gnu).
FROM debian:trixie-slim
# Build deps per README (C++20, LLVM >= 18, lld, CMake, Python).
# Versioned LLVM 23: stock trixie ships LLVM 19 as default, which is too
# old for src/main.cpp (Module::setTargetTriple(Triple) needs LLVM >= 20).
# The -dev packages provide LLVMConfig.cmake + lld headers for find_package().
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential clang-23 lld-23 llvm-23 llvm-23-dev libclang-23-dev liblld-23-dev libpolly-23-dev \
    libclang-rt-23-dev cmake ninja-build python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Point find_package(LLVM/Clang) at the versioned install.
ENV CMAKE_PREFIX_PATH=/usr/lib/llvm-23
# CMAKE_C_COMPILER defaults to cc (gcc), which rejects clang's -target flag
# used for runtime bitcode; pin the whole image to clang.
ENV CC=clang-23 CXX=clang++-23
# Provide unversioned clang on PATH so test scripts using `clang` work.
RUN ln -sf /usr/bin/clang-23 /usr/bin/clang && ln -sf /usr/bin/clang++-23 /usr/bin/clang++
WORKDIR /work
# Default: parallel build then full suite (override with `docker run ... <cmd>`).
CMD ["sh", "-c", "cmake -G Ninja -S . -B build/cmake && cmake --build build/cmake -j$(nproc) && ctest --test-dir build/cmake -j$(nproc)"]
