# TinyCore Linux test-runner for pli (static musl binary runs here).
# pli itself cannot be built here (no LLVM >= 23 tcz); build it elsewhere
# (Debian host with PLI_LLVM_STATIC_PREFIX) and mount the static binary at
# /work or /usr/local/bin/pli.
FROM tatsushid/tinycore:11.0-x86_64
# bash is required by entrypoint.sh (#!/bin/bash); curl for fetching pli.
RUN tce-load -c -wi bash.tcz curl.tcz
WORKDIR /work
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
