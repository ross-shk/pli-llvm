# Bare-minimum test-runner image for pli on TinyCore Linux.
# NOTE: TinyCore's tcz repo ships no LLVM >= 23, so pli cannot be built here
# without compiling LLVM from source. This image only runs tests against a
# prebuilt pli binary (or a host-mounted build dir with its own toolchain).
FROM tatsushid/tinycore:11.0-x86_64
# bash only — entrypoint.sh is #!/bin/bash.
RUN tce-load -c -wi bash.tcz curl.tcz
WORKDIR /work
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
