defined_struct_probe: procedure options(main);
   declare 1 base,
            2 x fixed bin(31),
            2 y fixed bin(31);
   declare 1 view defined base;
   base.x = 5; base.y = 7;
   if view.x ^= 5 then do; put skip list('FAIL x', view.x); stop; end;
   if view.y ^= 7 then do; put skip list('FAIL y', view.y); stop; end;
   view.x = 9;
   if base.x ^= 9 then do; put skip list('FAIL base', base.x); stop; end;
   put skip list('PASS defined_struct_probe');
 end defined_struct_probe;