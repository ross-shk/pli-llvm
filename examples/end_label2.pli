 end_label2: procedure options(main);
    declare i fixed binary(31);
 outer: begin;
    do i = 1 to 10;
       if i = 2 then go to nxt;
    end;
    put skip list('FAIL inner');
 nxt: end outer;
    if i = 2 then
       put skip list('PASS end_label2');
    else
       put skip list('FAIL end_label2', i);
 end end_label2;
