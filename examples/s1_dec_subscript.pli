 /* scratch: a FIXED DECIMAL subscript — is the value unscaled before it
    addresses the array? (found while measuring WS-S1) */
 probe: procedure options(main);
   declare a(1:3) fixed dec(5,2);
   declare i fixed dec(5,2);
   declare x fixed dec(9,2);
   declare fails fixed bin(31);
   fails = 0;
   a(1) = 10.00;
   a(2) = 20.00;
   a(3) = 30.00;
   i = 2.00;
   x = a(i);
   put skip list(x);
   if x ^= 20.00 then fails = fails + 1;
   put skip list(fails);
 end;
