 /* scratch: builtin constant folding witness */
 bi_test: procedure options(main);
    declare s char(10) init('hello');
    declare t char(10) init('0123456789');
    declare v char(10) value('0123456789');
    declare n fixed bin(31);
    declare r char(20);
    n = length('abc');
    n = verify(s, t);
    n = verify(s, v);
    n = verify(s, '0123456789');
    n = search(s, t, 1);
    n = index(s, t);
    r = repeat('x', 5);
    r = repeat('xy', 3);
    put skip list('n=', n);
    put skip list('r=', r);
 end bi_test;
