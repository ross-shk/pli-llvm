 /* scratch: decimal literal overflow + zerodivide probes */
 dec_test: procedure options(main);
    declare a fixed dec(3,2) init(99.99);
    declare b fixed dec(5,2) init(999.99);
    declare z fixed dec(5,2);
    declare q fixed dec(5,2);
    declare d fixed dec(5,2) init(2.0);
    z = 1.0;
    q = z / d;
    put skip list('a=', a);
    put skip list('b=', b);
    put skip list('q=', q);
 end dec_test;
