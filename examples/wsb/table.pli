 /* scratch: constant-alphabet table */
 bi_test: procedure options(main);
    declare s char(10) init('hello');
    declare n fixed bin(31);
    n = verify(s, '0123456789');
    n = search(s, '0123456789', 1);
    n = verify(s, 'e');
    n = search(s, 'e', 1);
    put skip list('n=', n);
 end bi_test;
