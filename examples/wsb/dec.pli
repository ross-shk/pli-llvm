 /* scratch: decimal constant folding witness */
 dec_test: procedure options(main);
    declare d fixed dec(9,2);
    declare e fixed dec(9,2);
    declare f fixed dec(9,2);
    declare i fixed dec(9,2);
    d = 1.5 + 2.25;
    e = 1.5 * 2.25;
    f = 10.0 / 4.0;
    i = 1.5 + 1;
    put skip list('d=', d);
    put skip list('e=', e);
    put skip list('f=', f);
    put skip list('i=', i);
 end dec_test;
