 /* scratch: constant expression in INITIAL/VALUE */
 dec_test: procedure options(main);
    declare a fixed dec(9,2) init(99.99 + 0.01);
    declare b fixed dec(9,2) init(1.5 * 2.25);
    declare c fixed dec(9,2) value(10.0 + 2.5);
    declare d fixed dec(9,2);
    d = 3.5 - 1.25;
    put skip list('a=', a);
    put skip list('b=', b);
    put skip list('c=', c);
    put skip list('d=', d);
 end dec_test;
