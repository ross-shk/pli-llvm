 /* scratch (WS-K1, the negative half): the same program, but the handler
    does NOT read the local — so the local must not be pinned, and must stay
    register-allocatable. */
 order2: procedure options(main);
   declare x fixed bin(31);
   declare i fixed bin(31);
   declare d fixed bin(31);
   declare fails fixed bin(31);
   x = 0;
   on zerodivide begin;
      /* the handler touches nothing of the block's variables */
      put skip list('trap');
   end;
   i = 1;
   do while (i <= 3);
      x = x + 100;
      d = 0;
      x = x + (100 / d);
      i = i + 1;
   end;
   fails = 0;
   put skip list(fails);
 end;
