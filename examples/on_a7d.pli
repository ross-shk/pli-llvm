 /* A7 probe 4: a direct (non-BEGIN) ON unit arms a unit inside it. */
 on_a7d: procedure options(main);
    declare zd_hits fixed bin(31) external;
    declare inner_zd fixed bin(31) external;
    declare outer fixed bin(31) external;
    zd_hits = 0;
    inner_zd = 0;
    outer = 0;
    on zerodivide zd_hits = zd_hits + 1;
    on error on zerodivide inner_zd = inner_zd + 1;
    signal error;
    signal zerodivide;
    put skip list('after-unit', inner_zd, zd_hits);
 end on_a7d;
