 /* DEFINED overlays + iSUB sliding views. 
   
    Run: plic defined_isub.pli -o defd */

 overlays: proc options(main);
   dcl x fixed bin(31);
   dcl y fixed bin(31) defined x;

   x = 7;
   put skip list('y tracks x =', y);

   y = 9;
   put skip list('x tracks y =', x);

   /* one word, two views */
   dcl grid(10,10) fixed bin(31);
   dcl row(10) fixed bin(31) defined grid(1, 1sub);

   dcl i fixed bin(31);
   do i = 1 to 10;
     grid(1,i) = i;
   end;
   put skip list('row sum =', sum(row));

   grid(1,3) = 99;
   put skip list('tracks =', row(3));
   
   row(4) = 100;
   put skip list('writes back =', grid(1,4));
 end;
