# llvm_static.pins — single source of truth for the hermetic static LLVM stash.
# Consumed by scripts/fetch_llvm_static.sh (normal path) and
# scripts/build_llvm_static.sh (dep-bump path, .github/workflows/llvm-deps.yml).
#
# The LLVM toolchain is built ONCE per platform (workflow_dispatch only) and
# stashed as a tarball on the DEPS_TAG release. Normal CI and dev machines
# never compile LLVM: they fetch the matching tarball and verify its sha256.
#
# Replacing a pin: run scripts/build_llvm_static.sh --pack, paste the printed
# sha256 into the platform row, and commit. Never edit this by hand without a
# matching stash upload, or fetch will hard-fail on the checksum.
#
# <platform> <sha256>  (tarball: llvm-static-<LLVM_VER>-<platform>.tar.zst)
LLVM_VER=23.1.3
LLVM_TAG=llvmorg-23.1.3
# Upstream source tarball checksum (github release llvm-project-23.1.3.src.tar.xz).
LLVM_SRC_SHA256=c44186a7762ed28954be72e5ff6df9808e0779d4f1bf014ecc4e7e211d31ee34
ZLIB_VER=1.3.1
ZSTD_VER=1.5.7
DEPS_TAG=llvm-deps-23.1.3
linux-x86_64   <sha256-pending>
linux-aarch64  <sha256-pending>
darwin-arm64   <sha256-pending>
windows-x86_64 <sha256-pending>
