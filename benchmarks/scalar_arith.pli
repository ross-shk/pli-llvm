/* Scalar arithmetic benchmark */
test_scalar: PROCEDURE OPTIONS(MAIN);
   DECLARE (i, n, sum, hash) FIXED BINARY(63);
   DECLARE (x, y, z) FLOAT DECIMAL(16);

   sum = 0;
   hash = 1;
   n = 35000000;
   DO i = 1 TO n;
     sum = sum + MOD(hash, 100);
     hash = MOD(hash * 1103515245 + 12345, 2147483648);
   END;

   x = 0.0;
   y = 1.0;
   DO i = 1 TO 500;
     z = x + y * 2.5;
     x = y;
     y = z;
   END;

   PUT SKIP EDIT(sum, x, y)(F(20), E(24,15), E(24,15));
END test_scalar;
