/* Scalar arithmetic benchmark */
test_scalar: PROCEDURE OPTIONS(MAIN);
  DECLARE (i, j, k, sum) FIXED BINARY(31);
  DECLARE (x, y, z) FLOAT DECIMAL(6);

  sum = 0;
  DO i = 1 TO 5000;
    sum = sum + i;
  END;

  x = 0.0;
  y = 1.0;
  DO i = 1 TO 500;
    z = x + y * 2.5;
    x = y;
    y = z;
  END;

  PUT SKIP LIST(sum, x, y);
END test_scalar;