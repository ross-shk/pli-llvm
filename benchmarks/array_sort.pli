/* Array sorting benchmark - bubble sort on a large array */
test_sort: PROCEDURE OPTIONS(MAIN);
  DECLARE (i, j, n, tmp, sum) FIXED BINARY(31);
  DECLARE arr(2000) FIXED BINARY(31);

  n = 2000;
  DO i = 1 TO n;
    arr(i) = n - i;
  END;

  /* Bubble sort - reverse sorted input */
  DO i = 1 TO n - 1;
    DO j = 1 TO n - i;
      IF arr(j) > arr(j + 1) THEN DO;
        tmp = arr(j);
        arr(j) = arr(j + 1);
        arr(j + 1) = tmp;
      END;
    END;
  END;

  sum = 0;
  DO i = 1 TO n;
    sum = sum + arr(i);
  END;

  PUT SKIP LIST(sum);
END test_sort;
