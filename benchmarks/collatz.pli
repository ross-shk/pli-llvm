/* Collatz conjecture benchmark - integer arithmetic and branching */
test_collatz: PROCEDURE OPTIONS(MAIN);
  DECLARE (i, n, steps, total) FIXED BINARY(31);

  n = 50000;
  total = 0;
  DO i = 2 TO n;
    steps = 0;
    n = i;
    DO WHILE (n > 1);
      IF MOD(n, 2) = 0 THEN
        n = n / 2;
      ELSE
        n = 3 * n + 1;
      steps = steps + 1;
    END;
    total = total + steps;
  END;

  PUT SKIP LIST(total);
END test_collatz;
