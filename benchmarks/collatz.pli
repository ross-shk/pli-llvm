/* Collatz conjecture benchmark - integer arithmetic and branching */
test_collatz: PROCEDURE OPTIONS(MAIN);
  DECLARE (i, m, n, steps, total) FIXED BINARY(63);

   n = 400000;
  total = 0;
  DO i = 2 TO n;
    steps = 0;
    m = i;
    DO WHILE (m > 1);
      IF MOD(m, 2) = 0 THEN
        m = m / 2;
      ELSE
        m = 3 * m + 1;
      steps = steps + 1;
    END;
    total = total + steps;
  END;

  PUT SKIP LIST(total);
END test_collatz;
