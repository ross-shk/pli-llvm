/* FIXED BINARY(63) arithmetic benchmark - widening, mixed 31x63 ops. */
/* Partners scalar_arith (which stays in 31-bit range). */
/*
 * Bounds (all < 2^63-1 ~ 9.2e18; see P2 checklist item 1):
 *   - hash: kept < 2^31 via MOD 2147483648
 *   - hash * 1103515245 + 12345: max ~2.37e18 (fits i64, no overflow)
 *   - a31 < 7919, b31 < 31, w31 < 7950
 *   - acc grows by ~2.1e9/iter max: 30M * 2.1e9 = 6.3e16 < 9.2e18
 *   - sum < 3e10 (fits i64)
 *
 * Scaling rule (P2 checklist item 2): 30M iterations of 63-bit multiply +
 * MOD + widening add — slowest -O2 config exceeds 50ms at -O2.
 *
 * Codegen pinned (P2 checklist item 4): FIXED BINARY(63) multiply without
 * overflow trap; implicit widening of FIXED BINARY(31) operand in mixed
 * addition; no redundant sign-extension of 31-bit values on use.
 */
test_bin63: PROCEDURE OPTIONS(MAIN);
   DECLARE (i, n) FIXED BINARY(63);
   DECLARE (acc, sum, hash) FIXED BINARY(63);
   DECLARE (a31, b31, w31) FIXED BINARY(31);

   acc = 0;
   sum = 0;
   hash = 1;
   n = 30000000;

   DO i = 1 TO n;
     a31 = MOD(hash, 7919);          /* 63-bit MOD, narrows to 31-bit store */
     b31 = MOD(hash, 31);
     w31 = a31 + b31;                 /* 31-bit arithmetic */
     acc = acc + w31 + hash;          /* w31 widens to 63-bit; hash is 63-bit */
     hash = MOD(hash * 1103515245 + 12345, 2147483648);
     sum = sum + MOD(acc, 997);       /* 63-bit MOD */
   END;

   PUT SKIP LIST(sum);
END test_bin63;
