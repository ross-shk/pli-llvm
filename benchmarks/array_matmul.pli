/* Array operations benchmark - matrix multiply */
test_array: PROCEDURE OPTIONS(MAIN);
  DECLARE (i, j, k, n) FIXED BINARY(31);
  DECLARE a(400,400) FIXED BINARY(31);
  DECLARE b(400,400) FIXED BINARY(31);
  DECLARE c(400,400) FIXED BINARY(31);
  DECLARE sum FIXED BINARY(63);          /* checksum overflows 32-bit at n=400 */

  n = 400;
  
  /* Initialize matrices */
  DO i = 1 TO n;
    DO j = 1 TO n;
      a(i,j) = i + j;
      b(i,j) = i - j;
      c(i,j) = 0;
    END;
  END;

  /* Matrix multiply */
  DO i = 1 TO n;
    DO j = 1 TO n;
      sum = 0;
      DO k = 1 TO n;
        sum = sum + a(i,k) * b(k,j);
      END;
      c(i,j) = sum;
    END;
  END;

  /* Verify with checksum */
  sum = 0;
  DO i = 1 TO n;
    DO j = 1 TO n;
      sum = sum + c(i,j);
    END;
  END;

  PUT SKIP LIST(sum);
END test_array;