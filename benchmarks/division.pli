/* Division benchmark - tests FIXED/FIXED → FIXED fast path */
test_div: PROCEDURE OPTIONS(MAIN);
  DECLARE (i, j, denom, result) FIXED BINARY(31);
  DECLARE sum FIXED BINARY(63);

  sum = 0;
   DO i = 1 TO 600000;
    DO j = 1 TO 100;
      denom = MOD(j, 17) + 1;
      result = i / denom;
      sum = sum + result;
    END;
  END;

  PUT SKIP LIST(sum);
END test_div;
