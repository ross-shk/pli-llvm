/* File I/O benchmark - sequential WRITE then READ of 10000 records */
/* through a temp file. Stdout is a checksum only (never timing) so */
/* the harness match logic works unchanged. Partners io_throughput. */
/*
 * Bounds (P2 checklist item 1):
 *   - record values: i * 7 MOD 1000, max 997 (fits FIXED BINARY(31))
   *   - checksum: 500000 iters * ~400K = ~2e11 (fits FIXED BINARY(63)) ✓
 *
   * Scaling rule (P2 checklist item 2): 100000 records each side, 200000
   * file operations total — slow enough for >50ms at -O2.
 *
 * Codegen pinned (P2 checklist item 4): GET/PUT stream I/O path through
 * the runtime list-directed output buffer (see irgen.cpp PUT/GET lowering).
 */
test_fileio: PROCEDURE OPTIONS(MAIN);
   DECLARE (i, n, val) FIXED BINARY(31);
   DECLARE checksum FIXED BINARY(63);
   DECLARE f FILE;

   n = 500000;

   /* WRITE phase — SKIP writes each value on its own record (newline) */
   OPEN FILE(f) TITLE('/tmp/pli_fileio_test') OUTPUT;
   DO i = 1 TO n;
      val = MOD(i * 7, 1000);
      PUT FILE(f) SKIP LIST(val);
   END;
   CLOSE FILE(f);

   /* READ phase */
   checksum = 0;
   OPEN FILE(f) TITLE('/tmp/pli_fileio_test') INPUT;
   DO i = 1 TO n;
      GET FILE(f) SKIP LIST(val);
      checksum = checksum + val;
   END;
   CLOSE FILE(f);

   PUT SKIP LIST(checksum);
END test_fileio;
