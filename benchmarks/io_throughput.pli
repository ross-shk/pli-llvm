/* I/O throughput benchmark: emits 1000 lines of formatted output via
   PUT SKIP LIST (rules (104)-(105)) — exercising the list-directed
   output path — plus a final integer checksum. Both PL/I and C produce
   identical stdout so the harness can verify correctness. */
io_throughput: procedure options(main);
   declare i fixed bin(31);
   declare total fixed bin(31);

   total = 0;
   do i = 1 to 1000;
      put skip list(i, i * i, abs(5000 - i * 3));
      total = total + i;
   end;
   put skip list(total);
end io_throughput;
