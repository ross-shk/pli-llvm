 /* The shape of a by-ref array parameter (WS-G3, ADR-271). The callee
    sums its array parameter; the dummy's extent is known at compile time,
    so with the parameter's shape described to LLVM the loop may be
    vectorized. The paired build (--no-param-attrs) prices the description
    against the same program compiled without it. */
 array_param: procedure options(main);
   declare a(1000) fixed bin(31);
   declare i fixed bin(31);
   declare s fixed bin(63);

   do i = 1 to 1000;
      a(i) = i * 7 - 3;
   end;

   s = 0;
   do i = 1 to 1000000;
      s = s + total(a);
   end;

   put skip list(s);

 total: procedure(x) returns(fixed bin(63));
   declare x(1000) fixed bin(31);
   declare i fixed bin(31);
   declare t fixed bin(63);
   t = 0;
   do i = 1 to 1000;
      t = t + x(i);
   end;
   return(t);
 end total;
 end array_param;
