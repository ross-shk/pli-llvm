 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* Procedure memory effects (WS-A1, ADR-264). The helper is a top-level
    procedure, so it is externally linked and the compiler never marks it for
    inlining; LLVM may still specialize it. The call sits in a hot loop whose
    other operand comes from an array, so the loop cannot be folded away.
    The paired build (--no-memory-effects) prices the inferred effect against
    the same program compiled without it. */
 pure_call: procedure options(main);
   declare a(1000) fixed bin(31);
   declare (i, j, x) fixed bin(31);
   declare s fixed bin(63);

   do i = 1 to 1000;
      a(i) = i * 7 - 3;
   end;

   s = 0;
   do i = 1 to 150000000;
      j = mod(i, 1000) + 1;
      x = a(j);
      s = s + x + helper(i);
   end;

   put skip list(s);

 helper: procedure(x) returns(fixed bin(31));
   declare x fixed bin(31);
   declare y fixed bin(31);
   y = x * 3 + 1;
   return(y);
 end helper;
 end pure_call;
