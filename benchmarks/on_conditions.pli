/* Rules (91)-(94): ON ZERODIVIDE establishes a handler that
   resumes division by zero with 0. This benchmark performs repeated
   integer divisions in a tight loop, triggering the handler whenever
   the divisor is zero (every 100th iteration), and accumulates a
   deterministic checksum. */
on_conditions: procedure options(main);
   declare i fixed bin(31);
    declare s fixed bin(63);
   declare q fixed bin(31);
    s = 0;
    /* Bare RETURN ends the ON-unit and resumes after the faulting division
       with q = 0 (rule 91; cf. irgen.cpp zerodivideResume). Every 100th
       iteration faults, so this loop measures ~1% handler-take rate. */
    on zerodivide begin;
      return;
   end;
     do i = 1 to 60000000;
      q = 1000000 / mod(i, 100);
      s = s + i;
      s = s + mod(q, 10);
   end;
   put skip list(s);
end on_conditions;
