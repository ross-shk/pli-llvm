 /* SPDX-License-Identifier: Apache-2.0 */
 /* Copyright 2026 Ross S. - pli-llvm: a PL/I compiler targeting LLVM */
 /* Paged KV-cache benchmark: free-block stack, per-sequence block
    tables, reference counts, prefix sharing on fork, copy-on-write of a
    shared partial block and preemption when memory runs out - the
    host-side metadata a vLLM-style server keeps around the GPU KV
    tensors (benchmarks/LLM-ORCHESTRATION-PLAN.md 4.3). */
 /*
  * Bounds:
  *   - 320 physical blocks, 32 sequences, at most 64 blocks each
  *   - slot = (b - 1) * 16 + off < 5120; chk = mod(chk * 31 + slot,
  *     1000000007) < 3.2e10 per tick (fits fixed bin(63))
  *   - the free stack holds at most 320 entries; a block is pushed
  *     only when its count reaches 0, and a block passes through at
  *     most one 0 per release, so the stack cannot overflow
  *
  * Scaling rule: 1200000 ticks of 32 sequences puts the slowest -O2
  * configuration at ~230 ms.
  */
 test_llm_kvcache: proc options(main);
    dcl btab(32, 64) fixed bin(31);
    dcl nblk(32) fixed bin(31);
    dcl slen(32) fixed bin(31);
    dcl goal(32) fixed bin(31);
    dcl refs(320) fixed bin(31);
    dcl free_stk(320) fixed bin(31);
    dcl (nfree, s, q, b, lb, off, j, victim, src, nshare, tick)
       fixed bin(31);
    dcl (seed, chk, nalloc, ncow, npreempt) fixed bin(63);
    dcl (need, cow) bit(1);

    /* every physical block starts on the free stack */
    nfree = 0;
    do b = 320 to 1 by -1;
       nfree = nfree + 1;
       free_stk(nfree) = b;
       refs(b) = 0;
    end;
    seed = 4242;
    do s = 1 to 32;
       nblk(s) = 0;
       slen(s) = 0;
       seed = mod(seed * 1103515245 + 12345, 2147483648);
       goal(s) = 32 + mod(seed / 65536, 224);
    end;
    chk = 0;
    nalloc = 0;
    ncow = 0;
    npreempt = 0;

    do tick = 1 to 1200000;
       /* periodic admission pressure: preempt the longest other
          sequence even while the pool still has room, so the eviction
          path is priced alongside allocation */
       if mod(tick, 5000) = 0 then do;
          victim = 0;
          do q = 2 to 32;
             if victim = 0 then victim = q;
             else if nblk(q) > nblk(victim) then victim = q;
          end;
          if nblk(victim) > 0 then do;
             call release(victim);
             npreempt = npreempt + 1;
          end;
       end;
       do s = 1 to 32;
          /* sequence done: release it and fork a new one sharing up
             to eight blocks of its neighbour, partial tail included */
          if slen(s) >= goal(s) then do;
             call release(s);
             src = mod(s, 32) + 1;
             slen(s) = slen(src);
             if slen(s) > 120 then slen(s) = 120;
             nshare = (slen(s) + 15) / 16;
             do j = 1 to nshare;
                btab(s, j) = btab(src, j);
                refs(btab(s, j)) = refs(btab(s, j)) + 1;
             end;
             nblk(s) = nshare;
             seed = mod(seed * 1103515245 + 12345, 2147483648);
             goal(s) = slen(s) + 32 + mod(seed / 65536, 224);
          end;
          /* append one token: a new logical block, or a shared one
             that must be copied before it is written */
          lb = slen(s) / 16 + 1;
          off = mod(slen(s), 16);
          need = lb > nblk(s);
          cow = '0'b;
          if ^need then do;
             b = btab(s, lb);
             if refs(b) > 1 then do;
                refs(b) = refs(b) - 1;
                cow = '1'b;
                need = '1'b;
             end;
          end;
          if need then do;
             /* no free block: preempt the longest other sequence */
             do while (nfree = 0);
                victim = 0;
                do q = 1 to 32;
                   if q ^= s then
                      if victim = 0 then victim = q;
                      else if nblk(q) > nblk(victim) then victim = q;
                end;
                call release(victim);
                npreempt = npreempt + 1;
             end;
             b = free_stk(nfree);
             nfree = nfree - 1;
             refs(b) = 1;
             btab(s, lb) = b;
             nblk(s) = lb;
             nalloc = nalloc + 1;
             if cow then ncow = ncow + 1;
          end;
          slen(s) = slen(s) + 1;
          chk = mod(chk * 31 + (b - 1) * 16 + off, 1000000007);
       end;
    end;
    put skip list(nalloc);
    put skip list(ncow);
    put skip list(npreempt);
    put skip list(chk);

 /* drop one reference to each block; a block with none goes back */
 release: proc(q);
    dcl (q, k, p) fixed bin(31);
    do k = 1 to nblk(q);
       p = btab(q, k);
       refs(p) = refs(p) - 1;
       if refs(p) = 0 then do;
          nfree = nfree + 1;
          free_stk(nfree) = p;
       end;
    end;
    nblk(q) = 0;
    slen(q) = 0;
 end release;
 end test_llm_kvcache;
